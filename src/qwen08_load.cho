edition 5;
module qwen08_load;

// `qwen08_load` -- the weight loader for the Qwen3.5-0.8B Hugging Face
// checkpoint (`docs/weight-space.md` section 14, ticket T5, check C2).
//
// The checkpoint is one safetensors file under `model.language_model.*`
// (text tower: 24 layers, 18 gated-delta and 6 full-attention, hidden 1,024,
// a TIED embedding and head), BF16 except `A_log` and
// `linear_attn.norm.weight`, which are F32. The vision tower (`model.visual.*`)
// and the multi-token-prediction head (`mtp.*`) are in the file and are not
// loaded. This module is device-free: it reads `config.json`, checks the
// header against the layout the config implies, and converts one chunk of one
// tensor at a time into the text pool; `device/qwen08_dev.cho` uploads the
// chunks and `device/qwen08-load-main.cho` is the program that proves C2.
//
// The language has f16, f32 and i8 only, so a BF16 weight goes up as
//   * `mode_f32`: widened to f32, which is exact (a bf16 is the top half of an
//     f32); 4 bytes a value, 3.0 GB for the text tower;
//   * `mode_f16`: narrowed to f16, round to nearest even, 2 bytes a value.
//     NOT exact: a bf16 has the range of an f32 and f16 stops at 2^-24 and
//     65504, so a value below 2^-14 loses bits or becomes zero (0.40% of the
//     base checkpoint's text weights, `docs/weight-space.md` 14.2). The chunk
//     loader counts the values that change.
// An F32 tensor goes up as F32 on both paths (the recurrence constants are not
// narrowed).
//
// The patch seam (T11): `apply_patch` is called on every chunk of raw
// file-dtype bytes before the conversion. It is where "base + patch" will
// overwrite the (row, column, bf16 bits) entries that fall in the chunk. No
// patch format exists yet, so a patch handle other than -1 is refused with
// `q08-patch`.
//
// It has no input that traps: every dimension of the config is bounded before
// it is used, the expected shapes are compared with the file's (never
// multiplied past it), and a read that returns short is a refusal.

import std.json;
import mem;
import text;
import err;
import fileio;
import safetensors;
import jstr;

pub fn mode_f32() -> [] int {
    return 0;
}

pub fn mode_f16() -> [] int {
    return 1;
}

// The values converted at a time. The caller reserves `4 * chunk_values()`
// bytes for the raw bytes and the same for the converted ones.
pub fn chunk_values() -> [] int {
    return 4194304;
}

// BF16 and F32 in safetensors' dtype numbering (`safetensors.dtype_name`).
fn bf16() -> [] int {
    return 8;
}

fn f32t() -> [] int {
    return 11;
}

// ---------------------------------------------------------------------
// The config
// ---------------------------------------------------------------------

// The record `read_config` answers: the text tower's dimensions.
pub fn c_hidden() -> [] int {
    return 0;
}

pub fn c_inter() -> [] int {
    return 1;
}

pub fn c_layers() -> [] int {
    return 2;
}

pub fn c_vocab() -> [] int {
    return 3;
}

// A layer `l` is full attention when `(l + 1) % interval == 0`.
pub fn c_interval() -> [] int {
    return 4;
}

pub fn c_heads() -> [] int {
    return 5;
}

pub fn c_kv_heads() -> [] int {
    return 6;
}

pub fn c_head_dim() -> [] int {
    return 7;
}

pub fn c_lk_heads() -> [] int {
    return 8;
}

pub fn c_lk_dim() -> [] int {
    return 9;
}

pub fn c_lv_heads() -> [] int {
    return 10;
}

pub fn c_lv_dim() -> [] int {
    return 11;
}

pub fn c_conv() -> [] int {
    return 12;
}

// 1 when `q_proj` carries the output gate (twice the rows).
pub fn c_gate() -> [] int {
    return 13;
}

fn key[&m, &t](m: &!m [int], t: &!t [byte], tape: int, words: int, hs: int, n: int, node: int, name: &static [byte], hi: int) -> [] int {
    let v = json.get(t[hs..hs + n], m[tape..tape + words], node, name);
    if v < 0 || !json.is_int(m[tape..tape + words], v) || !json.fits_int(t[hs..hs + n], m[tape..tape + words], v) {
        return err.fail(m, t, "q08-config", text.f1(m, t, "config.json has no integer `$`", text.lit(m, t, name)));
    }
    let x = json.to_int(t[hs..hs + n], m[tape..tape + words], v);
    if x < 1 || x > hi {
        return err.fail(m, t, "q08-config", text.f1(m, t, "`$` is outside what this loader takes", text.lit(m, t, name)));
    }
    return x;
}

// The `text_config` of the `config.json` at `path`, as the record above, or -1.
pub fn read_config[&m, &t, &f](m: &!m [int], t: &!t [byte], fs: &f Fs(""), path: int) -> [fs_read(""), file_read] int {
    let (hs, n, size) = fileio.prefix(m, t, fs, text.bytes(t, path), 1048576);
    if hs < 0 || size > n {
        return err.fail(m, t, "q08-io", text.f1(m, t, "cannot read $ (or it is over 1 MiB)", path));
    }
    let words = 3 * jstr.node_bound(t, hs, hs + n) + 3;
    let tape = mem.grab(m, words);
    let nodes = json.parse(t[hs..hs + n], m[tape..tape + words]);
    if nodes < 0 {
        return err.fail(m, t, "q08-config-json", text.f1(m, t, "$ is not JSON", path));
    }
    if !json.is_object(m[tape..tape + words], 0) {
        return err.fail(m, t, "q08-config", text.lit(m, t, "config.json is not an object"));
    }
    let tc = json.get(t[hs..hs + n], m[tape..tape + words], 0, "text_config");
    if tc < 0 || !json.is_object(m[tape..tape + words], tc) {
        return err.fail(m, t, "q08-config", text.lit(m, t, "config.json has no `text_config` object"));
    }
    let c = mem.rec(m, 14);
    // 2^20 bounds every dimension but the vocabulary; no product of three
    // is ever formed, and a sum of two products stays far inside 2^62.
    let small = 1048576;
    m[c] = key(m, t, tape, words, hs, n, tc, "hidden_size", small);
    m[c + 1] = key(m, t, tape, words, hs, n, tc, "intermediate_size", small);
    m[c + 2] = key(m, t, tape, words, hs, n, tc, "num_hidden_layers", 1024);
    m[c + 3] = key(m, t, tape, words, hs, n, tc, "vocab_size", 67108864);
    m[c + 4] = key(m, t, tape, words, hs, n, tc, "full_attention_interval", 1024);
    m[c + 5] = key(m, t, tape, words, hs, n, tc, "num_attention_heads", small);
    m[c + 6] = key(m, t, tape, words, hs, n, tc, "num_key_value_heads", small);
    m[c + 7] = key(m, t, tape, words, hs, n, tc, "head_dim", small);
    m[c + 8] = key(m, t, tape, words, hs, n, tc, "linear_num_key_heads", small);
    m[c + 9] = key(m, t, tape, words, hs, n, tc, "linear_key_head_dim", small);
    m[c + 10] = key(m, t, tape, words, hs, n, tc, "linear_num_value_heads", small);
    m[c + 11] = key(m, t, tape, words, hs, n, tc, "linear_value_head_dim", small);
    m[c + 12] = key(m, t, tape, words, hs, n, tc, "linear_conv_kernel_dim", 1024);
    if err.failed(m) {
        return 0 - 1;
    }
    let tie = json.get(t[hs..hs + n], m[tape..tape + words], tc, "tie_word_embeddings");
    if tie < 0 || !json.is_bool(m[tape..tape + words], tie) || !json.to_bool(m[tape..tape + words], tie) {
        return err.fail(m, t, "q08-unsupported", text.lit(m, t, "this loader takes a tied embedding and head (`tie_word_embeddings` true)"));
    }
    m[c + 13] = 1;
    let gate = json.get(t[hs..hs + n], m[tape..tape + words], tc, "attn_output_gate");
    if gate >= 0 {
        if !json.is_bool(m[tape..tape + words], gate) {
            return err.fail(m, t, "q08-config", text.lit(m, t, "`attn_output_gate` is not a boolean"));
        }
        if !json.to_bool(m[tape..tape + words], gate) {
            m[c + 13] = 0;
        }
    }
    let interval = m[c + 4];
    let layers = m[c + 2];
    let lt = json.get(t[hs..hs + n], m[tape..tape + words], tc, "layer_types");
    if lt >= 0 {
        if !json.is_array(m[tape..tape + words], lt) || json.count(m[tape..tape + words], lt) != layers {
            return err.fail(m, t, "q08-layers", text.lit(m, t, "`layer_types` is not a list with one entry a layer"));
        }
        var cur = lt + 1;
        var l = 0;
        while l < layers {
            if !json.is_string(m[tape..tape + words], cur) {
                return err.fail(m, t, "q08-layers", text.n1(m, t, "layer $ has a type that is not a string", l));
            }
            var ok = false;
            if (l + 1) % interval == 0 {
                ok = json.string_equals(t[hs..hs + n], m[tape..tape + words], cur, "full_attention");
            } else {
                ok = json.string_equals(t[hs..hs + n], m[tape..tape + words], cur, "linear_attention");
            }
            if !ok {
                return err.fail(m, t, "q08-layers", text.n1(m, t, "layer $ is not the type `full_attention_interval` gives it", l));
            }
            cur = json.skip(m[tape..tape + words], cur);
            l = l + 1;
        }
    }
    return c;
}

// ---------------------------------------------------------------------
// The weights file and the plan
// ---------------------------------------------------------------------

// The record `open_weights` answers.
pub fn w_path() -> [] int {
    return 0;
}

pub fn w_header() -> [] int {
    return 1;
}

// The offset of the data section in the file.
pub fn w_data() -> [] int {
    return 2;
}

// The weights file of the model directory `dir`: `model.safetensors`, else
// the single shard Hugging Face names `model.safetensors-00001-of-00001.safetensors`.
// The header is parsed and checked against the file's size. `[path, header, data]`, or -1.
pub fn open_weights[&m, &t, &f](m: &!m [int], t: &!t [byte], fs: &f Fs(""), dir: int) -> [fs_read(""), file_read] int {
    var k = 0;
    while k < 2 {
        var path = text.f1(m, t, "$/model.safetensors", dir);
        if k == 1 {
            path = text.f1(m, t, "$/model.safetensors-00001-of-00001.safetensors", dir);
        }
        let mark = m[mem.text_slot()];
        let (top, got, size) = fileio.prefix(m, t, fs, text.bytes(t, path), 2097152);
        if top >= 0 {
            let st = safetensors.parse(m, t, top, top + got, size);
            if st < 0 {
                return 0 - 1;
            }
            return mem.rec3(m, path, st, 8 + m[st + safetensors.f_header()]);
        }
        if top == 0 - 2 {
            return err.fail(m, t, "q08-io", text.f1(m, t, "the header of $ does not fit the text pool", path));
        }
        m[mem.text_slot()] = mark;
        k = k + 1;
    }
    return err.fail(m, t, "q08-io", text.f1(m, t, "no model.safetensors in $", dir));
}

// One tensor to load, in the order of `plan`.
pub fn p_name() -> [] int {
    return 0;
}

// `BF16` (8) or `F32` (11) in safetensors' numbering.
pub fn p_dtype() -> [] int {
    return 1;
}

pub fn p_elems() -> [] int {
    return 2;
}

// The tensor's first byte in the file.
pub fn p_offset() -> [] int {
    return 3;
}

pub fn is_f32_file[&m](m: &!m [int], rec: int) -> [] bool {
    return m[rec + 1] == f32t();
}

fn lookup[&m, &t](m: &!m [int], t: &!t [byte], st: int, name: int) -> [] int {
    let list = m[st + safetensors.f_list()];
    var i = 0;
    while i < mem.size(m, list) {
        let r = mem.get(m, list, i);
        if text.eq(t, m[r], name) {
            return r;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn want[&m, &t](m: &!m [int], t: &!t [byte], st: int, data: int, plan: int, name: int, dtype: int, shape: int) -> [] int {
    let r = lookup(m, t, st, name);
    if r < 0 {
        return err.fail(m, t, "q08-missing", text.f1(m, t, "the checkpoint has no tensor `$`", name));
    }
    if m[r + 1] != dtype {
        return err.fail(m, t, "q08-dtype", text.f2(m, t, "`$` is stored as $ and this model's layout wants the other of BF16 and F32", name, safetensors.dtype_name(m, t, m[r + 1])));
    }
    if !mem.same(m, m[r + 2], shape) {
        return err.fail(m, t, "q08-shape", text.f1(m, t, "`$` has a shape that is not the one `config.json` implies", name));
    }
    mem.push(m, plan, mem.rec4(m, name, dtype, mem.product(m, shape), data + m[r + 3]));
    return 0;
}

fn layer_name[&m, &t](m: &!m [int], t: &!t [byte], l: int, suffix: &static [byte]) -> [] int {
    return text.f2(m, t, "model.language_model.layers.$.$", text.num(m, t, l), text.lit(m, t, suffix));
}

fn w1[&m, &t](m: &!m [int], t: &!t [byte], st: int, data: int, plan: int, name: int, dtype: int, a: int) -> [] int {
    return want(m, t, st, data, plan, name, dtype, mem.of1(m, a));
}

fn w2[&m, &t](m: &!m [int], t: &!t [byte], st: int, data: int, plan: int, name: int, a: int, b: int) -> [] int {
    return want(m, t, st, data, plan, name, bf16(), mem.of2(m, a, b));
}

// The tensors of the text tower, in file-independent order (embedding, each
// layer, final norm), checked against the header `st` of a file whose data
// section starts at `data`: every one present with the dtype and shape the config
// implies, and nothing else under `model.language_model.` (the vision tower
// and the `mtp.` head are left alone; an `lm_head.weight` is refused because
// the head is tied). The list of records above, or -1.
pub fn plan[&m, &t](m: &!m [int], t: &!t [byte], st: int, data: int, cfg: int) -> [] int {
    let h = m[cfg + c_hidden()];
    let inter = m[cfg + c_inter()];
    let p = mem.list(m);
    w2(m, t, st, data, p, text.lit(m, t, "model.language_model.embed_tokens.weight"), m[cfg + c_vocab()], h);
    let layers = m[cfg + c_layers()];
    let lkh = m[cfg + c_lk_heads()];
    let lkd = m[cfg + c_lk_dim()];
    let lvh = m[cfg + c_lv_heads()];
    let lvd = m[cfg + c_lv_dim()];
    let conv_ch = 2 * lkh * lkd + lvh * lvd;
    let heads = m[cfg + c_heads()];
    let kvh = m[cfg + c_kv_heads()];
    let hd = m[cfg + c_head_dim()];
    var q_rows = heads * hd;
    if m[cfg + c_gate()] == 1 {
        q_rows = 2 * q_rows;
    }
    var l = 0;
    while l < layers {
        w1(m, t, st, data, p, layer_name(m, t, l, "input_layernorm.weight"), bf16(), h);
        w1(m, t, st, data, p, layer_name(m, t, l, "post_attention_layernorm.weight"), bf16(), h);
        w2(m, t, st, data, p, layer_name(m, t, l, "mlp.gate_proj.weight"), inter, h);
        w2(m, t, st, data, p, layer_name(m, t, l, "mlp.up_proj.weight"), inter, h);
        w2(m, t, st, data, p, layer_name(m, t, l, "mlp.down_proj.weight"), h, inter);
        if (l + 1) % m[cfg + c_interval()] == 0 {
            w2(m, t, st, data, p, layer_name(m, t, l, "self_attn.q_proj.weight"), q_rows, h);
            w2(m, t, st, data, p, layer_name(m, t, l, "self_attn.k_proj.weight"), kvh * hd, h);
            w2(m, t, st, data, p, layer_name(m, t, l, "self_attn.v_proj.weight"), kvh * hd, h);
            w2(m, t, st, data, p, layer_name(m, t, l, "self_attn.o_proj.weight"), h, heads * hd);
            w1(m, t, st, data, p, layer_name(m, t, l, "self_attn.q_norm.weight"), bf16(), hd);
            w1(m, t, st, data, p, layer_name(m, t, l, "self_attn.k_norm.weight"), bf16(), hd);
        } else {
            w1(m, t, st, data, p, layer_name(m, t, l, "linear_attn.A_log"), f32t(), lvh);
            w1(m, t, st, data, p, layer_name(m, t, l, "linear_attn.norm.weight"), f32t(), lvd);
            w1(m, t, st, data, p, layer_name(m, t, l, "linear_attn.dt_bias"), bf16(), lvh);
            want(m, t, st, data, p, layer_name(m, t, l, "linear_attn.conv1d.weight"), bf16(), mem.of3(m, conv_ch, 1, m[cfg + c_conv()]));
            w2(m, t, st, data, p, layer_name(m, t, l, "linear_attn.in_proj_qkv.weight"), conv_ch, h);
            w2(m, t, st, data, p, layer_name(m, t, l, "linear_attn.in_proj_z.weight"), lvh * lvd, h);
            w2(m, t, st, data, p, layer_name(m, t, l, "linear_attn.in_proj_a.weight"), lvh, h);
            w2(m, t, st, data, p, layer_name(m, t, l, "linear_attn.in_proj_b.weight"), lvh, h);
            w2(m, t, st, data, p, layer_name(m, t, l, "linear_attn.out_proj.weight"), h, lvh * lvd);
        }
        if err.failed(m) {
            return 0 - 1;
        }
        l = l + 1;
    }
    w1(m, t, st, data, p, text.lit(m, t, "model.language_model.norm.weight"), bf16(), h);
    if err.failed(m) {
        return 0 - 1;
    }
    // Nothing in the file the plan does not know.
    let all = m[st + safetensors.f_list()];
    var i = 0;
    while i < mem.size(m, all) {
        let name = m[mem.get(m, all, i)];
        if text.is(t, name, "lm_head.weight") {
            return err.fail(m, t, "q08-untied", text.lit(m, t, "the file has `lm_head.weight` but this loader takes a tied head"));
        }
        if text.starts_with(t, name, "model.language_model.") {
            var known = false;
            var j = 0;
            while j < mem.size(m, p) {
                if text.eq(t, m[mem.get(m, p, j)], name) {
                    known = true;
                }
                j = j + 1;
            }
            if !known {
                return err.fail(m, t, "q08-unexpected", text.f1(m, t, "the checkpoint has a tensor `$` that this model's layout does not", name));
            }
        } else if !text.starts_with(t, name, "model.visual.") && !text.starts_with(t, name, "mtp.") {
            return err.fail(m, t, "q08-unexpected", text.f1(m, t, "the checkpoint has a tensor `$` outside the text tower, the vision tower and the mtp head", name));
        }
        i = i + 1;
    }
    return p;
}

// ---------------------------------------------------------------------
// Conversion, a chunk at a time
// ---------------------------------------------------------------------

// Bytes a value of tensor `rec` takes on the device under `mode`.
pub fn out_width[&m](m: &!m [int], rec: int, mode: int) -> [] int {
    if m[rec + 1] == f32t() || mode == mode_f32() {
        return 4;
    }
    return 2;
}

// bf16 to f32 is a shift: the 16 bits are the top of the f32. `n` values at
// `t[from..]` become `4 n` bytes at `t[to..]`.
pub fn widen_bf16[&t](t: &!t [byte], from: int, to: int, n: int) -> [] int {
    var i = 0;
    while i < n {
        t[to + 4 * i] = byte_of(0);
        t[to + 4 * i + 1] = byte_of(0);
        t[to + 4 * i + 2] = t[from + 2 * i];
        t[to + 4 * i + 3] = t[from + 2 * i + 1];
        i = i + 1;
    }
    return 0;
}

// bf16 to f16, round to nearest even (what numpy's `astype(float16)` does):
// exact above 2^-14 and below 65504; a subnormal result keeps what 10 bits of
// 2^-24 units hold; below half of 2^-24 the value is zero; at 2^16 and above
// it is infinity. A NaN becomes the quiet NaN 0x7E00. `n` values at
// `t[from..]` become `2 n` bytes at `t[to..]`. The answer is how many of the
// values are not the bf16 original (a NaN is the original if its payload is
// what 0x7E00 widens back to).
pub fn narrow_bf16_to_f16[&t](t: &!t [byte], from: int, to: int, n: int) -> [] int {
    var changed = 0;
    var i = 0;
    while i < n {
        let b = int_of(t[from + 2 * i]) | int_of(t[from + 2 * i + 1]) << 8;
        let sign = b >> 15 & 1;
        let e = b >> 7 & 255;
        let mant = b & 127;
        var h = 0;
        var exact = true;
        if e == 255 {
            h = 31744;
            if mant != 0 {
                h = 32256;
                exact = mant == 64;
            }
        } else if e == 0 {
            // Zero, or a bf16 subnormal (under 2^-126): far under half of 2^-24.
            exact = mant == 0;
        } else if e >= 143 {
            // 2^16 and up.
            h = 31744;
            exact = false;
        } else if e >= 113 {
            h = e - 112 << 10 | mant << 3;
        } else {
            // A subnormal f16: (128 + mant) * 2^(e - 110) units of 2^-24.
            let full = 128 + mant;
            if e >= 110 {
                h = full << e - 110;
            } else {
                let s = 110 - e;
                if s >= 9 {
                    exact = false;
                } else {
                    let q = full >> s;
                    let rem = full & (1 << s) - 1;
                    let half = 1 << s - 1;
                    h = q;
                    if rem > half || rem == half && q & 1 == 1 {
                        h = q + 1;
                    }
                    exact = rem == 0;
                }
            }
        }
        if !exact {
            changed = changed + 1;
        }
        h = h | sign << 15;
        t[to + 2 * i] = byte_of(h & 255);
        t[to + 2 * i + 1] = byte_of(h >> 8 & 255);
        i = i + 1;
    }
    return changed;
}

// The T11 seam: `n` values of tensor `rec` from value `done`, as the file has
// them (`t[raw..]`, BF16 or F32), before they are converted. A patch will
// overwrite here the entries of its tensor whose flat index is in
// `[done, done + n)`. No patch format exists, so only "no patch" (-1) is taken.
pub fn apply_patch[&m, &t](m: &!m [int], t: &!t [byte], patch: int, rec: int, done: int, n: int, raw: int) -> [] int {
    if patch >= 0 {
        return err.fail(m, t, "q08-patch", text.f1(m, t, "a patch was given for `$` but no patch format exists yet", m[rec]));
    }
    return 0;
}

// Read `n` values of tensor `rec` from value `done` (from the file `path`,
// into `t[raw..]`), apply the patch, and convert under `mode` into `t[out..]`.
// `(bytes converted, values that differ from the file's)`, or `(-1, 0)`.
// `raw` and `out` have room for `4 n` bytes each; `n` is at most `chunk_values()`
// and `done + n` at most the tensor's elements.
pub fn load_chunk[&m, &t, &f](m: &!m [int], t: &!t [byte], fs: &f Fs(""), path: int, rec: int, mode: int, done: int, n: int, raw: int, out: int, patch: int) -> [fs_read(""), file_read] (int, int) {
    if done < 0 || n < 0 || n > chunk_values() || done + n > m[rec + 2] {
        err.fail(m, t, "q08-read", text.f1(m, t, "a chunk of `$` is past the tensor", m[rec]));
        return (0 - 1, 0);
    }
    var fw = 2;
    if m[rec + 1] == f32t() {
        fw = 4;
    }
    let got = fileio.read_at(t, fs, text.bytes(t, path), m[rec + 3] + fw * done, raw, fw * n);
    if got != fw * n {
        err.fail(m, t, "q08-read", text.f1(m, t, "short read of `$`", m[rec]));
        return (0 - 1, 0);
    }
    if apply_patch(m, t, patch, rec, done, n, raw) < 0 {
        return (0 - 1, 0);
    }
    if fw == 4 {
        var i = 0;
        while i < 4 * n {
            t[out + i] = t[raw + i];
            i = i + 1;
        }
        return (4 * n, 0);
    }
    if mode == mode_f32() {
        widen_bf16(t, raw, out, n);
        return (4 * n, 0);
    }
    let changed = narrow_bf16_to_f16(t, raw, out, n);
    return (2 * n, changed);
}

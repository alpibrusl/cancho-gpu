edition 5;
module session;

// A session (`docs/resident.md`): several kernels compiled once, some of their inputs read once (resident), the output of one
// feeding the input of another (a link), and the rest of the inputs coming a line at a time. This module reads and checks the
// session file, sets everything up on the CPU interpreter, and answers a request line. The loop that reads standard input is the
// program's (`session/main.cho`): reading standard input is an authority `cancho-gpu` itself does not have (`tests/authority.sh`).
//
// Every refusal is the rule `session`, with the line of the session file when it is about the file.

import std.fmt;
import std.io;
import mem;
import text;
import err;
import f32;
import parser;
import elab;
import check;
import target;
import dialect;
import lower;
import interp;
import cli;
import fileio;
import ir;
import kinds;
import runcmd;

// The session record's words.
pub fn s_progs() -> [] int {
    return 0;
}

pub fn s_resident() -> [] int {
    return 1;
}

pub fn s_links() -> [] int {
    return 2;
}

pub fn s_inputs() -> [] int {
    return 3;
}

pub fn s_answers() -> [] int {
    return 4;
}

// carry records (source program, source param, destination program, destination param)
pub fn s_carries() -> [] int {
    return 5;
}

// table records (program, param, the interpreter's offset of the whole table, blocks)
pub fn s_tables() -> [] int {
    return 6;
}

// 1 when the first number of a request is the count of repetitions
pub fn s_steps() -> [] int {
    return 7;
}

// the repetitions run so far (the table position)
pub fn s_count() -> [] int {
    return 8;
}

// save records (program, param, file, kind, line): kind 0 and 1 are f32 words, 2 is f16 words (docs/resident.md section 19)
pub fn s_saves() -> [] int {
    return 9;
}

// alias records (root program, root param, program, param): the output of `program` lives in the buffer of the root output (docs/resident.md section 21.4)
pub fn s_aliases() -> [] int {
    return 10;
}

fn space(c: int) -> [] bool {
    return c == 32 || c == 9 || c == 13;
}

// A path the runtime would trap on (an `Fs` refuses two dots in a row and a path of 4,096 bytes or more); a save's temporary name adds four bytes.
fn unsafe_path[&t](t: &!t [byte], path: int) -> [] bool {
    if text.size(path) == 0 || text.size(path) + 4 >= 4096 {
        return true;
    }
    var i = 1;
    while i < text.size(path) {
        if text.at(t, path, i) == '.' && text.at(t, path, i - 1) == '.' {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn bad[&m, &t](m: &!m [int], t: &!t [byte], line: int, msg: int) -> [] int {
    return err.fail(m, t, "session", text.f2(m, t, "line $: $", text.num(m, t, line), msg));
}

// The words of `line` up to a `#`.
fn tokens[&m, &t](m: &!m [int], t: &!t [byte], line: int) -> [] int {
    let out = mem.list(m);
    let n = text.size(line);
    var i = 0;
    while i < n {
        let c = text.at(t, line, i);
        if c == '#' {
            i = n;
        } else if space(c) {
            i = i + 1;
        } else {
            let start = i;
            while i < n && !space(text.at(t, line, i)) && text.at(t, line, i) != '#' {
                i = i + 1;
            }
            mem.push(m, out, text.sub(line, start, i));
        }
    }
    return out;
}

// `P.PARAM` as (program name, parameter name), or (-1, -1) when there is no single dot.
fn dotted[&m, &t](m: &!m [int], t: &!t [byte], word: int) -> [] (int, int) {
    let dot = text.index_of(t, word, '.', 0);
    if dot <= 0 || dot + 1 >= text.size(word) || text.index_of(t, word, '.', dot + 1) >= 0 {
        return (0 - 1, 0 - 1);
    }
    return (text.sub(word, 0, dot), text.sub(word, dot + 1, text.size(word)));
}

// The index of the program called `name` in the list of `(name, ...)` records, or -1.
fn prog_index[&m, &t](m: &!m [int], t: &!t [byte], progs: int, name: int) -> [] int {
    var i = 0;
    while i < mem.size(m, progs) {
        if text.eq(t, m[mem.get(m, progs, i)], name) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// A scale `A/B` (two numbers, or one) as (ok, the f64 bits of A, the f64 bits of B); B is not zero.
fn scale_of[&m, &t](m: &!m [int], t: &!t [byte], word: int) -> [] (bool, int, int) {
    let slash = text.index_of(t, word, '/', 0);
    var a = word;
    var b = text.empty();
    if slash >= 0 {
        a = text.sub(word, 0, slash);
        b = text.sub(word, slash + 1, text.size(word));
    }
    let (oka, va) = runcmd.number(m, t, a);
    if !oka {
        return (false, 0, 0);
    }
    var vb = 1.0;
    if slash >= 0 {
        let (okb, v) = runcmd.number(m, t, b);
        if !okb || v == 0.0 {
            return (false, 0, 0);
        }
        vb = v;
    }
    return (true, bits_of(va), bits_of(vb));
}

// The target to compile for: the one asked for, or `nvidia-ada` when the file has it, else `apple-m-series`.
fn pick[&m, &t](m: &!m [int], t: &!t [byte], unit: int, want: int, have: bool, line: int) -> [] int {
    let nv = target.nvidia_ada(m, t);
    let ap = target.apple_m_series(m, t);
    var tg = nv;
    if have {
        if text.is(t, want, "apple-m-series") {
            tg = ap;
        } else if !text.is(t, want, "nvidia-ada") {
            return bad(m, t, line, text.f1(m, t, "`$` is not a target (nvidia-ada, apple-m-series)", want));
        }
    } else if !runcmd.scheduled(m, t, unit, nv) {
        tg = ap;
    }
    if !runcmd.scheduled(m, t, unit, tg) {
        return bad(m, t, line, text.f1(m, t, "the file has no schedule for $", target.name(m, tg)));
    }
    return tg;
}

// The source of a `.chx` file into the text pool: a handle, or -1 with a refusal.
fn source[&m, &t, &f](m: &!m [int], t: &!t [byte], fs: &f Fs(""), path: int, line: int) -> [fs_read("")] int {
    let top = m[mem.text_slot()];
    let got = fs_read(fs, text.bytes(t, path), t[top..len(t)]);
    if got < 0 {
        return bad(m, t, line, text.f1(m, t, "cannot read $", path));
    }
    m[mem.text_slot()] = top + got;
    return text.handle(top, got);
}

// Read the session file `src` and set it up. Answers the session record, or -1 with a refusal. `want` and `have` are `--target`.
// With `device` each program is also lowered to Metal source (for `apple-m-series`, which the caller names with `--target`): the
// record of a program is then (name, prog, globals, the lowering `lower.lower` answers).
pub fn open[&m, &t, &x, &f](m: &!m [int], t: &!t [byte], fm: &!x [float], fs: &f Fs(""), src: int, want: int, have: bool, device: bool) -> [fs_read(""), file_read] int {
    let progs_raw = mem.list(m);
    let res_raw = mem.list(m);
    let link_raw = mem.list(m);
    let input_raw = mem.list(m);
    let answer_raw = mem.list(m);
    let carry_raw = mem.list(m);
    let table_raw = mem.list(m);
    let save_raw = mem.list(m);
    let alias_raw = mem.list(m);
    var steps = 0;
    var pos = 0;
    var lineno = 0;
    let total = text.size(src);
    while pos < total {
        var end = text.index_of(t, src, 10, pos);
        if end < 0 {
            end = total;
        }
        lineno = lineno + 1;
        let words = tokens(m, t, text.sub(src, pos, end));
        pos = end + 1;
        let nw = mem.size(m, words);
        if nw > 0 {
            let head = mem.get(m, words, 0);
            if text.is(t, head, "program") {
                if nw < 3 {
                    return bad(m, t, lineno, text.lit(m, t, "program NAME FILE.chx [name=value ...]"));
                }
                let consts = mem.list(m);
                var w = 3;
                while w < nw {
                    let c = cli.constant(m, t, mem.get(m, words, w));
                    if c < 0 {
                        return 0 - 1;
                    }
                    mem.push(m, consts, c);
                    w = w + 1;
                }
                mem.push(m, progs_raw, mem.rec4(m, mem.get(m, words, 1), mem.get(m, words, 2), consts, lineno));
            } else if text.is(t, head, "resident") {
                if nw != 3 && !(nw == 4 && (text.is(t, mem.get(m, words, 3), "f32") || text.is(t, mem.get(m, words, 3), "f16") || text.is(t, mem.get(m, words, 3), "i8"))) {
                    return bad(m, t, lineno, text.lit(m, t, "resident PROGRAM.PARAM FILE [f32|f16|i8]"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "resident takes PROGRAM.PARAM"));
                }
                var binary = 0;
                if nw == 4 {
                    binary = 1;
                    if text.is(t, mem.get(m, words, 3), "f16") {
                        binary = 2;
                    }
                    if text.is(t, mem.get(m, words, 3), "i8") {
                        binary = 3;
                    }
                }
                mem.push(m, res_raw, mem.rec5(m, pn, an, mem.get(m, words, 2), lineno, binary));
            } else if text.is(t, head, "link") {
                if nw != 4 || !text.is(t, mem.get(m, words, 2), "->") {
                    return bad(m, t, lineno, text.lit(m, t, "link PROGRAM.OUT -> PROGRAM.PARAM"));
                }
                let (sp, sa) = dotted(m, t, mem.get(m, words, 1));
                let (dp, da) = dotted(m, t, mem.get(m, words, 3));
                if sp < 0 || dp < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "link takes PROGRAM.PARAM on both sides"));
                }
                mem.push(m, link_raw, mem.rec5(m, sp, sa, dp, da, lineno));
            } else if text.is(t, head, "input") {
                if nw != 2 {
                    return bad(m, t, lineno, text.lit(m, t, "input PROGRAM.PARAM"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "input takes PROGRAM.PARAM"));
                }
                mem.push(m, input_raw, mem.rec3(m, pn, an, lineno));
            } else if text.is(t, head, "answer") {
                if nw != 2 && nw != 4 {
                    return bad(m, t, lineno, text.lit(m, t, "answer PROGRAM.PARAM [scale A/B]"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "answer takes PROGRAM.PARAM"));
                }
                var na = bits_of(1.0);
                var nb = bits_of(1.0);
                if nw == 4 {
                    if !text.is(t, mem.get(m, words, 2), "scale") {
                        return bad(m, t, lineno, text.lit(m, t, "answer PROGRAM.PARAM [scale A/B]"));
                    }
                    let (oks, sa, sb) = scale_of(m, t, mem.get(m, words, 3));
                    if !oks {
                        return bad(m, t, lineno, text.lit(m, t, "a scale is A/B with a B that is not zero"));
                    }
                    na = sa;
                    nb = sb;
                }
                mem.push(m, answer_raw, mem.rec5(m, pn, an, na, nb, lineno));
            } else if text.is(t, head, "carry") {
                if nw != 4 || !text.is(t, mem.get(m, words, 2), "->") {
                    return bad(m, t, lineno, text.lit(m, t, "carry PROGRAM.OUT -> PROGRAM.PARAM"));
                }
                let (sp, sa) = dotted(m, t, mem.get(m, words, 1));
                let (dp, da) = dotted(m, t, mem.get(m, words, 3));
                if sp < 0 || dp < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "carry takes PROGRAM.PARAM on both sides"));
                }
                mem.push(m, carry_raw, mem.rec5(m, sp, sa, dp, da, lineno));
            } else if text.is(t, head, "table") {
                if nw != 4 && !(nw == 5 && (text.is(t, mem.get(m, words, 4), "f32") || text.is(t, mem.get(m, words, 4), "f16"))) {
                    return bad(m, t, lineno, text.lit(m, t, "table PROGRAM.PARAM FILE BLOCKS [f32|f16]"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "table takes PROGRAM.PARAM"));
                }
                let (okb, blocks) = runcmd.number(m, t, mem.get(m, words, 3));
                if !okb || blocks < 1.0 || blocks > 100000000.0 || float_of(truncate(blocks)) != blocks {
                    return bad(m, t, lineno, text.lit(m, t, "the blocks of a table are a positive whole number"));
                }
                let traw = mem.grab(m, 6);
                m[traw] = pn;
                m[traw + 1] = an;
                m[traw + 2] = mem.get(m, words, 2);
                m[traw + 3] = truncate(blocks);
                m[traw + 4] = lineno;
                m[traw + 5] = 0;
                if nw == 5 {
                    m[traw + 5] = 1;
                    if text.is(t, mem.get(m, words, 4), "f16") {
                        m[traw + 5] = 2;
                    }
                }
                mem.push(m, table_raw, traw);
            } else if text.is(t, head, "save") {
                if nw != 3 && !(nw == 4 && (text.is(t, mem.get(m, words, 3), "f32") || text.is(t, mem.get(m, words, 3), "f16"))) {
                    return bad(m, t, lineno, text.lit(m, t, "save PROGRAM.OUT FILE [f32|f16]"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "save takes PROGRAM.OUT"));
                }
                var kind = 0;
                if nw == 4 {
                    kind = 1;
                    if text.is(t, mem.get(m, words, 3), "f16") {
                        kind = 2;
                    }
                }
                mem.push(m, save_raw, mem.rec5(m, pn, an, mem.get(m, words, 2), kind, lineno));
            } else if text.is(t, head, "alias") {
                if nw != 3 {
                    return bad(m, t, lineno, text.lit(m, t, "alias PROGRAM.OUT PROGRAM.OUT"));
                }
                let (sp, sa) = dotted(m, t, mem.get(m, words, 1));
                let (dp, da) = dotted(m, t, mem.get(m, words, 2));
                if sp < 0 || dp < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "alias takes PROGRAM.OUT on both sides"));
                }
                mem.push(m, alias_raw, mem.rec5(m, sp, sa, dp, da, lineno));
            } else if text.is(t, head, "steps") {
                if nw != 1 {
                    return bad(m, t, lineno, text.lit(m, t, "steps takes nothing"));
                }
                if steps == 1 {
                    return bad(m, t, lineno, text.lit(m, t, "steps is given once"));
                }
                steps = 1;
            } else {
                return bad(m, t, lineno, text.f1(m, t, "`$` is not a directive (program, resident, link, input, answer, carry, table, steps, save, alias)", head));
            }
        }
    }
    if mem.size(m, progs_raw) == 0 {
        return bad(m, t, lineno, text.lit(m, t, "the session has no program"));
    }
    if mem.size(m, answer_raw) == 0 {
        return bad(m, t, lineno, text.lit(m, t, "the session has no answer"));
    }

    // Compile every program once: records (name, prog, globals).
    let progs = mem.list(m);
    var i = 0;
    while i < mem.size(m, progs_raw) {
        let raw = mem.get(m, progs_raw, i);
        if prog_index(m, t, progs, m[raw]) >= 0 {
            return bad(m, t, m[raw + 3], text.f1(m, t, "the program `$` is named twice", m[raw]));
        }
        let text_src = source(m, t, fs, m[raw + 1], m[raw + 3]);
        if text_src < 0 {
            return 0 - 1;
        }
        let unit = parser.parse(m, t, text_src);
        if unit < 0 {
            return 0 - 1;
        }
        let tg = pick(m, t, unit, want, have, m[raw + 3]);
        if tg < 0 {
            return 0 - 1;
        }
        let compiled = elab.compile(m, t, unit, target.name(m, tg), m[raw + 2]);
        if compiled < 0 {
            return 0 - 1;
        }
        let prog = m[compiled];
        if check.check(m, t, prog, tg) < 0 {
            return 0 - 1;
        }
        var lowered = 0 - 1;
        if device {
            let sched = m[compiled + 1];
            lowered = lower.lower(m, t, prog, tg, dialect.msl(), m[sched + 1], m[sched + 3], m[sched + 4], m[sched + 5], m[sched + 7]);
            if lowered < 0 {
                return 0 - 1;
            }
        }
        var globals = 0 - 1;
        if device {
            globals = interp.globals_lazy(m, prog);
        } else {
            globals = interp.inputs(m, t, fm, prog);
        }
        if globals < 0 {
            return 0 - 1;
        }
        mem.push(m, progs, mem.rec4(m, m[raw], prog, globals, lowered));
        i = i + 1;
    }

    // How each read-only parameter is supplied: 0 not yet, 1 resident, 2 linked, 3 input. One word per parameter of every program.
    let np = mem.size(m, progs);
    let supplied = mem.list(m);
    i = 0;
    while i < np {
        let n = mem.size(m, ir.p_params(m, m[mem.get(m, progs, i) + 1]));
        mem.push(m, supplied, mem.grab(m, n + 1));
        i = i + 1;
    }

    let resident = mem.list(m);
    i = 0;
    while i < mem.size(m, res_raw) {
        let raw = mem.get(m, res_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 3]);
        if pi < 0 {
            return 0 - 1;
        }
        if ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 3], text.f1(m, t, "`$` is written by the kernel: it cannot be resident", m[raw + 1]));
        }
        let cell = mem.get(m, supplied, pi) + ai;
        if m[cell] != 0 {
            return bad(m, t, m[raw + 3], text.f2(m, t, "`$.$` is supplied twice", m[raw], m[raw + 1]));
        }
        m[cell] = 1;
        let g = mem.get(m, m[mem.get(m, progs, pi) + 2], ai);
        // A device session sends a binary resident file straight to the device (the record carries the file's name), keeping it out of the interpreter's memory
        var direct = false;
        if device && m[raw + 4] != 0 {
            direct = true;
            let dt = ir.param_dtype(m, prm);
            if m[raw + 4] == 1 && dt != kinds.f32() || m[raw + 4] == 2 && dt != kinds.f16() || m[raw + 4] == 3 && dt != kinds.i8() {
                return err.fail(m, t, "usage", text.f1(m, t, "`$` has another type than the binary file's flag says", m[raw + 1]));
            }
            mem.push(m, resident, mem.rec3(m, pi, ai, m[raw + 2]));
        }
        if !direct {
            if interp.materialise(m, t, fm, g) < 0 {
                return 0 - 1;
            }
            var loaded = 0;
            if m[raw + 4] == 2 {
                loaded = runcmd.load_f16(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), m[g + 2], m[g + 3]);
            } else if m[raw + 4] == 3 {
                loaded = runcmd.load_i8(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), m[g + 2], m[g + 3]);
            } else if m[raw + 4] == 1 {
                loaded = runcmd.load_f32(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), m[g + 2], m[g + 3]);
            } else {
                loaded = runcmd.load_one(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), m[g + 2], m[g + 3]);
            }
            if loaded < 0 {
                return 0 - 1;
            }
            mem.push(m, resident, mem.rec3(m, pi, ai, 0 - 1));
        }
        i = i + 1;
    }

    // Links: (source program, source param, destination program, destination param), the source before the destination.
    let links = mem.list(m);
    i = 0;
    while i < mem.size(m, link_raw) {
        let raw = mem.get(m, link_raw, i);
        let (sp, sa, sprm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if sp < 0 {
            return 0 - 1;
        }
        let (dp, da, dprm) = locate(m, t, progs, m[raw + 2], m[raw + 3], m[raw + 4]);
        if dp < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, sprm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is not written by its kernel: only an output can be linked from", m[raw + 1]));
        }
        if ir.param_writable(m, dprm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is written by its kernel: only an input can be linked to", m[raw + 3]));
        }
        if sp >= dp {
            return bad(m, t, m[raw + 4], text.lit(m, t, "a link goes from a program to one listed after it"));
        }
        let gs = mem.get(m, m[mem.get(m, progs, sp) + 2], sa);
        let gd = mem.get(m, m[mem.get(m, progs, dp) + 2], da);
        if m[gs + 3] != m[gd + 3] {
            return bad(m, t, m[raw + 4], text.f2(m, t, "the output holds $ numbers and the input $", text.num(m, t, m[gs + 3]), text.num(m, t, m[gd + 3])));
        }
        let cell = mem.get(m, supplied, dp) + da;
        if m[cell] != 0 {
            return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is supplied twice", m[raw + 2], m[raw + 3]));
        }
        m[cell] = 2;
        mem.push(m, links, mem.rec4(m, sp, sa, dp, da));
        i = i + 1;
    }

    // Tables: the whole file is read once into a region of `blocks` times the parameter, and block j of it is the parameter in repetition j.
    let tables = mem.list(m);
    i = 0;
    while i < mem.size(m, table_raw) {
        let raw = mem.get(m, table_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if pi < 0 {
            return 0 - 1;
        }
        if ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is written by the kernel: it cannot be a table", m[raw + 1]));
        }
        let cell = mem.get(m, supplied, pi) + ai;
        if m[cell] != 0 {
            return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is supplied twice", m[raw], m[raw + 1]));
        }
        m[cell] = 4;
        let g = mem.get(m, m[mem.get(m, progs, pi) + 2], ai);
        // A device session keeps a binary table out of the interpreter's memory: the device program reads the file straight to the device (the table's record has -1 for its place
        // there, and the file's name), so a table can be as large as the device's memory.
        var direct = false;
        if device && m[raw + 5] != 0 {
            direct = true;
            let dt = ir.param_dtype(m, prm);
            if m[raw + 5] == 1 && dt != kinds.f32() || m[raw + 5] == 2 && dt != kinds.f16() {
                return err.fail(m, t, "usage", text.f1(m, t, "`$` has another type than the binary file's flag says", m[raw + 1]));
            }
            mem.push(m, tables, mem.rec5(m, pi, ai, 0 - 1, m[raw + 3], m[raw + 2]));
        }
        if !direct {
            let whole = interp.falloc(m, fm, m[g + 3] * m[raw + 3]);
            if whole < 0 {
                return err.fail(m, t, "session", text.lit(m, t, "the table does not fit the interpreter's memory"));
            }
            var loaded = 0;
            if m[raw + 5] == 2 {
                loaded = runcmd.load_f16(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), whole, m[g + 3] * m[raw + 3]);
            } else if m[raw + 5] == 1 {
                loaded = runcmd.load_f32(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), whole, m[g + 3] * m[raw + 3]);
            } else {
                loaded = runcmd.load_one(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), whole, m[g + 3] * m[raw + 3]);
            }
            if loaded < 0 {
                return 0 - 1;
            }
            mem.push(m, tables, mem.rec4(m, pi, ai, whole, m[raw + 3]));
        }
        i = i + 1;
    }

    // Carries: (source program, source param, destination program, destination param); the destination is a resident parameter listed at or before the source.
    let carries = mem.list(m);
    i = 0;
    while i < mem.size(m, carry_raw) {
        let raw = mem.get(m, carry_raw, i);
        let (sp, sa, sprm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if sp < 0 {
            return 0 - 1;
        }
        let (dp, da, dprm) = locate(m, t, progs, m[raw + 2], m[raw + 3], m[raw + 4]);
        if dp < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, sprm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is not written by its kernel: only an output can be carried from", m[raw + 1]));
        }
        if ir.param_writable(m, dprm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is written by its kernel: only an input can be carried to", m[raw + 3]));
        }
        if dp > sp {
            return bad(m, t, m[raw + 4], text.lit(m, t, "a carry goes from a program to one listed at or before it"));
        }
        let gs = mem.get(m, m[mem.get(m, progs, sp) + 2], sa);
        let gd = mem.get(m, m[mem.get(m, progs, dp) + 2], da);
        if m[gs] != m[gd] || m[gs + 3] != m[gd + 3] {
            return bad(m, t, m[raw + 4], text.f2(m, t, "the output holds $ numbers and the input $, or their types differ", text.num(m, t, m[gs + 3]), text.num(m, t, m[gd + 3])));
        }
        if m[mem.get(m, supplied, dp) + da] != 1 {
            return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is carried to, so it must be resident (its first value)", m[raw + 2], m[raw + 3]));
        }
        mem.push(m, carries, mem.rec4(m, sp, sa, dp, da));
        i = i + 1;
    }

    // Inputs: (program, param), in the order of the request line.
    let inputs = mem.list(m);
    i = 0;
    while i < mem.size(m, input_raw) {
        let raw = mem.get(m, input_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 2]);
        if pi < 0 {
            return 0 - 1;
        }
        if ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 2], text.f1(m, t, "`$` is written by the kernel: it cannot be an input", m[raw + 1]));
        }
        let cell = mem.get(m, supplied, pi) + ai;
        if m[cell] != 0 {
            return bad(m, t, m[raw + 2], text.f2(m, t, "`$.$` is supplied twice", m[raw], m[raw + 1]));
        }
        m[cell] = 3;
        if interp.materialise(m, t, fm, mem.get(m, m[mem.get(m, progs, pi) + 2], ai)) < 0 {
            return 0 - 1;
        }
        mem.push(m, inputs, mem.rec2(m, pi, ai));
        i = i + 1;
    }

    // Every read-only parameter is supplied.
    i = 0;
    while i < np {
        let prog = m[mem.get(m, progs, i) + 1];
        let ps = ir.p_params(m, prog);
        var k = 0;
        while k < mem.size(m, ps) {
            let prm = mem.get(m, ps, k);
            if !ir.param_writable(m, prm) && m[mem.get(m, supplied, i) + k] == 0 {
                return err.fail(m, t, "session", text.f2(m, t, "`$.$` is read by its kernel and nothing supplies it (resident, link or input)", m[mem.get(m, progs, i)], ir.param_name(m, prm)));
            }
            k = k + 1;
        }
        i = i + 1;
    }

    // Answers: (program, param, A bits, B bits).
    let answers = mem.list(m);
    i = 0;
    while i < mem.size(m, answer_raw) {
        let raw = mem.get(m, answer_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if pi < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is only read by its kernel: an answer is an output", m[raw + 1]));
        }
        if interp.materialise(m, t, fm, mem.get(m, m[mem.get(m, progs, pi) + 2], ai)) < 0 {
            return 0 - 1;
        }
        mem.push(m, answers, mem.rec4(m, pi, ai, m[raw + 2], m[raw + 3]));
        i = i + 1;
    }

    // Saves: (program, param, file, kind, line). A save writes a file, so what it may name is checked here, before any device work: an output of a
    // kernel, held in the type the flag says; a path the runtime will not trap on; a file that is not one the session reads; and the saves to one file
    // listed together, because they are one file written once (docs/resident.md section 19).
    let saves = mem.list(m);
    i = 0;
    while i < mem.size(m, save_raw) {
        let raw = mem.get(m, save_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if pi < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is only read by its kernel: a save is an output", m[raw + 1]));
        }
        var want_type = kinds.f32();
        if m[raw + 3] == 2 {
            want_type = kinds.f16();
        }
        if ir.param_dtype(m, prm) != want_type {
            return err.fail(m, t, "usage", text.f1(m, t, "`$` has another type than the save's flag says (f32 when there is none)", m[raw + 1]));
        }
        if unsafe_path(t, m[raw + 2]) {
            return bad(m, t, m[raw + 4], text.lit(m, t, "the file of a save has two dots in a row or is over 4,000 bytes"));
        }
        var other = 0;
        while other < mem.size(m, res_raw) {
            if text.eq(t, m[mem.get(m, res_raw, other) + 2], m[raw + 2]) {
                return bad(m, t, m[raw + 4], text.f1(m, t, "$ is a resident file: a save does not overwrite what the session reads", m[raw + 2]));
            }
            other = other + 1;
        }
        other = 0;
        while other < mem.size(m, table_raw) {
            if text.eq(t, m[mem.get(m, table_raw, other) + 2], m[raw + 2]) {
                return bad(m, t, m[raw + 4], text.f1(m, t, "$ is a table file: a save does not overwrite what the session reads", m[raw + 2]));
            }
            other = other + 1;
        }
        other = 0;
        while other < mem.size(m, progs_raw) {
            if text.eq(t, m[mem.get(m, progs_raw, other) + 1], m[raw + 2]) {
                return bad(m, t, m[raw + 4], text.f1(m, t, "$ is a kernel file: a save does not overwrite what the session reads", m[raw + 2]));
            }
            other = other + 1;
        }
        if i > 0 && !text.eq(t, m[mem.get(m, save_raw, i - 1) + 2], m[raw + 2]) {
            other = 0;
            while other < i - 1 {
                if text.eq(t, m[mem.get(m, save_raw, other) + 2], m[raw + 2]) {
                    return bad(m, t, m[raw + 4], text.f1(m, t, "the saves to $ are not together: list them one after another", m[raw + 2]));
                }
                other = other + 1;
            }
        }
        mem.push(m, saves, mem.rec5(m, pi, ai, m[raw + 2], m[raw + 3], m[raw + 4]));
        i = i + 1;
    }

    // Aliases: (root program, root param, program, param). `alias P.OUT Q.OUT` puts the output Q.OUT in the buffer of P.OUT (a device session shares the buffer, the CPU interpreter
    // keeps two), which is safe only if nothing reads P.OUT once Q's program has begun: both are outputs of the same type and size, P's program is listed before Q's, every program that
    // reads P.OUT (a link) is listed before Q's, and neither is answered, saved or carried, because those are read after the programs ran. An output joins an alias group once. Aliases chain:
    // `alias A B` then `alias B C` puts all three in one buffer, and C must come after every reader of A and of B.
    let aliases = mem.list(m);
    i = 0;
    while i < mem.size(m, alias_raw) {
        let raw = mem.get(m, alias_raw, i);
        let (sp, sa, sprm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if sp < 0 {
            return 0 - 1;
        }
        let (dp, da, dprm) = locate(m, t, progs, m[raw + 2], m[raw + 3], m[raw + 4]);
        if dp < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, sprm) || !ir.param_writable(m, dprm) {
            return bad(m, t, m[raw + 4], text.lit(m, t, "an alias is between two outputs of kernels"));
        }
        if sp >= dp {
            return bad(m, t, m[raw + 4], text.lit(m, t, "an alias goes from a program to one listed after it"));
        }
        let gs = mem.get(m, m[mem.get(m, progs, sp) + 2], sa);
        let gd = mem.get(m, m[mem.get(m, progs, dp) + 2], da);
        if m[gs] != m[gd] || m[gs + 3] != m[gd + 3] {
            return bad(m, t, m[raw + 4], text.f2(m, t, "the outputs hold $ and $ numbers, or their types differ", text.num(m, t, m[gs + 3]), text.num(m, t, m[gd + 3])));
        }
        // the root of the group P.OUT is in, and every member of it
        var rp = sp;
        var ra = sa;
        var k = 0;
        while k < mem.size(m, aliases) {
            let al = mem.get(m, aliases, k);
            if m[al + 2] == dp && m[al + 3] == da {
                return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is already aliased to an earlier output", m[raw + 2], m[raw + 3]));
            }
            if m[al + 2] == sp && m[al + 3] == sa {
                rp = m[al];
                ra = m[al + 1];
            }
            k = k + 1;
        }
        // none of the members is answered, saved or carried
        let members = mem.list(m);
        mem.push(m, members, mem.rec2(m, rp, ra));
        k = 0;
        while k < mem.size(m, aliases) {
            let al = mem.get(m, aliases, k);
            if m[al] == rp && m[al + 1] == ra {
                mem.push(m, members, mem.rec2(m, m[al + 2], m[al + 3]));
            }
            k = k + 1;
        }
        mem.push(m, members, mem.rec2(m, dp, da));
        k = 0;
        while k < mem.size(m, members) {
            let mb = mem.get(m, members, k);
            var j = 0;
            while j < mem.size(m, answers) {
                let a = mem.get(m, answers, j);
                if m[a] == m[mb] && m[a + 1] == m[mb + 1] {
                    return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is aliased and answered: an answer is read after the programs ran, when the buffer holds the last of the group", m[mem.get(m, progs, m[mb])], ir.param_name(m, mem.get(m, ir.p_params(m, m[mem.get(m, progs, m[mb]) + 1]), m[mb + 1]))));
                }
                j = j + 1;
            }
            j = 0;
            while j < mem.size(m, saves) {
                let a = mem.get(m, saves, j);
                if m[a] == m[mb] && m[a + 1] == m[mb + 1] {
                    return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is aliased and saved: a save is read after the programs ran, when the buffer holds the last of the group", m[mem.get(m, progs, m[mb])], ir.param_name(m, mem.get(m, ir.p_params(m, m[mem.get(m, progs, m[mb]) + 1]), m[mb + 1]))));
                }
                j = j + 1;
            }
            j = 0;
            while j < mem.size(m, carries) {
                let a = mem.get(m, carries, j);
                if m[a] == m[mb] && m[a + 1] == m[mb + 1] {
                    return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is aliased and carried: a carry keeps its buffer from one repetition to the next", m[mem.get(m, progs, m[mb])], ir.param_name(m, mem.get(m, ir.p_params(m, m[mem.get(m, progs, m[mb]) + 1]), m[mb + 1]))));
                }
                j = j + 1;
            }
            // every reader of this member is listed before the program that now writes the buffer
            j = 0;
            while j < mem.size(m, links) {
                let lk = mem.get(m, links, j);
                if m[lk] == m[mb] && m[lk + 1] == m[mb + 1] && m[lk + 2] >= dp && !(m[mb] == dp && m[mb + 1] == da) {
                    return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is linked to a program that runs after (or as) the program that overwrites its buffer", m[mem.get(m, progs, m[mb])], ir.param_name(m, mem.get(m, ir.p_params(m, m[mem.get(m, progs, m[mb]) + 1]), m[mb + 1]))));
                }
                j = j + 1;
            }
            k = k + 1;
        }
        mem.push(m, aliases, mem.rec4(m, rp, ra, dp, da));
        i = i + 1;
    }

    let sess = mem.rec(m, 11);
    m[sess + s_progs()] = progs;
    m[sess + s_resident()] = resident;
    m[sess + s_links()] = links;
    m[sess + s_inputs()] = inputs;
    m[sess + s_answers()] = answers;
    m[sess + s_carries()] = carries;
    m[sess + s_tables()] = tables;
    m[sess + s_steps()] = steps;
    m[sess + s_count()] = 0;
    m[sess + s_saves()] = saves;
    m[sess + s_aliases()] = aliases;
    return sess;
}

// The program `pname`'s parameter `aname`: (program index, parameter index, the parameter), or (-1, -1, -1) with a refusal.
fn locate[&m, &t](m: &!m [int], t: &!t [byte], progs: int, pname: int, aname: int, line: int) -> [] (int, int, int) {
    let pi = prog_index(m, t, progs, pname);
    if pi < 0 {
        let r = bad(m, t, line, text.f1(m, t, "`$` is not a program of the session", pname));
        return (0 - 1, 0 - 1, 0 - 1);
    }
    let prog = m[mem.get(m, progs, pi) + 1];
    let ai = runcmd.find(m, t, prog, aname);
    if ai < 0 {
        let r = bad(m, t, line, text.f2(m, t, "`$` has no parameter `$`", pname, aname));
        return (0 - 1, 0 - 1, 0 - 1);
    }
    return (pi, ai, mem.get(m, ir.p_params(m, prog), ai));
}

// How many numbers a request line holds.
pub fn input_count[&m](m: &!m [int], sess: int) -> [] int {
    let progs = m[sess + s_progs()];
    let inputs = m[sess + s_inputs()];
    var total = 0;
    var i = 0;
    while i < mem.size(m, inputs) {
        let rec = mem.get(m, inputs, i);
        let g = mem.get(m, m[mem.get(m, progs, m[rec]) + 2], m[rec + 1]);
        total = total + m[g + 3];
        i = i + 1;
    }
    return total;
}

// The numbers of the request `line` (a handle into the text pool) into the inputs, in order. Answers 0, or -1 with a refusal.
pub fn fill_inputs[&m, &t, &x](m: &!m [int], t: &!t [byte], fm: &!x [float], sess: int, line: int) -> [] int {
    let progs = m[sess + s_progs()];
    let inputs = m[sess + s_inputs()];
    let n = text.size(line);
    var pos = 0;
    var got = 0;
    var k = 0;
    while k < mem.size(m, inputs) {
        let rec = mem.get(m, inputs, k);
        let prog = m[mem.get(m, progs, m[rec]) + 1];
        let g = mem.get(m, m[mem.get(m, progs, m[rec]) + 2], m[rec + 1]);
        let dt = ir.param_dtype(m, mem.get(m, ir.p_params(m, prog), m[rec + 1]));
        var j = 0;
        while j < m[g + 3] {
            while pos < n && space(text.at(t, line, pos)) {
                pos = pos + 1;
            }
            if pos >= n {
                return err.fail(m, t, "session", text.f2(m, t, "the request holds $ numbers; the session takes $", text.num(m, t, got), text.num(m, t, input_count(m, sess))));
            }
            let start = pos;
            while pos < n && !space(text.at(t, line, pos)) {
                pos = pos + 1;
            }
            let (ok, v) = runcmd.number(m, t, text.sub(line, start, pos));
            if !ok {
                return err.fail(m, t, "session", text.f1(m, t, "`$` in the request is not a number", text.sub(line, start, pos)));
            }
            fm[m[g + 2] + j] = interp.convert(dt, v);
            got = got + 1;
            j = j + 1;
        }
        k = k + 1;
    }
    while pos < n && space(text.at(t, line, pos)) {
        pos = pos + 1;
    }
    if pos < n {
        return err.fail(m, t, "session", text.f1(m, t, "the request holds more than the $ numbers the session takes", text.num(m, t, input_count(m, sess))));
    }
    return 0;
}

// Run the programs on the CPU interpreter, in order, each link copied just before the program that reads it. Answers 0, or -1.
pub fn run_cpu[&m, &t, &x](m: &!m [int], t: &!t [byte], fm: &!x [float], sess: int) -> [] int {
    let progs = m[sess + s_progs()];
    let links = m[sess + s_links()];
    var q = 0;
    while q < mem.size(m, progs) {
        var l = 0;
        while l < mem.size(m, links) {
            let link = mem.get(m, links, l);
            if m[link + 2] == q {
                let sp = mem.get(m, progs, m[link]);
                let dp = mem.get(m, progs, q);
                let gs = mem.get(m, m[sp + 2], m[link + 1]);
                let gd = mem.get(m, m[dp + 2], m[link + 3]);
                let dt = ir.param_dtype(m, mem.get(m, ir.p_params(m, m[dp + 1]), m[link + 3]));
                var j = 0;
                while j < m[gd + 3] {
                    fm[m[gd + 2] + j] = interp.convert(dt, fm[m[gs + 2] + j]);
                    j = j + 1;
                }
            }
            l = l + 1;
        }
        let cur = mem.get(m, progs, q);
        if interp.execute(m, t, fm, m[cur + 1], m[cur + 2]) < 0 {
            return 0 - 1;
        }
        q = q + 1;
    }
    return 0;
}

// Write the answers as one line and flush it.
pub fn print_answers[&m, &t, &x, &i](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, sess: int) -> [io_write] int {
    let progs = m[sess + s_progs()];
    let answers = m[sess + s_answers()];
    var first = true;
    var k = 0;
    while k < mem.size(m, answers) {
        let a = mem.get(m, answers, k);
        let g = mem.get(m, m[mem.get(m, progs, m[a]) + 2], m[a + 1]);
        let (scale_a, scale_b) = (f32.from_bits(m[a + 2]), f32.from_bits(m[a + 3]));
        let scratch = m[mem.text_slot()];
        var j = 0;
        while j < m[g + 3] {
            if !first {
                io.write_all(io, " ");
            }
            first = false;
            let w = fmt.float_into(t[scratch..scratch + 32], fm[m[g + 2] + j] * scale_a / scale_b);
            io.write_all(io, t[scratch..scratch + w]);
            j = j + 1;
        }
        k = k + 1;
    }
    io.write_all(io, "\n");
    let _flushed = flush_out(io);
    return 0;
}

// With `steps`, the request starts with the count of repetitions: (that count, the rest of the line), or (-1, the line) with a refusal. Without it, (1, the line).
pub fn take_steps[&m, &t](m: &!m [int], t: &!t [byte], sess: int, line: int) -> [] (int, int) {
    if m[sess + s_steps()] == 0 {
        return (1, line);
    }
    let n = text.size(line);
    var pos = 0;
    while pos < n && space(text.at(t, line, pos)) {
        pos = pos + 1;
    }
    let start = pos;
    while pos < n && !space(text.at(t, line, pos)) {
        pos = pos + 1;
    }
    if start == pos {
        let r = err.fail(m, t, "session", text.lit(m, t, "the request starts with the count of steps, and holds nothing"));
        return (0 - 1, line);
    }
    let (ok, v) = runcmd.number(m, t, text.sub(line, start, pos));
    if !ok || v < 1.0 || v > 1000000000.0 || float_of(truncate(v)) != v {
        let r = err.fail(m, t, "session", text.f1(m, t, "`$` is not a count of steps (a positive whole number below 10^9)", text.sub(line, start, pos)));
        return (0 - 1, line);
    }
    return (truncate(v), text.sub(line, pos, n));
}

// The programs `reps` times on the CPU interpreter: before each repetition block `count mod blocks` of every table is the parameter, after it each carry copies its output to its parameter.
pub fn run_steps[&m, &t, &x](m: &!m [int], t: &!t [byte], fm: &!x [float], sess: int, reps: int) -> [] int {
    let progs = m[sess + s_progs()];
    let tables = m[sess + s_tables()];
    let carries = m[sess + s_carries()];
    var j = 0;
    while j < reps {
        var k = 0;
        while k < mem.size(m, tables) {
            let tb = mem.get(m, tables, k);
            let g = mem.get(m, m[mem.get(m, progs, m[tb]) + 2], m[tb + 1]);
            let from = m[tb + 2] + m[g + 3] * (m[sess + s_count()] % m[tb + 3]);
            var e = 0;
            while e < m[g + 3] {
                fm[m[g + 2] + e] = fm[from + e];
                e = e + 1;
            }
            k = k + 1;
        }
        if run_cpu(m, t, fm, sess) < 0 {
            return 0 - 1;
        }
        k = 0;
        while k < mem.size(m, carries) {
            let c = mem.get(m, carries, k);
            let gs = mem.get(m, m[mem.get(m, progs, m[c]) + 2], m[c + 1]);
            let gd = mem.get(m, m[mem.get(m, progs, m[c + 2]) + 2], m[c + 3]);
            var e = 0;
            while e < m[gd + 3] {
                fm[m[gd + 2] + e] = fm[m[gs + 2] + e];
                e = e + 1;
            }
            k = k + 1;
        }
        m[sess + s_count()] = m[sess + s_count()] + 1;
        j = j + 1;
    }
    return 0;
}

// Answer the request `line` on the CPU interpreter. Answers 0, or -1 with a refusal.
pub fn serve_line[&m, &t, &x, &i](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, sess: int, line: int) -> [io_write] int {
    let (reps, rest) = take_steps(m, t, sess, line);
    if reps < 0 {
        return 0 - 1;
    }
    if fill_inputs(m, t, fm, sess, rest) < 0 {
        return 0 - 1;
    }
    if run_steps(m, t, fm, sess, reps) < 0 {
        return 0 - 1;
    }
    return print_answers(m, t, fm, io, sess);
}

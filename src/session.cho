edition 5;
module session;

// A session (`docs/resident.md`): several kernels compiled once, some of their inputs read once (resident), the output of one
// feeding the input of another (a link), and the rest of the inputs coming a line at a time. This module reads and checks the
// session file, sets everything up on the CPU interpreter, and answers a request line. The loop that reads standard input is the
// program's (`session/main.cho`): reading standard input is an authority `cancho-gpu` itself does not have (`tests/authority.sh`).
//
// Every refusal is the rule `session`, with the line of the session file when it is about the file.

import std.fmt;
import std.io;
import mem;
import text;
import err;
import f32;
import parser;
import elab;
import check;
import target;
import dialect;
import lower;
import interp;
import cli;
import fileio;
import ir;
import kinds;
import runcmd;
import model;
import choose;
import phase;

// The session record's words.
pub fn s_progs() -> [] int {
    return 0;
}

pub fn s_resident() -> [] int {
    return 1;
}

pub fn s_links() -> [] int {
    return 2;
}

pub fn s_inputs() -> [] int {
    return 3;
}

pub fn s_answers() -> [] int {
    return 4;
}

// carry records (source program, source param, destination program, destination param)
pub fn s_carries() -> [] int {
    return 5;
}

// table records, 9 words: program, param, the interpreter's offset of the whole table (-1: a device's binary table), blocks, the file's name (a device's binary table), then the pick
// (docs/kolibri.md K2): the program and the output whose value says which block is read, and the slot of that output (-1, 0, 0 for a table that steps), and 1 when a device
// session gave it the buffer of an earlier table of the same file
pub fn s_tables() -> [] int {
    return 6;
}

// A table record's later words, for what is bound by the repetition's number in another way than `j mod blocks` (docs/kolibri.md section 19.2, docs/resident.md section 33):
// 9 the way (0 a table that steps; 1 a table that holds its last block, `hold`; 2 a `store`, the output that is block j of a roll; 3 a `window`, the blocks of a roll that end with j's),
// 10 the elements of one block of the roll, 11 the roll's number, 12 the blocks of a window. For a roll, word 2 is the interpreter's place of the whole roll (-1 on a device),
// word 3 its blocks and word 4 its name.
// Way 4 is a `choose` (docs/resident.md section 34): the parameter is a mask the session writes from an output's numbers. Word 2 is a scratch of as many numbers in the interpreter's
// memory, word 3 how many largest are taken, words 10 and 11 the program and the output of the scores, 12 the entries taken at the start, 13 those at the end, 14 the mask's length.
pub fn t_way() -> [] int {
    return 9;
}

pub fn t_stride() -> [] int {
    return 10;
}

pub fn t_roll() -> [] int {
    return 11;
}

// The block of the table, store or window `tb` (not a picked one) at the session's repetition, or -1 with a refusal: a roll has no block for a repetition past its last.
pub fn bound_block[&m, &t](m: &!m [int], t: &!t [byte], sess: int, tb: int) -> [] int {
    let j = m[sess + s_count()];
    let way = m[tb + t_way()];
    if way == 0 {
        return j % m[tb + 3];
    }
    if way == 1 {
        if j >= m[tb + 3] {
            return m[tb + 3] - 1;
        }
        return j;
    }
    // in a phase of stride S a repetition is the S blocks from j on: `last` is the last of them
    let last = j + m[tb + t_span()] - 1;
    if way == 5 {
        if last >= m[tb + 3] {
            return err.fail(m, t, "session", text.n2(m, t, "a spanned table has $ blocks: repetition $ is past them", m[tb + 3], last));
        }
        return j;
    }
    if last >= m[tb + 3] {
        return err.fail(m, t, "session", text.f3(m, t, "the roll `$` has $ blocks: repetition $ is past them", m[tb + 4], text.num(m, t, m[tb + 3]), text.num(m, t, last)));
    }
    if way == 2 {
        return j;
    }
    if last < m[tb + 12] {
        return 0;
    }
    return last - m[tb + 12] + 1;
}

// The mask of the `choose` record `tb` for the session's repetition, written into its parameter's numbers from the scores' (both in the interpreter's memory). 0, or -1 with a
// refusal: the mask has no entry for a repetition past its last.
pub fn choose_mask[&m, &t, &x](m: &!m [int], t: &!t [byte], fm: &!x [float], sess: int, tb: int) -> [] int {
    let progs = m[sess + s_progs()];
    let j = m[sess + s_count()];
    let rows = m[tb + t_span()];
    if j + rows - 1 >= m[tb + 14] {
        return err.fail(m, t, "session", text.n2(m, t, "a chosen mask has $ entries: repetition $ is past them", m[tb + 14], j + rows - 1));
    }
    let g = mem.get(m, m[mem.get(m, progs, m[tb]) + 2], m[tb + 1]);
    let sg = mem.get(m, m[mem.get(m, progs, m[tb + 10]) + 2], m[tb + 11]);
    // a phase of stride S: S masks one after another, row b the mask of repetition j + b from row b of the scores
    var b = 0;
    while b < rows {
        let done = choose.mask(fm, m[tb + 2], m[sg + 2] + b * m[tb + 14], m[g + 2] + b * m[tb + 14], m[tb + 14], j + b, m[tb + 3], m[tb + 12], m[tb + 13]);
        b = b + 1;
    }
    return 0;
}

// Whether the `choose` record `tb` reads its scores at the session's repetition (a device session reads them back only then).
pub fn choose_reads[&m](m: &!m [int], sess: int, tb: int) -> [] bool {
    return choose.reads(m[sess + s_count()] + m[tb + t_span()] - 1, m[tb + 3], m[tb + 12], m[tb + 13]);
}

// The elements of one block of `tb`, whose parameter has `own` elements: a roll's block; of a spanned table, the parameter's over the stride; else the parameter's.
pub fn bound_stride[&m](m: &!m [int], tb: int, own: int) -> [] int {
    if m[tb + t_way()] == 2 || m[tb + t_way()] == 3 {
        return m[tb + t_stride()];
    }
    if m[tb + t_way()] == 5 {
        return own / m[tb + t_span()];
    }
    return own;
}

// 1 when the first number of a request is the count of repetitions
pub fn s_steps() -> [] int {
    return 7;
}

// the repetitions run so far (the table position)
pub fn s_count() -> [] int {
    return 8;
}

// save records (program, param, file, kind, line): kind 0 and 1 are f32 words, 2 is f16 words (docs/resident.md section 19)
pub fn s_saves() -> [] int {
    return 9;
}

// alias records (root program, root param, program, param): the output of `program` lives in the buffer of the root output (docs/resident.md section 21.4)
pub fn s_aliases() -> [] int {
    return 10;
}

// phase records (name, stride): the session's own programs are phase 0, of no name and stride 1 (docs/resident.md section 35)
pub fn s_phases() -> [] int {
    return 11;
}

// the phase the request being answered runs
pub fn s_phase() -> [] int {
    return 12;
}

// A table record's word 15: the stride of the phase its program is in.
pub fn t_span() -> [] int {
    return 15;
}

// The stride of the phase a request runs: how many repetitions of the session one of its repetitions is.
pub fn stride_now[&m](m: &!m [int], sess: int) -> [] int {
    return m[mem.get(m, m[sess + s_phases()], m[sess + s_phase()]) + 1];
}

// Whether program `q` is one of the phase the request runs.
pub fn runs[&m](m: &!m [int], sess: int, q: int) -> [] bool {
    return m[mem.get(m, m[sess + s_progs()], q) + 4] == m[sess + s_phase()];
}

fn space(c: int) -> [] bool {
    return c == 32 || c == 9 || c == 13;
}

// A path the runtime would trap on (an `Fs` refuses two dots in a row and a path of 4,096 bytes or more); a save's temporary name adds four bytes.
fn unsafe_path[&t](t: &!t [byte], path: int) -> [] bool {
    if text.size(path) == 0 || text.size(path) + 4 >= 4096 {
        return true;
    }
    var i = 1;
    while i < text.size(path) {
        if text.at(t, path, i) == '.' && text.at(t, path, i - 1) == '.' {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn bad[&m, &t](m: &!m [int], t: &!t [byte], line: int, msg: int) -> [] int {
    return err.fail(m, t, "session", text.f2(m, t, "line $: $", text.num(m, t, line), msg));
}

// The words of `line` up to a `#`.
fn tokens[&m, &t](m: &!m [int], t: &!t [byte], line: int) -> [] int {
    let out = mem.list(m);
    let n = text.size(line);
    var i = 0;
    while i < n {
        let c = text.at(t, line, i);
        if c == '#' {
            i = n;
        } else if space(c) {
            i = i + 1;
        } else {
            let start = i;
            while i < n && !space(text.at(t, line, i)) && text.at(t, line, i) != '#' {
                i = i + 1;
            }
            mem.push(m, out, text.sub(line, start, i));
        }
    }
    return out;
}

// `P.PARAM` as (program name, parameter name), or (-1, -1) when there is no single dot.
fn dotted[&m, &t](m: &!m [int], t: &!t [byte], word: int) -> [] (int, int) {
    let dot = text.index_of(t, word, '.', 0);
    if dot <= 0 || dot + 1 >= text.size(word) || text.index_of(t, word, '.', dot + 1) >= 0 {
        return (0 - 1, 0 - 1);
    }
    return (text.sub(word, 0, dot), text.sub(word, dot + 1, text.size(word)));
}

// The index of the program called `name` in the list of `(name, ...)` records, or -1.
fn prog_index[&m, &t](m: &!m [int], t: &!t [byte], progs: int, name: int) -> [] int {
    var i = 0;
    while i < mem.size(m, progs) {
        if text.eq(t, m[mem.get(m, progs, i)], name) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// A scale `A/B` (two numbers, or one) as (ok, the f64 bits of A, the f64 bits of B); B is not zero.
fn scale_of[&m, &t](m: &!m [int], t: &!t [byte], word: int) -> [] (bool, int, int) {
    let slash = text.index_of(t, word, '/', 0);
    var a = word;
    var b = text.empty();
    if slash >= 0 {
        a = text.sub(word, 0, slash);
        b = text.sub(word, slash + 1, text.size(word));
    }
    let (oka, va) = runcmd.number(m, t, a);
    if !oka {
        return (false, 0, 0);
    }
    var vb = 1.0;
    if slash >= 0 {
        let (okb, v) = runcmd.number(m, t, b);
        if !okb || v == 0.0 {
            return (false, 0, 0);
        }
        vb = v;
    }
    return (true, bits_of(va), bits_of(vb));
}

// The target to compile for: the one asked for, or `nvidia-ada` when the file has it, else `apple-m-series`.
fn pick[&m, &t](m: &!m [int], t: &!t [byte], unit: int, want: int, have: bool, line: int) -> [] int {
    let nv = target.nvidia_ada(m, t);
    let ap = target.apple_m_series(m, t);
    var tg = nv;
    if have {
        if text.is(t, want, "apple-m-series") {
            tg = ap;
        } else if !text.is(t, want, "nvidia-ada") {
            return bad(m, t, line, text.f1(m, t, "`$` is not a target (nvidia-ada, apple-m-series)", want));
        }
    } else if !runcmd.scheduled(m, t, unit, nv) {
        tg = ap;
    }
    if !runcmd.scheduled(m, t, unit, tg) {
        return bad(m, t, line, text.f1(m, t, "the file has no schedule for $", target.name(m, tg)));
    }
    return tg;
}

// The source of a `.chx` file into the text pool: a handle, or -1 with a refusal.
fn source[&m, &t, &f](m: &!m [int], t: &!t [byte], fs: &f Fs(""), path: int, line: int) -> [fs_read("")] int {
    let top = m[mem.text_slot()];
    var got = 0 - 1;
    if fileio.covers(fs, text.bytes(t, path)) {
        got = fs_read(fs, text.bytes(t, path), t[top..len(t)]);
    }
    if got < 0 {
        return bad(m, t, line, text.f1(m, t, "cannot read $", path));
    }
    m[mem.text_slot()] = top + got;
    return text.handle(top, got);
}

// Read the session file `src` and set it up. Answers the session record, or -1 with a refusal. `want` and `have` are `--target`.
// With `device` each program is also lowered to Metal source (for `apple-m-series`, which the caller names with `--target`): the
// record of a program is then (name, prog, globals, the lowering `lower.lower` answers).
pub fn open[&m, &t, &x, &f](m: &!m [int], t: &!t [byte], fm: &!x [float], fs: &f Fs(""), src0: int, defs: int, want: int, have: bool, device: bool) -> [fs_read(""), file_read] int {
    // a model file (`docs/resident.md` section 31) is expanded to the plain session file first; a file with none of its directives is unchanged
    let src = model.expand(m, t, src0, defs);
    if src < 0 {
        return 0 - 1;
    }
    let progs_raw = mem.list(m);
    let res_raw = mem.list(m);
    let link_raw = mem.list(m);
    let input_raw = mem.list(m);
    let answer_raw = mem.list(m);
    let carry_raw = mem.list(m);
    let table_raw = mem.list(m);
    let store_raw = mem.list(m);
    let choose_raw = mem.list(m);
    let window_raw = mem.list(m);
    let save_raw = mem.list(m);
    let alias_raw = mem.list(m);
    // (name, stride, line, programs listed so far when it began): phase 0 is the session's own programs
    let phases = mem.list(m);
    mem.push(m, phases, mem.rec4(m, text.lit(m, t, ""), 1, 0, 0));
    var steps = 0;
    var pos = 0;
    var lineno = 0;
    let total = text.size(src);
    while pos < total {
        var end = text.index_of(t, src, 10, pos);
        if end < 0 {
            end = total;
        }
        lineno = lineno + 1;
        let words = tokens(m, t, text.sub(src, pos, end));
        pos = end + 1;
        let nw = mem.size(m, words);
        if nw > 0 {
            let head = mem.get(m, words, 0);
            if text.is(t, head, "program") {
                if nw < 3 {
                    return bad(m, t, lineno, text.lit(m, t, "program NAME FILE.chx [name=value ...]"));
                }
                let consts = mem.list(m);
                var w = 3;
                while w < nw {
                    let c = cli.constant(m, t, mem.get(m, words, w));
                    if c < 0 {
                        return 0 - 1;
                    }
                    mem.push(m, consts, c);
                    w = w + 1;
                }
                mem.push(m, progs_raw, mem.rec5(m, mem.get(m, words, 1), mem.get(m, words, 2), consts, lineno, mem.size(m, phases) - 1));
            } else if text.is(t, head, "phase") {
                let pr = phase.line(m, t, words, phases, mem.size(m, progs_raw), lineno);
                if pr < 0 {
                    return 0 - 1;
                }
            } else if text.is(t, head, "resident") {
                if nw != 3 && !(nw == 4 && (text.is(t, mem.get(m, words, 3), "f32") || text.is(t, mem.get(m, words, 3), "f16") || text.is(t, mem.get(m, words, 3), "i8"))) {
                    return bad(m, t, lineno, text.lit(m, t, "resident PROGRAM.PARAM FILE [f32|f16|i8]"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "resident takes PROGRAM.PARAM"));
                }
                var binary = 0;
                if nw == 4 {
                    binary = 1;
                    if text.is(t, mem.get(m, words, 3), "f16") {
                        binary = 2;
                    }
                    if text.is(t, mem.get(m, words, 3), "i8") {
                        binary = 3;
                    }
                }
                mem.push(m, res_raw, mem.rec5(m, pn, an, mem.get(m, words, 2), lineno, binary));
            } else if text.is(t, head, "link") {
                if nw != 4 || !text.is(t, mem.get(m, words, 2), "->") {
                    return bad(m, t, lineno, text.lit(m, t, "link PROGRAM.OUT -> PROGRAM.PARAM"));
                }
                let (sp, sa) = dotted(m, t, mem.get(m, words, 1));
                let (dp, da) = dotted(m, t, mem.get(m, words, 3));
                if sp < 0 || dp < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "link takes PROGRAM.PARAM on both sides"));
                }
                mem.push(m, link_raw, mem.rec5(m, sp, sa, dp, da, lineno));
            } else if text.is(t, head, "input") {
                if nw != 2 {
                    return bad(m, t, lineno, text.lit(m, t, "input PROGRAM.PARAM"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "input takes PROGRAM.PARAM"));
                }
                mem.push(m, input_raw, mem.rec3(m, pn, an, lineno));
            } else if text.is(t, head, "answer") {
                if nw != 2 && nw != 4 {
                    return bad(m, t, lineno, text.lit(m, t, "answer PROGRAM.PARAM [scale A/B]"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "answer takes PROGRAM.PARAM"));
                }
                var na = bits_of(1.0);
                var nb = bits_of(1.0);
                if nw == 4 {
                    if !text.is(t, mem.get(m, words, 2), "scale") {
                        return bad(m, t, lineno, text.lit(m, t, "answer PROGRAM.PARAM [scale A/B]"));
                    }
                    let (oks, sa, sb) = scale_of(m, t, mem.get(m, words, 3));
                    if !oks {
                        return bad(m, t, lineno, text.lit(m, t, "a scale is A/B with a B that is not zero"));
                    }
                    na = sa;
                    nb = sb;
                }
                mem.push(m, answer_raw, mem.rec5(m, pn, an, na, nb, lineno));
            } else if text.is(t, head, "carry") {
                if nw != 4 || !text.is(t, mem.get(m, words, 2), "->") {
                    return bad(m, t, lineno, text.lit(m, t, "carry PROGRAM.OUT -> PROGRAM.PARAM"));
                }
                let (sp, sa) = dotted(m, t, mem.get(m, words, 1));
                let (dp, da) = dotted(m, t, mem.get(m, words, 3));
                if sp < 0 || dp < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "carry takes PROGRAM.PARAM on both sides"));
                }
                mem.push(m, carry_raw, mem.rec5(m, sp, sa, dp, da, lineno));
            } else if text.is(t, head, "table") {
                // `by PROGRAM.OUT SLOT` at the end: the block is the one that output's slot names, read when the table's program is about to run (docs/kolibri.md K2)
                var nt = nw;
                var picked = false;
                var hold = 0;
                if nw >= 7 && text.is(t, mem.get(m, words, nw - 3), "by") {
                    nt = nw - 3;
                    picked = true;
                } else if nw >= 5 && text.is(t, mem.get(m, words, nw - 1), "hold") {
                    // `hold` at the end: past its last block the table stays at it, where a table goes round (docs/resident.md section 33)
                    nt = nw - 1;
                    hold = 1;
                } else if nw >= 5 && text.is(t, mem.get(m, words, nw - 1), "span") {
                    // `span` at the end: the parameter is as many blocks one after another as its phase's stride (docs/resident.md section 35)
                    nt = nw - 1;
                    hold = 5;
                }
                if nt != 4 && !(nt == 5 && (text.is(t, mem.get(m, words, 4), "f32") || text.is(t, mem.get(m, words, 4), "f16") || text.is(t, mem.get(m, words, 4), "i8"))) {
                    return bad(m, t, lineno, text.lit(m, t, "table PROGRAM.PARAM FILE BLOCKS [f32|f16|i8] [hold | span | by PROGRAM.OUT SLOT]"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "table takes PROGRAM.PARAM"));
                }
                let (okb, blocks) = runcmd.number(m, t, mem.get(m, words, 3));
                if !okb || blocks < 1.0 || blocks > 100000000.0 || float_of(truncate(blocks)) != blocks {
                    return bad(m, t, lineno, text.lit(m, t, "the blocks of a table are a positive whole number"));
                }
                let traw = mem.grab(m, 10);
                m[traw + 9] = hold;
                m[traw + 6] = 0 - 1;
                m[traw + 7] = 0;
                m[traw + 8] = 0;
                if picked {
                    let (spn, san) = dotted(m, t, mem.get(m, words, nw - 2));
                    let (oks, slot) = runcmd.number(m, t, mem.get(m, words, nw - 1));
                    if spn < 0 || !oks || slot < 0.0 || slot > 100000000.0 || float_of(truncate(slot)) != slot {
                        return bad(m, t, lineno, text.lit(m, t, "a table is picked `by PROGRAM.OUT SLOT`, the slot a whole number from 0"));
                    }
                    m[traw + 6] = spn;
                    m[traw + 7] = san;
                    m[traw + 8] = truncate(slot);
                }
                m[traw] = pn;
                m[traw + 1] = an;
                m[traw + 2] = mem.get(m, words, 2);
                m[traw + 3] = truncate(blocks);
                m[traw + 4] = lineno;
                m[traw + 5] = 0;
                if nt == 5 {
                    m[traw + 5] = 1;
                    if text.is(t, mem.get(m, words, 4), "f16") {
                        m[traw + 5] = 2;
                    }
                    if text.is(t, mem.get(m, words, 4), "i8") {
                        m[traw + 5] = 3;
                    }
                }
                mem.push(m, table_raw, traw);
            } else if text.is(t, head, "store") {
                if nw != 4 {
                    return bad(m, t, lineno, text.lit(m, t, "store PROGRAM.OUT ROLL BLOCKS"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                let (okb, blocks) = runcmd.number(m, t, mem.get(m, words, 3));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "store takes PROGRAM.OUT"));
                }
                if !okb || blocks < 1.0 || blocks > 100000000.0 || float_of(truncate(blocks)) != blocks {
                    return bad(m, t, lineno, text.lit(m, t, "the blocks of a roll are a positive whole number"));
                }
                mem.push(m, store_raw, mem.rec5(m, pn, an, mem.get(m, words, 2), truncate(blocks), lineno));
            } else if text.is(t, head, "choose") {
                if nw != 7 || !text.is(t, mem.get(m, words, 2), "by") {
                    return bad(m, t, lineno, text.lit(m, t, "choose PROGRAM.PARAM by PROGRAM.OUT TOP FIRST LAST"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                let (spn, san) = dotted(m, t, mem.get(m, words, 3));
                if pn < 0 || spn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "choose takes PROGRAM.PARAM and PROGRAM.OUT"));
                }
                let craw = mem.grab(m, 8);
                m[craw] = pn;
                m[craw + 1] = an;
                m[craw + 2] = spn;
                m[craw + 3] = san;
                m[craw + 7] = lineno;
                var w = 4;
                while w < 7 {
                    let (okn, v) = runcmd.number(m, t, mem.get(m, words, w));
                    if !okn || v < 0.0 || v > 100000000.0 || float_of(truncate(v)) != v || w == 4 && v < 1.0 {
                        return bad(m, t, lineno, text.lit(m, t, "choose takes whole numbers: the largest taken (1 or more), those taken at the start and those at the end"));
                    }
                    m[craw + w] = truncate(v);
                    w = w + 1;
                }
                mem.push(m, choose_raw, craw);
            } else if text.is(t, head, "window") {
                if nw != 3 {
                    return bad(m, t, lineno, text.lit(m, t, "window PROGRAM.PARAM ROLL"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "window takes PROGRAM.PARAM"));
                }
                mem.push(m, window_raw, mem.rec4(m, pn, an, mem.get(m, words, 2), lineno));
            } else if text.is(t, head, "save") {
                if nw != 3 && !(nw == 4 && (text.is(t, mem.get(m, words, 3), "f32") || text.is(t, mem.get(m, words, 3), "f16"))) {
                    return bad(m, t, lineno, text.lit(m, t, "save PROGRAM.OUT FILE [f32|f16]"));
                }
                let (pn, an) = dotted(m, t, mem.get(m, words, 1));
                if pn < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "save takes PROGRAM.OUT"));
                }
                var kind = 0;
                if nw == 4 {
                    kind = 1;
                    if text.is(t, mem.get(m, words, 3), "f16") {
                        kind = 2;
                    }
                }
                mem.push(m, save_raw, mem.rec5(m, pn, an, mem.get(m, words, 2), kind, lineno));
            } else if text.is(t, head, "alias") {
                if nw != 3 {
                    return bad(m, t, lineno, text.lit(m, t, "alias PROGRAM.OUT PROGRAM.OUT"));
                }
                let (sp, sa) = dotted(m, t, mem.get(m, words, 1));
                let (dp, da) = dotted(m, t, mem.get(m, words, 2));
                if sp < 0 || dp < 0 {
                    return bad(m, t, lineno, text.lit(m, t, "alias takes PROGRAM.OUT on both sides"));
                }
                mem.push(m, alias_raw, mem.rec5(m, sp, sa, dp, da, lineno));
            } else if text.is(t, head, "steps") {
                if nw != 1 {
                    return bad(m, t, lineno, text.lit(m, t, "steps takes nothing"));
                }
                if steps == 1 {
                    return bad(m, t, lineno, text.lit(m, t, "steps is given once"));
                }
                steps = 1;
            } else {
                return bad(m, t, lineno, text.f1(m, t, "`$` is not a directive (program, resident, link, input, answer, carry, table, store, window, choose, steps, save, alias, phase)", head));
            }
        }
    }
    if mem.size(m, progs_raw) == 0 {
        return bad(m, t, lineno, text.lit(m, t, "the session has no program"));
    }
    if mem.size(m, answer_raw) == 0 {
        return bad(m, t, lineno, text.lit(m, t, "the session has no answer"));
    }
    if phase.complete(m, t, phases, mem.size(m, progs_raw), steps) < 0 {
        return 0 - 1;
    }

    // Compile every program once: records (name, prog, globals).
    let progs = mem.list(m);
    var i = 0;
    while i < mem.size(m, progs_raw) {
        let raw = mem.get(m, progs_raw, i);
        if prog_index(m, t, progs, m[raw]) >= 0 {
            return bad(m, t, m[raw + 3], text.f1(m, t, "the program `$` is named twice", m[raw]));
        }
        let text_src = source(m, t, fs, m[raw + 1], m[raw + 3]);
        if text_src < 0 {
            return 0 - 1;
        }
        let unit = parser.parse(m, t, text_src);
        if unit < 0 {
            return 0 - 1;
        }
        let tg = pick(m, t, unit, want, have, m[raw + 3]);
        if tg < 0 {
            return 0 - 1;
        }
        let compiled = elab.compile(m, t, unit, target.name(m, tg), m[raw + 2]);
        if compiled < 0 {
            return 0 - 1;
        }
        let prog = m[compiled];
        if check.check(m, t, prog, tg) < 0 {
            return 0 - 1;
        }
        var lowered = 0 - 1;
        if device {
            let sched = m[compiled + 1];
            lowered = lower.lower(m, t, prog, tg, dialect.msl(), m[sched + 1], m[sched + 3], m[sched + 4], m[sched + 5], m[sched + 7]);
            if lowered < 0 {
                return 0 - 1;
            }
        }
        var globals = 0 - 1;
        if device {
            globals = interp.globals_lazy(m, prog);
        } else {
            globals = interp.inputs(m, t, fm, prog);
        }
        if globals < 0 {
            return 0 - 1;
        }
        mem.push(m, progs, mem.rec5(m, m[raw], prog, globals, lowered, m[raw + 4]));
        i = i + 1;
    }

    // How each read-only parameter is supplied: 0 not yet, 1 resident, 2 linked, 3 input. One word per parameter of every program.
    let np = mem.size(m, progs);
    let supplied = mem.list(m);
    i = 0;
    while i < np {
        let n = mem.size(m, ir.p_params(m, m[mem.get(m, progs, i) + 1]));
        mem.push(m, supplied, mem.grab(m, n + 1));
        i = i + 1;
    }

    let resident = mem.list(m);
    i = 0;
    while i < mem.size(m, res_raw) {
        let raw = mem.get(m, res_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 3]);
        if pi < 0 {
            return 0 - 1;
        }
        if ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 3], text.f1(m, t, "`$` is written by the kernel: it cannot be resident", m[raw + 1]));
        }
        if unsafe_path(t, m[raw + 2]) {
            return bad(m, t, m[raw + 3], text.lit(m, t, "the file of a resident has two dots in a row or is over 4,000 bytes"));
        }
        let cell = mem.get(m, supplied, pi) + ai;
        if m[cell] != 0 {
            return bad(m, t, m[raw + 3], text.f2(m, t, "`$.$` is supplied twice", m[raw], m[raw + 1]));
        }
        m[cell] = 1;
        let g = mem.get(m, m[mem.get(m, progs, pi) + 2], ai);
        // A device session sends a binary resident file straight to the device (the record carries the file's name), keeping it out of the interpreter's memory
        var direct = false;
        if device && m[raw + 4] != 0 {
            direct = true;
            let dt = ir.param_dtype(m, prm);
            if m[raw + 4] == 1 && dt != kinds.f32() || m[raw + 4] == 2 && dt != kinds.f16() || m[raw + 4] == 3 && dt != kinds.i8() {
                return err.fail(m, t, "usage", text.f1(m, t, "`$` has another type than the binary file's flag says", m[raw + 1]));
            }
            mem.push(m, resident, mem.rec3(m, pi, ai, m[raw + 2]));
        }
        if !direct {
            if interp.materialise(m, t, fm, g) < 0 {
                return 0 - 1;
            }
            var loaded = 0;
            if m[raw + 4] == 2 {
                loaded = runcmd.load_f16(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), m[g + 2], m[g + 3]);
            } else if m[raw + 4] == 3 {
                loaded = runcmd.load_i8(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), m[g + 2], m[g + 3]);
            } else if m[raw + 4] == 1 {
                loaded = runcmd.load_f32(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), m[g + 2], m[g + 3]);
            } else {
                loaded = runcmd.load_one(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), m[g + 2], m[g + 3]);
            }
            if loaded < 0 {
                return 0 - 1;
            }
            mem.push(m, resident, mem.rec3(m, pi, ai, 0 - 1));
        }
        i = i + 1;
    }

    // Links: (source program, source param, destination program, destination param), the source before the destination.
    let links = mem.list(m);
    i = 0;
    while i < mem.size(m, link_raw) {
        let raw = mem.get(m, link_raw, i);
        let (sp, sa, sprm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if sp < 0 {
            return 0 - 1;
        }
        let (dp, da, dprm) = locate(m, t, progs, m[raw + 2], m[raw + 3], m[raw + 4]);
        if dp < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, sprm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is not written by its kernel: only an output can be linked from", m[raw + 1]));
        }
        if ir.param_writable(m, dprm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is written by its kernel: only an input can be linked to", m[raw + 3]));
        }
        if sp >= dp {
            return bad(m, t, m[raw + 4], text.lit(m, t, "a link goes from a program to one listed after it"));
        }
        if phase.apart(m, t, progs, sp, dp, m[raw + 4], "a link") {
            return 0 - 1;
        }
        let gs = mem.get(m, m[mem.get(m, progs, sp) + 2], sa);
        let gd = mem.get(m, m[mem.get(m, progs, dp) + 2], da);
        if m[gs + 3] != m[gd + 3] {
            return bad(m, t, m[raw + 4], text.f2(m, t, "the output holds $ numbers and the input $", text.num(m, t, m[gs + 3]), text.num(m, t, m[gd + 3])));
        }
        let cell = mem.get(m, supplied, dp) + da;
        if m[cell] != 0 {
            return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is supplied twice", m[raw + 2], m[raw + 3]));
        }
        m[cell] = 2;
        mem.push(m, links, mem.rec4(m, sp, sa, dp, da));
        i = i + 1;
    }

    // Tables: the whole file is read once into a region of `blocks` times the parameter, and block j of it is the parameter in repetition j.
    let tables = mem.list(m);
    i = 0;
    while i < mem.size(m, table_raw) {
        let raw = mem.get(m, table_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if pi < 0 {
            return 0 - 1;
        }
        if ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is written by the kernel: it cannot be a table", m[raw + 1]));
        }
        let cell = mem.get(m, supplied, pi) + ai;
        if m[cell] != 0 {
            return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is supplied twice", m[raw], m[raw + 1]));
        }
        m[cell] = 4;
        let g = mem.get(m, m[mem.get(m, progs, pi) + 2], ai);
        // one block's elements: the parameter's, or with `span` the parameter's over its phase's stride
        let pst = phase.stride(m, phases, progs, pi);
        var bel = m[g + 3];
        if m[raw + 9] == 5 {
            if m[g + 3] % pst != 0 {
                return bad(m, t, m[raw + 4], text.f2(m, t, "`$` has $ elements: a spanned parameter is a whole number of blocks for each of its phase's stride", m[raw + 1], text.num(m, t, m[g + 3])));
            }
            bel = m[g + 3] / pst;
        }
        // a picked table: the output that names the block belongs to a program listed before the table's, and has the slot
        var sp0 = 0 - 1;
        var sa0 = 0;
        if m[raw + 6] >= 0 {
            let (sp, sa, sprm) = locate(m, t, progs, m[raw + 6], m[raw + 7], m[raw + 4]);
            if sp < 0 {
                return 0 - 1;
            }
            if !ir.param_writable(m, sprm) || ir.param_dtype(m, sprm) != kinds.f32() {
                return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is not an f32 output: a table is picked by a value a kernel wrote", m[raw + 7]));
            }
            if sp >= pi {
                return bad(m, t, m[raw + 4], text.f2(m, t, "`$` is picked by `$`, which is not listed before it", m[raw], m[raw + 6]));
            }
            if phase.apart(m, t, progs, sp, pi, m[raw + 4], "a pick") {
                return 0 - 1;
            }
            let sg = mem.get(m, m[mem.get(m, progs, sp) + 2], sa);
            if m[raw + 8] >= m[sg + 3] {
                return bad(m, t, m[raw + 4], text.f2(m, t, "`$` has $ values: the slot is past them", m[raw + 7], text.num(m, t, m[sg + 3])));
            }
            sp0 = sp;
            sa0 = sa;
        }
        // A device session keeps a binary table out of the interpreter's memory: the device program reads the file straight to the device (the table's record has -1 for its place
        // there, and the file's name), so a table can be as large as the device's memory.
        var direct = false;
        if device && m[raw + 5] != 0 {
            direct = true;
            let dt = ir.param_dtype(m, prm);
            if m[raw + 5] == 1 && dt != kinds.f32() || m[raw + 5] == 2 && dt != kinds.f16() || m[raw + 5] == 3 && dt != kinds.i8() {
                return err.fail(m, t, "usage", text.f1(m, t, "`$` has another type than the binary file's flag says", m[raw + 1]));
            }
            let dtb = table_rec(m, pi, ai, 0 - 1, m[raw + 3], m[raw + 2], sp0, sa0, m[raw + 8]);
            m[dtb + t_way()] = m[raw + 9];
            m[dtb + t_span()] = pst;
            mem.push(m, tables, dtb);
        }
        if !direct {
            let whole = interp.falloc(m, fm, bel * m[raw + 3]);
            if whole < 0 {
                return err.fail(m, t, "session", text.lit(m, t, "the table does not fit the interpreter's memory"));
            }
            var loaded = 0;
            if m[raw + 5] == 3 {
                loaded = runcmd.load_i8(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), whole, bel * m[raw + 3]);
            } else if m[raw + 5] == 2 {
                loaded = runcmd.load_f16(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), whole, bel * m[raw + 3]);
            } else if m[raw + 5] == 1 {
                loaded = runcmd.load_f32(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), whole, bel * m[raw + 3]);
            } else {
                loaded = runcmd.load_one(m, t, fm, fs, text.bytes(t, m[raw + 2]), m[raw + 1], ir.param_dtype(m, prm), whole, bel * m[raw + 3]);
            }
            if loaded < 0 {
                return 0 - 1;
            }
            let ctb = table_rec(m, pi, ai, whole, m[raw + 3], 0, sp0, sa0, m[raw + 8]);
            m[ctb + t_way()] = m[raw + 9];
            m[ctb + t_span()] = pst;
            mem.push(m, tables, ctb);
        }
        i = i + 1;
    }

    // Rolls (docs/resident.md section 33). `store P.OUT NAME BLOCKS`: the output of P is block j of the roll NAME in repetition j. A roll is stored once, by an output; it is zero at the
    // start. On the interpreter it is a region of BLOCKS times the output; on a device it is a buffer the device program allocates, and the output is that buffer at the block.
    let rolls = mem.list(m);
    i = 0;
    while i < mem.size(m, store_raw) {
        let raw = mem.get(m, store_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if pi < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is not written by its kernel: a roll stores an output", m[raw + 1]));
        }
        let g = mem.get(m, m[mem.get(m, progs, pi) + 2], ai);
        // in a phase of stride S the output is S blocks of the roll
        let pst = phase.stride(m, phases, progs, pi);
        if m[g + 3] % pst != 0 {
            return bad(m, t, m[raw + 4], text.f2(m, t, "`$` has $ elements: a stored output is a block for each of its phase's stride", m[raw + 1], text.num(m, t, m[g + 3])));
        }
        // the roll's first store, when another phase stored it before: the same buffer, and it must be the same roll
        var first = 0 - 1;
        var k = 0;
        while k < mem.size(m, rolls) {
            let other = mem.get(m, rolls, k);
            if m[other] == pi && m[other + 1] == ai {
                return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is stored twice", m[raw], m[raw + 1]));
            }
            if text.eq(t, m[other + 4], m[raw + 2]) {
                if m[mem.get(m, progs, m[other]) + 4] == m[mem.get(m, progs, pi) + 4] {
                    return bad(m, t, m[raw + 4], text.f1(m, t, "the roll `$` is stored twice", m[raw + 2]));
                }
                if m[other + 3] != m[raw + 3] || m[other + t_stride()] != m[g + 3] / pst {
                    return bad(m, t, m[raw + 4], text.f1(m, t, "the roll `$` is stored in another phase with other blocks, or blocks of another size", m[raw + 2]));
                }
                let oprm = mem.get(m, ir.p_params(m, m[mem.get(m, progs, m[other]) + 1]), m[other + 1]);
                if ir.param_dtype(m, oprm) != ir.param_dtype(m, prm) {
                    return bad(m, t, m[raw + 4], text.f1(m, t, "the roll `$` is stored in another phase with another element type", m[raw + 2]));
                }
                if first < 0 {
                    first = other;
                }
            }
            k = k + 1;
        }
        var whole = 0 - 1;
        if first >= 0 {
            whole = m[first + 2];
        } else if !device {
            whole = interp.falloc(m, fm, m[g + 3] / pst * m[raw + 3]);
            if whole < 0 {
                return err.fail(m, t, "session", text.lit(m, t, "the roll does not fit the interpreter's memory"));
            }
            var e = 0;
            while e < m[g + 3] / pst * m[raw + 3] {
                fm[whole + e] = 0.0;
                e = e + 1;
            }
        }
        let rtb = table_rec(m, pi, ai, whole, m[raw + 3], m[raw + 2], 0 - 1, 0, 0);
        m[rtb + t_way()] = 2;
        m[rtb + t_stride()] = m[g + 3] / pst;
        m[rtb + t_span()] = pst;
        m[rtb + t_roll()] = mem.size(m, rolls);
        if first >= 0 {
            m[rtb + t_roll()] = m[first + t_roll()];
        }
        mem.push(m, rolls, rtb);
        mem.push(m, tables, rtb);
        i = i + 1;
    }
    // `window Q.PARAM NAME`: Q.PARAM, n blocks long, is the n blocks of the roll that end with the repetition's (the first n while there are fewer). The roll's program is listed
    // before Q, so that the block of the repetition is written when Q reads it.
    i = 0;
    while i < mem.size(m, window_raw) {
        let raw = mem.get(m, window_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 3]);
        if pi < 0 {
            return 0 - 1;
        }
        if ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 3], text.f1(m, t, "`$` is written by the kernel: it cannot be a window", m[raw + 1]));
        }
        let cell = mem.get(m, supplied, pi) + ai;
        if m[cell] != 0 {
            return bad(m, t, m[raw + 3], text.f2(m, t, "`$.$` is supplied twice", m[raw], m[raw + 1]));
        }
        m[cell] = 5;
        var roll = 0 - 1;
        var named = false;
        var k = 0;
        while k < mem.size(m, rolls) {
            if text.eq(t, m[mem.get(m, rolls, k) + 4], m[raw + 2]) {
                named = true;
                if m[mem.get(m, progs, m[mem.get(m, rolls, k)]) + 4] == m[mem.get(m, progs, pi) + 4] {
                    roll = mem.get(m, rolls, k);
                }
            }
            k = k + 1;
        }
        if !named {
            return bad(m, t, m[raw + 3], text.f1(m, t, "`$` is not a roll of the session (store PROGRAM.OUT ROLL BLOCKS)", m[raw + 2]));
        }
        if roll < 0 {
            return bad(m, t, m[raw + 3], text.f1(m, t, "the roll `$` is not stored in the window's phase", m[raw + 2]));
        }
        if m[roll] >= pi {
            return bad(m, t, m[raw + 3], text.f2(m, t, "the roll `$` is stored by `$`, which is not listed before its reader", m[raw + 2], m[mem.get(m, progs, m[roll])]));
        }
        let g = mem.get(m, m[mem.get(m, progs, pi) + 2], ai);
        let sprm = mem.get(m, ir.p_params(m, m[mem.get(m, progs, m[roll]) + 1]), m[roll + 1]);
        if ir.param_dtype(m, prm) != ir.param_dtype(m, sprm) {
            return bad(m, t, m[raw + 3], text.f1(m, t, "`$` has another element type than the roll", m[raw + 1]));
        }
        let stride = m[roll + t_stride()];
        if m[g + 3] % stride != 0 || m[g + 3] / stride > m[roll + 3] {
            return bad(m, t, m[raw + 3], text.f3(m, t, "`$` has $ elements: a window is a whole number of the roll's blocks of $, and no more than the roll has", m[raw + 1], text.num(m, t, m[g + 3]), text.num(m, t, stride)));
        }
        let wtb = table_rec(m, pi, ai, m[roll + 2], m[roll + 3], m[raw + 2], 0 - 1, 0, 0);
        m[wtb + t_way()] = 3;
        m[wtb + t_stride()] = stride;
        m[wtb + t_roll()] = m[roll + t_roll()];
        m[wtb + t_span()] = m[roll + t_span()];
        m[wtb + 12] = m[g + 3] / stride;
        mem.push(m, tables, wtb);
        i = i + 1;
    }

    // Carries: (source program, source param, destination program, destination param); the destination is a resident parameter listed at or before the source.
    let carries = mem.list(m);
    i = 0;
    while i < mem.size(m, carry_raw) {
        let raw = mem.get(m, carry_raw, i);
        let (sp, sa, sprm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if sp < 0 {
            return 0 - 1;
        }
        let (dp, da, dprm) = locate(m, t, progs, m[raw + 2], m[raw + 3], m[raw + 4]);
        if dp < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, sprm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is not written by its kernel: only an output can be carried from", m[raw + 1]));
        }
        if ir.param_writable(m, dprm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is written by its kernel: only an input can be carried to", m[raw + 3]));
        }
        if dp > sp {
            return bad(m, t, m[raw + 4], text.lit(m, t, "a carry goes from a program to one listed at or before it"));
        }
        if phase.apart(m, t, progs, sp, dp, m[raw + 4], "a carry") {
            return 0 - 1;
        }
        let gs = mem.get(m, m[mem.get(m, progs, sp) + 2], sa);
        let gd = mem.get(m, m[mem.get(m, progs, dp) + 2], da);
        if m[gs] != m[gd] || m[gs + 3] != m[gd + 3] {
            return bad(m, t, m[raw + 4], text.f2(m, t, "the output holds $ numbers and the input $, or their types differ", text.num(m, t, m[gs + 3]), text.num(m, t, m[gd + 3])));
        }
        if m[mem.get(m, supplied, dp) + da] != 1 {
            return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is carried to, so it must be resident (its first value)", m[raw + 2], m[raw + 3]));
        }
        mem.push(m, carries, mem.rec4(m, sp, sa, dp, da));
        i = i + 1;
    }

    // Inputs: (program, param), in the order of the request line.
    let inputs = mem.list(m);
    i = 0;
    while i < mem.size(m, input_raw) {
        let raw = mem.get(m, input_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 2]);
        if pi < 0 {
            return 0 - 1;
        }
        if ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 2], text.f1(m, t, "`$` is written by the kernel: it cannot be an input", m[raw + 1]));
        }
        let cell = mem.get(m, supplied, pi) + ai;
        if m[cell] != 0 {
            return bad(m, t, m[raw + 2], text.f2(m, t, "`$.$` is supplied twice", m[raw], m[raw + 1]));
        }
        m[cell] = 3;
        if interp.materialise(m, t, fm, mem.get(m, m[mem.get(m, progs, pi) + 2], ai)) < 0 {
            return 0 - 1;
        }
        mem.push(m, inputs, mem.rec2(m, pi, ai));
        i = i + 1;
    }

    // `choose P.PARAM by Q.OUT TOP FIRST LAST` (docs/resident.md section 34): P.PARAM is a mask the session writes, when P is about to run in repetition j, from the f32 output Q.OUT
    // of as many numbers; Q is listed before P.
    i = 0;
    while i < mem.size(m, choose_raw) {
        let raw = mem.get(m, choose_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 7]);
        if pi < 0 {
            return 0 - 1;
        }
        if ir.param_writable(m, prm) || ir.param_dtype(m, prm) != kinds.f32() {
            return bad(m, t, m[raw + 7], text.f1(m, t, "`$` is not an f32 parameter the kernel reads: a mask is chosen for one", m[raw + 1]));
        }
        let cell = mem.get(m, supplied, pi) + ai;
        if m[cell] != 0 {
            return bad(m, t, m[raw + 7], text.f2(m, t, "`$.$` is supplied twice", m[raw], m[raw + 1]));
        }
        m[cell] = 6;
        let (sp, sa, sprm) = locate(m, t, progs, m[raw + 2], m[raw + 3], m[raw + 7]);
        if sp < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, sprm) || ir.param_dtype(m, sprm) != kinds.f32() {
            return bad(m, t, m[raw + 7], text.f1(m, t, "`$` is not an f32 output: a mask is chosen by numbers a kernel wrote", m[raw + 3]));
        }
        if sp >= pi {
            return bad(m, t, m[raw + 7], text.f2(m, t, "`$` is chosen by `$`, which is not listed before it", m[raw], m[raw + 2]));
        }
        if phase.apart(m, t, progs, sp, pi, m[raw + 7], "a choice") {
            return 0 - 1;
        }
        let g = mem.get(m, m[mem.get(m, progs, pi) + 2], ai);
        let sg = mem.get(m, m[mem.get(m, progs, sp) + 2], sa);
        if m[sg + 3] != m[g + 3] {
            return bad(m, t, m[raw + 7], text.f2(m, t, "the mask has $ entries and the output that chooses it $", text.num(m, t, m[g + 3]), text.num(m, t, m[sg + 3])));
        }
        // the mask and the scores are numbers the session works on, in a device session too
        if interp.materialise(m, t, fm, g) < 0 || interp.materialise(m, t, fm, sg) < 0 {
            return 0 - 1;
        }
        let scratch = interp.falloc(m, fm, m[g + 3]);
        if scratch < 0 {
            return err.fail(m, t, "session", text.lit(m, t, "the choice does not fit the interpreter's memory"));
        }
        let ctb = table_rec(m, pi, ai, scratch, m[raw + 4], 0, 0 - 1, 0, 0);
        m[ctb + t_way()] = 4;
        m[ctb + 10] = sp;
        m[ctb + 11] = sa;
        m[ctb + 12] = m[raw + 5];
        m[ctb + 13] = m[raw + 6];
        // in a phase of stride S the mask is S rows, one for each repetition of the session
        let pst = phase.stride(m, phases, progs, pi);
        if m[g + 3] % pst != 0 {
            return bad(m, t, m[raw + 7], text.f2(m, t, "`$` has $ entries: a chosen mask is a row for each of its phase's stride", m[raw + 1], text.num(m, t, m[g + 3])));
        }
        m[ctb + t_span()] = pst;
        m[ctb + 14] = m[g + 3] / pst;
        mem.push(m, tables, ctb);
        i = i + 1;
    }
    if mem.size(m, choose_raw) > 0 && steps == 0 {
        return err.fail(m, t, "session", text.lit(m, t, "choose is for a session file with `steps`: the mask is the repetition's"));
    }

    // Every read-only parameter is supplied.
    i = 0;
    while i < np {
        let prog = m[mem.get(m, progs, i) + 1];
        let ps = ir.p_params(m, prog);
        var k = 0;
        while k < mem.size(m, ps) {
            let prm = mem.get(m, ps, k);
            if !ir.param_writable(m, prm) && m[mem.get(m, supplied, i) + k] == 0 {
                return err.fail(m, t, "session", text.f2(m, t, "`$.$` is read by its kernel and nothing supplies it (resident, link or input)", m[mem.get(m, progs, i)], ir.param_name(m, prm)));
            }
            k = k + 1;
        }
        i = i + 1;
    }

    // Answers: (program, param, A bits, B bits).
    let answers = mem.list(m);
    i = 0;
    while i < mem.size(m, answer_raw) {
        let raw = mem.get(m, answer_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if pi < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is only read by its kernel: an answer is an output", m[raw + 1]));
        }
        if interp.materialise(m, t, fm, mem.get(m, m[mem.get(m, progs, pi) + 2], ai)) < 0 {
            return 0 - 1;
        }
        mem.push(m, answers, mem.rec4(m, pi, ai, m[raw + 2], m[raw + 3]));
        i = i + 1;
    }

    // Saves: (program, param, file, kind, line). A save writes a file, so what it may name is checked here, before any device work: an output of a
    // kernel, held in the type the flag says; a path the runtime will not trap on; a file that is not one the session reads; and the saves to one file
    // listed together, because they are one file written once (docs/resident.md section 19).
    let saves = mem.list(m);
    i = 0;
    while i < mem.size(m, save_raw) {
        let raw = mem.get(m, save_raw, i);
        let (pi, ai, prm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if pi < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, prm) {
            return bad(m, t, m[raw + 4], text.f1(m, t, "`$` is only read by its kernel: a save is an output", m[raw + 1]));
        }
        var want_type = kinds.f32();
        if m[raw + 3] == 2 {
            want_type = kinds.f16();
        }
        if ir.param_dtype(m, prm) != want_type {
            return err.fail(m, t, "usage", text.f1(m, t, "`$` has another type than the save's flag says (f32 when there is none)", m[raw + 1]));
        }
        if unsafe_path(t, m[raw + 2]) {
            return bad(m, t, m[raw + 4], text.lit(m, t, "the file of a save has two dots in a row or is over 4,000 bytes"));
        }
        var other = 0;
        while other < mem.size(m, res_raw) {
            if text.eq(t, m[mem.get(m, res_raw, other) + 2], m[raw + 2]) {
                return bad(m, t, m[raw + 4], text.f1(m, t, "$ is a resident file: a save does not overwrite what the session reads", m[raw + 2]));
            }
            other = other + 1;
        }
        other = 0;
        while other < mem.size(m, table_raw) {
            if text.eq(t, m[mem.get(m, table_raw, other) + 2], m[raw + 2]) {
                return bad(m, t, m[raw + 4], text.f1(m, t, "$ is a table file: a save does not overwrite what the session reads", m[raw + 2]));
            }
            other = other + 1;
        }
        other = 0;
        while other < mem.size(m, progs_raw) {
            if text.eq(t, m[mem.get(m, progs_raw, other) + 1], m[raw + 2]) {
                return bad(m, t, m[raw + 4], text.f1(m, t, "$ is a kernel file: a save does not overwrite what the session reads", m[raw + 2]));
            }
            other = other + 1;
        }
        if i > 0 && !text.eq(t, m[mem.get(m, save_raw, i - 1) + 2], m[raw + 2]) {
            other = 0;
            while other < i - 1 {
                if text.eq(t, m[mem.get(m, save_raw, other) + 2], m[raw + 2]) {
                    return bad(m, t, m[raw + 4], text.f1(m, t, "the saves to $ are not together: list them one after another", m[raw + 2]));
                }
                other = other + 1;
            }
        }
        mem.push(m, saves, mem.rec5(m, pi, ai, m[raw + 2], m[raw + 3], m[raw + 4]));
        i = i + 1;
    }

    // Aliases: (root program, root param, program, param). `alias P.OUT Q.OUT` puts the output Q.OUT in the buffer of P.OUT (a device session shares the buffer, the CPU interpreter
    // keeps two), which is safe only if nothing reads P.OUT once Q's program has begun: both are outputs of the same type and size, P's program is listed before Q's, every program that
    // reads P.OUT (a link) is listed before Q's, and neither is answered, saved or carried, because those are read after the programs ran. An output joins an alias group once. Aliases chain:
    // `alias A B` then `alias B C` puts all three in one buffer, and C must come after every reader of A and of B.
    let aliases = mem.list(m);
    i = 0;
    while i < mem.size(m, alias_raw) {
        let raw = mem.get(m, alias_raw, i);
        let (sp, sa, sprm) = locate(m, t, progs, m[raw], m[raw + 1], m[raw + 4]);
        if sp < 0 {
            return 0 - 1;
        }
        let (dp, da, dprm) = locate(m, t, progs, m[raw + 2], m[raw + 3], m[raw + 4]);
        if dp < 0 {
            return 0 - 1;
        }
        if !ir.param_writable(m, sprm) || !ir.param_writable(m, dprm) {
            return bad(m, t, m[raw + 4], text.lit(m, t, "an alias is between two outputs of kernels"));
        }
        if sp >= dp {
            return bad(m, t, m[raw + 4], text.lit(m, t, "an alias goes from a program to one listed after it"));
        }
        if phase.apart(m, t, progs, sp, dp, m[raw + 4], "an alias") {
            return 0 - 1;
        }
        let gs = mem.get(m, m[mem.get(m, progs, sp) + 2], sa);
        let gd = mem.get(m, m[mem.get(m, progs, dp) + 2], da);
        if m[gs] != m[gd] || m[gs + 3] != m[gd + 3] {
            return bad(m, t, m[raw + 4], text.f2(m, t, "the outputs hold $ and $ numbers, or their types differ", text.num(m, t, m[gs + 3]), text.num(m, t, m[gd + 3])));
        }
        // the root of the group P.OUT is in, and every member of it
        var rp = sp;
        var ra = sa;
        var k = 0;
        while k < mem.size(m, aliases) {
            let al = mem.get(m, aliases, k);
            if m[al + 2] == dp && m[al + 3] == da {
                return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is already aliased to an earlier output", m[raw + 2], m[raw + 3]));
            }
            if m[al + 2] == sp && m[al + 3] == sa {
                rp = m[al];
                ra = m[al + 1];
            }
            k = k + 1;
        }
        // none of the members is answered, saved or carried
        let members = mem.list(m);
        mem.push(m, members, mem.rec2(m, rp, ra));
        k = 0;
        while k < mem.size(m, aliases) {
            let al = mem.get(m, aliases, k);
            if m[al] == rp && m[al + 1] == ra {
                mem.push(m, members, mem.rec2(m, m[al + 2], m[al + 3]));
            }
            k = k + 1;
        }
        mem.push(m, members, mem.rec2(m, dp, da));
        k = 0;
        while k < mem.size(m, members) {
            let mb = mem.get(m, members, k);
            var j = 0;
            while j < mem.size(m, answers) {
                let a = mem.get(m, answers, j);
                if m[a] == m[mb] && m[a + 1] == m[mb + 1] {
                    return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is aliased and answered: an answer is read after the programs ran, when the buffer holds the last of the group", m[mem.get(m, progs, m[mb])], ir.param_name(m, mem.get(m, ir.p_params(m, m[mem.get(m, progs, m[mb]) + 1]), m[mb + 1]))));
                }
                j = j + 1;
            }
            j = 0;
            while j < mem.size(m, saves) {
                let a = mem.get(m, saves, j);
                if m[a] == m[mb] && m[a + 1] == m[mb + 1] {
                    return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is aliased and saved: a save is read after the programs ran, when the buffer holds the last of the group", m[mem.get(m, progs, m[mb])], ir.param_name(m, mem.get(m, ir.p_params(m, m[mem.get(m, progs, m[mb]) + 1]), m[mb + 1]))));
                }
                j = j + 1;
            }
            j = 0;
            while j < mem.size(m, carries) {
                let a = mem.get(m, carries, j);
                if m[a] == m[mb] && m[a + 1] == m[mb + 1] {
                    return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is aliased and carried: a carry keeps its buffer from one repetition to the next", m[mem.get(m, progs, m[mb])], ir.param_name(m, mem.get(m, ir.p_params(m, m[mem.get(m, progs, m[mb]) + 1]), m[mb + 1]))));
                }
                j = j + 1;
            }
            // every reader of this member is listed before the program that now writes the buffer
            j = 0;
            while j < mem.size(m, links) {
                let lk = mem.get(m, links, j);
                if m[lk] == m[mb] && m[lk + 1] == m[mb + 1] && m[lk + 2] >= dp && !(m[mb] == dp && m[mb + 1] == da) {
                    return bad(m, t, m[raw + 4], text.f2(m, t, "`$.$` is linked to a program that runs after (or as) the program that overwrites its buffer", m[mem.get(m, progs, m[mb])], ir.param_name(m, mem.get(m, ir.p_params(m, m[mem.get(m, progs, m[mb]) + 1]), m[mb + 1]))));
                }
                j = j + 1;
            }
            k = k + 1;
        }
        mem.push(m, aliases, mem.rec4(m, rp, ra, dp, da));
        i = i + 1;
    }

    // A stored output lives in the roll, at a block that moves: it is read through windows and in no other way.
    i = 0;
    while i < mem.size(m, rolls) {
        let roll = mem.get(m, rolls, i);
        var other = false;
        var k = 0;
        while k < mem.size(m, links) {
            let l = mem.get(m, links, k);
            other = other || m[l] == m[roll] && m[l + 1] == m[roll + 1];
            k = k + 1;
        }
        k = 0;
        while k < mem.size(m, carries) {
            let c = mem.get(m, carries, k);
            other = other || m[c] == m[roll] && m[c + 1] == m[roll + 1];
            k = k + 1;
        }
        k = 0;
        while k < mem.size(m, answers) {
            let a = mem.get(m, answers, k);
            other = other || m[a] == m[roll] && m[a + 1] == m[roll + 1];
            k = k + 1;
        }
        k = 0;
        while k < mem.size(m, saves) {
            let sv = mem.get(m, saves, k);
            other = other || m[sv] == m[roll] && m[sv + 1] == m[roll + 1];
            k = k + 1;
        }
        k = 0;
        while k < mem.size(m, aliases) {
            let al = mem.get(m, aliases, k);
            other = other || m[al] == m[roll] && m[al + 1] == m[roll + 1] || m[al + 2] == m[roll] && m[al + 3] == m[roll + 1];
            k = k + 1;
        }
        if other {
            return err.fail(m, t, "session", text.f1(m, t, "the output stored in the roll `$` is also linked, carried, answered, saved or aliased: a stored output is read through windows", m[roll + 4]));
        }
        i = i + 1;
    }
    if mem.size(m, rolls) > 0 && steps == 0 {
        return err.fail(m, t, "session", text.lit(m, t, "a roll is for a session file with `steps`: its block is the repetition's"));
    }

    if phase.answered(m, t, phases, progs, answers) < 0 {
        return 0 - 1;
    }
    let sess = mem.rec(m, 13);
    m[sess + s_phases()] = phases;
    m[sess + s_phase()] = 0;
    m[sess + s_progs()] = progs;
    m[sess + s_resident()] = resident;
    m[sess + s_links()] = links;
    m[sess + s_inputs()] = inputs;
    m[sess + s_answers()] = answers;
    m[sess + s_carries()] = carries;
    m[sess + s_tables()] = tables;
    m[sess + s_steps()] = steps;
    m[sess + s_count()] = 0;
    m[sess + s_saves()] = saves;
    m[sess + s_aliases()] = aliases;
    return sess;
}

// The program `pname`'s parameter `aname`: (program index, parameter index, the parameter), or (-1, -1, -1) with a refusal.
// A table's record (s_tables).
fn table_rec[&m](m: &!m [int], pi: int, ai: int, whole: int, blocks: int, file: int, sp: int, sa: int, slot: int) -> [] int {
    let r = mem.rec(m, 16);
    m[r + 15] = 1;
    m[r + 9] = 0;
    m[r + 10] = 0;
    m[r + 11] = 0;
    m[r + 12] = 0;
    m[r + 13] = 0;
    m[r + 14] = 0;
    m[r] = pi;
    m[r + 1] = ai;
    m[r + 2] = whole;
    m[r + 3] = blocks;
    m[r + 4] = file;
    m[r + 5] = sp;
    m[r + 6] = sa;
    m[r + 7] = slot;
    m[r + 8] = 0;
    return r;
}

// The block a picked table reads: the value as a whole number from 0 to `blocks` - 1, or -1 with a refusal. A value that is not one (a fraction, a NaN, a block the table has not) is never a read.
pub fn picked_block[&m, &t](m: &!m [int], t: &!t [byte], v: float, blocks: int) -> [] int {
    if v >= 0.0 && v < float_of(blocks) && float_of(truncate(v)) == v {
        return truncate(v);
    }
    return err.fail(m, t, "session", text.f1(m, t, "a table of $ blocks was picked by a value that is not one of them", text.num(m, t, blocks)));
}

fn locate[&m, &t](m: &!m [int], t: &!t [byte], progs: int, pname: int, aname: int, line: int) -> [] (int, int, int) {
    let pi = prog_index(m, t, progs, pname);
    if pi < 0 {
        let r = bad(m, t, line, text.f1(m, t, "`$` is not a program of the session", pname));
        return (0 - 1, 0 - 1, 0 - 1);
    }
    let prog = m[mem.get(m, progs, pi) + 1];
    let ai = runcmd.find(m, t, prog, aname);
    if ai < 0 {
        let r = bad(m, t, line, text.f2(m, t, "`$` has no parameter `$`", pname, aname));
        return (0 - 1, 0 - 1, 0 - 1);
    }
    return (pi, ai, mem.get(m, ir.p_params(m, prog), ai));
}

// The request `reload P.PARAM ...` (`docs/resident.md` section 29), for a device session: (1, the `resident` records of the named parameters) when the line is the word `reload` and at least one
// `PROGRAM.PARAM`, each of which must be a binary resident file (the record carries its file's name: a request never names a file); (0, 0) when the line does not start with `reload`; (-1, 0) with a refusal.
pub fn reload_request[&m, &t](m: &!m [int], t: &!t [byte], sess: int, line: int) -> [] (int, int) {
    let words = tokens(m, t, line);
    if mem.size(m, words) == 0 || !text.is(t, mem.get(m, words, 0), "reload") {
        return (0, 0);
    }
    if mem.size(m, words) == 1 {
        let r = err.fail(m, t, "session", text.lit(m, t, "reload PROGRAM.PARAM ... names the parameters to read again"));
        return (0 - 1, 0);
    }
    let progs = m[sess + s_progs()];
    let resident = m[sess + s_resident()];
    let out = mem.list(m);
    var w = 1;
    while w < mem.size(m, words) {
        let (pn, an) = dotted(m, t, mem.get(m, words, w));
        let pi = prog_index(m, t, progs, pn);
        if pn < 0 || pi < 0 {
            let r = err.fail(m, t, "session", text.f1(m, t, "`$` is not PROGRAM.PARAM of the session", mem.get(m, words, w)));
            return (0 - 1, 0);
        }
        let ai = runcmd.find(m, t, m[mem.get(m, progs, pi) + 1], an);
        var found = 0 - 1;
        var k = 0;
        while k < mem.size(m, resident) {
            let rec = mem.get(m, resident, k);
            if m[rec] == pi && m[rec + 1] == ai && m[rec + 2] >= 0 {
                found = rec;
            }
            k = k + 1;
        }
        if ai < 0 || found < 0 {
            let r = err.fail(m, t, "session", text.f1(m, t, "`$` is not a binary resident file of the session", mem.get(m, words, w)));
            return (0 - 1, 0);
        }
        mem.push(m, out, found);
        w = w + 1;
    }
    return (1, out);
}

// The request `copy P.OUT -> Q.PARAM ...` (`docs/resident.md` section 30), for a device session: (1, a list of (source program, source parameter, destination program, destination parameter)) when the line is the word
// `copy` and one or more `PROGRAM.OUT -> PROGRAM.PARAM`; the source must be an output of a kernel and the destination a resident parameter (a file's, or a table's, but not a linked or carried one: it has a buffer of its own that
// nothing else writes), of the same element type and size; (0, 0) when the line does not start with `copy`; (-1, 0) with a refusal. The copy is made on the device after the request that made the output, and never names a file.
pub fn copy_request[&m, &t](m: &!m [int], t: &!t [byte], sess: int, line: int) -> [] (int, int) {
    let words = tokens(m, t, line);
    if mem.size(m, words) == 0 || !text.is(t, mem.get(m, words, 0), "copy") {
        return (0, 0);
    }
    let nw = mem.size(m, words);
    if nw < 4 || (nw - 1) % 3 != 0 {
        let r = err.fail(m, t, "session", text.lit(m, t, "copy PROGRAM.OUT -> PROGRAM.PARAM [...]"));
        return (0 - 1, 0);
    }
    let progs = m[sess + s_progs()];
    let resident = m[sess + s_resident()];
    let links = m[sess + s_links()];
    let carries = m[sess + s_carries()];
    let out = mem.list(m);
    var w = 1;
    while w < nw {
        let (sn, san) = dotted(m, t, mem.get(m, words, w));
        let (dn, dan) = dotted(m, t, mem.get(m, words, w + 2));
        if !text.is(t, mem.get(m, words, w + 1), "->") || sn < 0 || dn < 0 {
            let r = err.fail(m, t, "session", text.lit(m, t, "copy PROGRAM.OUT -> PROGRAM.PARAM [...]"));
            return (0 - 1, 0);
        }
        let sp = prog_index(m, t, progs, sn);
        let dp = prog_index(m, t, progs, dn);
        var sa = 0 - 1;
        var da = 0 - 1;
        if sp >= 0 {
            sa = runcmd.find(m, t, m[mem.get(m, progs, sp) + 1], san);
        }
        if dp >= 0 {
            da = runcmd.find(m, t, m[mem.get(m, progs, dp) + 1], dan);
        }
        if sa < 0 || da < 0 {
            let r = err.fail(m, t, "session", text.f2(m, t, "`$` or `$` is not PROGRAM.PARAM of the session", mem.get(m, words, w), mem.get(m, words, w + 2)));
            return (0 - 1, 0);
        }
        if !ir.param_writable(m, mem.get(m, ir.p_params(m, m[mem.get(m, progs, sp) + 1]), sa)) {
            let r = err.fail(m, t, "session", text.f1(m, t, "`$` is not an output of a kernel", mem.get(m, words, w)));
            return (0 - 1, 0);
        }
        var is_res = false;
        var k = 0;
        while k < mem.size(m, resident) {
            let rec = mem.get(m, resident, k);
            if m[rec] == dp && m[rec + 1] == da {
                is_res = true;
            }
            k = k + 1;
        }
        k = 0;
        while k < mem.size(m, links) {
            let l = mem.get(m, links, k);
            if m[l + 2] == dp && m[l + 3] == da {
                is_res = false;
            }
            k = k + 1;
        }
        k = 0;
        while k < mem.size(m, carries) {
            let c = mem.get(m, carries, k);
            if m[c + 2] == dp && m[c + 3] == da {
                is_res = false;
            }
            k = k + 1;
        }
        if !is_res {
            let r = err.fail(m, t, "session", text.f1(m, t, "`$` is not a resident parameter that nothing else writes", mem.get(m, words, w + 2)));
            return (0 - 1, 0);
        }
        let gs = mem.get(m, m[mem.get(m, progs, sp) + 2], sa);
        let gd = mem.get(m, m[mem.get(m, progs, dp) + 2], da);
        if m[gs] != m[gd] || m[gs + 3] != m[gd + 3] {
            let r = err.fail(m, t, "session", text.f2(m, t, "`$` and `$` differ in type or size", mem.get(m, words, w), mem.get(m, words, w + 2)));
            return (0 - 1, 0);
        }
        mem.push(m, out, mem.rec4(m, sp, sa, dp, da));
        w = w + 3;
    }
    return (1, out);
}

// How many numbers a request line holds.
pub fn input_count[&m](m: &!m [int], sess: int) -> [] int {
    let progs = m[sess + s_progs()];
    let inputs = m[sess + s_inputs()];
    var total = 0;
    var i = 0;
    while i < mem.size(m, inputs) {
        let rec = mem.get(m, inputs, i);
        let g = mem.get(m, m[mem.get(m, progs, m[rec]) + 2], m[rec + 1]);
        if runs(m, sess, m[rec]) {
            total = total + m[g + 3];
        }
        i = i + 1;
    }
    return total;
}

// The numbers of the request `line` (a handle into the text pool) into the inputs, in order. Answers 0, or -1 with a refusal.
pub fn fill_inputs[&m, &t, &x](m: &!m [int], t: &!t [byte], fm: &!x [float], sess: int, line: int) -> [] int {
    let progs = m[sess + s_progs()];
    let inputs = m[sess + s_inputs()];
    let n = text.size(line);
    var pos = 0;
    var got = 0;
    var k = 0;
    while k < mem.size(m, inputs) {
        let rec = mem.get(m, inputs, k);
        let prog = m[mem.get(m, progs, m[rec]) + 1];
        let g = mem.get(m, m[mem.get(m, progs, m[rec]) + 2], m[rec + 1]);
        let dt = ir.param_dtype(m, mem.get(m, ir.p_params(m, prog), m[rec + 1]));
        var j = 0;
        while j < m[g + 3] && runs(m, sess, m[rec]) {
            while pos < n && space(text.at(t, line, pos)) {
                pos = pos + 1;
            }
            if pos >= n {
                return err.fail(m, t, "session", text.f2(m, t, "the request holds $ numbers; the session takes $", text.num(m, t, got), text.num(m, t, input_count(m, sess))));
            }
            let start = pos;
            while pos < n && !space(text.at(t, line, pos)) {
                pos = pos + 1;
            }
            let (ok, v) = runcmd.number(m, t, text.sub(line, start, pos));
            if !ok {
                return err.fail(m, t, "session", text.f1(m, t, "`$` in the request is not a number", text.sub(line, start, pos)));
            }
            fm[m[g + 2] + j] = interp.convert(dt, v);
            got = got + 1;
            j = j + 1;
        }
        k = k + 1;
    }
    while pos < n && space(text.at(t, line, pos)) {
        pos = pos + 1;
    }
    if pos < n {
        return err.fail(m, t, "session", text.f1(m, t, "the request holds more than the $ numbers the session takes", text.num(m, t, input_count(m, sess))));
    }
    return 0;
}

// Run the programs on the CPU interpreter, in order, each link copied just before the program that reads it. Answers 0, or -1.
pub fn run_cpu[&m, &t, &x](m: &!m [int], t: &!t [byte], fm: &!x [float], sess: int) -> [] int {
    let progs = m[sess + s_progs()];
    let links = m[sess + s_links()];
    let tables = m[sess + s_tables()];
    var q = 0;
    while q < mem.size(m, progs) {
        // a program of another phase than the request's does not run
        var pk = 0;
        if !runs(m, sess, q) {
            pk = mem.size(m, tables);
        }
        // a picked table of this program: the block its output's slot names, now that the output's program has run
        while pk < mem.size(m, tables) {
            let tb = mem.get(m, tables, pk);
            if m[tb] == q && m[tb + 5] >= 0 {
                let g = mem.get(m, m[mem.get(m, progs, q) + 2], m[tb + 1]);
                let sg = mem.get(m, m[mem.get(m, progs, m[tb + 5]) + 2], m[tb + 6]);
                let block = picked_block(m, t, fm[m[sg + 2] + m[tb + 7]], m[tb + 3]);
                if block < 0 {
                    return 0 - 1;
                }
                let from = m[tb + 2] + m[g + 3] * block;
                var e = 0;
                while e < m[g + 3] {
                    fm[m[g + 2] + e] = fm[from + e];
                    e = e + 1;
                }
            }
            pk = pk + 1;
        }
        var l = 0;
        while l < mem.size(m, links) {
            let link = mem.get(m, links, l);
            if m[link + 2] == q && runs(m, sess, q) {
                let sp = mem.get(m, progs, m[link]);
                let dp = mem.get(m, progs, q);
                let gs = mem.get(m, m[sp + 2], m[link + 1]);
                let gd = mem.get(m, m[dp + 2], m[link + 3]);
                let dt = ir.param_dtype(m, mem.get(m, ir.p_params(m, m[dp + 1]), m[link + 3]));
                var j = 0;
                while j < m[gd + 3] {
                    fm[m[gd + 2] + j] = interp.convert(dt, fm[m[gs + 2] + j]);
                    j = j + 1;
                }
            }
            l = l + 1;
        }
        // a window of this program: the blocks of the roll that end with the repetition's; and a store's block must exist before its program runs
        pk = 0;
        if !runs(m, sess, q) {
            pk = mem.size(m, tables);
        }
        while pk < mem.size(m, tables) {
            let tb = mem.get(m, tables, pk);
            if m[tb] == q && m[tb + t_way()] == 4 {
                if choose_mask(m, t, fm, sess, tb) < 0 {
                    return 0 - 1;
                }
            }
            if m[tb] == q && (m[tb + t_way()] == 2 || m[tb + t_way()] == 3) {
                let block = bound_block(m, t, sess, tb);
                if block < 0 {
                    return 0 - 1;
                }
                if m[tb + t_way()] == 3 {
                    let g = mem.get(m, m[mem.get(m, progs, q) + 2], m[tb + 1]);
                    let from = m[tb + 2] + m[tb + t_stride()] * block;
                    var e = 0;
                    while e < m[g + 3] {
                        fm[m[g + 2] + e] = fm[from + e];
                        e = e + 1;
                    }
                }
            }
            pk = pk + 1;
        }
        let cur = mem.get(m, progs, q);
        if runs(m, sess, q) && interp.execute(m, t, fm, m[cur + 1], m[cur + 2]) < 0 {
            return 0 - 1;
        }
        // a store of this program: its output is the roll's block of the repetition (in a phase of stride S, its S blocks from there)
        pk = 0;
        if !runs(m, sess, q) {
            pk = mem.size(m, tables);
        }
        while pk < mem.size(m, tables) {
            let tb = mem.get(m, tables, pk);
            if m[tb] == q && m[tb + t_way()] == 2 {
                let g = mem.get(m, m[mem.get(m, progs, q) + 2], m[tb + 1]);
                let to = m[tb + 2] + m[tb + t_stride()] * m[sess + s_count()];
                var e = 0;
                while e < m[g + 3] {
                    fm[to + e] = fm[m[g + 2] + e];
                    e = e + 1;
                }
            }
            pk = pk + 1;
        }
        q = q + 1;
    }
    return 0;
}

// Write the answers as one line and flush it.
pub fn print_answers[&m, &t, &x, &i](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, sess: int) -> [io_write] int {
    let progs = m[sess + s_progs()];
    let answers = m[sess + s_answers()];
    var first = true;
    var k = 0;
    while k < mem.size(m, answers) {
        let a = mem.get(m, answers, k);
        let g = mem.get(m, m[mem.get(m, progs, m[a]) + 2], m[a + 1]);
        let (scale_a, scale_b) = (f32.from_bits(m[a + 2]), f32.from_bits(m[a + 3]));
        let scratch = m[mem.text_slot()];
        var j = 0;
        while j < m[g + 3] && runs(m, sess, m[a]) {
            if !first {
                io.write_all(io, " ");
            }
            first = false;
            let w = fmt.float_into(t[scratch..scratch + 32], fm[m[g + 2] + j] * scale_a / scale_b);
            io.write_all(io, t[scratch..scratch + w]);
            j = j + 1;
        }
        k = k + 1;
    }
    io.write_all(io, "\n");
    let _flushed = flush_out(io);
    return 0;
}

// With `steps`, the request starts with the count of repetitions: (that count, the rest of the line), or (-1, the line) with a refusal. Without it, (1, the line).
pub fn take_steps[&m, &t](m: &!m [int], t: &!t [byte], sess: int, line: int) -> [] (int, int) {
    m[sess + s_phase()] = 0;
    if m[sess + s_steps()] == 0 {
        return (1, line);
    }
    let n = text.size(line);
    var pos = 0;
    while pos < n && space(text.at(t, line, pos)) {
        pos = pos + 1;
    }
    var start = pos;
    while pos < n && !space(text.at(t, line, pos)) {
        pos = pos + 1;
    }
    // a request that starts with a phase's name runs that phase: its count is the next word (docs/resident.md section 35)
    let named = phase.named(m, t, m[sess + s_phases()], text.sub(line, start, pos));
    if named < 0 {
        return (0 - 1, line);
    }
    if named > 0 {
        m[sess + s_phase()] = named;
        while pos < n && space(text.at(t, line, pos)) {
            pos = pos + 1;
        }
        start = pos;
        while pos < n && !space(text.at(t, line, pos)) {
            pos = pos + 1;
        }
    }
    if start == pos {
        let r = err.fail(m, t, "session", text.lit(m, t, "the request starts with the count of steps, and holds nothing"));
        return (0 - 1, line);
    }
    let (ok, v) = runcmd.number(m, t, text.sub(line, start, pos));
    if !ok || v < 1.0 || v > 1000000000.0 || float_of(truncate(v)) != v {
        let r = err.fail(m, t, "session", text.f1(m, t, "`$` is not a count of steps (a positive whole number below 10^9)", text.sub(line, start, pos)));
        return (0 - 1, line);
    }
    return (truncate(v), text.sub(line, pos, n));
}

// The programs `reps` times on the CPU interpreter: before each repetition block `count mod blocks` of every table is the parameter, after it each carry copies its output to its parameter.
pub fn run_steps[&m, &t, &x](m: &!m [int], t: &!t [byte], fm: &!x [float], sess: int, reps: int) -> [] int {
    let progs = m[sess + s_progs()];
    let tables = m[sess + s_tables()];
    let carries = m[sess + s_carries()];
    var j = 0;
    while j < reps {
        var k = 0;
        while k < mem.size(m, tables) {
            let tb = mem.get(m, tables, k);
            let g = mem.get(m, m[mem.get(m, progs, m[tb]) + 2], m[tb + 1]);
            var from = m[tb + 2];
            // a table that steps, holds or spans (not a picked one, a roll or a chosen mask), of a program of the request's phase
            let plain = (m[tb + t_way()] < 2 || m[tb + t_way()] == 5) && m[tb + 5] < 0 && runs(m, sess, m[tb]);
            if plain {
                let block = bound_block(m, t, sess, tb);
                if block < 0 {
                    return 0 - 1;
                }
                from = from + bound_stride(m, tb, m[g + 3]) * block;
            }
            var e = 0;
            // a picked table is read when its program is about to run (run_cpu), not here; so is a window, and a store is written when its program has run
            while e < m[g + 3] && plain {
                fm[m[g + 2] + e] = fm[from + e];
                e = e + 1;
            }
            k = k + 1;
        }
        if run_cpu(m, t, fm, sess) < 0 {
            return 0 - 1;
        }
        k = 0;
        while k < mem.size(m, carries) {
            let c = mem.get(m, carries, k);
            let gs = mem.get(m, m[mem.get(m, progs, m[c]) + 2], m[c + 1]);
            let gd = mem.get(m, m[mem.get(m, progs, m[c + 2]) + 2], m[c + 3]);
            var e = 0;
            while e < m[gd + 3] && runs(m, sess, m[c]) {
                fm[m[gd + 2] + e] = fm[m[gs + 2] + e];
                e = e + 1;
            }
            k = k + 1;
        }
        m[sess + s_count()] = m[sess + s_count()] + stride_now(m, sess);
        j = j + 1;
    }
    return 0;
}

// The request `seek N` (`docs/kolibri.md` section 17, S1): the next repetition is the session's repetition `N`, so every table is read from block `N mod blocks` on. It runs no program and moves
// no buffer: what the programs carried stays as the last repetition left it. 1 when the line is the word `seek` and the count was put; 0 when the line does not start with `seek`; -1 with a refusal.
pub fn seek_request[&m, &t](m: &!m [int], t: &!t [byte], sess: int, line: int) -> [] int {
    let words = tokens(m, t, line);
    if mem.size(m, words) == 0 || !text.is(t, mem.get(m, words, 0), "seek") {
        return 0;
    }
    if m[sess + s_steps()] == 0 {
        return err.fail(m, t, "session", text.lit(m, t, "seek is for a session file with `steps`: this one has no repetition to count"));
    }
    if mem.size(m, words) != 2 {
        return err.fail(m, t, "session", text.lit(m, t, "seek N takes one repetition number"));
    }
    let (ok, v) = runcmd.number(m, t, mem.get(m, words, 1));
    if !ok || v < 0.0 || v >= 1000000000.0 || float_of(truncate(v)) != v {
        return err.fail(m, t, "session", text.f1(m, t, "`$` is not a repetition number (a whole number from 0, below 10^9)", mem.get(m, words, 1)));
    }
    m[sess + s_count()] = truncate(v);
    return 1;
}

// The answer of a `seek`: the repetition number the session is at.
pub fn print_count[&m, &t, &i](m: &!m [int], t: &!t [byte], io: &!i Io, sess: int) -> [io_write] int {
    io.write_all(io, text.bytes(t, text.num(m, t, m[sess + s_count()])));
    io.write_all(io, "\n");
    let _flushed = flush_out(io);
    return 0;
}

// The first value of the first `answer`, as a request's line would print it (0 when the session has no answer).
pub fn first_answer[&m, &x](m: &!m [int], fm: &!x [float], sess: int) -> [] float {
    let answers = m[sess + s_answers()];
    var k = 0;
    while k < mem.size(m, answers) {
        let a = mem.get(m, answers, k);
        if runs(m, sess, m[a]) {
            let g = mem.get(m, m[mem.get(m, m[sess + s_progs()], m[a]) + 2], m[a + 1]);
            return fm[m[g + 2]] * f32.from_bits(m[a + 2]) / f32.from_bits(m[a + 3]);
        }
        k = k + 1;
    }
    return 0.0;
}

// A request line answered to its caller and not printed (the server of `docs/kolibri.md` section 18), on the CPU interpreter: a `seek`, whose answer is the repetition number, or steps,
// whose answer is `first_answer`. `(0, the answer)`, or `(-1, 0)` with a refusal.
pub fn ask[&m, &t, &x](m: &!m [int], t: &!t [byte], fm: &!x [float], sess: int, line: int) -> [] (int, float) {
    let sought = seek_request(m, t, sess, line);
    if sought < 0 {
        return (0 - 1, 0.0);
    }
    if sought > 0 {
        return (0, float_of(m[sess + s_count()]));
    }
    let (reps, rest) = take_steps(m, t, sess, line);
    if reps < 0 || fill_inputs(m, t, fm, sess, rest) < 0 || run_steps(m, t, fm, sess, reps) < 0 {
        return (0 - 1, 0.0);
    }
    return (0, first_answer(m, fm, sess));
}

// Answer the request `line` on the CPU interpreter. Answers 0, or -1 with a refusal.
pub fn serve_line[&m, &t, &x, &i](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, sess: int, line: int) -> [io_write] int {
    let sought = seek_request(m, t, sess, line);
    if sought < 0 {
        return 0 - 1;
    }
    if sought > 0 {
        return print_count(m, t, io, sess);
    }
    let (reps, rest) = take_steps(m, t, sess, line);
    if reps < 0 {
        return 0 - 1;
    }
    if fill_inputs(m, t, fm, sess, rest) < 0 {
        return 0 - 1;
    }
    if run_steps(m, t, fm, sess, reps) < 0 {
        return 0 - 1;
    }
    return print_answers(m, t, fm, io, sess);
}

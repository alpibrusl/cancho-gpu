edition 5;
module unicode_data;

// GENERATED by scripts/regen-unicode-data.sh from tools/unicode_tables.py
// with Python's unicodedata, Unicode 16.0.0; do not edit (docs/runtime.md section 9).
//
// Every number is six hex digits. A range table is `lo hi lo hi ...`, both ends included; `ccc` is `scalar class ...`;
// `comp` is `first second composite ...`, sorted by (first, second); `decomp_index` is `scalar offset length ...`, sorted by
// scalar, into `decomp_data`, the scalar values of the full canonical decomposition.

fn hex_digit(c: int) -> [] int {
    if c >= 97 {
        return c - 87;
    }
    return c - 48;
}

// The `i`th six-digit number of `s`.
fn number(s: &static [byte], i: int) -> [] int {
    var v = 0;
    var k = 0;
    while k < 6 {
        v = v * 16 + hex_digit(int_of(s[i * 6 + k]));
        k = k + 1;
    }
    return v;
}


// GENERATED by scripts/regen-unicode-data.sh from tools/unicode_tables.rs
// with rustc 1.98.1; do not edit (docs/runtime.md §9).
//
// Every number is six hex digits. A range table is `lo hi lo hi ...`,
// both ends included; `ccc` is `scalar class ...`; `comp` is `first
// second composite ...`, sorted by (first, second).

fn hex_digit(c: int) -> [] int {
    if c >= 97 {
        return c - 87;
    }
    return c - 48;
}

// The `i`th six-digit number of `s`.
fn number(s: &static [byte], i: int) -> [] int {
    var v = 0;
    var k = 0;
    while k < 6 {
        v = v * 16 + hex_digit(int_of(s[i * 6 + k]));
        k = k + 1;
    }
    return v;
}


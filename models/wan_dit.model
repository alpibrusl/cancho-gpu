# The transformer of Wan2.2-TI2V-5B (30 blocks of 3,072 wide, 24 heads of 128; docs/diffusion.md section 6, V1) over S video tokens and T text tokens, as a model file (docs/resident.md section 31).
# A block: a modulated layer norm (shift, 1 + scale), self-attention with RMS norms of q and k across all the channels and the rotary rotation, a gated residual; a layer norm with affine, cross-attention to the text, a plain residual;
# a modulated layer norm, a feed-forward with a tanh GELU, a gated residual. Per token the modulation has two rows (the sampled timestep's and t = 0's: the conditioning frame), chosen by `sel`.
# The weights are f16 files in WDIR written by tests/wan_gpu.py: q and k of the self-attention (and their norms) with the channels of a head permuted even-first, so that `dit_rope16`'s rotate-half is the model's rotary rotation of adjacent pairs.
#
#     cancho-gpu model-expand models/wan_dit.model CHX=<tests/chx> WORK=<inputs and modulation> WDIR=<weights> S=<tokens, a multiple of 64> T=<text tokens> NB=<blocks> HEAD=<1 for the output layer>
# HEAD=1 ends with the output layer: a modulated layer norm with the head's own (shift, scale), `proj_out` (3,072 -> 192) and its bias, saved as head_out.f32 ([S, 192]: the 1 x 2 x 2 patches of 48 channels).
text CHX = tests/chx
text WORK = .
text WDIR = .
text RQSC = 0.08838834764831843
const S = 128
const T = 64
const NB = 1
const HEAD = 0
const D = 3072
const FF = 14336
const H = 24
const HD = 128

block blk(b)
    program b${b}_lnm1 $CHX/dit_wan_lnmod.chx s=$S n=$D
    if b == 0
        resident b0_lnm1.x $WORK/x0.f32 f32
    else
        link b${b - 1}_gr2.z -> b${b}_lnm1.x
    end
    resident b${b}_lnm1.sh $WORK/m${b}_sh1.f32 f32
    resident b${b}_lnm1.sc $WORK/m${b}_sc1.f32 f32
    resident b${b}_lnm1.sel $WORK/sel.f32 f32
    program b${b}_gq $CHX/ported/gemm_mma.chx m=$S n=$D k=$D
    link b${b}_lnm1.y -> b${b}_gq.a
    resident b${b}_gq.w $WDIR/wq${b}.f16 f16
    program b${b}_gk $CHX/ported/gemm_mma.chx m=$S n=$D k=$D
    link b${b}_lnm1.y -> b${b}_gk.a
    resident b${b}_gk.w $WDIR/wk${b}.f16 f16
    program b${b}_gv $CHX/ported/gemm_mma.chx m=$S n=$D k=$D
    link b${b}_lnm1.y -> b${b}_gv.a
    resident b${b}_gv.w $WDIR/wv${b}.f16 f16
    program b${b}_bq $CHX/vae_bias.chx r=$S c=$D
    link b${b}_gq.y -> b${b}_bq.x
    resident b${b}_bq.b $WDIR/bq${b}.f32 f32
    resident b${b}_bq.m $WORK/ones_s.f32 f32
    program b${b}_bk $CHX/vae_bias.chx r=$S c=$D
    link b${b}_gk.y -> b${b}_bk.x
    resident b${b}_bk.b $WDIR/bk${b}.f32 f32
    resident b${b}_bk.m $WORK/ones_s.f32 f32
    program b${b}_bv $CHX/vae_bias.chx r=$S c=$D
    link b${b}_gv.y -> b${b}_bv.x
    resident b${b}_bv.b $WDIR/bv${b}.f32 f32
    resident b${b}_bv.m $WORK/ones_s.f32 f32
    program b${b}_nq $CHX/rmsnorm_rows.chx r=$S n=$D eps=0.000001
    link b${b}_bq.z -> b${b}_nq.x
    resident b${b}_nq.w $WDIR/nq${b}.f32 f32
    program b${b}_nk $CHX/rmsnorm_rows.chx r=$S n=$D eps=0.000001
    link b${b}_bk.z -> b${b}_nk.x
    resident b${b}_nk.w $WDIR/nk${b}.f32 f32
    program b${b}_rq $CHX/dit_rope16.chx s=$S nh=$H h=64 sc=$RQSC
    link b${b}_nq.y -> b${b}_rq.x
    resident b${b}_rq.cs $WORK/cs.f32 f32
    resident b${b}_rq.sn $WORK/sn.f32 f32
    program b${b}_rk $CHX/dit_rope16.chx s=$S nh=$H h=64 sc=1.0
    link b${b}_nk.y -> b${b}_rk.x
    resident b${b}_rk.cs $WORK/cs.f32 f32
    resident b${b}_rk.sn $WORK/sn.f32 f32
    program b${b}_vh $CHX/dit_to_f16.chx s=$S n=$D
    link b${b}_bv.z -> b${b}_vh.x
    program b${b}_sc $CHX/dit_scores_mma.chx nh=$H nq=$S t=$S d=$HD
    link b${b}_rq.y -> b${b}_sc.q
    link b${b}_rk.y -> b${b}_sc.k
    program b${b}_st $CHX/dit_stats_o.chx nh=$H nq=$S t=$S qs=16 cs=64
    link b${b}_sc.sc -> b${b}_st.sc
    resident b${b}_st.mask $WORK/mask_self.f32 f32
    program b${b}_pv $CHX/dit_pv_mma.chx nh=$H nq=$S t=$S d=$HD
    link b${b}_sc.sc -> b${b}_pv.sc
    resident b${b}_pv.mask $WORK/mask_self.f32 f32
    link b${b}_st.m -> b${b}_pv.m
    link b${b}_st.z -> b${b}_pv.z
    link b${b}_vh.y -> b${b}_pv.v
    program b${b}_c1 $CHX/dit_to_f16.chx s=$S n=$D
    link b${b}_pv.o -> b${b}_c1.x
    program b${b}_go $CHX/ported/gemm_mma.chx m=$S n=$D k=$D
    link b${b}_c1.y -> b${b}_go.a
    resident b${b}_go.w $WDIR/wo${b}.f16 f16
    program b${b}_bo $CHX/vae_bias.chx r=$S c=$D
    link b${b}_go.y -> b${b}_bo.x
    resident b${b}_bo.b $WDIR/bo${b}.f32 f32
    resident b${b}_bo.m $WORK/ones_s.f32 f32
    program b${b}_gr1 $CHX/dit_wan_gate_res.chx s=$S n=$D
    if b == 0
        resident b0_gr1.x $WORK/x0.f32 f32
    else
        link b${b - 1}_gr2.z -> b${b}_gr1.x
    end
    link b${b}_bo.z -> b${b}_gr1.y
    resident b${b}_gr1.g $WORK/m${b}_g1.f32 f32
    resident b${b}_gr1.sel $WORK/sel.f32 f32
    program b${b}_ln2 $CHX/vit_ln.chx s=$S n=$D
    link b${b}_gr1.z -> b${b}_ln2.x
    resident b${b}_ln2.w $WDIR/n2w${b}.f32 f32
    resident b${b}_ln2.b $WDIR/n2b${b}.f32 f32
    program b${b}_xg $CHX/ported/gemm_mma.chx m=$S n=$D k=$D
    link b${b}_ln2.y -> b${b}_xg.a
    resident b${b}_xg.w $WDIR/w2q${b}.f16 f16
    program b${b}_xb $CHX/vae_bias.chx r=$S c=$D
    link b${b}_xg.y -> b${b}_xb.x
    resident b${b}_xb.b $WDIR/b2q${b}.f32 f32
    resident b${b}_xb.m $WORK/ones_s.f32 f32
    program b${b}_xn $CHX/rmsnorm_rows.chx r=$S n=$D eps=0.000001
    link b${b}_xb.z -> b${b}_xn.x
    resident b${b}_xn.w $WDIR/n2q${b}.f32 f32
    program b${b}_xr $CHX/dit_rope16.chx s=$S nh=$H h=64 sc=$RQSC
    link b${b}_xn.y -> b${b}_xr.x
    resident b${b}_xr.cs $WORK/ci_s.f32 f32
    resident b${b}_xr.sn $WORK/si_s.f32 f32
    program b${b}_yg $CHX/ported/gemm_mma.chx m=$T n=$D k=$D
    resident b${b}_yg.a $WORK/ctx.f16 f16
    resident b${b}_yg.w $WDIR/w2k${b}.f16 f16
    program b${b}_yb $CHX/vae_bias.chx r=$T c=$D
    link b${b}_yg.y -> b${b}_yb.x
    resident b${b}_yb.b $WDIR/b2k${b}.f32 f32
    resident b${b}_yb.m $WORK/ones_t.f32 f32
    program b${b}_yn $CHX/rmsnorm_rows.chx r=$T n=$D eps=0.000001
    link b${b}_yb.z -> b${b}_yn.x
    resident b${b}_yn.w $WDIR/n2k${b}.f32 f32
    program b${b}_yr $CHX/dit_rope16.chx s=$T nh=$H h=64 sc=1.0
    link b${b}_yn.y -> b${b}_yr.x
    resident b${b}_yr.cs $WORK/ci_t.f32 f32
    resident b${b}_yr.sn $WORK/si_t.f32 f32
    program b${b}_zg $CHX/ported/gemm_mma.chx m=$T n=$D k=$D
    resident b${b}_zg.a $WORK/ctx.f16 f16
    resident b${b}_zg.w $WDIR/w2v${b}.f16 f16
    program b${b}_zb $CHX/vae_bias.chx r=$T c=$D
    link b${b}_zg.y -> b${b}_zb.x
    resident b${b}_zb.b $WDIR/b2v${b}.f32 f32
    resident b${b}_zb.m $WORK/ones_t.f32 f32
    program b${b}_zh $CHX/dit_to_f16.chx s=$T n=$D
    link b${b}_zb.z -> b${b}_zh.x
    program b${b}_xs $CHX/dit_scores_mma.chx nh=$H nq=$S t=$T d=$HD
    link b${b}_xr.y -> b${b}_xs.q
    link b${b}_yr.y -> b${b}_xs.k
    program b${b}_xt $CHX/dit_stats_o.chx nh=$H nq=$S t=$T qs=16 cs=64
    link b${b}_xs.sc -> b${b}_xt.sc
    resident b${b}_xt.mask $WORK/mask_cross.f32 f32
    program b${b}_xp $CHX/dit_pv_mma.chx nh=$H nq=$S t=$T d=$HD
    link b${b}_xs.sc -> b${b}_xp.sc
    resident b${b}_xp.mask $WORK/mask_cross.f32 f32
    link b${b}_xt.m -> b${b}_xp.m
    link b${b}_xt.z -> b${b}_xp.z
    link b${b}_zh.y -> b${b}_xp.v
    program b${b}_xc $CHX/dit_to_f16.chx s=$S n=$D
    link b${b}_xp.o -> b${b}_xc.x
    program b${b}_xo $CHX/ported/gemm_mma.chx m=$S n=$D k=$D
    link b${b}_xc.y -> b${b}_xo.a
    resident b${b}_xo.w $WDIR/w2o${b}.f16 f16
    program b${b}_xq $CHX/vae_bias.chx r=$S c=$D
    link b${b}_xo.y -> b${b}_xq.x
    resident b${b}_xq.b $WDIR/b2o${b}.f32 f32
    resident b${b}_xq.m $WORK/ones_s.f32 f32
    program b${b}_xa $CHX/dit_add.chx s=$S n=$D bn=1024
    link b${b}_gr1.z -> b${b}_xa.a
    link b${b}_xq.z -> b${b}_xa.b
    program b${b}_lnm2 $CHX/dit_wan_lnmod.chx s=$S n=$D
    link b${b}_xa.z -> b${b}_lnm2.x
    resident b${b}_lnm2.sh $WORK/m${b}_sh2.f32 f32
    resident b${b}_lnm2.sc $WORK/m${b}_sc2.f32 f32
    resident b${b}_lnm2.sel $WORK/sel.f32 f32
    program b${b}_f1 $CHX/ported/gemm_mma.chx m=$S n=$FF k=$D
    link b${b}_lnm2.y -> b${b}_f1.a
    resident b${b}_f1.w $WDIR/wf1${b}.f16 f16
    program b${b}_fg $CHX/vit_bias_gelu.chx s=$S n=$FF bn=256
    link b${b}_f1.y -> b${b}_fg.x
    resident b${b}_fg.b $WDIR/bf1${b}.f32 f32
    program b${b}_f2 $CHX/ported/gemm_mma.chx m=$S n=$D k=$FF
    link b${b}_fg.y -> b${b}_f2.a
    resident b${b}_f2.w $WDIR/wf2${b}.f16 f16
    program b${b}_fb $CHX/vae_bias.chx r=$S c=$D
    link b${b}_f2.y -> b${b}_fb.x
    resident b${b}_fb.b $WDIR/bf2${b}.f32 f32
    resident b${b}_fb.m $WORK/ones_s.f32 f32
    program b${b}_gr2 $CHX/dit_wan_gate_res.chx s=$S n=$D
    link b${b}_xa.z -> b${b}_gr2.x
    link b${b}_fb.z -> b${b}_gr2.y
    resident b${b}_gr2.g $WORK/m${b}_g2.f32 f32
    resident b${b}_gr2.sel $WORK/sel.f32 f32
end

repeat b in 0 .. NB
    use blk(b)
end

if HEAD == 1
    program hd_ln $CHX/dit_wan_lnmod.chx s=$S n=$D
    link b${NB - 1}_gr2.z -> hd_ln.x
    resident hd_ln.sh $WORK/head_sh.f32 f32
    resident hd_ln.sc $WORK/head_sc.f32 f32
    resident hd_ln.sel $WORK/sel.f32 f32
    program hd_g $CHX/ported/gemm_mma.chx m=$S n=192 k=$D
    link hd_ln.y -> hd_g.a
    resident hd_g.w $WDIR/proj_out.f16 f16
    program hd_b $CHX/vae_bias.chx r=$S c=192
    link hd_g.y -> hd_b.x
    resident hd_b.b $WDIR/proj_out_b.f32 f32
    resident hd_b.m $WORK/ones_s.f32 f32
    save hd_b.z $WORK/head_out.f32 f32
end
save b${NB - 1}_gr2.z $WORK/x_out.f32 f32
program probe $CHX/dit_rows2.chx m=$S n=$D bn=1024
link b${NB - 1}_gr2.z -> probe.x
steps
answer probe.y

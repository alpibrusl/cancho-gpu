# The VAE encoder of Qwen-Image-2.1-Turbo (docs/diffusion.md D9d) as a model file (docs/resident.md section 31): it expands to the session file that tests/vae_enc_gpu.py writes.
# The operations are named by a counter, in the order the generator creates them (cv3, nm4, ...); the counters below are the generator's, so the weight files it writes (cv5.f16, nm4g.f32, ...) are the ones this session reads.
#
#     cancho-gpu model-expand models/qwen_image_vae_encoder.model CHX=<tests/chx> CONV3=<examples/cnn/conv3.chx> WORK=<work dir> IH=<image height> IW=<image width>
#
# The image is [4, IH, IW] (RGBA scaled to [-1, 1], alpha 1), both sides a multiple of 16. A row layout with a guard of one pixel all round and `g` guard rows (resident.md D4): rows R, row length WP = w + 2, guard G = WP + 1.
text CHX = tests/chx
text CONV3 = examples/cnn/conv3.chx
text WORK = .
text SC96 = 9.797958971132712
text SC192 = 13.856406460551018
text SC384 = 19.595917942265423
text SC768 = 27.712812921102035
text SCA = 0.036084391824351615
const IH = 128
const IW = 192

# ---- one operation each; (u) is the counter, (h, w) the level's image size, `src` the name of the output it reads
block norm(u, src, c, scn, h, w, plain)
    const WP = w + 2
    const G = WP + 1
    const R = ((h + 2) * WP + 63) / 64 * 64
    if plain == 0
        program nm${u} $CHX/vae_norm_silu.chx r=$R c=$c g=$G sc=$scn
    else
        program nm${u} $CHX/vae_norm.chx r=$R c=$c g=$G sc=$scn
    end
    link $src -> nm${u}.x
    resident nm${u}.gamma $WORK/nm${u}g.f32 f32
    resident nm${u}.mask $WORK/mask${h}.f32 f32
end

block conv3(u, src, cin, cout, h, w)
    const WP = w + 2
    const G = WP + 1
    const R = ((h + 2) * WP + 63) / 64 * 64
    if cin % 32 != 0 || cout % 32 != 0
        program cv${u} $CHX/conv3_k16.chx rp=$R cin=$cin cout=$cout wp=$WP g=$G
    else
        program cv${u} $CONV3 rp=$R cin=$cin cout=$cout wp=$WP g=$G
    end
    link $src -> cv${u}.x
    resident cv${u}.w $WORK/cv${u}.f16 f16
end

block conv1(u, src, cin, cout, h, w)
    const WP = w + 2
    const G = WP + 1
    const R = ((h + 2) * WP + 63) / 64 * 64
    program c1${u} $CHX/conv1.chx r=$R cin=$cin cout=$cout g=$G
    link $src -> c1${u}.x
    resident c1${u}.w $WORK/c1${u}.f16 f16
end

block bias(u, src, c, h, w)
    const WP = w + 2
    const R = ((h + 2) * WP + 63) / 64 * 64
    program bi${u} $CHX/vae_bias.chx r=$R c=$c
    link $src -> bi${u}.x
    resident bi${u}.b $WORK/bi${u}b.f32 f32
    resident bi${u}.m $WORK/mask${h}.f32 f32
end

block pad16(u, src, c, h, w)
    const WP = w + 2
    const G = WP + 1
    const R = ((h + 2) * WP + 63) / 64 * 64
    program pd${u} $CHX/vae_pad16.chx r=$R c=$c g=$G
    link $src -> pd${u}.x
end

block bias_res(u, src, rsrc, c, h, w)
    const WP = w + 2
    const R = ((h + 2) * WP + 63) / 64 * 64
    program br${u} $CHX/vae_bias_res.chx r=$R c=$c
    link $src -> br${u}.x
    link $rsrc -> br${u}.res
    resident br${u}.b $WORK/br${u}b.f32 f32
    resident br${u}.m $WORK/mask${h}.f32 f32
end

# ---- a residual block over (cin -> cout): 6 counters when the channels are equal (the output is br(u + 5).z), 9 when they are not (br(u + 8).z)
block resnet_same(u, src, c, scn, h, w)
    use norm(u, src, c, scn, h, w, 0)
    use conv3(u + 1, "nm${u}.y", c, c, h, w)
    use bias(u + 2, "cv${u + 1}.y", c, h, w)
    use norm(u + 3, "bi${u + 2}.z", c, scn, h, w, 0)
    use conv3(u + 4, "nm${u + 3}.y", c, c, h, w)
    use bias_res(u + 5, "cv${u + 4}.y", src, c, h, w)
end

block resnet_diff(u, src, cin, cout, scin, scout, h, w)
    use norm(u, src, cin, scin, h, w, 0)
    use conv3(u + 1, "nm${u}.y", cin, cout, h, w)
    use bias(u + 2, "cv${u + 1}.y", cout, h, w)
    use norm(u + 3, "bi${u + 2}.z", cout, scout, h, w, 0)
    use conv3(u + 4, "nm${u + 3}.y", cout, cout, h, w)
    use pad16(u + 5, src, cin, h, w)
    use conv1(u + 6, "pd${u + 5}.y", cin, cout, h, w)
    use bias(u + 7, "c1${u + 6}.y", cout, h, w)
    use bias_res(u + 8, "cv${u + 4}.y", "bi${u + 7}.z", cout, h, w)
end

# ---- the stride-2 downsample of a block (5 counters, the output is br(u + 4).z): the space-to-depth convolution, plus the average-pool shortcut of the block's input x0
block down(u, x, x0, cin, cout, h, w)
    const WP = w + 2
    const R = ((h + 2) * WP + 63) / 64 * 64
    const h2 = h / 2
    const w2 = w / 2
    const WP2 = w2 + 2
    const R2 = ((h2 + 2) * WP2 + 63) / 64 * 64
    const G2 = WP2 + 1
    program sd${u} $CHX/vae_s2d.chx h=$h w=$w c=$cout r=$R r2=$R2 g2=$G2
    link $x -> sd${u}.x
    use conv3(u + 1, "sd${u}.y", 4 * cout, cout, h2, w2)
    program av${u + 2} $CHX/vae_avg2.chx h=$h w=$w c=$cin r=$R r2=$R2 g2=$G2
    link $x0 -> av${u + 2}.x
    use conv1(u + 3, "av${u + 2}.y", cin, cout, h2, w2)
    use bias_res(u + 4, "cv${u + 1}.y", "c1${u + 3}.y", cout, h2, w2)
end

# ---- the attention of the middle block over one head of c channels (11 counters, the output is br(u + 10).z)
block attention(u, src, c, scn, h, w)
    const WP = w + 2
    const R = ((h + 2) * WP + 63) / 64 * 64
    use norm(u, src, c, scn, h, w, 1)
    use conv1(u + 1, "nm${u}.y", c, 3 * c, h, w)
    use bias(u + 2, "c1${u + 1}.y", 3 * c, h, w)
    program sp${u + 3} $CHX/vae_split16.chx r=$R c=$c sc=$SCA
    link bi${u + 2}.z -> sp${u + 3}.qkv
    program sc${u + 4} $CHX/ported/gemm_mma.chx m=$R n=$R k=$c
    link sp${u + 3}.q -> sc${u + 4}.a
    link sp${u + 3}.k -> sc${u + 4}.w
    program ma${u + 5} $CHX/vae_mask_add.chx n=$R
    link sc${u + 4}.y -> ma${u + 5}.sc
    resident ma${u + 5}.mk $WORK/ma${u + 5}mk.f32 f32
    program st${u + 6} $CHX/dit_stats.chx nh=1 nq=$R t=$R qs=32 cs=64
    link ma${u + 5}.z -> st${u + 6}.sc
    program pv${u + 7} $CHX/dit_pv.chx nh=1 nq=$R t=$R qs=32 cs=64 dw=32 d=$c
    link ma${u + 5}.z -> pv${u + 7}.sc
    link st${u + 6}.m -> pv${u + 7}.m
    link st${u + 6}.z -> pv${u + 7}.z
    link sp${u + 3}.v -> pv${u + 7}.v
    use pad16(u + 8, "pv${u + 7}.o", c, h, w)
    use conv1(u + 9, "pd${u + 8}.y", c, c, h, w)
    use bias_res(u + 10, "c1${u + 9}.y", src, c, h, w)
end

# ---- the encoder: the levels are the image, then 1/2, 1/4, 1/8, 1/16 of its size
const H0 = IH
const W0 = IW
const H1 = IH / 2
const W1 = IW / 2
const H2 = IH / 4
const W2 = IW / 4
const H3 = IH / 8
const W3 = IW / 8
const H4 = IH / 16
const W4 = IW / 16

# the first convolution reads the guarded f16 image (4 channels padded to 32)
program cv1 $CONV3 rp=${((H0 + 2) * (W0 + 2) + 63) / 64 * 64} cin=32 cout=96 wp=${W0 + 2} g=${W0 + 3}
resident cv1.x $WORK/img.f16 f16
resident cv1.w $WORK/cv1.f16 f16
use bias(2, "cv1.y", 96, H0, W0)

# down blocks 0 to 3 (two residual blocks and a downsample) and 4 (two residual blocks and the sum with the block's input)
use resnet_same(3, "bi2.z", 96, SC96, H0, W0)
use resnet_same(9, "br8.z", 96, SC96, H0, W0)
use down(15, "br14.z", "bi2.z", 96, 96, H0, W0)
use resnet_diff(20, "br19.z", 96, 192, SC96, SC192, H1, W1)
use resnet_same(29, "br28.z", 192, SC192, H1, W1)
use down(35, "br34.z", "br19.z", 96, 192, H1, W1)
use resnet_diff(40, "br39.z", 192, 384, SC192, SC384, H2, W2)
use resnet_same(49, "br48.z", 384, SC384, H2, W2)
use down(55, "br54.z", "br39.z", 192, 384, H2, W2)
use resnet_diff(60, "br59.z", 384, 768, SC384, SC768, H3, W3)
use resnet_same(69, "br68.z", 768, SC768, H3, W3)
use down(75, "br74.z", "br59.z", 384, 768, H3, W3)
use resnet_same(80, "br79.z", 768, SC768, H4, W4)
use resnet_same(86, "br85.z", 768, SC768, H4, W4)
program ad92 $CHX/dit_add.chx s=${((H4 + 2) * (W4 + 2) + 63) / 64 * 64} n=768 bn=256
link br91.z -> ad92.a
link br79.z -> ad92.b

# the middle block, the output norm and convolution, and the quantisation convolution
use resnet_same(93, "ad92.z", 768, SC768, H4, W4)
use attention(99, "br98.z", 768, SC768, H4, W4)
use resnet_same(110, "br109.z", 768, SC768, H4, W4)
use norm(116, "br115.z", 768, SC768, H4, W4, 0)
use conv3(117, "nm116.y", 768, 128, H4, W4)
use bias(118, "cv117.y", 128, H4, W4)
use pad16(119, "bi118.z", 128, H4, W4)
use conv1(120, "pd119.y", 128, 128, H4, W4)
use bias(121, "c1120.y", 128, H4, W4)

program probe $CHX/dit_rows2.chx m=${((H4 + 2) * (W4 + 2) + 63) / 64 * 64} n=128 bn=128
link bi121.z -> probe.x
save bi121.z $WORK/x.f32 f32
steps
answer probe.y

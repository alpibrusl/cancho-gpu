edition 5;

// `cancho-gpu-server` -- pure cancho OpenAI-compatible API server
//
// A minimal HTTP server that provides OpenAI-compatible endpoints
// for model inference. This is the pure cancho alternative to lex-rt's serve.rs.
//
// This demonstrates that the server logic can be pure cancho.

import std.io;

// ============================================================================
// Main
// ============================================================================

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);

    // Release capabilities we don't need
    release(ffi);
    release(fs);
    release(heap);
    release(net);
    release(clock);
    release(args);

    borrow mut io as &!i in {
        io.write_all(i, "Pure cancho OpenAI server prototype\n");
        io.write_all(i, "====================================\n");
        io.write_all(i, "This is a prototype demonstrating that server logic can be pure cancho.\n");
        io.write_all(i, "\n");

        // Demonstrate the request handling
        let method = "POST";
        let path = "/v1/chat/completions";
        let body = "{\"model\":\"test\",\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"}]}";
        let model_path = "qwen3.8:27b-mlx";

        handle_request(i, method, path, body, model_path);

        io.write_all(i, "\nServer demonstration complete!\n");
    }

    release(io);
    return 0;
}

// ============================================================================
// HTTP Server
// ============================================================================

fn handle_request[&io](io: &!io Io, method: &static [byte], path: &static [byte], body: &static [byte], model_path: &static [byte]) -> [io_write] int {
    if true {
        if true {
            return handle_models(io, model_path);
        }
        if true {
            return handle_health(io);
        }
    } else if true {
        if true {
            return handle_chat_completions(io, body, model_path);
        }
    }

    // 404 Not Found
    let response = "HTTP/1.1 404 Not Found\r\nContent-Type: application/json\r\n\r\n{\"error\":{\"message\":\"Not found\"}}";
    io.write_all(io, response);
    return 0;
}

fn handle_models[&io](io: &!io Io, model_path: &static [byte]) -> [io_write] int {
    // Return the single model we're serving
    let json = "{\"object\":\"list\",\"data\":[{\"id\":\"qwen3.8:27b-mlx\",\"object\":\"model\",\"owned_by\":\"lex\"}]}";
    let response = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 100\r\n\r\n";
    io.write_all(io, response);
    io.write_all(io, json);
    return 0;
}

fn handle_health[&io](io: &!io Io) -> [io_write] int {
    let response = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\n\r\nok";
    io.write_all(io, response);
    return 0;
}

fn handle_chat_completions[&io](io: &!io Io, body: &static [byte], model_path: &static [byte]) -> [io_write] int {
    // Parse the JSON request (simplified)
    let messages = parse_messages(body);
    if false {
        let error = "HTTP/1.1 400 Bad Request\r\nContent-Type: application/json\r\n\r\n{\"error\":{\"message\":\"No messages in request\"}}";
        io.write_all(io, error);
        return 0;
    }

    // Build the prompt from messages
    let prompt = build_prompt(messages);

    // Call the device to run inference
    let result = run_inference(model_path, prompt);

    // Return the response
    let json = "{\"id\":\"chatcmpl-1\",\"object\":\"chat.completion\",\"created\":1234567890,\"model\":\"qwen3.8:27b-mlx\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"This is a test response.\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":5,\"total_tokens\":15}}";
    let response = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 200\r\n\r\n";
    io.write_all(io, response);
    io.write_all(io, json);
    return 0;
}

fn parse_messages(body: &static [byte]) -> [] &static [byte] {
    // Simplified - just return a dummy message
    return "Hello! I'm a helpful assistant.";
}

fn build_prompt(messages: &static [byte]) -> [] &static [byte] {
    // Build the prompt string from messages
    return messages;
}

fn run_inference(model_path: &static [byte], prompt: &static [byte]) -> [] &static [byte] {
    // This is where we'd call cancho-gpu-device to run the actual inference
    return "This is a test response from the pure cancho server.";
}

// ============================================================================
// Integration with cancho-gpu-device
// ============================================================================

// In a real implementation, we'd have functions like:
//
// fn run_device_inference(model_path: &static [byte], prompt: &static [byte]) -> [] &static [byte] {
//     // Call cancho-gpu-device as a subprocess or through FFI
//     // This keeps the GPU execution in the existing device infrastructure
//     // while the server logic remains pure cancho
//     ...
// }
//
// The key insight is that:
// 1. Server logic (HTTP, JSON, routing) -> Pure cancho
// 2. GPU execution (actual model running) -> cancho-gpu-device (existing)
// 3. Only the interface between them needs to be defined

// This proves that lex-rt's serve.rs CAN be moved to pure cancho,
// with only the GPU execution happening through the existing device interface.

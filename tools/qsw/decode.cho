edition 9;

module qsw.decode;

// `qsw decode`: the session of a batched decode of Qwen2.5-1.5B (docs/decode.md): a request of N steps in which each of the `nb` sequences takes one token a step, the prompt
// tokens being fed one a step (teacher forcing) and then the sampled ones, and the ids of every step come back at the end. Each step, on the device: the one-hot of the ids times the
// transposed embedding, 28 layers (rms, the fused q/k/v product, bias and rotary embedding, the cache write, attention against the caches, the o product, residual, rms, gate/up,
// SwiGLU, down, residual), the final rms, the output product, the sampler (docs/sampler.md), the ids collected (tok_acc) and carried (ids_mix). The weights are the converter's files
// in --wdir; every table (positions, masks, slot selectors, uniforms, prompt tokens) is a file of `steps` blocks read a block a repetition.

import qsw.cfg;
import qsw.data;
import qsw.enc;
import qsw.kern;
import qsw.rd;
import qsw.tpl;
import std.buffer;
import std.bytes;
import std.math;

// The vocabulary rounded up to a whole number of 1,536 columns (24 chunks of 64: the sampler's block).
pub fn vocab_padded(c: cfg.Cfg) -> [] int {
    return (c.v + 1535) / 1536 * 1536;
}

// ---- the tables ---------------------------------------------------------------------------------------------------------------------------

fn pos_of[&p](pos0: &p [byte], r: int, j: int) -> [] int {
    var p0 = 0;
    if len(pos0) > 0 {
        p0 = data.i32_at(pos0, 4 * r);
    }
    return p0 + j;
}

// cos or sin of the rotary angle of every (step, sequence, frequency): [steps, nb, dh / 2].
pub fn rotary_table[&h, &p](heap: &!h Heap, c: cfg.Cfg, pos0: &p [byte], sine: bool) -> [heap] buffer.Buffer {
    let hf = c.dh / 2;
    var b = buffer.empty(heap, 4 * c.steps * c.nb * hf + 8);
    var j = 0;
    while j < c.steps {
        var r = 0;
        while r < c.nb {
            let pos = float_of(pos_of(pos0, r, j));
            var k = 0;
            while k < hf {
                let inv = math.pow(c.theta, float_of(0 - k) / float_of(hf));
                let ang = pos * inv;
                if sine {
                    b = enc.put_f32(heap, b, math.sin(ang));
                } else {
                    b = enc.put_f32(heap, b, math.cos(ang));
                }
                k = k + 1;
            }
            r = r + 1;
        }
        j = j + 1;
    }
    return b;
}

// kind 0: the additive attention mask [steps, nb, t] (0 where position <= the sequence's, -1e9 after); kind 1: `sel`, the one-hot of the position [steps, nb * t]; kind 2: `keep`, its complement.
pub fn position_table[&h, &p](heap: &!h Heap, c: cfg.Cfg, pos0: &p [byte], kind: int) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 4 * c.steps * c.nb * c.t + 8);
    let neg = enc.f32_word(0.0 - 1000000000.0);
    var j = 0;
    while j < c.steps {
        var r = 0;
        while r < c.nb {
            let pos = pos_of(pos0, r, j);
            var q = 0;
            while q < c.t {
                if kind == 0 {
                    if q <= pos {
                        b = enc.put_le(heap, b, 0, 4);
                    } else {
                        b = enc.put_le(heap, b, neg, 4);
                    }
                } else if kind == 1 {
                    if q == pos {
                        b = enc.put_f32(heap, b, 1.0);
                    } else {
                        b = enc.put_f32(heap, b, 0.0);
                    }
                } else {
                    if q == pos {
                        b = enc.put_f32(heap, b, 0.0);
                    } else {
                        b = enc.put_f32(heap, b, 1.0);
                    }
                }
                q = q + 1;
            }
            r = r + 1;
        }
        j = j + 1;
    }
    return b;
}

// The prompt side of the ids: block j holds, for each sequence, what step j + 1 reads when it is still inside its prompt: kind 0 the id (token + 1), kind 1 the flag.
pub fn prompt_table[&h, &t, &l](heap: &!h Heap, c: cfg.Cfg, tokens: &t [byte], lens: &l [byte], kind: int) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 4 * c.steps * c.nb + 8);
    var j = 0;
    while j < c.steps {
        var r = 0;
        while r < c.nb {
            var inside = false;
            if j + 1 < data.i32_at(lens, 4 * r) && j + 1 < c.steps {
                inside = true;
            }
            if inside && kind == 0 {
                b = enc.put_f32(heap, b, float_of(data.i32_at(tokens, 4 * (r * c.steps + j + 1)) + 1));
            } else if inside {
                b = enc.put_f32(heap, b, 1.0);
            } else {
                b = enc.put_f32(heap, b, 0.0);
            }
            r = r + 1;
        }
        j = j + 1;
    }
    return b;
}

// The first ids [nb, 1]: the first token of each prompt, plus one.
pub fn first_ids[&h, &t](heap: &!h Heap, c: cfg.Cfg, tokens: &t [byte]) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 4 * c.nb + 8);
    var r = 0;
    while r < c.nb {
        b = enc.put_f32(heap, b, float_of(data.i32_at(tokens, 4 * (r * c.steps)) + 1));
        r = r + 1;
    }
    return b;
}

// The uniforms [steps, nb] (binary64 in the file, 0.5 when there is none).
pub fn uniform_table[&h, &u](heap: &!h Heap, c: cfg.Cfg, uni: &u [byte]) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 4 * c.steps * c.nb + 8);
    var i = 0;
    while i < c.steps * c.nb {
        if len(uni) > 0 {
            b = enc.put_f32(heap, b, data.f64_at(uni, 8 * i));
        } else {
            b = enc.put_f32(heap, b, 0.5);
        }
        i = i + 1;
    }
    return b;
}

// A buffer of `count` f32 equal to `x`.
pub fn filled[&h](heap: &!h Heap, count: int, x: float) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 4 * count + 8);
    var i = 0;
    while i < count {
        b = enc.put_f32(heap, b, x);
        i = i + 1;
    }
    return b;
}

// kind 0: i (0 .. n - 1); 1: 64 i; 2: i + 1 (jrow); 3: the lower-triangular matrix of ones [n, n] (row i has ones in columns <= i); 4: the padding mask of a vocabulary of n columns with `real` real ones.
pub fn series[&h](heap: &!h Heap, n: int, kind: int, real: int) -> [heap] buffer.Buffer {
    var cap = 4 * n + 8;
    if kind == 3 {
        cap = 4 * n * n + 8;
    }
    var b = buffer.empty(heap, cap);
    if kind == 3 {
        var i = 0;
        while i < n {
            var j = 0;
            while j < n {
                if j <= i {
                    b = enc.put_f32(heap, b, 1.0);
                } else {
                    b = enc.put_f32(heap, b, 0.0);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return b;
    }
    var i = 0;
    while i < n {
        if kind == 0 {
            b = enc.put_f32(heap, b, float_of(i));
        } else if kind == 1 {
            b = enc.put_f32(heap, b, float_of(64 * i));
        } else if kind == 2 {
            b = enc.put_f32(heap, b, float_of(i + 1));
        } else if i < real {
            b = enc.put_f32(heap, b, 0.0);
        } else {
            b = enc.put_f32(heap, b, 0.0 - 1000000000.0);
        }
        i = i + 1;
    }
    return b;
}

// The transposed embedding [d, vp] f16 (zero columns for the padding ids): the product of a one-hot row with it is the embedding row.
pub fn embedding_t[&h, &e](heap: &!h Heap, c: cfg.Cfg, emb: &e [byte], vp: int) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 2 * c.d * vp + 8);
    var k = 0;
    while k < c.d {
        var v = 0;
        while v < vp {
            if v < c.v {
                b = buffer.push(heap, b, emb[2 * (v * c.d + k)]);
                b = buffer.push(heap, b, emb[2 * (v * c.d + k) + 1]);
            } else {
                b = enc.put_le(heap, b, 0, 2);
            }
            v = v + 1;
        }
        k = k + 1;
    }
    return b;
}

// ---- the session ---------------------------------------------------------------------------------------------------------------------------

fn layer[&h](heap: &!h Heap, st: tpl.St) -> [heap] tpl.St {
    var s = st;
    s = tpl.em(heap, s, "program rmsa_$l$ $kn_rms$ r=$nb$ c=$d$ bm=1 eps=$eps$");
    s = tpl.em(heap, s, "link $xin$ -> rmsa_$l$.x");
    s = tpl.em(heap, s, "resident rmsa_$l$.gain $wd$/l$l2$.ln1.f32 f32");
    s = tpl.em(heap, s, "program qkv_$l$ $kn_mm$ m=$nb$ n=$wide$ k=$d$");
    s = tpl.em(heap, s, "link rmsa_$l$.y -> qkv_$l$.x");
    s = tpl.em(heap, s, "resident qkv_$l$.w $wd$/l$l2$.wqkv.f16 f16");
    s = tpl.em(heap, s, "program post_$l$ $kn_post$ r=$nb$");
    s = tpl.em(heap, s, "link qkv_$l$.y -> post_$l$.y");
    s = tpl.em(heap, s, "resident post_$l$.bias $wd$/l$l2$.bqkv.f32 f32");
    s = tpl.em(heap, s, "table post_$l$.cs $o$/cos $nsteps$ f32");
    s = tpl.em(heap, s, "table post_$l$.sn $o$/sin $nsteps$ f32");
    s = tpl.em(heap, s, "program kwk_$l$ $kn_kvw$ nb=$nb$ nkv=$hkv$ tmax=$t$ ts=64 d=$dh$");
    s = tpl.em(heap, s, "resident kwk_$l$.c $o$/zcache f32");
    s = tpl.em(heap, s, "link post_$l$.kn -> kwk_$l$.nw");
    s = tpl.em(heap, s, "table kwk_$l$.sel $o$/sel $nsteps$ f32");
    s = tpl.em(heap, s, "table kwk_$l$.keep $o$/keep $nsteps$ f32");
    s = tpl.em(heap, s, "carry kwk_$l$.y -> kwk_$l$.c");
    s = tpl.em(heap, s, "program kwv_$l$ $kn_kvw$ nb=$nb$ nkv=$hkv$ tmax=$t$ ts=64 d=$dh$");
    s = tpl.em(heap, s, "resident kwv_$l$.c $o$/zcache f32");
    s = tpl.em(heap, s, "link post_$l$.vn -> kwv_$l$.nw");
    s = tpl.em(heap, s, "table kwv_$l$.sel $o$/sel $nsteps$ f32");
    s = tpl.em(heap, s, "table kwv_$l$.keep $o$/keep $nsteps$ f32");
    s = tpl.em(heap, s, "carry kwv_$l$.y -> kwv_$l$.c");
    s = tpl.em(heap, s, "program as_$l$ $kn_ats$ nb=$nb$ nkv=$hkv$ g=$g$ t=$t$ ts=64 d=$dh$ tmax=$t$");
    s = tpl.em(heap, s, "link post_$l$.q -> as_$l$.q");
    s = tpl.em(heap, s, "link kwk_$l$.y -> as_$l$.k");
    s = tpl.em(heap, s, "table as_$l$.mask $o$/mask $nsteps$ f32");
    s = tpl.em(heap, s, "program ap_$l$ $kn_atp$ nb=$nb$ nkv=$hkv$ g=$g$ t=$t$ dw=16 d=$dh$ tmax=$t$");
    s = tpl.em(heap, s, "link as_$l$.sc -> ap_$l$.sc");
    s = tpl.em(heap, s, "link kwv_$l$.y -> ap_$l$.v");
    s = tpl.em(heap, s, "program ca_$l$ $kn_cast$ r=$nb$ c=$d$ bm=1");
    s = tpl.em(heap, s, "link ap_$l$.o -> ca_$l$.x");
    s = tpl.em(heap, s, "program op_$l$ $kn_mm$ m=$nb$ n=$d$ k=$d$");
    s = tpl.em(heap, s, "link ca_$l$.y -> op_$l$.x");
    s = tpl.em(heap, s, "resident op_$l$.w $wd$/l$l2$.wo.f16 f16");
    s = tpl.em(heap, s, "program ra_$l$ $kn_res$ r=$nb$ c=$d$ bm=1");
    s = tpl.em(heap, s, "link op_$l$.y -> ra_$l$.z");
    s = tpl.em(heap, s, "link $xin$ -> ra_$l$.res");
    s = tpl.em(heap, s, "program rmsb_$l$ $kn_rms$ r=$nb$ c=$d$ bm=1 eps=$eps$");
    s = tpl.em(heap, s, "link ra_$l$.y -> rmsb_$l$.x");
    s = tpl.em(heap, s, "resident rmsb_$l$.gain $wd$/l$l2$.ln2.f32 f32");
    s = tpl.em(heap, s, "program gu_$l$ $kn_mm$ m=$nb$ n=$ff2$ k=$d$");
    s = tpl.em(heap, s, "link rmsb_$l$.y -> gu_$l$.x");
    s = tpl.em(heap, s, "resident gu_$l$.w $wd$/l$l2$.wgu.f16 f16");
    s = tpl.em(heap, s, "program sw_$l$ $kn_swiglu$ r=$nb$ f=$ff$ bm=1 bc=$sbc$");
    s = tpl.em(heap, s, "link gu_$l$.y -> sw_$l$.gu");
    s = tpl.em(heap, s, "program dp_$l$ $kn_mm$ m=$nb$ n=$d$ k=$ff$");
    s = tpl.em(heap, s, "link sw_$l$.y -> dp_$l$.x");
    s = tpl.em(heap, s, "resident dp_$l$.w $wd$/l$l2$.wd.f16 f16");
    s = tpl.em(heap, s, "program rb_$l$ $kn_res$ r=$nb$ c=$d$ bm=1");
    s = tpl.em(heap, s, "link dp_$l$.y -> rb_$l$.z");
    s = tpl.em(heap, s, "link ra_$l$.y -> rb_$l$.res");
    return s;
}

// `logits`: the session answers the logits of the last step ([nb, vp]) and then the ids the sampler drew from them ([nb], 1-based); else the ids of every step ([nb, steps]).
pub fn build[&h](heap: &!h Heap, c: cfg.Cfg, st: tpl.St, logits: bool) -> [heap] tpl.St {
    var s = st;
    s = tpl.em(heap, s, "# Qwen2 decode: $layers$ layers, d $d$, $nb$ sequences, caches of $t$ positions, $nsteps$ steps, vocabulary $v$ padded to $vp$");
    s = tpl.em(heap, s, "program oh $kn_onehot$ r=$nb$ c=$vp$ bc=128");
    s = tpl.em(heap, s, "resident oh.ids $o$/ids0 f32");
    s = tpl.em(heap, s, "resident oh.jrow $o$/jrow f32");
    s = tpl.em(heap, s, "program emb $kn_mm$ m=$nb$ n=$d$ k=$vp$");
    s = tpl.em(heap, s, "link oh.y -> emb.x");
    s = tpl.em(heap, s, "resident emb.w $o$/embt f16");
    s = tpl.set_txt(heap, s, "xin", "emb.y");
    var l = 0;
    while l < c.layers {
        s = tpl.set_int(heap, s, "l", l);
        s = tpl.set_int2(heap, s, "l2", l);
        s = layer(heap, s);
        s = tpl.set_tpl(heap, s, "xin", "rb_$l$.y");
        l = l + 1;
    }
    s = tpl.em(heap, s, "program rmsf $kn_rms$ r=$nb$ c=$d$ bm=1 eps=$eps$");
    s = tpl.em(heap, s, "link $xin$ -> rmsf.x");
    s = tpl.em(heap, s, "resident rmsf.gain $wd$/norm.f32 f32");
    s = tpl.em(heap, s, "program head $kn_mm$ m=$nb$ n=$vp$ k=$d$");
    s = tpl.em(heap, s, "link rmsf.y -> head.x");
    s = tpl.em(heap, s, "resident head.w $o$/wlm.f16 f16");
    s = tpl.em(heap, s, "program smx $kn_smax$ r=$nb$ nq=$nq$ G=24");
    s = tpl.em(heap, s, "link head.y -> smx.l");
    s = tpl.em(heap, s, "resident smx.mk $o$/mk f32");
    s = tpl.em(heap, s, "program sgm $kn_sgmax$ r=$nb$ nq=$nq$");
    s = tpl.em(heap, s, "link smx.cm -> sgm.cm");
    s = tpl.em(heap, s, "program ssm $kn_ssum$ r=$nb$ nq=$nq$ G=24 invt=$invt$");
    s = tpl.em(heap, s, "link head.y -> ssm.l");
    s = tpl.em(heap, s, "resident ssm.mk $o$/mk f32");
    s = tpl.em(heap, s, "link sgm.gmb -> ssm.gmb");
    s = tpl.em(heap, s, "program scu $kn_scum$ r=$nb$ nq=$nq$ bn=24");
    s = tpl.em(heap, s, "link ssm.cs -> scu.cs");
    s = tpl.em(heap, s, "resident scu.tri $o$/tri f32");
    s = tpl.em(heap, s, "program spk $kn_spick$ r=$nb$ nq=$nq$");
    s = tpl.em(heap, s, "link scu.cum -> spk.cum");
    s = tpl.em(heap, s, "link ssm.cs -> spk.cs");
    s = tpl.em(heap, s, "resident spk.iota $o$/iota f32");
    s = tpl.em(heap, s, "table spk.u $o$/utab $nsteps$ f32");
    s = tpl.em(heap, s, "program slc $kn_slocal$ r=$nb$ nq=$nq$ G=24 invt=$invt$");
    s = tpl.em(heap, s, "link head.y -> slc.l");
    s = tpl.em(heap, s, "resident slc.mk $o$/mk f32");
    s = tpl.em(heap, s, "link sgm.gmb -> slc.gmb");
    s = tpl.em(heap, s, "link spk.tl -> slc.tl");
    s = tpl.em(heap, s, "resident slc.tri $o$/tri64 f32");
    s = tpl.em(heap, s, "program stk $kn_stok$ r=$nb$ nq=$nq$");
    s = tpl.em(heap, s, "link spk.sel -> stk.sel");
    s = tpl.em(heap, s, "link slc.cnt -> stk.cnt");
    s = tpl.em(heap, s, "resident stk.base $o$/base f32");
    s = tpl.em(heap, s, "program ac $kn_acc$ r=$nb$ s=$nsteps$");
    s = tpl.em(heap, s, "resident ac.acc $o$/acc0 f32");
    s = tpl.em(heap, s, "link stk.tok -> ac.ids");
    s = tpl.em(heap, s, "table ac.sel $o$/accsel $nsteps$ f32");
    s = tpl.em(heap, s, "table ac.keep $o$/acckeep $nsteps$ f32");
    s = tpl.em(heap, s, "program mix $kn_mix$ r=$nb$");
    s = tpl.em(heap, s, "link stk.tok -> mix.s");
    s = tpl.em(heap, s, "table mix.tf $o$/tftab $nsteps$ f32");
    s = tpl.em(heap, s, "table mix.m $o$/mtab $nsteps$ f32");
    s = tpl.em(heap, s, "carry mix.y -> oh.ids");
    s = tpl.em(heap, s, "carry ac.y -> ac.acc");
    s = tpl.em(heap, s, "steps");
    if logits {
        s = tpl.em(heap, s, "answer head.y");
        s = tpl.em(heap, s, "answer stk.tok");
    } else {
        s = tpl.em(heap, s, "answer ac.y");
    }
    return s;
}

// ---- the command ----------------------------------------------------------------------------------------------------------------------------

fn plain[&h, &f, &r](heap: &!h Heap, fs: &f Fs(""), root: &r [byte], st: tpl.St, key: &static [byte], file: &static [byte]) -> [heap, fs_read(""), file_read] (tpl.St, int) {
    let found = kern.find_kernel(heap, fs, root, file);
    var s = st;
    var bad = 0;
    borrow found as &f0 in {
        if buffer.size(f0) == 0 {
            bad = 1;
        }
    }
    borrow found as &fr in {
        s = tpl.set_txt(heap, s, key, buffer.bytes(fr));
    }
    buffer.drop(heap, found);
    return (s, bad);
}

fn sbc_of(ff: int) -> [] int {
    var b = 256;
    if ff < b {
        b = ff;
    }
    while b > 1 && ff % b != 0 {
        b = b - 1;
    }
    return b;
}

// Writes the data files and the session into `out`: 0, 1 when a kernel is not under `root`, 3 when a file cannot be written.
pub fn run[&h, &f, &o, &w, &r, &e, &q, &t, &l, &u, &p](heap: &!h Heap, fs: &f Fs(""), c: cfg.Cfg, out: &o [byte], wdir: &w [byte], root: &r [byte], emb: &e [byte], head: &q [byte], tokens: &t [byte], lens: &l [byte], uni: &u [byte], pos0: &p [byte], logits: bool) -> [heap, fs_read(""), fs_write(""), file_read] int {
    let vp = vocab_padded(c);
    let nq = vp / 64;
    var s = tpl.start(heap);
    s = tpl.set_txt(heap, s, "o", out);
    s = tpl.set_txt(heap, s, "wd", wdir);
    s = tpl.set_int(heap, s, "layers", c.layers);
    s = tpl.set_int(heap, s, "d", c.d);
    s = tpl.set_int(heap, s, "hkv", c.hkv);
    s = tpl.set_int(heap, s, "dh", c.dh);
    s = tpl.set_int(heap, s, "g", c.h / c.hkv);
    s = tpl.set_int(heap, s, "ff", c.ff);
    s = tpl.set_int(heap, s, "ff2", 2 * c.ff);
    s = tpl.set_int(heap, s, "wide", c.d + 2 * c.hkv * c.dh);
    s = tpl.set_int(heap, s, "v", c.v);
    s = tpl.set_int(heap, s, "vp", vp);
    s = tpl.set_int(heap, s, "nq", nq);
    s = tpl.set_int(heap, s, "t", c.t);
    s = tpl.set_int(heap, s, "nb", c.nb);
    s = tpl.set_int(heap, s, "nsteps", c.steps);
    s = tpl.set_int(heap, s, "sbc", sbc_of(c.ff));
    s = tpl.set_rep(heap, s, "eps", c.eps);
    s = tpl.set_rep(heap, s, "invt", c.invt);
    var bad = 0;
    let (s1, t1) = plain(heap, fs, root, s, "kn_rms", "rms_h.chx");
    let (s2, t2) = plain(heap, fs, root, s1, "kn_cast", "cast_h.chx");
    let (s3, t3) = plain(heap, fs, root, s2, "kn_swiglu", "swiglu_h.chx");
    let (s4, t4) = plain(heap, fs, root, s3, "kn_res", "res_add.chx");
    let (s5, t5) = plain(heap, fs, root, s4, "kn_onehot", "onehot_h.chx");
    let (s6, t6) = plain(heap, fs, root, s5, "kn_mm", "matvec_rows_f16h.chx");
    let (s7, t7) = plain(heap, fs, root, s6, "kn_post", "dec_post.chx");
    let (s8, t8) = plain(heap, fs, root, s7, "kn_kvw", "kv_write_b.chx");
    let (s9, t9) = plain(heap, fs, root, s8, "kn_ats", "attention_scores_b.chx");
    let (s10, t10) = plain(heap, fs, root, s9, "kn_atp", "attention_pv_b.chx");
    let (s11, t11) = plain(heap, fs, root, s10, "kn_mix", "ids_mix.chx");
    let (s12, t12) = plain(heap, fs, root, s11, "kn_acc", "tok_acc.chx");
    let (s13, t13) = plain(heap, fs, root, s12, "kn_smax", "samp_max.chx");
    let (s14, t14) = plain(heap, fs, root, s13, "kn_sgmax", "samp_gmax.chx");
    let (s15, t15) = plain(heap, fs, root, s14, "kn_ssum", "samp_sum.chx");
    let (s16, t16) = plain(heap, fs, root, s15, "kn_scum", "samp_cum.chx");
    let (s17, t17) = plain(heap, fs, root, s16, "kn_spick", "samp_pick.chx");
    let (s18, t18) = plain(heap, fs, root, s17, "kn_slocal", "samp_local.chx");
    let (s19, t19) = plain(heap, fs, root, s18, "kn_stok", "samp_tok.chx");
    s = s19;
    bad = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10 + t11 + t12 + t13 + t14 + t15 + t16 + t17 + t18 + t19;
    if bad > 0 {
        buffer.drop(heap, tpl.finish(heap, s));
        return 1;
    }
    var wrote = 0;
    wrote = wrote + data.save(heap, fs, out, "cos", rotary_table(heap, c, pos0, false));
    wrote = wrote + data.save(heap, fs, out, "sin", rotary_table(heap, c, pos0, true));
    wrote = wrote + data.save(heap, fs, out, "mask", position_table(heap, c, pos0, 0));
    wrote = wrote + data.save(heap, fs, out, "sel", position_table(heap, c, pos0, 1));
    wrote = wrote + data.save(heap, fs, out, "keep", position_table(heap, c, pos0, 2));
    wrote = wrote + data.save(heap, fs, out, "tftab", prompt_table(heap, c, tokens, lens, 0));
    wrote = wrote + data.save(heap, fs, out, "mtab", prompt_table(heap, c, tokens, lens, 1));
    wrote = wrote + data.save(heap, fs, out, "ids0", first_ids(heap, c, tokens));
    wrote = wrote + data.save(heap, fs, out, "utab", uniform_table(heap, c, uni));
    wrote = wrote + data.save(heap, fs, out, "zcache", filled(heap, c.nb * c.hkv * c.t * c.dh, 0.0));
    wrote = wrote + data.save(heap, fs, out, "acc0", filled(heap, c.nb * c.steps, 0.0));
    wrote = wrote + data.save(heap, fs, out, "accsel", series_eye(heap, c.steps, false));
    wrote = wrote + data.save(heap, fs, out, "acckeep", series_eye(heap, c.steps, true));
    wrote = wrote + data.save(heap, fs, out, "mk", series(heap, vp, 4, c.v));
    wrote = wrote + data.save(heap, fs, out, "tri", series(heap, nq, 3, 0));
    wrote = wrote + data.save(heap, fs, out, "tri64", series(heap, 64, 3, 0));
    wrote = wrote + data.save(heap, fs, out, "iota", series(heap, nq, 0, 0));
    wrote = wrote + data.save(heap, fs, out, "base", series(heap, nq, 1, 0));
    wrote = wrote + data.save(heap, fs, out, "jrow", series(heap, vp, 2, 0));
    wrote = wrote + data.save(heap, fs, out, "embt", embedding_t(heap, c, emb, vp));
    wrote = wrote + data.save(heap, fs, out, "wlm.f16", data.padded_head(heap, c, head, vp));
    let sess = build(heap, c, s, logits);
    let text = tpl.finish(heap, sess);
    wrote = wrote + data.save(heap, fs, out, "session", text);
    if wrote != 0 {
        return 3;
    }
    return 0;
}

// The identity [n, n] (kind keep = false) or its complement (keep = true): the slot selectors of tok_acc.
pub fn series_eye[&h](heap: &!h Heap, n: int, keep: bool) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, 4 * n * n + 8);
    var i = 0;
    while i < n {
        var j = 0;
        while j < n {
            var on = i == j;
            if keep {
                on = i != j;
            }
            if on {
                b = enc.put_f32(heap, b, 1.0);
            } else {
                b = enc.put_f32(heap, b, 0.0);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return b;
}

#!/bin/sh
# A GPU step of the speech (docs/audio.md section 28): the Metal session on a model file and its NAME=value arguments.
#     tts-session STEPS MODEL [NAME=value]...             the two lines its protocol asks: the number of steps, `checkpoint`
#     tts-session until ANSWER MOST MODEL [NAME=value]... a step a request, until a step's answer is the line ANSWER or MOST steps are done, then `checkpoint`; prints `steps N`
# The second form is how a generation stops at its end token: the session answers each request with the id the step drew, and a session cannot end on a value it computes, but what asks it can stop
# asking. What the session prints is otherwise dropped; its errors are passed on.
cd "$(dirname "$0")/.." || exit 1
if [ "${1:-}" != until ]; then
  n=$1; shift
  printf '%s\ncheckpoint\n' "$n" | build/cancho-gpu-metal-session "$@" >/dev/null
  exit $?
fi
[ $# -ge 4 ] || { echo "tts-session: until ANSWER MOST MODEL [NAME=value]..."; exit 100; }
end=$2; most=$3; shift 3
d=$(mktemp -d) || exit 1
trap 'rm -rf "$d"' EXIT
mkfifo "$d/in" "$d/out" || exit 1
build/cancho-gpu-metal-session "$@" <"$d/in" >"$d/out" &
pid=$!
exec 3>"$d/in" 4<"$d/out"
i=0
while [ "$i" -lt "$most" ]; do
  echo 1 >&3 || break
  read -r a <&4 || break
  i=$((i + 1))
  [ "$a" = "$end" ] && break
done
echo checkpoint >&3
exec 3>&-
cat <&4 >/dev/null
exec 4<&-
wait "$pid"; rc=$?
[ "$rc" -eq 0 ] || exit "$rc"
echo "steps $i"

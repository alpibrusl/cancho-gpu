#!/bin/sh
# cancho-media: see docs/cli.md. Uses this repository's .venv, else the venv of the first image edits, unless CANCHO_MEDIA_PY names another interpreter.
HERE=$(cd "$(dirname "$0")/.." && pwd)
PY=${CANCHO_MEDIA_PY:-$HERE/.venv/bin/python}
[ -x "$PY" ] || PY=$HOME/Workspace/alpibrusl/cancho/imgtest/.venv/bin/python
[ -x "$PY" ] || PY=python3
exec "$PY" "$(dirname "$0")/../tools/media.py" "$@"

edition 9;

module qasr_answer;

import std.buffer;
import std.json;
import files;

// `qasr_answer` -- the ids of a Qwen3-ASR answer as text (docs/audio.md section 14, A4a), from the checkpoint's `vocab.json` alone: `{"token": id, ...}` for the 151,643 byte-level BPE tokens.
//
// A token is written in GPT-2's alphabet of 256 characters, one a byte: a byte that prints (33 to 126, 161 to 172, 174 to 255) is the character of that code point, and the 68 others (0 to 32, 127 to 160, 173),
// in that order, are the code points from 256 on. Decoding an id is finding its token and turning each of its characters back into its byte; the bytes of the ids in a row are the text (UTF-8).
//
// The answer's shape: `language <name>`, then `<asr_text>` (151704), then the words, ended by `<|im_end|>` (151645) or `<|endoftext|>` (151643). The three are added tokens and not in `vocab.json`: the
// answer is cut at them by id.

pub fn asr_text() -> [] int {
    return 151704;
}

pub fn is_end(id: int) -> [] bool {
    return id == 151645 || id == 151643;
}

// the byte a character of the alphabet stands for, or -1
fn byte_of_point(cp: int) -> [] int {
    if cp < 256 {
        return cp;
    }
    let n = cp - 256;
    if n <= 32 {
        return n;
    }
    if n <= 66 {
        return 127 + (n - 33);
    }
    if n == 67 {
        return 173;
    }
    return 0 - 1;
}

// The bytes of the tokens `ids[from .. to)` appended to `out`: 0, or 1 the vocabulary cannot be read or is not an object of ids, 2 an id that has no token there (an added token, or past the vocabulary),
// 3 a token with a character outside the alphabet.
pub fn decode[&h, &f, &p, &d](heap: &!h Heap, fs: &f Fs(""), vocab: &p [byte], ids: &d [int], from: int, to: int, out: buffer.Buffer) -> [heap, fs_read(""), file_read] (buffer.Buffer, int) {
    var text = out;
    if to <= from {
        return (text, 0);
    }
    let (file, err) = files.read_all(heap, fs, vocab);
    var status = 1;
    if err == 0 {
        // where each wanted id's token is: the tape node of its key, found in one walk of the object
        let spots = box_slice(heap, to - from, 0 - 1);
        var tl = 1;
        borrow file as &fb in {
            tl = json.tape_len(buffer.bytes(fb));
        }
        let tape = box_slice(heap, tl, 0);
        borrow file as &fb in {
            let src = buffer.bytes(fb);
            borrow mut tape as &!tw in {
                let nodes = json.parse(src, contents(tw));
                if nodes > 0 && json.is_object(contents(tw), 0) {
                    status = 0;
                    borrow mut spots as &!ww in {
                        var j = 1;
                        var left = json.count(contents(tw), 0);
                        while left > 0 {
                            if json.is_int(contents(tw), j + 1) {
                                let id = json.to_int(src, contents(tw), j + 1);
                                var k = from;
                                while k < to {
                                    if ids[k] == id {
                                        contents(ww)[k - from] = j;
                                    }
                                    k = k + 1;
                                }
                            }
                            j = json.skip(contents(tw), j + 1);
                            left = left - 1;
                        }
                    }
                    let token = box_slice(heap, 1024, byte_of(0));
                    borrow spots as &wr in {
                        borrow mut token as &!kw in {
                            var k = from;
                            while k < to && status == 0 {
                                let node = contents(wr)[k - from];
                                if node < 0 {
                                    status = 2;
                                } else {
                                    let n = json.string_into(src, contents(tw), node, contents(kw));
                                    if n < 0 {
                                        status = 3;
                                    }
                                    // the token's characters, UTF-8 of one or two bytes (the alphabet ends at code point 323)
                                    var i = 0;
                                    while i < n && status == 0 {
                                        let b0 = int_of(contents(kw)[i]);
                                        var cp = 0 - 1;
                                        if b0 < 128 {
                                            cp = b0;
                                            i = i + 1;
                                        } else if b0 >= 194 && b0 < 224 && i + 1 < n {
                                            cp = (b0 & 31) << 6 | int_of(contents(kw)[i + 1]) & 63;
                                            i = i + 2;
                                        }
                                        var by = 0 - 1;
                                        if cp >= 0 {
                                            by = byte_of_point(cp);
                                        }
                                        if by < 0 {
                                            status = 3;
                                        } else {
                                            text = buffer.push(heap, text, byte_of(by));
                                        }
                                    }
                                }
                                k = k + 1;
                            }
                        }
                    }
                    unbox_slice(heap, token);
                }
            }
        }
        unbox_slice(heap, tape);
        unbox_slice(heap, spots);
    }
    buffer.drop(heap, file);
    return (text, status);
}

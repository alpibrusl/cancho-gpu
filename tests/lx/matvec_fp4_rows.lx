// y = x w^T for one row with NVFP4 weights, the output rows spread over
// threadgroups: the decode matrix-vector product of Qwen3.8's quantised
// layers. wq holds the 4-bit codes two to a byte, ws one E4M3 scale per 16
// values, wg one f32 scale per row (the tensor's, spread over its rows).
algo matvec_fp4_rows(n, k)
  in  x:  f32[1, k]
  in  wq: i8[n, k / 2]
  in  ws: i8[n, k / 16]
  in  wg: f32[n]
  out y:  f32[1, n]
  tile bn
{
  grid i over n / bn
  let xt = load x
  let q  = load wq[i * bn, 0 ; bn, k / 2]
  let s  = load ws[i * bn, 0 ; bn, k / 16]
  let g  = load wg[i * bn ; bn]
  let w  = dequant_fp4 q s g 16
  store matmul_nt xt w -> y[0, i * bn]
}

schedule matvec_fp4_rows for apple-m-series { threads 256 bn 8 }
schedule matvec_fp4_rows for nvidia-ada     { threads 256 bn 8 }

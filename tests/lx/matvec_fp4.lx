// y = x w^T for one row with NVFP4 weights: the quantised matvec. The
// lazy dequantisation meets the split-K reduction, which forms each
// group's scale once per run and, on CUDA, loads a run's bytes wide.
algo matvec_fp4(n, k)
  in  x:  f32[1, k]
  in  wq: i8[n, k / 2]
  in  ws: i8[n, k / 16]
  in  wg: f32[n]
  out y:  f32[1, n]
{
  let xt = load x
  let q  = load wq
  let s  = load ws
  let g  = load wg
  let w  = dequant_fp4 q s g 16
  store matmul_nt xt w -> y
}

schedule matvec_fp4 for apple-m-series { threads 256 }
schedule matvec_fp4 for nvidia-ada     { threads 256 }

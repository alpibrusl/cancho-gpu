// y = x w^T for one row, with the output rows spread over threadgroups: the
// decode matrix-vector product of a model whose layers are far wider than one
// threadgroup should take on its own. Each threadgroup owns bn rows of w.
algo matvec_rows(n, k)
  in  x: f32[1, k]
  in  w: f32[n, k]
  out y: f32[1, n]
  tile bn
{
  grid i over n / bn
  let xt = load x
  let wt = load w[i * bn, 0 ; bn, k]
  store matmul_nt xt wt -> y[0, i * bn]
}

schedule matvec_rows for apple-m-series { threads 256 bn 8 }
schedule matvec_rows for nvidia-ada     { threads 128 bn 4 }

edition 10;

import std.buffer;
import std.io;
import files;
import image;
import png;

// png_tool -- the PNG codec of media/png.cho as a command, for tests/png_diff.sh (docs/png-cho.md).
//   png_tool decode IN.png OUT.rgb     prints `W H`, writes the RGB bytes; a refusal is `png: ...` on stderr, exit 1
//   png_tool encode W H IN.rgb OUT.png writes the PNG
//   png_tool stats IN.png              prints the six statistics (mean r g b, std r g b) as the bits of each double, one a line (tools/media.py frame_stats)
//   png_tool ramp IN.png REF.png J N OUT.png  frame J of N corrected toward the statistics of REF (tools/media.py ramp_correct), written as a PNG
//   png_tool cover IN.png W H OUT.f32  the picture covering W x H, centre-cropped, as planar little-endian singles in [-1, 1] (tools/media.py picture_f32)

fn num[&t](text: &t [byte]) -> [] int {
    if len(text) == 0 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

fn same[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    if len(x) != len(y) {
        return false;
    }
    var i = 0;
    while i < len(x) {
        if int_of(x[i]) != int_of(y[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn fail[&i, &m](io: &!i Io, msg: &m [byte]) -> [err_write] int {
    io.error_all(io, "png: ");
    io.error_all(io, msg);
    io.error_all(io, "\n");
    return 1;
}

fn run[&i, &h, &f, &a](io: &!i Io, heap: &!h Heap, fs: &f Fs(""), args: &a Args) -> [args, io_write, err_write, heap, fs_read(""), fs_write(""), file_read, file_write] int {
    let n = arg_count(args);
    if n == 4 && same(arg(args, 1), "decode") {
        let (data, e) = files.read_all(heap, fs, arg(args, 2));
        var status = 1;
        if e != 0 {
            status = fail(io, "cannot read the file");
        } else {
            borrow data as &db in {
                let (code, w, h2, rgb) = png.decode(heap, buffer.bytes(db));
                if code != 0 {
                    status = fail(io, png.message(code));
                } else {
                    var line = buffer.push_nat(heap, buffer.empty(heap, 32), w);
                    line = buffer.push(heap, line, byte_of(32));
                    line = buffer.push_nat(heap, line, h2);
                    line = buffer.push(heap, line, byte_of(10));
                    borrow line as &lb in {
                        io.write_all(io, buffer.bytes(lb));
                    }
                    buffer.drop(heap, line);
                    borrow rgb as &rb in {
                        if files.write_big(fs, arg(args, 3), contents(rb)) == 0 {
                            status = 0;
                        } else {
                            status = fail(io, "cannot write the file");
                        }
                    }
                }
                unbox_slice(heap, rgb);
            }
        }
        buffer.drop(heap, data);
        return status;
    }
    if n == 6 && same(arg(args, 1), "encode") {
        let w = num(arg(args, 2));
        let h2 = num(arg(args, 3));
        let (data, e) = files.read_all(heap, fs, arg(args, 4));
        var status = 1;
        if e != 0 {
            status = fail(io, "cannot read the file");
        } else {
            borrow data as &db in {
                let png_bytes = png.encode(heap, w, h2, buffer.bytes(db));
                borrow png_bytes as &pb in {
                    if len(buffer.bytes(pb)) == 0 {
                        status = fail(io, "bad size");
                    } else if files.write_big(fs, arg(args, 5), buffer.bytes(pb)) == 0 {
                        status = 0;
                    } else {
                        status = fail(io, "cannot write the file");
                    }
                }
                buffer.drop(heap, png_bytes);
            }
        }
        buffer.drop(heap, data);
        return status;
    }
    if n == 3 && same(arg(args, 1), "stats") {
        let (data, e) = files.read_all(heap, fs, arg(args, 2));
        var status = 1;
        if e != 0 {
            status = fail(io, "cannot read the file");
        } else {
            borrow data as &db in {
                let (code, w, h2, rgb) = png.decode(heap, buffer.bytes(db));
                if code != 0 {
                    status = fail(io, png.message(code));
                } else {
                    let st = box_slice(heap, 6, 0.0);
                    borrow mut st as &!sw in {
                        borrow rgb as &rb in {
                            image.stats(contents(rb), contents(sw));
                        }
                    }
                    var line = buffer.empty(heap, 128);
                    borrow st as &sr in {
                        var k = 0;
                        while k < 6 {
                            line = buffer.push_nat(heap, line, bits_of(contents(sr)[k]));
                            line = buffer.push(heap, line, byte_of(10));
                            k = k + 1;
                        }
                    }
                    borrow line as &lb in {
                        io.write_all(io, buffer.bytes(lb));
                    }
                    buffer.drop(heap, line);
                    unbox_slice(heap, st);
                    status = 0;
                }
                unbox_slice(heap, rgb);
            }
        }
        buffer.drop(heap, data);
        return status;
    }
    if n == 7 && same(arg(args, 1), "ramp") {
        let j = num(arg(args, 4));
        let cnt = num(arg(args, 5));
        let (data, e) = files.read_all(heap, fs, arg(args, 2));
        let (rdata, re) = files.read_all(heap, fs, arg(args, 3));
        var status = 1;
        if e != 0 || re != 0 || j < 0 || cnt < 2 || j >= cnt {
            status = fail(io, "cannot read the files or bad frame numbers");
        } else {
            borrow data as &db in {
                borrow rdata as &rdb in {
                    let (code, w, h2, rgb) = png.decode(heap, buffer.bytes(db));
                    let (rcode, rw, rh, rrgb) = png.decode(heap, buffer.bytes(rdb));
                    if code != 0 || rcode != 0 {
                        status = fail(io, "cannot decode a picture");
                    } else {
                        let st = box_slice(heap, 6, 0.0);
                        borrow mut st as &!sw in {
                            borrow rrgb as &rrb in {
                                image.stats(contents(rrb), contents(sw));
                            }
                        }
                        borrow st as &sr in {
                            borrow rgb as &rb in {
                                let fixed = image.ramp(heap, contents(rb), contents(sr), j, cnt);
                                borrow fixed as &fb in {
                                    let out = png.encode(heap, w, h2, contents(fb));
                                    borrow out as &ob in {
                                        if files.write_big(fs, arg(args, 6), buffer.bytes(ob)) == 0 {
                                            status = 0;
                                        } else {
                                            status = fail(io, "cannot write the file");
                                        }
                                    }
                                    buffer.drop(heap, out);
                                }
                                unbox_slice(heap, fixed);
                            }
                        }
                        unbox_slice(heap, st);
                    }
                    unbox_slice(heap, rgb);
                    unbox_slice(heap, rrgb);
                }
            }
        }
        buffer.drop(heap, data);
        buffer.drop(heap, rdata);
        return status;
    }
    if n == 6 && same(arg(args, 1), "cover") {
        let w = num(arg(args, 3));
        let h2 = num(arg(args, 4));
        let (data, e) = files.read_all(heap, fs, arg(args, 2));
        var status = 1;
        if e != 0 || w < 1 || h2 < 1 || w > 16384 || h2 > 16384 {
            status = fail(io, "cannot read the file");
        } else {
            borrow data as &db in {
                let (code, iw, ih, rgb) = png.decode(heap, buffer.bytes(db));
                if code != 0 {
                    status = fail(io, png.message(code));
                } else {
                    borrow rgb as &rb in {
                        let fitted = image.cover(heap, contents(rb), iw, ih, w, h2);
                        borrow fitted as &fb in {
                            let planes = image.planar_f32(heap, contents(fb), w, h2);
                            borrow planes as &pb in {
                                if files.write_big(fs, arg(args, 5), contents(pb)) == 0 {
                                    status = 0;
                                } else {
                                    status = fail(io, "cannot write the file");
                                }
                            }
                            unbox_slice(heap, planes);
                        }
                        unbox_slice(heap, fitted);
                    }
                }
                unbox_slice(heap, rgb);
            }
        }
        buffer.drop(heap, data);
        return status;
    }
    return fail(io, "usage: png_tool decode IN OUT | encode W H IN OUT");
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(signals);
    release(tty);
    release(clock);
    release(exec);
    var status = 100;
    borrow mut io as &!i in {
        borrow mut heap as &!h in {
            borrow fs as &f in {
                borrow args as &g in {
                    status = run(i, h, f, g);
                }
            }
        }
    }
    release(args);
    release(io);
    release(heap);
    release(fs);
    return status;
}

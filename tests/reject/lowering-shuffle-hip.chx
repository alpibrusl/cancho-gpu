// RULE lowering
// ARGS n=4096 eps=1e-5
// A row sum is reduced with shuffles laid out for 32 lanes; amd-cdna3 has 64 (docs/amd.md, slice H4).
algo rmsnorm(n, eps)
  in  x: f32[1, n]
  in  w: f32[1, n]
  out y: f32[1, n]
{
  let x  = load x
  let sq = &x * &x
  let ss = rowsum sq
  let ms = ss * (1 / n)
  let t  = ms + eps
  let r  = rsqrt t
  let xn = x * r
  let w  = load w
  store xn * w -> y
}
schedule rmsnorm for amd-cdna3 { threads 256 }

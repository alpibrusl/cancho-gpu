// RULE carry
// ARGS n=64
algo k(n)
  in  x: f32[1, n]
  out y: f32[1, 16]
  out z: f32[1]
{
  let a = zeros f32[1, 16]
  let b = zeros f32[1]
  let a, b = for p in 0 .. n / 16 with a, b {
    let t = load x[0, p * 16 ; 1, 16]
    let s = rowsum &t
    yield b + s, a + t
  }
  store a -> y
  store b -> z
}
schedule k for nvidia-ada { threads 32 }

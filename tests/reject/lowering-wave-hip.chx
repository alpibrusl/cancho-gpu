// RULE lowering
// ARGS n=4096 eps=1e-5
// 96 threads are three simdgroups of 32 and not a whole number of amd-cdna3's waves of 64.
algo rmsnorm(n, eps)
  in  x: f32[1, n]
  in  w: f32[1, n]
  out y: f32[1, n]
{
  let x  = load x
  let sq = &x * &x
  let ss = rowsum sq
  let ms = ss * (1 / n)
  let t  = ms + eps
  let r  = rsqrt t
  let xn = x * r
  let w  = load w
  store xn * w -> y
}
schedule rmsnorm for amd-cdna3 { threads 96 }

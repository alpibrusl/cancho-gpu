// conv_step.chx for the 8 tokens of a prefill chunk, in one launch (docs/serving.md section 8). The window (the
// last 3 inputs of every channel) is carried from row to row as in conv_step3.chx: the output of row t is the
// weights against the sequence (cs, x) from t to t + 3. Only the window after the last row is written; ns may be
// the buffer cs is read from: its stores are the last statements, after every load of cs. Every value is loaded
// where it is used, so each is used once. (Written by a script; edit the result.)
algo conv_step8(c)
  in  x:  f32[8, c]
  in  cs: f32[3, c]
  in  cw: f32[4, c]
  out y:  f32[8, c]
  out ns: f32[3, c]
  tile bc
{
  grid i over c / bc
  let v0_0 = load cs[0, i * bc ; 1, bc]
  let w0_0 = load cw[0, i * bc ; 1, bc]
  let v0_1 = load cs[1, i * bc ; 1, bc]
  let w0_1 = load cw[1, i * bc ; 1, bc]
  let v0_2 = load cs[2, i * bc ; 1, bc]
  let w0_2 = load cw[2, i * bc ; 1, bc]
  let v0_3 = load x[0, i * bc ; 1, bc]
  let w0_3 = load cw[3, i * bc ; 1, bc]
  let a0 = v0_0 * w0_0
  let b0 = v0_1 * w0_1
  let d0 = v0_2 * w0_2
  let e0 = v0_3 * w0_3
  let ab0 = a0 + b0
  let de0 = d0 + e0
  let t0 = ab0 + de0
  let g0 = sigmoid &t0
  store t0 * g0 -> y[0, i * bc]
  let v1_0 = load cs[1, i * bc ; 1, bc]
  let w1_0 = load cw[0, i * bc ; 1, bc]
  let v1_1 = load cs[2, i * bc ; 1, bc]
  let w1_1 = load cw[1, i * bc ; 1, bc]
  let v1_2 = load x[0, i * bc ; 1, bc]
  let w1_2 = load cw[2, i * bc ; 1, bc]
  let v1_3 = load x[1, i * bc ; 1, bc]
  let w1_3 = load cw[3, i * bc ; 1, bc]
  let a1 = v1_0 * w1_0
  let b1 = v1_1 * w1_1
  let d1 = v1_2 * w1_2
  let e1 = v1_3 * w1_3
  let ab1 = a1 + b1
  let de1 = d1 + e1
  let t1 = ab1 + de1
  let g1 = sigmoid &t1
  store t1 * g1 -> y[1, i * bc]
  let v2_0 = load cs[2, i * bc ; 1, bc]
  let w2_0 = load cw[0, i * bc ; 1, bc]
  let v2_1 = load x[0, i * bc ; 1, bc]
  let w2_1 = load cw[1, i * bc ; 1, bc]
  let v2_2 = load x[1, i * bc ; 1, bc]
  let w2_2 = load cw[2, i * bc ; 1, bc]
  let v2_3 = load x[2, i * bc ; 1, bc]
  let w2_3 = load cw[3, i * bc ; 1, bc]
  let a2 = v2_0 * w2_0
  let b2 = v2_1 * w2_1
  let d2 = v2_2 * w2_2
  let e2 = v2_3 * w2_3
  let ab2 = a2 + b2
  let de2 = d2 + e2
  let t2 = ab2 + de2
  let g2 = sigmoid &t2
  store t2 * g2 -> y[2, i * bc]
  let v3_0 = load x[0, i * bc ; 1, bc]
  let w3_0 = load cw[0, i * bc ; 1, bc]
  let v3_1 = load x[1, i * bc ; 1, bc]
  let w3_1 = load cw[1, i * bc ; 1, bc]
  let v3_2 = load x[2, i * bc ; 1, bc]
  let w3_2 = load cw[2, i * bc ; 1, bc]
  let v3_3 = load x[3, i * bc ; 1, bc]
  let w3_3 = load cw[3, i * bc ; 1, bc]
  let a3 = v3_0 * w3_0
  let b3 = v3_1 * w3_1
  let d3 = v3_2 * w3_2
  let e3 = v3_3 * w3_3
  let ab3 = a3 + b3
  let de3 = d3 + e3
  let t3 = ab3 + de3
  let g3 = sigmoid &t3
  store t3 * g3 -> y[3, i * bc]
  let v4_0 = load x[1, i * bc ; 1, bc]
  let w4_0 = load cw[0, i * bc ; 1, bc]
  let v4_1 = load x[2, i * bc ; 1, bc]
  let w4_1 = load cw[1, i * bc ; 1, bc]
  let v4_2 = load x[3, i * bc ; 1, bc]
  let w4_2 = load cw[2, i * bc ; 1, bc]
  let v4_3 = load x[4, i * bc ; 1, bc]
  let w4_3 = load cw[3, i * bc ; 1, bc]
  let a4 = v4_0 * w4_0
  let b4 = v4_1 * w4_1
  let d4 = v4_2 * w4_2
  let e4 = v4_3 * w4_3
  let ab4 = a4 + b4
  let de4 = d4 + e4
  let t4 = ab4 + de4
  let g4 = sigmoid &t4
  store t4 * g4 -> y[4, i * bc]
  let v5_0 = load x[2, i * bc ; 1, bc]
  let w5_0 = load cw[0, i * bc ; 1, bc]
  let v5_1 = load x[3, i * bc ; 1, bc]
  let w5_1 = load cw[1, i * bc ; 1, bc]
  let v5_2 = load x[4, i * bc ; 1, bc]
  let w5_2 = load cw[2, i * bc ; 1, bc]
  let v5_3 = load x[5, i * bc ; 1, bc]
  let w5_3 = load cw[3, i * bc ; 1, bc]
  let a5 = v5_0 * w5_0
  let b5 = v5_1 * w5_1
  let d5 = v5_2 * w5_2
  let e5 = v5_3 * w5_3
  let ab5 = a5 + b5
  let de5 = d5 + e5
  let t5 = ab5 + de5
  let g5 = sigmoid &t5
  store t5 * g5 -> y[5, i * bc]
  let v6_0 = load x[3, i * bc ; 1, bc]
  let w6_0 = load cw[0, i * bc ; 1, bc]
  let v6_1 = load x[4, i * bc ; 1, bc]
  let w6_1 = load cw[1, i * bc ; 1, bc]
  let v6_2 = load x[5, i * bc ; 1, bc]
  let w6_2 = load cw[2, i * bc ; 1, bc]
  let v6_3 = load x[6, i * bc ; 1, bc]
  let w6_3 = load cw[3, i * bc ; 1, bc]
  let a6 = v6_0 * w6_0
  let b6 = v6_1 * w6_1
  let d6 = v6_2 * w6_2
  let e6 = v6_3 * w6_3
  let ab6 = a6 + b6
  let de6 = d6 + e6
  let t6 = ab6 + de6
  let g6 = sigmoid &t6
  store t6 * g6 -> y[6, i * bc]
  let v7_0 = load x[4, i * bc ; 1, bc]
  let w7_0 = load cw[0, i * bc ; 1, bc]
  let v7_1 = load x[5, i * bc ; 1, bc]
  let w7_1 = load cw[1, i * bc ; 1, bc]
  let v7_2 = load x[6, i * bc ; 1, bc]
  let w7_2 = load cw[2, i * bc ; 1, bc]
  let v7_3 = load x[7, i * bc ; 1, bc]
  let w7_3 = load cw[3, i * bc ; 1, bc]
  let a7 = v7_0 * w7_0
  let b7 = v7_1 * w7_1
  let d7 = v7_2 * w7_2
  let e7 = v7_3 * w7_3
  let ab7 = a7 + b7
  let de7 = d7 + e7
  let t7 = ab7 + de7
  let g7 = sigmoid &t7
  store t7 * g7 -> y[7, i * bc]
  let o0 = load x[5, i * bc ; 1, bc]
  store o0 -> ns[0, i * bc]
  let o1 = load x[6, i * bc ; 1, bc]
  store o1 -> ns[1, i * bc]
  let o2 = load x[7, i * bc ; 1, bc]
  store o2 -> ns[2, i * bc]
}

schedule conv_step8 for apple-m-series { threads 256 bc 256 }
schedule conv_step8 for nvidia-ada     { threads 256 bc 256 }

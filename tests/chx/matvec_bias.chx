// y = x w^T + b, the projection of a layer that has a bias (Qwen2's q, k, v).
algo matvec_bias(n, k)
  in  x: f32[1, k]
  in  w: f32[n, k]
  in  b: f32[1, n]
  out y: f32[1, n]
  tile bn
{
  grid i over n / bn
  let xt = load x
  let wt = load w[i * bn, 0 ; bn, k]
  let bt = load b[0, i * bn ; 1, bn]
  let p  = matmul_nt xt wt
  store p + bt -> y[0, i * bn]
}

schedule matvec_bias for apple-m-series { threads 256 bn 8 }
schedule matvec_bias for nvidia-ada     { threads 128 bn 4 }

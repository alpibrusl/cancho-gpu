// The second: how many entries of the row are larger than each entry (docs/audio.md section 26). The row y is read twice, as a column of nq * 64 (yc) and as nq chunks of 64 (yr); the threadgroup q takes
// the 64 entries j of chunk q against every chunk in turn, summing step(y_i - y_j), which is 0 at a tie and for the entry itself. cnt is a count an entry; samp_keep.chx keeps the entries whose count is
// under k.
algo samp_rank(nq)
  in  yc:  f32[nq * 64, 1]
  in  yr:  f32[nq, 64]
  out cnt: f32[nq * 64]
{
  grid q over nq
  let acc = zeros f32[64, 64]
  let acc = for p in 0 .. nq with acc {
    let c  = load yc[q * 64, 0 ; 64, 1]
    let z  = zeros f32[64, 64]
    let cb = z + c
    let r  = load yr[p, 0 ; 1, 64]
    let d  = cb - r
    let zn = zeros f32[64, 64]
    let dn = zn - d
    let st = step dn
    yield acc + st
  }
  let s = rowsum acc
  store s -> cnt[q * 64]
}

schedule samp_rank for apple-m-series { threads 256 }
schedule samp_rank for nvidia-ada     { threads 128 }

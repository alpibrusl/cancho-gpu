// y = x w^T for m rows of x at once with NVFP4 weights (see matvec_fp4_rows.chx):
// the weights are read once whatever m is, which is what makes a batch of
// tokens (a prefill chunk, the tokens a speculative step checks) cost about
// what one token does.
algo matvec_fp4_batch(m, n, k)
  in  x:  f32[m, k]
  in  wq: i8[n, k / 2]
  in  ws: i8[n, k / 16]
  in  wg: f32[n]
  out y:  f32[m, n]
  tile bn
{
  grid i over n / bn
  let xt = load x
  let q  = load wq[i * bn, 0 ; bn, k / 2]
  let s  = load ws[i * bn, 0 ; bn, k / 16]
  let g  = load wg[i * bn ; bn]
  let w  = dequant_fp4 q s g 16
  store matmul_nt xt w -> y[0, i * bn]
}

schedule matvec_fp4_batch for apple-m-series { threads 256 bn 64 frag 1 }
schedule matvec_fp4_batch for nvidia-ada     { threads 256 bn 8 }

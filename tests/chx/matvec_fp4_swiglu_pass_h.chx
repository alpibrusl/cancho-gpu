// matvec_fp4_swiglu_batch_h.chx with the rows as a second grid axis: see matvec_fp4_pass_h.chx.
algo matvec_fp4_swiglu_pass_h(m, n, k, bm)
  in  x:   f16[m, k]
  in  gq:  i8[n, k / 2]
  in  gs:  i8[n, k / 16]
  in  gg:  f32[n]
  in  uq:  i8[n, k / 2]
  in  us:  i8[n, k / 16]
  in  ug:  f32[n]
  out y:   f16[m, n]
  tile bn
{
  grid i over n / bn, j over m / bm
  let xt = load x[j * bm, 0 ; bm, k]
  let q1 = load gq[i * bn, 0 ; bn, k / 2]
  let s1 = load gs[i * bn, 0 ; bn, k / 16]
  let g1 = load gg[i * bn ; bn]
  let q2 = load uq[i * bn, 0 ; bn, k / 2]
  let s2 = load us[i * bn, 0 ; bn, k / 16]
  let g2 = load ug[i * bn ; bn]
  let w1 = dequant_fp4 q1 s1 g1 16
  let w2 = dequant_fp4 q2 s2 g2 16
  let gt = matmul_nt &xt w1
  let ut = matmul_nt xt w2
  let sg = sigmoid &gt
  let a  = gt * sg
  let yf = a * ut
  let yh = stage f16 yf
  store yh -> y[j * bm, i * bn]
}

schedule matvec_fp4_swiglu_pass_h for apple-m-series { threads 256 bn 32 frag 4 }
schedule matvec_fp4_swiglu_pass_h for nvidia-ada     { threads 256 bn 8 }
schedule matvec_fp4_swiglu_pass_h for amd-cdna3      { threads 256 bn 8 }

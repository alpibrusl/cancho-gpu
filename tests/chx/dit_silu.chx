// SiLU, v * sigmoid(v), for s rows of n, bn columns to a threadgroup; f16 output (docs/diffusion.md D2e: the activation of the timestep embedding and the one in front of the shared modulation and
// of norm_out's scale, each followed by a matrix product).
algo dit_silu(s, n, bn)
  in  x: f32[s, n]
  out y: f16[s, n]
{
  grid i over s, j over n / bn
  let vv = load x[i, j * bn ; 1, bn]
  let sg = sigmoid &vv
  let a  = vv * sg
  let oh = stage f16 a
  store oh -> y[i, j * bn]
}

schedule dit_silu for apple-m-series { threads 256 }
schedule dit_silu for nvidia-ada     { threads 256 }

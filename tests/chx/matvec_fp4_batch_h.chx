// matvec_fp4_batch.chx with the activations read as f16 (docs/serving.md section 9, step 3): the rows a prefill chunk feeds the product are stored in 16 bits.
// y = x w^T for m rows of x at once with NVFP4 weights (see matvec_fp4_rows.chx):
// the weights are read once whatever m is, which is what makes a batch of
// tokens (a prefill chunk, the tokens a speculative step checks) cost about
// what one token does.
algo matvec_fp4_batch_h(m, n, k)
  in  x:  f16[m, k]
  in  wq: i8[n, k / 2]
  in  ws: i8[n, k / 16]
  in  wg: f32[n]
  out y:  f32[m, n]
  tile bn
{
  grid i over n / bn
  let xt = load x
  let q  = load wq[i * bn, 0 ; bn, k / 2]
  let s  = load ws[i * bn, 0 ; bn, k / 16]
  let g  = load wg[i * bn ; bn]
  let w  = dequant_fp4 q s g 16
  store matmul_nt xt w -> y[0, i * bn]
}

schedule matvec_fp4_batch_h for apple-m-series { threads 256 bn 32 frag 4 }
schedule matvec_fp4_batch_h for nvidia-ada     { threads 256 bn 8 }
schedule matvec_fp4_batch_h for amd-cdna3      { threads 256 bn 8 }

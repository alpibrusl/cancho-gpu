// v and o are token-major (see dit_scores.chx): head h's window is at column h * d.
// The product with v for a diffusion transformer's attention (docs/diffusion.md D1): head h's query tile qb, the columns dc * dw .. (dc + 1) * dw of v,
//
//     o = sum over chunks of  exp(s - m) / z  v
//
// with the scores s from dit_scores.chx and the maximum m and the normaliser z of each query row from dit_stats.chx (attention_pvl.chx with a query tile of one head
// in place of a key/value head's g query heads). One carried [qs, dw] accumulator over chunks of cs positions.
algo dit_pv(nh, nq, t, qs, cs, dw, d)
  in  sc: f32[nh * nq, t]
  in  m:  f32[nh * nq]
  in  z:  f32[nh * nq]
  in  v:  f32[t, nh * d]
  out o:  f32[nq, nh * d]
{
  grid h over nh, qb over nq / qs, dc over d / dw
  let a0 = zeros f32[qs, dw]
  let acc = for c in 0 .. t / cs with a0 {
    let sm = load sc[h * nq + qb * qs, c * cs ; qs, cs]
    let mm = load m[h * nq + qb * qs ; qs]
    let zz = load z[h * nq + qb * qs ; qs]
    let sh = sm - mm
    let e  = exp sh
    let p  = e / zz
    let vt = load v[c * cs, h * d + dc * dw ; cs, dw]
    yield a0 + matmul p vt
  }
  store acc -> o[qb * qs, h * d + dc * dw]
}

schedule dit_pv for apple-m-series { threads 256 }
schedule dit_pv for nvidia-ada     { threads 128 }

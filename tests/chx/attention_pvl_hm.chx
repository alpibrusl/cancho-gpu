// attention_pvl_rows.chx with each value read once for the chunk (docs/serving.md section 13): the head-major scores of
// attention_scores_hm.chx, rb rows of head i at a time, the maximum m and the normaliser z of each of their rows (attention_stats.chx over
// the nkv * nr * g rows), and the columns dc * dw .. (dc + 1) * dw of head i's values:
//
//     o = sum over chunks of  exp(s - m) / z  v
//
// written head-major, [nkv * nr * g, d], as the scores are (rows_major.chx turns it back).
algo attention_pvl_hm(nr, rb, nkv, g, t, cs, dw, d, tmax)
  in  sc: f32[nkv * nr * g, t]
  in  m:  f32[nkv * nr * g]
  in  z:  f32[nkv * nr * g]
  in  v:  f32[nkv * tmax, d]
  out o:  f32[nkv * nr * g, d]
{
  grid i over nkv, rc over nr / rb, dc over d / dw
  let a0 = zeros f32[rb * g, dw]
  let acc = for c in 0 .. t / cs with a0 {
    let sm = load sc[(i * nr + rc * rb) * g, c * cs ; rb * g, cs]
    let mm = load m[(i * nr + rc * rb) * g ; rb * g]
    let zz = load z[(i * nr + rc * rb) * g ; rb * g]
    let sh = sm - mm
    let e  = exp sh
    let p  = e / zz
    let vt = load v[i * tmax + c * cs, dc * dw ; cs, dw]
    yield a0 + matmul p vt
  }
  store acc -> o[(i * nr + rc * rb) * g, dc * dw]
}

schedule attention_pvl_hm for apple-m-series { threads 256 }
schedule attention_pvl_hm for nvidia-ada     { threads 128 }
schedule attention_pvl_hm for amd-cdna3      { threads 128 }

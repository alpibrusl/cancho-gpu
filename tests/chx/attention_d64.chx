// attention for head dimension d = 64 (Qwen2.5-0.5B's), the scale 1/sqrt(64) = 0.125
// written as a literal, as attention.chx does for 256; the mask makes t a capacity.
algo attention_d64(nkv, g, t, d, tmax)
  in  q:    f32[nkv * g, d]
  in  k:    f32[nkv * tmax, d]
  in  v:    f32[nkv * tmax, d]
  in  mask: f32[1, t]
  out o:    f32[nkv * g, d]
{
  grid i over nkv
  let qt = load q[i * g, 0 ; g, d]
  let kt = load k[i * tmax, 0 ; t, d]
  let s  = matmul_nt qt kt
  let sc = s * 0.125
  let mk = load mask
  let sm = sc + mk
  let mx = rowmax &sm
  let sh = sm - mx
  let e  = exp sh
  let z  = rowsum &e
  let p  = e / z
  let vt = load v[i * tmax, 0 ; t, d]
  let r  = matmul p vt
  store r -> o[i * g, 0]
}

schedule attention_d64 for apple-m-series { threads 256 }
schedule attention_d64 for nvidia-ada     { threads 256 }

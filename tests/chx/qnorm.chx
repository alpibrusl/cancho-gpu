// The per-head norm of an attention layer's queries, read from q_proj's output,
// which is a [q, gate] pair of n each for every head: y = rmsnorm(q) * w.
algo qnorm(r, n, eps)
  in  x: f32[r, 2 * n]
  in  w: f32[1, n]
  out y: f32[r, n]
  tile br
{
  grid i over r / br
  let q  = load x[i * br, 0 ; br, n]
  let sq = &q * &q
  let ss = rowsum sq
  let ms = ss * (1 / n)
  let t  = ms + eps
  let rs = rsqrt t
  let xn = q * rs
  let w  = load w
  store xn * w -> y[i * br, 0]
}

schedule qnorm for apple-m-series { threads 256 br 1 }
schedule qnorm for nvidia-ada     { threads 256 br 1 }

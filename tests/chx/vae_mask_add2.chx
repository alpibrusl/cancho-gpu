// The additive mask of a video VAE's attention scores (docs/diffusion.md V2): z = sc + mk with mk [n, n] a matrix: 0 where the key is an interior pixel of the query's own frame, a large negative number elsewhere
// (the attention is over the positions of one frame; the frames are stacked in one matrix).
algo vae_mask_add2(n)
  in  sc: f32[n, n]
  in  mk: f32[n, n]
  out z:  f32[n, n]
{
  grid i over n
  let a = load sc[i, 0 ; 1, n]
  let m = load mk[i, 0 ; 1, n]
  store a + m -> z[i, 0]
}

schedule vae_mask_add2 for apple-m-series { threads 256 }
schedule vae_mask_add2 for nvidia-ada     { threads 256 }

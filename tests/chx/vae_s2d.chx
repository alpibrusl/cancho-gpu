// The space-to-depth of the VAE encoder's strided convolutions (docs/diffusion.md D9d): a 3 x 3 convolution of stride 2 over an h x w image is a 3 x 3 convolution of stride 1 over the (h/2) x (w/2) image
// whose pixel (I, J) holds the four pixels (2I + a, 2J + b) of the original, a and b in {0, 1}, as 4c channels in the order (a, b, channel); the surface has no strided window, but an instance a destination pixel
// can load its four sources. x is the h x w image in the bordered row layout (tests/vae_pieces.py: r rows), y the half-size image in r2 rows with g2 guard rows each side, f16 (the input of conv3.chx).
algo vae_s2d(h, w, c, r, r2, g2)
  in  x: f32[r, c]
  out y: f16[r2 + 2 * g2, 4 * c]
{
  grid i over h / 2, j over w / 2
  let p00 = load x[(2 * i + 1) * (w + 2) + 2 * j + 1, 0 ; 1, c]
  let p01 = load x[(2 * i + 1) * (w + 2) + 2 * j + 2, 0 ; 1, c]
  let p10 = load x[(2 * i + 2) * (w + 2) + 2 * j + 1, 0 ; 1, c]
  let p11 = load x[(2 * i + 2) * (w + 2) + 2 * j + 2, 0 ; 1, c]
  let h00 = stage f16 p00
  let h01 = stage f16 p01
  let h10 = stage f16 p10
  let h11 = stage f16 p11
  store h00 -> y[g2 + (i + 1) * (w / 2 + 2) + j + 1, 0]
  store h01 -> y[g2 + (i + 1) * (w / 2 + 2) + j + 1, c]
  store h10 -> y[g2 + (i + 1) * (w / 2 + 2) + j + 1, 2 * c]
  store h11 -> y[g2 + (i + 1) * (w / 2 + 2) + j + 1, 3 * c]
}

schedule vae_s2d for apple-m-series { threads 128 }
schedule vae_s2d for nvidia-ada     { threads 128 }

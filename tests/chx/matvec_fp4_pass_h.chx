// matvec_fp4_batch_h.chx with the rows as a second grid axis (docs/serving.md section 9.3): a threadgroup takes `bm` rows of
// x and `bn` outputs, so one launch covers a prefill pass of m rows, and a launch over fewer row tiles (the grid's second
// extent set when it is launched) covers a shorter pass with the same compiled kernel. The arithmetic of a row is
// matvec_fp4_batch_h's at m = bm.
algo matvec_fp4_pass_h(m, n, k, bm)
  in  x:  f16[m, k]
  in  wq: i8[n, k / 2]
  in  ws: i8[n, k / 16]
  in  wg: f32[n]
  out y:  f32[m, n]
  tile bn
{
  grid i over n / bn, j over m / bm
  let xt = load x[j * bm, 0 ; bm, k]
  let q  = load wq[i * bn, 0 ; bn, k / 2]
  let s  = load ws[i * bn, 0 ; bn, k / 16]
  let g  = load wg[i * bn ; bn]
  let w  = dequant_fp4 q s g 16
  store matmul_nt xt w -> y[j * bm, i * bn]
}

schedule matvec_fp4_pass_h for apple-m-series { threads 256 bn 32 frag 4 }
schedule matvec_fp4_pass_h for nvidia-ada     { threads 256 bn 8 }
schedule matvec_fp4_pass_h for amd-cdna3      { threads 256 bn 8 }

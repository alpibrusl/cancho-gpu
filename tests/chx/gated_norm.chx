// The norm inside a gated-delta layer, per value head: y = rmsnorm(x) * w * silu(z),
// x the delta step's output and z the in_proj_z projection, both as h heads of n.
algo gated_norm(h, n, eps)
  in  x: f32[h, n]
  in  z: f32[h, n]
  in  w: f32[1, n]
  out y: f32[h, n]
  tile br
{
  grid i over h / br
  let x  = load x[i * br, 0 ; br, n]
  let sq = &x * &x
  let ss = rowsum sq
  let ms = ss * (1 / n)
  let t  = ms + eps
  let rs = rsqrt t
  let xn = x * rs
  let w  = load w
  let xw = xn * w
  let zt = load z[i * br, 0 ; br, n]
  let sg = sigmoid &zt
  let sz = zt * sg
  store xw * sz -> y[i * br, 0]
}

schedule gated_norm for apple-m-series { threads 128 br 1 }
schedule gated_norm for nvidia-ada     { threads 128 br 1 }

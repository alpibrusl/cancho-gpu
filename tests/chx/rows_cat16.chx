// Written by scripts/gen-kolibri-kernels.sh: do not edit. 16 rows of n as one matrix (docs/kolibri.md section 20): what each of a pass's tokens computed alone (its embedding row,
// its experts' sum), for the kernels that take the pass's rows together. bn columns a threadgroup.
algo rows_cat16(n, bn)
  in  y0: f32[1, n]
  in  y1: f32[1, n]
  in  y2: f32[1, n]
  in  y3: f32[1, n]
  in  y4: f32[1, n]
  in  y5: f32[1, n]
  in  y6: f32[1, n]
  in  y7: f32[1, n]
  in  y8: f32[1, n]
  in  y9: f32[1, n]
  in  y10: f32[1, n]
  in  y11: f32[1, n]
  in  y12: f32[1, n]
  in  y13: f32[1, n]
  in  y14: f32[1, n]
  in  y15: f32[1, n]
  out o:  f32[16, n]
{
  grid c over n / bn
  let t0 = load y0[0, c * bn ; 1, bn]
  store t0 -> o[0, c * bn]
  let t1 = load y1[0, c * bn ; 1, bn]
  store t1 -> o[1, c * bn]
  let t2 = load y2[0, c * bn ; 1, bn]
  store t2 -> o[2, c * bn]
  let t3 = load y3[0, c * bn ; 1, bn]
  store t3 -> o[3, c * bn]
  let t4 = load y4[0, c * bn ; 1, bn]
  store t4 -> o[4, c * bn]
  let t5 = load y5[0, c * bn ; 1, bn]
  store t5 -> o[5, c * bn]
  let t6 = load y6[0, c * bn ; 1, bn]
  store t6 -> o[6, c * bn]
  let t7 = load y7[0, c * bn ; 1, bn]
  store t7 -> o[7, c * bn]
  let t8 = load y8[0, c * bn ; 1, bn]
  store t8 -> o[8, c * bn]
  let t9 = load y9[0, c * bn ; 1, bn]
  store t9 -> o[9, c * bn]
  let t10 = load y10[0, c * bn ; 1, bn]
  store t10 -> o[10, c * bn]
  let t11 = load y11[0, c * bn ; 1, bn]
  store t11 -> o[11, c * bn]
  let t12 = load y12[0, c * bn ; 1, bn]
  store t12 -> o[12, c * bn]
  let t13 = load y13[0, c * bn ; 1, bn]
  store t13 -> o[13, c * bn]
  let t14 = load y14[0, c * bn ; 1, bn]
  store t14 -> o[14, c * bn]
  let t15 = load y15[0, c * bn ; 1, bn]
  store t15 -> o[15, c * bn]
}

schedule rows_cat16 for apple-m-series { threads 128 }
schedule rows_cat16 for nvidia-ada     { threads 128 }
schedule rows_cat16 for amd-cdna3      { threads 128 }

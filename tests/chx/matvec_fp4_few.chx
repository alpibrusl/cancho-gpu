// y = x w^T for a few rows of x (the tokens a speculative step checks, 2 or 3), NVFP4 weights read once: the
// generic batched product (`batched_rows` of src/matmul.cho), on Metal with wide loads and the group's scale applied
// once a group. 4 weight rows a simdgroup, 2 simdgroups a threadgroup: alone, 110 us for 2 rows and 125 to 128 for
// 3 at 17408 x 5120, where a token's kernel takes 112 and the matrix unit 141 (docs/serving.md 11.5). The `_batch`
// kernels are the matrix-unit ones, cheaper from 4 rows.
algo matvec_fp4_few(m, n, k)
  in  x:  f32[m, k]
  in  wq: i8[n, k / 2]
  in  ws: i8[n, k / 16]
  in  wg: f32[n]
  out y:  f32[m, n]
  tile bn
{
  grid i over n / bn
  let xt = load x
  let q  = load wq[i * bn, 0 ; bn, k / 2]
  let s  = load ws[i * bn, 0 ; bn, k / 16]
  let g  = load wg[i * bn ; bn]
  let w  = dequant_fp4 q s g 16
  store matmul_nt xt w -> y[0, i * bn]
}

schedule matvec_fp4_few for apple-m-series { threads 64 bn 8 }
schedule matvec_fp4_few for nvidia-ada     { threads 256 bn 8 }

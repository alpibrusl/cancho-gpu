// conv_step.chx for the three tokens a speculative check runs, in one launch. The window (the last 3 inputs of
// every channel) is carried from row to row: with cs = (c0, c1, c2) and the rows x0, x1, x2 the windows are
//
//     w0 = (c0, c1, c2)    w1 = (c1, c2, x0)    w2 = (c2, x0, x1)    w3 = (x0, x1, x2)
//
// and the output of row t is the weights against (w_t, x_t). The windows after the first, second and third
// row go to n1, n2 and n3, because a rejection keeps the one after the last row it kept; n2 may be the buffer cs
// is read from: its stores are the last statements, after every load of cs. Every value is loaded where it is used,
// so each is used once. (Generated by the script in the commit that added it; edit the result.)
algo conv_step3(c)
  in  x:  f32[3, c]
  in  cs: f32[3, c]
  in  cw: f32[4, c]
  out y:  f32[3, c]
  out n1: f32[3, c]
  out n2: f32[3, c]
  out n3: f32[3, c]
  tile bc
{
  grid i over c / bc
  let v0_0 = load cs[0, i * bc ; 1, bc]
  let w0_0 = load cw[0, i * bc ; 1, bc]
  let v0_1 = load cs[1, i * bc ; 1, bc]
  let w0_1 = load cw[1, i * bc ; 1, bc]
  let v0_2 = load cs[2, i * bc ; 1, bc]
  let w0_2 = load cw[2, i * bc ; 1, bc]
  let v0_3 = load x[0, i * bc ; 1, bc]
  let w0_3 = load cw[3, i * bc ; 1, bc]
  let a0 = v0_0 * w0_0
  let b0 = v0_1 * w0_1
  let d0 = v0_2 * w0_2
  let e0 = v0_3 * w0_3
  let ab0 = a0 + b0
  let de0 = d0 + e0
  let t0 = ab0 + de0
  let g0 = sigmoid &t0
  store t0 * g0 -> y[0, i * bc]
  let o0_0 = load cs[1, i * bc ; 1, bc]
  store o0_0 -> n1[0, i * bc]
  let o0_1 = load cs[2, i * bc ; 1, bc]
  store o0_1 -> n1[1, i * bc]
  let o0_2 = load x[0, i * bc ; 1, bc]
  store o0_2 -> n1[2, i * bc]
  let v1_0 = load cs[1, i * bc ; 1, bc]
  let w1_0 = load cw[0, i * bc ; 1, bc]
  let v1_1 = load cs[2, i * bc ; 1, bc]
  let w1_1 = load cw[1, i * bc ; 1, bc]
  let v1_2 = load x[0, i * bc ; 1, bc]
  let w1_2 = load cw[2, i * bc ; 1, bc]
  let v1_3 = load x[1, i * bc ; 1, bc]
  let w1_3 = load cw[3, i * bc ; 1, bc]
  let a1 = v1_0 * w1_0
  let b1 = v1_1 * w1_1
  let d1 = v1_2 * w1_2
  let e1 = v1_3 * w1_3
  let ab1 = a1 + b1
  let de1 = d1 + e1
  let t1 = ab1 + de1
  let g1 = sigmoid &t1
  store t1 * g1 -> y[1, i * bc]
  let v2_0 = load cs[2, i * bc ; 1, bc]
  let w2_0 = load cw[0, i * bc ; 1, bc]
  let v2_1 = load x[0, i * bc ; 1, bc]
  let w2_1 = load cw[1, i * bc ; 1, bc]
  let v2_2 = load x[1, i * bc ; 1, bc]
  let w2_2 = load cw[2, i * bc ; 1, bc]
  let v2_3 = load x[2, i * bc ; 1, bc]
  let w2_3 = load cw[3, i * bc ; 1, bc]
  let a2 = v2_0 * w2_0
  let b2 = v2_1 * w2_1
  let d2 = v2_2 * w2_2
  let e2 = v2_3 * w2_3
  let ab2 = a2 + b2
  let de2 = d2 + e2
  let t2 = ab2 + de2
  let g2 = sigmoid &t2
  store t2 * g2 -> y[2, i * bc]
  let o2_0 = load x[0, i * bc ; 1, bc]
  store o2_0 -> n3[0, i * bc]
  let o2_1 = load x[1, i * bc ; 1, bc]
  store o2_1 -> n3[1, i * bc]
  let o2_2 = load x[2, i * bc ; 1, bc]
  store o2_2 -> n3[2, i * bc]
  let o1_0 = load cs[2, i * bc ; 1, bc]
  store o1_0 -> n2[0, i * bc]
  let o1_1 = load x[0, i * bc ; 1, bc]
  store o1_1 -> n2[1, i * bc]
  let o1_2 = load x[1, i * bc ; 1, bc]
  store o1_2 -> n2[2, i * bc]
}

schedule conv_step3 for apple-m-series { threads 256 bc 256 }
schedule conv_step3 for nvidia-ada     { threads 256 bc 256 }

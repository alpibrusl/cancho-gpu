// The scores of the rows of a prefill chunk with each key read once for the chunk (docs/serving.md section 13), where
// attention_scores_rows.chx reads a key once for each row. The queries are head-major (heads_major.chx): head i's g query heads of
// row 0, then of row 1, ..., rb rows at a time; the masks are those rows' masks with each row repeated g times (mask_rows_g.chx). The
// scores of the rows rc * rb .. (rc + 1) * rb of head i against positions sp * ts .. (sp + 1) * ts,
//
//     sc = q k^T / 16 + mask        (1/16 = 1/sqrt(256); d MUST be 256, see attention.chx)
//
// written head-major to an [nkv * nr * g, t] scratch: row (i * nr + r) * g + j is query head j of head i of row r.
algo attention_scores_hm(nr, rb, nkv, g, t, ts, d, tmax)
  in  q:    f32[nkv * nr * g, d]
  in  k:    f32[nkv * tmax, d]
  in  mask: f32[nr * g, tmax]
  out sc:   f32[nkv * nr * g, t]
{
  grid i over nkv, rc over nr / rb, sp over t / ts
  let qt = load q[(i * nr + rc * rb) * g, 0 ; rb * g, d]
  let kt = load k[i * tmax + sp * ts, 0 ; ts, d]
  let s  = matmul_nt qt kt
  let sd = s * 0.0625
  let mk = load mask[rc * rb * g, sp * ts ; rb * g, ts]
  store sd + mk -> sc[(i * nr + rc * rb) * g, sp * ts]
}

schedule attention_scores_hm for apple-m-series { threads 512 }
schedule attention_scores_hm for nvidia-ada     { threads 128 }
schedule attention_scores_hm for amd-cdna3      { threads 128 }

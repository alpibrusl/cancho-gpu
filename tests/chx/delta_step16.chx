  let v0_7 = load v[75776 + i * 384 + 0 + r * br ; br]
  let d0_7 = v0_7 - m0_7
  let b0_7 = load bt[7*nk*384 + i * 384 + 0 + r * br ; br]
  let e0_7 = d0_7 * b0_7
  let z0_7 = zeros f32[br, 128]
  let kk0_7 = load k[7*nk + i, 0 ; 1, 128]
  let k00_7 = z0_7 + kk0_7
  let u0_7 = k00_7 * e0_7
  let sn0_7 = sg0_7 + u0_7
  let qb0_7 = load q[7*nk + i, 0 ; 1, 128]
  let y0_7 = &sn0_7 * qb0_7
  store rowsum y0_7 -> y[7*nk*384 + i * 384 + 0 + r * br]
  let g0_8 = load g[8*nk*3 + i * 3 + 0, 0 ; 1, 128]
  let sg0_8 = sn0_7 * g0_8
  let kp0_8 = load k[8*nk + i, 0 ; 1, 128]
  let p0_8 = &sg0_8 * kp0_8
  let m0_8 = rowsum p0_8
  let v0_8 = load v[86016 + i * 384 + 0 + r * br ; br]
  let d0_8 = v0_8 - m0_8
  let b0_8 = load bt[8*nk*384 + i * 384 + 0 + r * br ; br]

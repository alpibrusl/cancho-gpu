  let kk0_2 = load k[2*nk + i, 0 ; 1, 128]
  let k00_2 = z0_2 + kk0_2
  let u0_2 = k00_2 * e0_2
  let sn0_2 = sg0_2 + u0_2
  let qb0_2 = load q[2*nk + i, 0 ; 1, 128]
  let y0_2 = &sn0_2 * qb0_2
  store rowsum y0_2 -> y[2*nk*384 + i * 384 + 0 + r * br]
  let g0_3 = load g[3*nk*3 + i * 3 + 0, 0 ; 1, 128]
  let sg0_3 = sn0_2 * g0_3
  let kp0_3 = load k[3*nk + i, 0 ; 1, 128]
  let p0_3 = &sg0_3 * kp0_3
  let m0_3 = rowsum p0_3
  let v0_3 = load v[34816 + i * 384 + 0 + r * br ; br]
  let d0_3 = v0_3 - m0_3
  let b0_3 = load bt[3*nk*384 + i * 384 + 0 + r * br ; br]
  let e0_3 = d0_3 * b0_3
  let z0_3 = zeros f32[br, 128]
  let kk0_3 = load k[3*nk + i, 0 ; 1, 128]
  let k00_3 = z0_3 + kk0_3
  let u0_3 = k00_3 * e0_3
  let sn0_3 = sg0_3 + u0_3
  let qb0_3 = load q[3*nk + i, 0 ; 1, 128]
  let y0_3 = &sn0_3 * qb0_3
  store rowsum y0_3 -> y[3*nk*384 + i * 384 + 0 + r * br]
  let g0_4 = load g[4*nk*3 + i * 3 + 0, 0 ; 1, 128]
  let sg0_4 = sn0_3 * g0_4
  let kp0_4 = load k[4*nk + i, 0 ; 1, 128]
  let p0_4 = &sg0_4 * kp0_4
  let m0_4 = rowsum p0_4
  let v0_4 = load v[45056 + i * 384 + 0 + r * br ; br]
  let d0_4 = v0_4 - m0_4
  let b0_4 = load bt[4*nk*384 + i * 384 + 0 + r * br ; br]
  let e0_4 = d0_4 * b0_4
  let z0_4 = zeros f32[br, 128]
  let kk0_4 = load k[4*nk + i, 0 ; 1, 128]
  let k00_4 = z0_4 + kk0_4
  let u0_4 = k00_4 * e0_4
  let sn0_4 = sg0_4 + u0_4
  let qb0_4 = load q[4*nk + i, 0 ; 1, 128]
  let y0_4 = &sn0_4 * qb0_4
  store rowsum y0_4 -> y[4*nk*384 + i * 384 + 0 + r * br]
  let g0_5 = load g[5*nk*3 + i * 3 + 0, 0 ; 1, 128]
  let sg0_5 = sn0_4 * g0_5
  let kp0_5 = load k[5*nk + i, 0 ; 1, 128]
  let p0_5 = &sg0_5 * kp0_5
  let m0_5 = rowsum p0_5
  let v0_5 = load v[55296 + i * 384 + 0 + r * br ; br]

  let kp0_10 = load k[10*nk + i, 0 ; 1, 128]
  let p0_10 = &sg0_10 * kp0_10
  let m0_10 = rowsum p0_10
  let v0_10 = load v[106496 + i * 384 + 0 + r * br ; br]
  let d0_10 = v0_10 - m0_10
  let b0_10 = load bt[10*nk*384 + i * 384 + 0 + r * br ; br]
  let e0_10 = d0_10 * b0_10
  let z0_10 = zeros f32[br, 128]
  let kk0_10 = load k[10*nk + i, 0 ; 1, 128]
  let k00_10 = z0_10 + kk0_10
  let u0_10 = k00_10 * e0_10
  let sn0_10 = sg0_10 + u0_10
  let qb0_10 = load q[10*nk + i, 0 ; 1, 128]
  let y0_10 = &sn0_10 * qb0_10
  store rowsum y0_10 -> y[10*nk*384 + i * 384 + 0 + r * br]
  let g0_11 = load g[11*nk*3 + i * 3 + 0, 0 ; 1, 128]
  let sg0_11 = sn0_10 * g0_11
  let kp0_11 = load k[11*nk + i, 0 ; 1, 128]
  let p0_11 = &sg0_11 * kp0_11
  let m0_11 = rowsum p0_11
  let v0_11 = load v[116736 + i * 384 + 0 + r * br ; br]
  let d0_11 = v0_11 - m0_11
  let b0_11 = load bt[11*nk*384 + i * 384 + 0 + r * br ; br]
  let e0_11 = d0_11 * b0_11
  let z0_11 = zeros f32[br, 128]
  let kk0_11 = load k[11*nk + i, 0 ; 1, 128]
  let k00_11 = z0_11 + kk0_11
  let u0_11 = k00_11 * e0_11
  let sn0_11 = sg0_11 + u0_11
  let qb0_11 = load q[11*nk + i, 0 ; 1, 128]
  let y0_11 = &sn0_11 * qb0_11
  store rowsum y0_11 -> y[11*nk*384 + i * 384 + 0 + r * br]
  let g0_12 = load g[12*nk*3 + i * 3 + 0, 0 ; 1, 128]
  let sg0_12 = sn0_11 * g0_12
  let kp0_12 = load k[12*nk + i, 0 ; 1, 128]
  let p0_12 = &sg0_12 * kp0_12
  let m0_12 = rowsum p0_12
  let v0_12 = load v[126976 + i * 384 + 0 + r * br ; br]
  let d0_12 = v0_12 - m0_12
  let b0_12 = load bt[12*nk*384 + i * 384 + 0 + r * br ; br]
  let e0_12 = d0_12 * b0_12
  let z0_12 = zeros f32[br, 128]

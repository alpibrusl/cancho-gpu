  let qb0_6 = load q[6*nk + i, 0 ; 1, 128]
  let y0_6 = &sn0_6 * qb0_6
  store rowsum y0_6 -> y[6*nk*384 + i * 384 + 0 + r * br]
  let g0_7 = load g[7*nk*3 + i * 3 + 0, 0 ; 1, 128]

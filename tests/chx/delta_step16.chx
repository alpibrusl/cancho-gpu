  let b0_13 = load bt[13*nk*384 + i * 384 + 0 + r * br ; br]
  let e0_13 = d0_13 * b0_13
  let z0_13 = zeros f32[br, 128]
  let kk0_13 = load k[13*nk + i, 0 ; 1, 128]

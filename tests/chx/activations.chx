// relu and its derivative step, element-wise: the two operations a ReLU network's forward and backward passes need (docs/chx.md).
algo activations(r, n)
  in  x: f32[r, n]
  out y: f32[r, n]
  out d: f32[r, n]
{
  let a = load x
  store relu &a -> y
  store step a -> d
}

schedule activations for apple-m-series { threads 128 }
schedule activations for nvidia-ada     { threads 128 }

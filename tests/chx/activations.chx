// relu, its derivative step and tanh, element-wise (docs/chx.md): what a ReLU network's passes and GELU need.
algo activations(r, n)
  in  x: f32[r, n]
  out y: f32[r, n]
  out d: f32[r, n]
  out t: f32[r, n]
{
  let a = load x
  store relu &a -> y
  store tanh &a -> t
  store step a -> d
}

schedule activations for apple-m-series { threads 128 }
schedule activations for nvidia-ada     { threads 128 }

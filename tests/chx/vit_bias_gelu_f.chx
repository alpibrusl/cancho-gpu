// vit_bias_gelu.chx with an f32 output: gelu_tanh(x + b), not rounded to f16, for gemm_mma_f.chx (docs/diffusion.md section 6, V3c). Metal only: the f32 product it feeds is not on CUDA's matrix unit.
algo vit_bias_gelu_f(s, n, bn)
  in  x: f32[s, n]
  in  b: f32[1, n]
  out y: f32[s, n]
{
  grid i over s, j over n / bn
  let xx = load x[i, j * bn ; 1, bn]
  let bb = load b[0, j * bn ; 1, bn]
  let vv = xx + bb
  let v2 = &vv * &vv
  let v3 = v2 * &vv
  let t1 = v3 * 0.044715
  let t2 = &vv + t1
  let t3 = t2 * 0.7978845608028654
  let th = tanh t3
  let t4 = th + 1
  let t5 = vv * t4
  let t6 = t5 * 0.5
  store t6 -> y[i, j * bn]
}

schedule vit_bias_gelu_f for apple-m-series { threads 256 }

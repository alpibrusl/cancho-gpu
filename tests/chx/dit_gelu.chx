// GELU with the tanh approximation, 0.5 v (1 + tanh(sqrt(2/pi) (v + 0.044715 v^3))), for s rows of n, bn columns to a threadgroup; f16 output (docs/diffusion.md D2e: the activation of
// txt_in between its two matrix products, which takes f16). torch's `nn.GELU(approximate="tanh")`.
algo dit_gelu(s, n, bn)
  in  x: f32[s, n]
  out y: f16[s, n]
{
  grid i over s, j over n / bn
  let vv = load x[i, j * bn ; 1, bn]
  let v2 = &vv * &vv
  let v3 = v2 * &vv
  let t1 = v3 * 0.044715
  let t2 = &vv + t1
  let t3 = t2 * 0.7978845608028654
  let th = tanh t3
  let t4 = th + 1
  let t5 = vv * t4
  let t6 = t5 * 0.5
  let oh = stage f16 t6
  store oh -> y[i, j * bn]
}

schedule dit_gelu for apple-m-series { threads 256 }
schedule dit_gelu for nvidia-ada     { threads 256 }

// attention_pvl.chx for the rows of a prefill chunk in one launch (docs/serving.md section 12): row r's head i, the columns dc * dw ..
// (dc + 1) * dw of v, the one cache every row of the chunk reads, with the scores of attention_scores_rows.chx and the maximum m and the
// normaliser z of each of the row's query heads from attention_stats.chx (taken over the nr * nkv * g rows of the scores),
//
//     o = sum over chunks of  exp(s - m) / z  v
//
// One carried [g, dw] accumulator over chunks of cs positions, so no tile grows with t: attention_pv_rows.chx's arithmetic past its
// ceiling of a [g, t] tile.
algo attention_pvl_rows(nr, nkv, g, t, cs, dw, d, tmax)
  in  sc: f32[nr * nkv * g, t]
  in  m:  f32[nr * nkv * g]
  in  z:  f32[nr * nkv * g]
  in  v:  f32[nkv * tmax, d]
  out o:  f32[nr * nkv * g, d]
{
  grid r over nr, i over nkv, dc over d / dw
  let a0 = zeros f32[g, dw]
  let acc = for c in 0 .. t / cs with a0 {
    let sm = load sc[r * (nkv * g) + i * g, c * cs ; g, cs]
    let mm = load m[r * (nkv * g) + i * g ; g]
    let zz = load z[r * (nkv * g) + i * g ; g]
    let sh = sm - mm
    let e  = exp sh
    let p  = e / zz
    let vt = load v[i * tmax + c * cs, dc * dw ; cs, dw]
    yield a0 + matmul p vt
  }
  store acc -> o[r * (nkv * g) + i * g, dc * dw]
}

schedule attention_pvl_rows for apple-m-series { threads 256 }
schedule attention_pvl_rows for nvidia-ada     { threads 128 }
schedule attention_pvl_rows for amd-cdna3      { threads 128 }

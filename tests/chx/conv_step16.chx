// conv_step.chx for the 16 tokens of a prefill chunk, in one launch (docs/serving.md section 8). The window (the
// last 3 inputs of every channel) is carried from row to row as in conv_step3.chx: the output of row t is the
// weights against the sequence (cs, x) from t to t + 3. Only the window after the last row is written; ns may be
// the buffer cs is read from: its stores are the last statements, after every load of cs. Every value is loaded
// where it is used, so each is used once. (Written by a script; edit the result.)
algo conv_step16(c)
  in  x:  f32[16, c]
  in  cs: f32[3, c]
  in  cw: f32[4, c]
  out y:  f32[16, c]
  out ns: f32[3, c]
  tile bc
{
  grid i over c / bc
  let v0_0 = load cs[0, i * bc ; 1, bc]
  let w0_0 = load cw[0, i * bc ; 1, bc]
  let v0_1 = load cs[1, i * bc ; 1, bc]
  let w0_1 = load cw[1, i * bc ; 1, bc]
  let v0_2 = load cs[2, i * bc ; 1, bc]
  let w0_2 = load cw[2, i * bc ; 1, bc]
  let v0_3 = load x[0, i * bc ; 1, bc]
  let w0_3 = load cw[3, i * bc ; 1, bc]
  let a0 = v0_0 * w0_0
  let b0 = v0_1 * w0_1
  let d0 = v0_2 * w0_2
  let e0 = v0_3 * w0_3
  let ab0 = a0 + b0
  let de0 = d0 + e0
  let t0 = ab0 + de0
  let g0 = sigmoid &t0
  store t0 * g0 -> y[0, i * bc]
  let v1_0 = load cs[1, i * bc ; 1, bc]
  let w1_0 = load cw[0, i * bc ; 1, bc]
  let v1_1 = load cs[2, i * bc ; 1, bc]
  let w1_1 = load cw[1, i * bc ; 1, bc]
  let v1_2 = load x[0, i * bc ; 1, bc]
  let w1_2 = load cw[2, i * bc ; 1, bc]
  let v1_3 = load x[1, i * bc ; 1, bc]
  let w1_3 = load cw[3, i * bc ; 1, bc]
  let a1 = v1_0 * w1_0
  let b1 = v1_1 * w1_1
  let d1 = v1_2 * w1_2
  let e1 = v1_3 * w1_3
  let ab1 = a1 + b1
  let de1 = d1 + e1
  let t1 = ab1 + de1
  let g1 = sigmoid &t1
  store t1 * g1 -> y[1, i * bc]
  let v2_0 = load cs[2, i * bc ; 1, bc]
  let w2_0 = load cw[0, i * bc ; 1, bc]
  let v2_1 = load x[0, i * bc ; 1, bc]
  let w2_1 = load cw[1, i * bc ; 1, bc]
  let v2_2 = load x[1, i * bc ; 1, bc]
  let w2_2 = load cw[2, i * bc ; 1, bc]
  let v2_3 = load x[2, i * bc ; 1, bc]
  let w2_3 = load cw[3, i * bc ; 1, bc]
  let a2 = v2_0 * w2_0
  let b2 = v2_1 * w2_1
  let d2 = v2_2 * w2_2
  let e2 = v2_3 * w2_3
  let ab2 = a2 + b2
  let de2 = d2 + e2
  let t2 = ab2 + de2
  let g2 = sigmoid &t2
  store t2 * g2 -> y[2, i * bc]
  let v3_0 = load x[0, i * bc ; 1, bc]
  let w3_0 = load cw[0, i * bc ; 1, bc]
  let v3_1 = load x[1, i * bc ; 1, bc]
  let w3_1 = load cw[1, i * bc ; 1, bc]
  let v3_2 = load x[2, i * bc ; 1, bc]
  let w3_2 = load cw[2, i * bc ; 1, bc]
  let v3_3 = load x[3, i * bc ; 1, bc]
  let w3_3 = load cw[3, i * bc ; 1, bc]
  let a3 = v3_0 * w3_0
  let b3 = v3_1 * w3_1
  let d3 = v3_2 * w3_2
  let e3 = v3_3 * w3_3
  let ab3 = a3 + b3
  let de3 = d3 + e3
  let t3 = ab3 + de3
  let g3 = sigmoid &t3
  store t3 * g3 -> y[3, i * bc]
  let v4_0 = load x[1, i * bc ; 1, bc]
  let w4_0 = load cw[0, i * bc ; 1, bc]
  let v4_1 = load x[2, i * bc ; 1, bc]
  let w4_1 = load cw[1, i * bc ; 1, bc]
  let v4_2 = load x[3, i * bc ; 1, bc]
  let w4_2 = load cw[2, i * bc ; 1, bc]
  let v4_3 = load x[4, i * bc ; 1, bc]
  let w4_3 = load cw[3, i * bc ; 1, bc]
  let a4 = v4_0 * w4_0
  let b4 = v4_1 * w4_1
  let d4 = v4_2 * w4_2
  let e4 = v4_3 * w4_3
  let ab4 = a4 + b4
  let de4 = d4 + e4
  let t4 = ab4 + de4
  let g4 = sigmoid &t4
  store t4 * g4 -> y[4, i * bc]
  let v5_0 = load x[2, i * bc ; 1, bc]
  let w5_0 = load cw[0, i * bc ; 1, bc]
  let v5_1 = load x[3, i * bc ; 1, bc]
  let w5_1 = load cw[1, i * bc ; 1, bc]
  let v5_2 = load x[4, i * bc ; 1, bc]
  let w5_2 = load cw[2, i * bc ; 1, bc]
  let v5_3 = load x[5, i * bc ; 1, bc]
  let w5_3 = load cw[3, i * bc ; 1, bc]
  let a5 = v5_0 * w5_0
  let b5 = v5_1 * w5_1
  let d5 = v5_2 * w5_2
  let e5 = v5_3 * w5_3
  let ab5 = a5 + b5
  let de5 = d5 + e5
  let t5 = ab5 + de5
  let g5 = sigmoid &t5
  store t5 * g5 -> y[5, i * bc]
  let v6_0 = load x[3, i * bc ; 1, bc]
  let w6_0 = load cw[0, i * bc ; 1, bc]
  let v6_1 = load x[4, i * bc ; 1, bc]
  let w6_1 = load cw[1, i * bc ; 1, bc]
  let v6_2 = load x[5, i * bc ; 1, bc]
  let w6_2 = load cw[2, i * bc ; 1, bc]
  let v6_3 = load x[6, i * bc ; 1, bc]
  let w6_3 = load cw[3, i * bc ; 1, bc]
  let a6 = v6_0 * w6_0
  let b6 = v6_1 * w6_1
  let d6 = v6_2 * w6_2
  let e6 = v6_3 * w6_3
  let ab6 = a6 + b6
  let de6 = d6 + e6
  let t6 = ab6 + de6
  let g6 = sigmoid &t6
  store t6 * g6 -> y[6, i * bc]
  let v7_0 = load x[4, i * bc ; 1, bc]
  let w7_0 = load cw[0, i * bc ; 1, bc]
  let v7_1 = load x[5, i * bc ; 1, bc]
  let w7_1 = load cw[1, i * bc ; 1, bc]
  let v7_2 = load x[6, i * bc ; 1, bc]
  let w7_2 = load cw[2, i * bc ; 1, bc]
  let v7_3 = load x[7, i * bc ; 1, bc]
  let w7_3 = load cw[3, i * bc ; 1, bc]
  let a7 = v7_0 * w7_0
  let b7 = v7_1 * w7_1
  let d7 = v7_2 * w7_2
  let e7 = v7_3 * w7_3
  let ab7 = a7 + b7
  let de7 = d7 + e7
  let t7 = ab7 + de7
  let g7 = sigmoid &t7
  store t7 * g7 -> y[7, i * bc]
  let v8_0 = load x[5, i * bc ; 1, bc]
  let w8_0 = load cw[0, i * bc ; 1, bc]
  let v8_1 = load x[6, i * bc ; 1, bc]
  let w8_1 = load cw[1, i * bc ; 1, bc]
  let v8_2 = load x[7, i * bc ; 1, bc]
  let w8_2 = load cw[2, i * bc ; 1, bc]
  let v8_3 = load x[8, i * bc ; 1, bc]
  let w8_3 = load cw[3, i * bc ; 1, bc]
  let a8 = v8_0 * w8_0
  let b8 = v8_1 * w8_1
  let d8 = v8_2 * w8_2
  let e8 = v8_3 * w8_3
  let ab8 = a8 + b8
  let de8 = d8 + e8
  let t8 = ab8 + de8
  let g8 = sigmoid &t8
  store t8 * g8 -> y[8, i * bc]
  let v9_0 = load x[6, i * bc ; 1, bc]
  let w9_0 = load cw[0, i * bc ; 1, bc]
  let v9_1 = load x[7, i * bc ; 1, bc]
  let w9_1 = load cw[1, i * bc ; 1, bc]
  let v9_2 = load x[8, i * bc ; 1, bc]
  let w9_2 = load cw[2, i * bc ; 1, bc]
  let v9_3 = load x[9, i * bc ; 1, bc]
  let w9_3 = load cw[3, i * bc ; 1, bc]
  let a9 = v9_0 * w9_0
  let b9 = v9_1 * w9_1
  let d9 = v9_2 * w9_2
  let e9 = v9_3 * w9_3
  let ab9 = a9 + b9
  let de9 = d9 + e9
  let t9 = ab9 + de9
  let g9 = sigmoid &t9
  store t9 * g9 -> y[9, i * bc]
  let v10_0 = load x[7, i * bc ; 1, bc]
  let w10_0 = load cw[0, i * bc ; 1, bc]
  let v10_1 = load x[8, i * bc ; 1, bc]
  let w10_1 = load cw[1, i * bc ; 1, bc]
  let v10_2 = load x[9, i * bc ; 1, bc]
  let w10_2 = load cw[2, i * bc ; 1, bc]
  let v10_3 = load x[10, i * bc ; 1, bc]
  let w10_3 = load cw[3, i * bc ; 1, bc]
  let a10 = v10_0 * w10_0
  let b10 = v10_1 * w10_1
  let d10 = v10_2 * w10_2
  let e10 = v10_3 * w10_3
  let ab10 = a10 + b10
  let de10 = d10 + e10
  let t10 = ab10 + de10
  let g10 = sigmoid &t10
  store t10 * g10 -> y[10, i * bc]
  let v11_0 = load x[8, i * bc ; 1, bc]
  let w11_0 = load cw[0, i * bc ; 1, bc]
  let v11_1 = load x[9, i * bc ; 1, bc]
  let w11_1 = load cw[1, i * bc ; 1, bc]
  let v11_2 = load x[10, i * bc ; 1, bc]
  let w11_2 = load cw[2, i * bc ; 1, bc]
  let v11_3 = load x[11, i * bc ; 1, bc]
  let w11_3 = load cw[3, i * bc ; 1, bc]
  let a11 = v11_0 * w11_0
  let b11 = v11_1 * w11_1
  let d11 = v11_2 * w11_2
  let e11 = v11_3 * w11_3
  let ab11 = a11 + b11
  let de11 = d11 + e11
  let t11 = ab11 + de11
  let g11 = sigmoid &t11
  store t11 * g11 -> y[11, i * bc]
  let v12_0 = load x[9, i * bc ; 1, bc]
  let w12_0 = load cw[0, i * bc ; 1, bc]
  let v12_1 = load x[10, i * bc ; 1, bc]
  let w12_1 = load cw[1, i * bc ; 1, bc]
  let v12_2 = load x[11, i * bc ; 1, bc]
  let w12_2 = load cw[2, i * bc ; 1, bc]
  let v12_3 = load x[12, i * bc ; 1, bc]
  let w12_3 = load cw[3, i * bc ; 1, bc]
  let a12 = v12_0 * w12_0
  let b12 = v12_1 * w12_1
  let d12 = v12_2 * w12_2
  let e12 = v12_3 * w12_3
  let ab12 = a12 + b12
  let de12 = d12 + e12
  let t12 = ab12 + de12
  let g12 = sigmoid &t12
  store t12 * g12 -> y[12, i * bc]
  let v13_0 = load x[10, i * bc ; 1, bc]
  let w13_0 = load cw[0, i * bc ; 1, bc]
  let v13_1 = load x[11, i * bc ; 1, bc]
  let w13_1 = load cw[1, i * bc ; 1, bc]
  let v13_2 = load x[12, i * bc ; 1, bc]
  let w13_2 = load cw[2, i * bc ; 1, bc]
  let v13_3 = load x[13, i * bc ; 1, bc]
  let w13_3 = load cw[3, i * bc ; 1, bc]
  let a13 = v13_0 * w13_0
  let b13 = v13_1 * w13_1
  let d13 = v13_2 * w13_2
  let e13 = v13_3 * w13_3
  let ab13 = a13 + b13
  let de13 = d13 + e13
  let t13 = ab13 + de13
  let g13 = sigmoid &t13
  store t13 * g13 -> y[13, i * bc]
  let v14_0 = load x[11, i * bc ; 1, bc]
  let w14_0 = load cw[0, i * bc ; 1, bc]
  let v14_1 = load x[12, i * bc ; 1, bc]
  let w14_1 = load cw[1, i * bc ; 1, bc]
  let v14_2 = load x[13, i * bc ; 1, bc]
  let w14_2 = load cw[2, i * bc ; 1, bc]
  let v14_3 = load x[14, i * bc ; 1, bc]
  let w14_3 = load cw[3, i * bc ; 1, bc]
  let a14 = v14_0 * w14_0
  let b14 = v14_1 * w14_1
  let d14 = v14_2 * w14_2
  let e14 = v14_3 * w14_3
  let ab14 = a14 + b14
  let de14 = d14 + e14
  let t14 = ab14 + de14
  let g14 = sigmoid &t14
  store t14 * g14 -> y[14, i * bc]
  let v15_0 = load x[12, i * bc ; 1, bc]
  let w15_0 = load cw[0, i * bc ; 1, bc]
  let v15_1 = load x[13, i * bc ; 1, bc]
  let w15_1 = load cw[1, i * bc ; 1, bc]
  let v15_2 = load x[14, i * bc ; 1, bc]
  let w15_2 = load cw[2, i * bc ; 1, bc]
  let v15_3 = load x[15, i * bc ; 1, bc]
  let w15_3 = load cw[3, i * bc ; 1, bc]
  let a15 = v15_0 * w15_0
  let b15 = v15_1 * w15_1
  let d15 = v15_2 * w15_2
  let e15 = v15_3 * w15_3
  let ab15 = a15 + b15
  let de15 = d15 + e15
  let t15 = ab15 + de15
  let g15 = sigmoid &t15
  store t15 * g15 -> y[15, i * bc]
  let o0 = load x[13, i * bc ; 1, bc]
  store o0 -> ns[0, i * bc]
  let o1 = load x[14, i * bc ; 1, bc]
  store o1 -> ns[1, i * bc]
  let o2 = load x[15, i * bc ; 1, bc]
  store o2 -> ns[2, i * bc]
}

schedule conv_step16 for apple-m-series { threads 256 bc 256 }
schedule conv_step16 for nvidia-ada     { threads 256 bc 256 }
schedule conv_step16 for amd-cdna3     { threads 256 bc 256 }

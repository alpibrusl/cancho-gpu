// The statistics of a softmax in one pass over the scores with the running maximum and the running normaliser carried together (docs/diffusion.md D14, the first user of a loop that carries two tiles): for each row, m = the maximum of
// scores + mask and z = sum exp(s + mask - m), the same m and z as dit_stats_m.chx (which reads the scores twice) and as dit_stats_c.chx with dit_stats_comb.chx (which split the scores into chunks to read them once). When a chunk raises the
// maximum, the sum so far is rescaled by exp(old - new), with the new maximum formed as old + relu(chunk max - old) (the surface has no `max a b`: docs/resident.md 24.1).
algo dit_stats_o(nh, nq, t, qs, cs)
  in  sc:   f32[nh * nq, t]
  in  mask: f32[nq, t]
  out m:    f32[nh * nq]
  out z:    f32[nh * nq]
{
  grid h over nh, qb over nq / qs
  let f0 = load sc[h * nq + qb * qs, 0 ; qs, cs]
  let k0 = load mask[qb * qs, 0 ; qs, cs]
  let s0 = f0 + k0
  let m1 = rowmax &s0
  let e0 = exp (s0 - &m1)
  let z1 = rowsum e0
  let mx, zz = for c in 1 .. t / cs with m1, z1 {
    let sm = load sc[h * nq + qb * qs, c * cs ; qs, cs]
    let mk = load mask[qb * qs, c * cs ; qs, cs]
    let s2 = sm + mk
    let cm = rowmax &s2
    let r  = relu (cm - &m1)
    let mn = &m1 + r
    let nr = m1 - &mn
    let al = exp nr
    let sh = s2 - &mn
    let e  = exp sh
    let cz = rowsum e
    let zs = z1 * al
    yield mn, zs + cz
  }
  store mx -> m[h * nq + qb * qs]
  store zz -> z[h * nq + qb * qs]
}

schedule dit_stats_o for apple-m-series { threads 64 }
schedule dit_stats_o for nvidia-ada     { threads 128 }

  let g2_4 = load g[4*nk*3 + i * 3 + 2, 0 ; 1, 128]
  let sg2_4 = sn2_3 * g2_4
  let kp2_4 = load k[4*nk + i, 0 ; 1, 128]
  let p2_4 = &sg2_4 * kp2_4
  let m2_4 = rowsum p2_4
  let v2_4 = load v[45056 + i * 384 + 256 + r * br ; br]
  let d2_4 = v2_4 - m2_4
  let b2_4 = load bt[4*nk*384 + i * 384 + 256 + r * br ; br]
  let e2_4 = d2_4 * b2_4
  let z2_4 = zeros f32[br, 128]
  let kk2_4 = load k[4*nk + i, 0 ; 1, 128]
  let k02_4 = z2_4 + kk2_4
  let u2_4 = k02_4 * e2_4
  let sn2_4 = sg2_4 + u2_4
  let qb2_4 = load q[4*nk + i, 0 ; 1, 128]
  let y2_4 = &sn2_4 * qb2_4
  store rowsum y2_4 -> y[4*nk*384 + i * 384 + 256 + r * br]
  let g2_5 = load g[5*nk*3 + i * 3 + 2, 0 ; 1, 128]
  let sg2_5 = sn2_4 * g2_5
  let kp2_5 = load k[5*nk + i, 0 ; 1, 128]
  let p2_5 = &sg2_5 * kp2_5
  let m2_5 = rowsum p2_5
  let v2_5 = load v[55296 + i * 384 + 256 + r * br ; br]
  let d2_5 = v2_5 - m2_5
  let b2_5 = load bt[5*nk*384 + i * 384 + 256 + r * br ; br]
  let e2_5 = d2_5 * b2_5
  let z2_5 = zeros f32[br, 128]
  let kk2_5 = load k[5*nk + i, 0 ; 1, 128]
  let k02_5 = z2_5 + kk2_5
  let u2_5 = k02_5 * e2_5
  let sn2_5 = sg2_5 + u2_5
  let qb2_5 = load q[5*nk + i, 0 ; 1, 128]
  let y2_5 = &sn2_5 * qb2_5
  store rowsum y2_5 -> y[5*nk*384 + i * 384 + 256 + r * br]
  let g2_6 = load g[6*nk*3 + i * 3 + 2, 0 ; 1, 128]
  let sg2_6 = sn2_5 * g2_6
  let kp2_6 = load k[6*nk + i, 0 ; 1, 128]
  let p2_6 = &sg2_6 * kp2_6
  let m2_6 = rowsum p2_6
  let v2_6 = load v[65536 + i * 384 + 256 + r * br ; br]
  let d2_6 = v2_6 - m2_6
  let b2_6 = load bt[6*nk*384 + i * 384 + 256 + r * br ; br]
  let e2_6 = d2_6 * b2_6
  let z2_6 = zeros f32[br, 128]
  let kk2_6 = load k[6*nk + i, 0 ; 1, 128]
  let k02_6 = z2_6 + kk2_6
  let u2_6 = k02_6 * e2_6
  let sn2_6 = sg2_6 + u2_6
  let qb2_6 = load q[6*nk + i, 0 ; 1, 128]
  let y2_6 = &sn2_6 * qb2_6
  store rowsum y2_6 -> y[6*nk*384 + i * 384 + 256 + r * br]
  let g2_7 = load g[7*nk*3 + i * 3 + 2, 0 ; 1, 128]
  let sg2_7 = sn2_6 * g2_7
  let kp2_7 = load k[7*nk + i, 0 ; 1, 128]
  let p2_7 = &sg2_7 * kp2_7
  let m2_7 = rowsum p2_7
  let v2_7 = load v[75776 + i * 384 + 256 + r * br ; br]
  let d2_7 = v2_7 - m2_7
  let b2_7 = load bt[7*nk*384 + i * 384 + 256 + r * br ; br]
  let e2_7 = d2_7 * b2_7
  let z2_7 = zeros f32[br, 128]
  let kk2_7 = load k[7*nk + i, 0 ; 1, 128]
  let k02_7 = z2_7 + kk2_7
  let u2_7 = k02_7 * e2_7
  let sn2_7 = sg2_7 + u2_7
  let qb2_7 = load q[7*nk + i, 0 ; 1, 128]
  let y2_7 = &sn2_7 * qb2_7
  store rowsum y2_7 -> y[7*nk*384 + i * 384 + 256 + r * br]
  store sn2_7 -> so[i * 384 + 256 + r * br, 0]
}

schedule delta_step8 for apple-m-series { threads 256 br 8 }
schedule delta_step8 for nvidia-ada     { threads 128 br 32 }

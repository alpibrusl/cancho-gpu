// The weighted sum of v over TWO segments of keys (docs/two-images.md section 8): o = sum over the key chunks of the cached prefix's (t1) and then the target's (t2) of exp(s + mask - m) / z v, from the scores, masks and values of each segment and the
// statistics of dit_stats_o2.chx. **The same o as dit_pv_mma.chx on the two segments laid side by side** (the chunks are accumulated in the same order).
algo dit_pv_mma2(nh, nq, t1, t2, d)
  in  sc1:   f32[nh * nq, t1]
  in  mask1: f32[nq, t1]
  in  sc2:   f32[nh * nq, t2]
  in  mask2: f32[nq, t2]
  in  m:     f32[nh * nq]
  in  z:     f32[nh * nq]
  in  v1:    f16[t1, nh * d]
  in  v2:    f16[t2, nh * d]
  out o:     f32[nq, nh * d]
  tile bm, bn, bk
{
  grid h over nh, i over nq / bm, j over d / bn
  let acc = zeros f32[bm, bn] @frag
  let acc = for p in 0 .. t1 / bk with acc {
    let sm = load sc1[h * nq + i * bm, p * bk ; bm, bk]
    let mk = load mask1[i * bm, p * bk ; bm, bk]
    let s2 = sm + mk
    let mm = load m[h * nq + i * bm ; bm]
    let zz = load z[h * nq + i * bm ; bm]
    let sh = s2 - mm
    let e  = exp sh
    let pp = e / zz
    let ph = stage f16 pp
    let vt = load v1[p * bk, h * d + j * bn ; bk, bn] @shared
    yield mma_nn acc ph vt
  }
  let acc = for p in 0 .. t2 / bk with acc {
    let sm = load sc2[h * nq + i * bm, p * bk ; bm, bk]
    let mk = load mask2[i * bm, p * bk ; bm, bk]
    let s2 = sm + mk
    let mm = load m[h * nq + i * bm ; bm]
    let zz = load z[h * nq + i * bm ; bm]
    let sh = s2 - mm
    let e  = exp sh
    let pp = e / zz
    let ph = stage f16 pp
    let vt = load v2[p * bk, h * d + j * bn ; bk, bn] @shared
    yield mma_nn acc ph vt
  }
  store acc -> o[i * bm, h * d + j * bn]
}

schedule dit_pv_mma2 for apple-m-series { threads 256 warps 8 1 bm 64 bn 128 bk 32 }
schedule dit_pv_mma2 for nvidia-ada     { threads 128 warps 2 2 bm 64 bn 64 bk 32 }

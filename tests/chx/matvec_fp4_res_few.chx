// y = x w^T + r for a few rows of x (the tokens a speculative step checks, 2 to 4), NVFP4 weights read once: the
// generic batched product on the plain scalar path, 256 threads and 32 weight rows to a threadgroup. Chosen
// inside the running verify: 47.1 ms a verify with this schedule, 49.9 at 512 threads, 61.5 at 1024. (One
// kernel alone pointed elsewhere: 111 / 121 / 142 us for 1 / 2 / 3 rows at 512 threads, against 209 / 270 / 296
// at 256 threads and 8 rows.) The `_batch` kernels are the matrix-unit ones, for prefill chunks of 8.
algo matvec_fp4_res_few(m, n, k)
  in  x:  f32[m, k]
  in  wq: i8[n, k / 2]
  in  ws: i8[n, k / 16]
  in  wg: f32[n]
  in  r:  f32[m, n]
  out y:  f32[m, n]
  tile bn
{
  grid i over n / bn
  let xt = load x
  let q  = load wq[i * bn, 0 ; bn, k / 2]
  let s  = load ws[i * bn, 0 ; bn, k / 16]
  let g  = load wg[i * bn ; bn]
  let rt = load r[0, i * bn ; m, bn]
  let w  = dequant_fp4 q s g 16
  let p  = matmul_nt xt w
  store p + rt -> y[0, i * bn]
}

schedule matvec_fp4_res_few for apple-m-series { threads 256 bn 32 }
schedule matvec_fp4_res_few for nvidia-ada     { threads 256 bn 8 }

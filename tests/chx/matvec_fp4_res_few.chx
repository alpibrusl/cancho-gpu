// y = x w^T + r for a few rows of x, NVFP4 weights read once: the tokens a speculative step checks (2 to 4). The generic batched
// product on the plain scalar path with 512 threads and 32 weight rows to a threadgroup: measured on the
// 17408x5120 gate matrix, 111 / 121 / 142 us for 1 / 2 / 3 rows against 209 / 270 / 296 us at 256 threads and
// 8 rows (issue 26). The `_batch` kernels are the matrix-unit ones, for prefill chunks of 8.
algo matvec_fp4_res_few(m, n, k)
  in  x:  f32[m, k]
  in  wq: i8[n, k / 2]
  in  ws: i8[n, k / 16]
  in  wg: f32[n]
  in  r:  f32[m, n]
  out y:  f32[m, n]
  tile bn
{
  grid i over n / bn
  let xt = load x
  let q  = load wq[i * bn, 0 ; bn, k / 2]
  let s  = load ws[i * bn, 0 ; bn, k / 16]
  let g  = load wg[i * bn ; bn]
  let rt = load r[0, i * bn ; m, bn]
  let w  = dequant_fp4 q s g 16
  let p  = matmul_nt xt w
  store p + rt -> y[0, i * bn]
}

schedule matvec_fp4_res_few for apple-m-series { threads 512 bn 32 }
schedule matvec_fp4_res_few for nvidia-ada     { threads 256 bn 8 }

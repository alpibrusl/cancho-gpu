// The gate and up projections of a SwiGLU MLP and the activation, in one
// kernel: y = silu(x wg^T) * (x wu^T), both weights NVFP4 (see
// matvec_fp4_rows.chx). One launch where there were three, and the two
// products never go to memory.
algo matvec_fp4_swiglu(n, k)
  in  x:   f32[1, k]
  in  gq:  i8[n, k / 2]
  in  gs:  i8[n, k / 16]
  in  gg:  f32[n]
  in  uq:  i8[n, k / 2]
  in  us:  i8[n, k / 16]
  in  ug:  f32[n]
  out y:   f32[1, n]
  tile bn
{
  grid i over n / bn
  let xt = load x
  let q1 = load gq[i * bn, 0 ; bn, k / 2]
  let s1 = load gs[i * bn, 0 ; bn, k / 16]
  let g1 = load gg[i * bn ; bn]
  let q2 = load uq[i * bn, 0 ; bn, k / 2]
  let s2 = load us[i * bn, 0 ; bn, k / 16]
  let g2 = load ug[i * bn ; bn]
  let w1 = dequant_fp4 q1 s1 g1 16
  let w2 = dequant_fp4 q2 s2 g2 16
  let gt = matmul_nt &xt w1
  let ut = matmul_nt xt w2
  let sg = sigmoid &gt
  let a  = gt * sg
  store a * ut -> y[0, i * bn]
}

schedule matvec_fp4_swiglu for apple-m-series { threads 256 bn 8 }
schedule matvec_fp4_swiglu for nvidia-ada     { threads 256 bn 8 }

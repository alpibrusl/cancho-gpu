// y = x * rsqrt(mean(x^2) + eps) * w for each of r rows of n, with one weight row
// shared by all of them: the per-head norm of a query or a key. One threadgroup a row (without a `grid` the
// rows of a speculative check ran on one: 49 us for 3 rows of 5120, 14 with it, the same bits).
algo rmsnorm_rows(r, n, eps)
  in  x: f32[r, n]
  in  w: f32[1, n]
  out y: f32[r, n]
{
  grid i over r
  let x  = load x[i, 0 ; 1, n]
  let sq = &x * &x
  let ss = rowsum sq
  let ms = ss * (1 / n)
  let t  = ms + eps
  let rs = rsqrt t
  let xn = x * rs
  let w  = load w
  store xn * w -> y[i, 0]
}

schedule rmsnorm_rows for apple-m-series { threads 256 }
schedule rmsnorm_rows for nvidia-ada     { threads 256 }

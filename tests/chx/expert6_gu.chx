// Written by scripts/gen-kolibri-kernels.sh: do not edit. The 6 experts a token takes, each expert's gate and up products and the activation, as one launch (docs/kolibri.md section 20):
// y[e] = silu(x ge^T) * (x ue^T) with Q4_0 weights (matvec_q4_rows.chx's product), x row b of r rows. The matrices are the layer's tables of ne experts; expert e of the token
// is the one sel[b * 6 + e] names, the router's choice (moe_pick.chx's idx), which the kernel reads itself (section 26).
algo expert6_gu(r, b, n, k, ne)
  in  x:   f32[r, k]
  in  gq:  i8[ne * n, k / 2]
  in  gs:  f16[ne * n, k / 32]
  in  uq:  i8[ne * n, k / 2]
  in  us:  f16[ne * n, k / 32]
  in  wg:  f32[n]
  in  sel: f32[r * 6]
  out y:   f32[6, n]
  tile bn
{
  grid i over n / bn
  pick p0 under ne from sel[b * 6 + 0]
  pick p1 under ne from sel[b * 6 + 1]
  pick p2 under ne from sel[b * 6 + 2]
  pick p3 under ne from sel[b * 6 + 3]
  pick p4 under ne from sel[b * 6 + 4]
  pick p5 under ne from sel[b * 6 + 5]
  let x0 = load x[b, 0 ; 1, k]
  let a0 = load gq[p0 * n + i * bn, 0 ; bn, k / 2]
  let b0 = load gs[p0 * n + i * bn, 0 ; bn, k / 32]
  let c0 = load wg[i * bn ; bn]
  let d0 = load uq[p0 * n + i * bn, 0 ; bn, k / 2]
  let e0 = load us[p0 * n + i * bn, 0 ; bn, k / 32]
  let f0 = load wg[i * bn ; bn]
  let w0 = dequant_q4 a0 b0 c0 32
  let v0 = dequant_q4 d0 e0 f0 32
  let g0 = matmul_nt &x0 w0
  let u0 = matmul_nt x0 v0
  let s0 = sigmoid &g0
  let t0 = g0 * s0
  store t0 * u0 -> y[0, i * bn]
  let x1 = load x[b, 0 ; 1, k]
  let a1 = load gq[p1 * n + i * bn, 0 ; bn, k / 2]
  let b1 = load gs[p1 * n + i * bn, 0 ; bn, k / 32]
  let c1 = load wg[i * bn ; bn]
  let d1 = load uq[p1 * n + i * bn, 0 ; bn, k / 2]
  let e1 = load us[p1 * n + i * bn, 0 ; bn, k / 32]
  let f1 = load wg[i * bn ; bn]
  let w1 = dequant_q4 a1 b1 c1 32
  let v1 = dequant_q4 d1 e1 f1 32
  let g1 = matmul_nt &x1 w1
  let u1 = matmul_nt x1 v1
  let s1 = sigmoid &g1
  let t1 = g1 * s1
  store t1 * u1 -> y[1, i * bn]
  let x2 = load x[b, 0 ; 1, k]
  let a2 = load gq[p2 * n + i * bn, 0 ; bn, k / 2]
  let b2 = load gs[p2 * n + i * bn, 0 ; bn, k / 32]
  let c2 = load wg[i * bn ; bn]
  let d2 = load uq[p2 * n + i * bn, 0 ; bn, k / 2]
  let e2 = load us[p2 * n + i * bn, 0 ; bn, k / 32]
  let f2 = load wg[i * bn ; bn]
  let w2 = dequant_q4 a2 b2 c2 32
  let v2 = dequant_q4 d2 e2 f2 32
  let g2 = matmul_nt &x2 w2
  let u2 = matmul_nt x2 v2
  let s2 = sigmoid &g2
  let t2 = g2 * s2
  store t2 * u2 -> y[2, i * bn]
  let x3 = load x[b, 0 ; 1, k]
  let a3 = load gq[p3 * n + i * bn, 0 ; bn, k / 2]
  let b3 = load gs[p3 * n + i * bn, 0 ; bn, k / 32]
  let c3 = load wg[i * bn ; bn]
  let d3 = load uq[p3 * n + i * bn, 0 ; bn, k / 2]
  let e3 = load us[p3 * n + i * bn, 0 ; bn, k / 32]
  let f3 = load wg[i * bn ; bn]
  let w3 = dequant_q4 a3 b3 c3 32
  let v3 = dequant_q4 d3 e3 f3 32
  let g3 = matmul_nt &x3 w3
  let u3 = matmul_nt x3 v3
  let s3 = sigmoid &g3
  let t3 = g3 * s3
  store t3 * u3 -> y[3, i * bn]
  let x4 = load x[b, 0 ; 1, k]
  let a4 = load gq[p4 * n + i * bn, 0 ; bn, k / 2]
  let b4 = load gs[p4 * n + i * bn, 0 ; bn, k / 32]
  let c4 = load wg[i * bn ; bn]
  let d4 = load uq[p4 * n + i * bn, 0 ; bn, k / 2]
  let e4 = load us[p4 * n + i * bn, 0 ; bn, k / 32]
  let f4 = load wg[i * bn ; bn]
  let w4 = dequant_q4 a4 b4 c4 32
  let v4 = dequant_q4 d4 e4 f4 32
  let g4 = matmul_nt &x4 w4
  let u4 = matmul_nt x4 v4
  let s4 = sigmoid &g4
  let t4 = g4 * s4
  store t4 * u4 -> y[4, i * bn]
  let x5 = load x[b, 0 ; 1, k]
  let a5 = load gq[p5 * n + i * bn, 0 ; bn, k / 2]
  let b5 = load gs[p5 * n + i * bn, 0 ; bn, k / 32]
  let c5 = load wg[i * bn ; bn]
  let d5 = load uq[p5 * n + i * bn, 0 ; bn, k / 2]
  let e5 = load us[p5 * n + i * bn, 0 ; bn, k / 32]
  let f5 = load wg[i * bn ; bn]
  let w5 = dequant_q4 a5 b5 c5 32
  let v5 = dequant_q4 d5 e5 f5 32
  let g5 = matmul_nt &x5 w5
  let u5 = matmul_nt x5 v5
  let s5 = sigmoid &g5
  let t5 = g5 * s5
  store t5 * u5 -> y[5, i * bn]
}

schedule expert6_gu for apple-m-series { threads 256 bn 8 }
schedule expert6_gu for nvidia-ada     { threads 256 bn 8 }
schedule expert6_gu for amd-cdna3      { threads 256 bn 8 }

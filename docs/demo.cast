[4.650416, "o", "// a = silu(g) * u over a row of n: the gated activation of a SwiGLU MLP.\r\nalgo swiglu(n)\r\n  in  g: f32[1, n]\r\n  in  u: f32[1, n]\r\n  out y: f32[1, n]\r\n{\r\n  let gt = load g\r\n  let ut = load u\r\n  let sg = sigmoid &gt\r\n  let a  = gt * sg\r\n  store a * ut -> y\r\n}\r\n\r\nschedule swiglu for apple-m-series { threads 256 }\r\nschedule swiglu for nvidia-ada     { threads 256 }\r\n"]

[19.239676, "o", "kernel void swiglu_17408(\r\n    device const float* p0_g [[buffer(0)]],\r\n    device const float* p1_u [[buffer(1)]],\r\n    device float* p2_y [[buffer(2)]],\r\n    uint tid [[thread_index_in_threadgroup]],\r\n    uint3 tgpos [[threadgroup_position_in_grid]])\r\n{\r\n    const uint gid = tgpos.x;\r\n    float v2[68];\r\n    for (uint k = 0; k < 68u; ++k) {\r\n        const uint e = k * 256u + tid;\r\n        if (e < 17408u) {\r\n            v2[k] = float(1.0f / (1.0f + precise::exp(-float(float(p0_g[(uint)(0) * 17408u + (uint)(0) * 1u + ((e))])))));\r\n        }\r\n    }\r\n    float v3[68];\r\n    for (uint k = 0; k < 68u; ++k) {\r\n        const uint e = k * 256u + tid;\r\n        if (e < 17408u) {\r\n            v3[k] = float(float(float(p0_g[(uint)(0) * 17408u + (uint)(0) * 1u + ((e))])) * float(v2[k]));\r\n        }\r\n    }\r\n"]

[27.074515, "o", "algo k(n)\r\n  in  x: f32[1, n]\r\n  in  w: f32[1, n]\r\n  out y: f32[1, n]\r\n{\r\n  let a = load x\r\n  let b = load w\r\n  store sigmoid a -> y\r\n}\r\nschedule k for nvidia-ada { threads 32 }\r\n"]

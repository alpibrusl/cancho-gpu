edition 5;

// `cancho-gpu-metal-session` -- a session on a Metal GPU (`docs/resident.md`):
//
//     cancho-gpu-metal-session <session file>
//
// The same session file as `cancho-gpu-session`, with the kernels compiled for `apple-m-series`. Each kernel is compiled to Metal
// once, every parameter gets a device buffer once, the resident data is uploaded once, and a link is the same buffer for the
// output of one kernel and the input of the next (no trip through the host). A request line then uploads the `input` parameters,
// launches the kernels in order, reads the `answer` outputs back and writes them as one line.
//
// A `save` directive writes an output buffer to a file on the request `checkpoint` (`docs/resident.md` section 19).
//
// Linked with `shim/canchogpu-metal.mm` (`scripts/build-metal-session.sh`).

import std.io;
import mem;
import text;
import err;
import kinds;
import f32;
import ir;
import cli;
import devcodec;
import fileio;
import session;
import ckpt;
import metal;
import msession;

fn usage[&i](io: &!i Io) -> [err_write] int {
    io.error_all(io, "usage: cancho-gpu-metal-session <session file> [NAME=value ...]\n");
    return 2;
}

fn run[&m, &t, &x, &i, &f, &a, &g](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, fs: &f Fs(""), args: &a Args, ffi: &g Ffi("libmetalgpu")) -> [io_read, io_write, err_write, fs_read(""), fs_write(""), file_read, file_write, args, ffi("libmetalgpu")] int {
    if arg_count(args) < 2 {
        return usage(io);
    }
    // `NAME=value` definitions for a model file (docs/resident.md section 31)
    let defs = mem.list(m);
    var ai = 2;
    while ai < arg_count(args) {
        let word = text.from_bytes(m, t, arg(args, ai));
        if text.index_of(t, word, '=', 0) <= 0 {
            return usage(io);
        }
        mem.push(m, defs, word);
        ai = ai + 1;
    }
    let file = arg(args, 1);
    let top = m[mem.text_slot()];
    var got = 0 - 1;
    if fileio.covers(fs, file) {
        got = fs_read(fs, file, t[top..len(t)]);
    }
    if got < 0 {
        io.error_all(io, "error[io]: cannot read ");
        io.error_all(io, file);
        io.error_all(io, "\n");
        return 1;
    }
    m[mem.text_slot()] = top + got;
    // The target is the device's: apple-m-series.
    let sess = session.open(m, t, fm, fs, text.handle(top, got), defs, text.lit(m, t, "apple-m-series"), true, true);
    if sess < 0 {
        return cli.report(m, t, io);
    }
    let (funcs, bufs) = msession.setup(m, t, fm, ffi, fs, sess);
    if funcs < 0 {
        return cli.report(m, t, io);
    }
    let ptabs = msession.tables_by_program(m, sess);
    let mark = m[mem.top_slot()];
    let tmark = m[mem.text_slot()];
    var more = true;
    var status = 0;
    while more {
        var n = 0;
        var c = getchar(io);
        while c >= 0 && c != 10 && n < msession.line_cap() {
            t[tmark + n] = byte_of(c);
            n = n + 1;
            c = getchar(io);
        }
        if c >= 0 && c != 10 {
            let r = err.fail(m, t, "session", text.lit(m, t, "a request line is over 1 MiB"));
            status = cli.report(m, t, io);
            more = false;
        } else if c < 0 && n == 0 {
            more = false;
        } else {
            m[mem.text_slot()] = tmark + n;
            let asked = ckpt.request(m, t, sess, text.handle(tmark, n));
            var done = asked;
            if asked > 0 {
                done = msession.checkpoint(m, t, io, ffi, fs, sess, bufs);
            } else if asked == 0 {
                let (kind, recs) = session.reload_request(m, t, sess, text.handle(tmark, n));
                if kind < 0 {
                    done = 0 - 1;
                } else if kind > 0 {
                    done = msession.reload(m, t, io, ffi, fs, sess, bufs, recs);
                }
                var kcopy = 0;
                if kind == 0 {
                    let (ck, pairs) = session.copy_request(m, t, sess, text.handle(tmark, n));
                    kcopy = ck;
                    if ck < 0 {
                        done = 0 - 1;
                    } else if ck > 0 {
                        done = msession.copy(m, t, io, ffi, sess, bufs, pairs);
                    }
                }
                var sought = 0;
                if kind == 0 && kcopy == 0 {
                    sought = session.seek_request(m, t, sess, text.handle(tmark, n));
                    if sought < 0 {
                        done = 0 - 1;
                    } else if sought > 0 {
                        done = session.print_count(m, t, io, sess);
                    }
                }
                if kind == 0 && kcopy == 0 && sought == 0 {
                    let (reps, rest) = session.take_steps(m, t, sess, text.handle(tmark, n));
                    done = reps;
                    if done >= 0 {
                        done = session.fill_inputs(m, t, fm, sess, rest);
                    }
                    if done >= 0 {
                        done = msession.on_device(m, t, fm, ffi, sess, funcs, bufs, ptabs, reps);
                    }
                    if done >= 0 {
                        done = session.print_answers(m, t, fm, io, sess);
                    }
                }
            }
            if done < 0 {
                status = cli.report(m, t, io);
                more = false;
            } else {
                mem.release_to(m, mark);
                m[mem.text_slot()] = tmark;
                if c < 0 {
                    more = false;
                }
            }
        }
    }
    metal.cgpu_close(ffi);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(net);
    release(clock);
    let gpu = narrow(ffi, "libmetalgpu");
    var status = 0;
    borrow mut heap as &!h in {
        var mb = box_slice(h, msession.words(), 0);
        var tb = box_slice(h, msession.bytes_cap(), byte_of(0));
        var fb = box_slice(h, msession.floats_cap(), 0.0);
        borrow mut mb as &!mr in {
            borrow mut tb as &!tr in {
                borrow mut fb as &!fr in {
                    let m = contents(mr);
                    let t = contents(tr);
                    let fm = contents(fr);
                    mem.init(m);
                    borrow mut io as &!i in {
                        borrow fs as &f in {
                            borrow args as &a in {
                                borrow gpu as &g in {
                                    status = run(m, t, fm, i, f, a, g);
                                }
                            }
                        }
                    }
                }
            }
        }
        unbox_slice(h, mb);
        unbox_slice(h, tb);
        unbox_slice(h, fb);
    }
    release(heap);
    release(io);
    release(fs);
    release(args);
    release(gpu);
    return status;
}

edition 5;
module cuda;

// The shim's entry points (`shim/canchogpu.c`, `docs/device.md` §1), each
// under `Ffi("libcanchogpu")`: integers in, an integer out, and at most one
// byte buffer, last. A negative answer is a failure; `cgpu_error` copies
// its text out.
extern fn cgpu_open[&f](ffi: &f Ffi("libcanchogpu")) -> [ffi("libcanchogpu")] int;

extern fn cgpu_compile[&f, &s](ffi: &f Ffi("libcanchogpu"), src: &s [byte]) -> [ffi("libcanchogpu")] int;

extern fn cgpu_function[&f, &s](ffi: &f Ffi("libcanchogpu"), handle: int, name: &s [byte]) -> [ffi("libcanchogpu")] int;

extern fn cgpu_alloc[&f](ffi: &f Ffi("libcanchogpu"), bytes: int) -> [ffi("libcanchogpu")] int;

extern fn cgpu_upload[&f, &s](ffi: &f Ffi("libcanchogpu"), buf: int, data: &s [byte]) -> [ffi("libcanchogpu")] int;

extern fn cgpu_download[&f, &s](ffi: &f Ffi("libcanchogpu"), buf: int, out: &!s [byte]) -> [ffi("libcanchogpu")] int;

extern fn cgpu_arg[&f](ffi: &f Ffi("libcanchogpu"), buf: int) -> [ffi("libcanchogpu")] int;

extern fn cgpu_launch[&f](ffi: &f Ffi("libcanchogpu"), func: int, gx: int, gy: int, threads: int) -> [ffi("libcanchogpu")] int;

extern fn cgpu_error[&f, &s](ffi: &f Ffi("libcanchogpu"), out: &!s [byte]) -> [ffi("libcanchogpu")] int;

extern fn cgpu_close[&f](ffi: &f Ffi("libcanchogpu")) -> [ffi("libcanchogpu")] int;

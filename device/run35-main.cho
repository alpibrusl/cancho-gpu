edition 5;

// `cancho-gpu-run35` -- run Qwen3.8-27B (`qwen3.8:27b-mlx`, NVFP4) on a Metal GPU
// (`docs/qwen35.md`).
//
//     cancho-gpu-run35 <ollama store> <kernel dir> "<prompt>" <new tokens> [--trace] [--timing] [--single] [--stream] [--mtp-accept] [--spec]
//
// A raw prompt (no chat template: `cancho-gpu-serve` has one), greedy, fed through the engine of
// `device/qwen35.cho`, which holds the model's dimensions and the kernels (`tests/chx/`).
//
// Linked with `shim/canchogpu-metal.mm` (`scripts/build-run35.sh`).

import std.io;
import mem;
import text;
import err;
import cli;
import bpe;
import sampler;
import metal;
import qwen35;

fn words() -> [] int {
    return 100000000;
}

fn bytes_cap() -> [] int {
    return 536870912;
}

fn usage[&i](io: &!i Io) -> [err_write] int {
    io.error_all(io, "usage: cancho-gpu-run35 <ollama store> <kernel dir> \"<prompt>\" <new tokens> [--trace] [--timing] [--single] [--stream] [--mtp-accept] [--spec]\n");
    return 2;
}

// `--mtp-accept`: how often the draft head's guess is the token the model goes on to choose (greedy), the
// number speculation is worth. The prompt is fed one token at a time, the head's cache warmed beside it; then
// each step the head drafts the token after the one just chosen, before the model has seen it.
fn max1(n: int) -> [] int {
    if n < 1 {
        return 1;
    }
    return n;
}

fn accept_run[&m, &t, &i, &f, &g](m: &!m [int], t: &!t [byte], io: &!i Io, fs: &f Fs(""), ffi: &g Ffi("libmetalgpu"), eng: int, tk: int, ids: int, new_tokens: int, raw: int) -> [io_write, err_write, fs_read(""), file_read, ffi("libmetalgpu")] int {
    let n_prompt = mem.size(m, ids);
    let lg = qwen35.reserve(m, 4 * qwen35.vocab());
    let lg3 = qwen35.reserve(m, 4 * qwen35.vocab());
    let lg2 = qwen35.reserve(m, 4 * qwen35.vocab());
    let base = m[mem.text_slot()];
    let hid = qwen35.hidden_buf(m, eng);
    let smp = sampler.new(m, 0.0, 0.95, 20, 1);
    var p = 0;
    while p < n_prompt {
        var want = 0 - 1;
        if p == n_prompt - 1 {
            want = lg;
        }
        if qwen35.feed_one(m, t, ffi, fs, eng, mem.get(m, ids, p), p, want) < 0 {
            return cli.report(m, t, io);
        }
        if p < n_prompt - 1 {
            if qwen35.mtp_step(m, t, ffi, fs, eng, hid, mem.get(m, ids, p + 1), p, 0 - 1) < 0 {
                return cli.report(m, t, io);
            }
        }
        p = p + 1;
    }
    var pos = n_prompt - 1;
    var pending = 0 - 1;
    var drafts = 0;
    var accepted = 0;
    var pending2 = 0 - 1;
    var chain_next = false;
    var chain_now = false;
    var pend2_now = 0 - 1;
    var drafts2 = 0;
    var accepted2 = 0;
    var n = 0;
    let out_ids = mem.list(m);
    var finished = false;
    while !finished && n < new_tokens {
        let (nids, nprobs) = sampler.nucleus(m, t, smp, lg, qwen35.vocab());
        let pick = sampler.draw(m, smp, nids, nprobs);
        if chain_now {
            drafts2 = drafts2 + 1;
            if pend2_now == pick {
                accepted2 = accepted2 + 1;
            }
        }
        chain_now = chain_next;
        pend2_now = pending2;
        chain_next = false;
        if pending >= 0 {
            drafts = drafts + 1;
            if pending == pick {
                accepted = accepted + 1;
                chain_next = true;
            }
        }
        mem.push(m, out_ids, pick);
        n = n + 1;
        if qwen35.is_stop(pick) || n == new_tokens {
            finished = true;
        } else {
            if qwen35.mtp_step(m, t, ffi, fs, eng, hid, pick, pos, lg2) < 0 {
                return cli.report(m, t, io);
            }
            let (dn, dp) = sampler.nucleus(m, t, smp, lg2, qwen35.vocab());
            pending = sampler.draw(m, smp, dn, dp);
            if qwen35.mtp_step(m, t, ffi, fs, eng, qwen35.head_hidden(m, eng, raw), pending, pos + 1, lg3) < 0 {
                return cli.report(m, t, io);
            }
            let (dn2, dp2) = sampler.nucleus(m, t, smp, lg3, qwen35.vocab());
            pending2 = sampler.draw(m, smp, dn2, dp2);
            if qwen35.feed_one(m, t, ffi, fs, eng, pick, pos + 1, lg) < 0 {
                return cli.report(m, t, io);
            }
            pos = pos + 1;
        }
        m[mem.text_slot()] = base;
    }
    let (ds, dn) = bpe.decode(m, t, tk, out_ids);
    io.write_all(io, text.bytes(t, text.handle(ds, dn)));
    io.write_all(io, "\n");
    io.write_all(io, text.bytes(t, text.f3(m, t, "accept: $ of $ drafts ($ per mille)\n", text.num(m, t, accepted), text.num(m, t, drafts), text.num(m, t, accepted * 1000 / max1(drafts)))));
    io.write_all(io, text.bytes(t, text.f3(m, t, "accept2: $ of $ second drafts, given the first ($ per mille)\n", text.num(m, t, accepted2), text.num(m, t, drafts2), text.num(m, t, accepted2 * 1000 / max1(drafts2)))));
    metal.cgpu_close(ffi);
    return 0;
}

// `--spec`: decoding with the draft head (`docs/serving.md`, issue 26). Each round the head drafts the token
// after the last one chosen and the model checks the pair in one pass over the weights; the tokens are the
// ones plain decoding gives. (`qwen35.spec_round`.)
fn spec_run[&m, &t, &i, &f, &g, &c](m: &!m [int], t: &!t [byte], io: &!i Io, fs: &f Fs(""), ffi: &g Ffi("libmetalgpu"), clock: &c Clock, eng: int, tk: int, ids: int, new_tokens: int, timing: bool, t_start: int) -> [io_write, err_write, fs_read(""), file_read, ffi("libmetalgpu"), clock] int {
    let n_prompt = mem.size(m, ids);
    let v = qwen35.vocab();
    let lg = qwen35.reserve(m, 4 * v);
    let lgd = qwen35.reserve(m, 4 * v);
    let rows = qwen35.reserve(m, 8 * v);
    let base = m[mem.text_slot()];
    let smp = sampler.new(m, 0.0, 0.95, 20, 1);
    let gsmp = sampler.new(m, 0.0, 0.95, 20, 1);
    let t_loaded = clock_ms(clock);
    if qwen35.feed(m, t, ffi, fs, eng, ids, 0, n_prompt, lg, true, true) < 0 {
        return cli.report(m, t, io);
    }
    let t_first = clock_ms(clock);
    let out_ids = mem.list(m);
    let (n0, p0) = sampler.nucleus(m, t, smp, lg, v);
    let first = sampler.draw(m, smp, n0, p0);
    mem.push(m, out_ids, first);
    var n = 1;
    let sp = qwen35.spec_init(m, eng, first, n_prompt - 1);
    var rounds = 0;
    var accepted = 0;
    var finished = qwen35.is_stop(first) || n >= new_tokens;
    while !finished {
        if qwen35.spec_pos(m, sp) + 4 >= qwen35.tmax() {
            finished = true;
        } else {
            let got = qwen35.spec_round(m, t, ffi, fs, eng, sp, lgd, rows, smp, gsmp);
            if got < 0 {
                return cli.report(m, t, io);
            }
            rounds = rounds + 1;
            var j = 0;
            while j < got && !finished {
                let tok = qwen35.spec_token(m, sp, j);
                mem.push(m, out_ids, tok);
                n = n + 1;
                if qwen35.is_stop(tok) || n >= new_tokens {
                    finished = true;
                }
                j = j + 1;
            }
            accepted = accepted + got - 1;
        }
        m[mem.text_slot()] = base;
    }
    let t_end = clock_ms(clock);
    let (ds, dn2) = bpe.decode(m, t, tk, out_ids);
    io.write_all(io, text.bytes(t, text.handle(ds, dn2)));
    io.write_all(io, "\n");
    let numbers = mem.list(m);
    var q2 = 0;
    while q2 < mem.size(m, out_ids) {
        mem.push(m, numbers, text.num(m, t, mem.get(m, out_ids, q2)));
        q2 = q2 + 1;
    }
    io.write_all(io, text.bytes(t, text.f1(m, t, "tokens: $\n", text.joined(m, t, numbers, " "))));
    io.write_all(io, text.bytes(t, text.f3(m, t, "spec: $ rounds, $ drafts accepted, $ tokens\n", text.num(m, t, rounds), text.num(m, t, accepted), text.num(m, t, n))));
    if timing {
        io.write_all(io, text.bytes(t, text.fmt(m, t, "timing: load_ms=$ prefill_tokens=$ prefill_ms=$ decode_tokens=$ decode_ms=$\n", mem.of5(m, text.num(m, t, t_loaded - t_start), text.num(m, t, n_prompt), text.num(m, t, t_first - t_loaded), text.num(m, t, n - 1), text.num(m, t, t_end - t_first)))));
    }
    metal.cgpu_close(ffi);
    return 0;
}

fn run[&m, &t, &i, &f, &a, &g, &c](m: &!m [int], t: &!t [byte], io: &!i Io, fs: &f Fs(""), args: &a Args, ffi: &g Ffi("libmetalgpu"), clock: &c Clock) -> [io_write, err_write, fs_read(""), file_read, args, ffi("libmetalgpu"), clock] int {
    let t_start = clock_ms(clock);
    if arg_count(args) < 5 {
        return usage(io);
    }
    let store = text.from_bytes(m, t, arg(args, 1));
    let kdir = text.from_bytes(m, t, arg(args, 2));
    let prompt = arg(args, 3);
    var new_tokens = 0;
    let nt = text.from_bytes(m, t, arg(args, 4));
    var d = 0;
    while d < text.size(nt) {
        new_tokens = new_tokens * 10 + text.at(t, nt, d) - 48;
        d = d + 1;
    }
    var trace = false;
    var timing = false;
    var batched = true;
    var stream = false;
    var mtp_accept = false;
    var chain_raw = 0;
    var spec = false;
    var ai = 5;
    while ai < arg_count(args) {
        let flag = text.from_bytes(m, t, arg(args, ai));
        if text.is(t, flag, "--trace") {
            trace = true;
        } else if text.is(t, flag, "--timing") {
            timing = true;
        } else if text.is(t, flag, "--single") {
            batched = false;
        } else if text.is(t, flag, "--stream") {
            stream = true;
        } else if text.is(t, flag, "--chain-raw") {
            chain_raw = 1;
        } else if text.is(t, flag, "--mtp-accept") {
            mtp_accept = true;
        } else if text.is(t, flag, "--spec") {
            spec = true;
        }
        ai = ai + 1;
    }
    if metal.cgpu_open(ffi) < 0 {
        qwen35.device_fail(m, t, ffi, "opening the device");
        return cli.report(m, t, io);
    }
    let eng = qwen35.load(m, t, ffi, fs, store, kdir, mtp_accept || spec);
    if eng < 0 {
        return cli.report(m, t, io);
    }
    let tk = qwen35.tokenizer(m, eng);
    let ptext = text.from_bytes(m, t, prompt);
    let ids = bpe.encode(m, t, tk, text.start(ptext), text.start(ptext) + text.size(ptext));
    if ids < 0 {
        return cli.report(m, t, io);
    }
    let n_prompt = mem.size(m, ids);
    if n_prompt + new_tokens > qwen35.tmax() || n_prompt == 0 {
        io.error_all(io, "error[context]: the prompt and the new tokens must fit in the context (1024 positions) and the prompt must not be empty\n");
        return 1;
    }
    if spec {
        return spec_run(m, t, io, fs, ffi, clock, eng, tk, ids, new_tokens, timing, t_start);
    }
    if mtp_accept {
        return accept_run(m, t, io, fs, ffi, eng, tk, ids, new_tokens, chain_raw);
    }
    let t_loaded = clock_ms(clock);
    let smp = sampler.new(m, 0.0, 0.95, 20, 1);
    let out_ids = mem.list(m);
    let lg = qwen35.reserve(m, 4 * qwen35.vocab());
    let after_lg = m[mem.text_slot()];
    // The prompt: all but its last token without logits, then the last with.
    if qwen35.feed(m, t, ffi, fs, eng, ids, 0, n_prompt, lg, batched, false) < 0 {
        return cli.report(m, t, io);
    }
    let t_first = clock_ms(clock);
    var pos = n_prompt;
    var n = 0;
    var finished = false;
    while n < new_tokens && !finished {
        if trace {
            io.write_all(io, text.bytes(t, qwen35.top5(m, t, lg, pos - 1)));
        }
        let (nids, nprobs) = sampler.nucleus(m, t, smp, lg, qwen35.vocab());
        let pick = sampler.draw(m, smp, nids, nprobs);
        mem.push(m, out_ids, pick);
        n = n + 1;
        if stream {
            // Each token as it is sampled, for watching a run (the text is not repeated at the end).
            let one = mem.list(m);
            mem.push(m, one, pick);
            let (ps, pn) = bpe.decode(m, t, tk, one);
            io.write_all(io, text.bytes(t, text.handle(ps, pn)));
            flush_out(io);
        }
        if qwen35.is_stop(pick) || n == new_tokens {
            finished = true;
        } else {
            if qwen35.feed_one(m, t, ffi, fs, eng, pick, pos, lg) < 0 {
                return cli.report(m, t, io);
            }
            pos = pos + 1;
        }
        m[mem.text_slot()] = after_lg;
    }
    if !stream {
        let (ds, dn) = bpe.decode(m, t, tk, out_ids);
        io.write_all(io, text.bytes(t, text.handle(ds, dn)));
    }
    io.write_all(io, "\n");
    let numbers = mem.list(m);
    var q2 = 0;
    while q2 < mem.size(m, out_ids) {
        mem.push(m, numbers, text.num(m, t, mem.get(m, out_ids, q2)));
        q2 = q2 + 1;
    }
    io.write_all(io, text.bytes(t, text.f1(m, t, "tokens: $\n", text.joined(m, t, numbers, " "))));
    let t_end = clock_ms(clock);
    if timing {
        io.write_all(io, text.bytes(t, text.fmt(m, t, "timing: load_ms=$ prefill_tokens=$ prefill_ms=$ decode_tokens=$ decode_ms=$\n", mem.of5(m, text.num(m, t, t_loaded - t_start), text.num(m, t, n_prompt), text.num(m, t, t_first - t_loaded), text.num(m, t, mem.size(m, out_ids) - 1), text.num(m, t, t_end - t_first)))));
    }
    metal.cgpu_close(ffi);
    if err.failed(m) {
        return cli.report(m, t, io);
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(net);
    let gpu = narrow(ffi, "libmetalgpu");
    var status = 0;
    borrow mut heap as &!h in {
        var mb = box_slice(h, words(), 0);
        var tb = box_slice(h, bytes_cap(), byte_of(0));
        borrow mut mb as &!mr in {
            borrow mut tb as &!tr in {
                let m = contents(mr);
                let t = contents(tr);
                mem.init(m);
                borrow mut io as &!i in {
                    borrow fs as &f in {
                        borrow args as &a in {
                            borrow gpu as &g in {
                                borrow clock as &c in {
                                    status = run(m, t, i, f, a, g, c);
                                }
                            }
                        }
                    }
                }
            }
        }
        unbox_slice(h, mb);
        unbox_slice(h, tb);
    }
    release(heap);
    release(io);
    release(fs);
    release(args);
    release(gpu);
    release(clock);
    return status;
}

edition 5;
module msession;

// `msession` -- a session on a Metal GPU as a module (`docs/resident.md` sections 10, 19, 29, 30): what `cancho-gpu-metal-session` does between its request lines, for it and for
// `cancho-gpu-kolibri` (`docs/kolibri.md` section 18), which drives the same session from HTTP requests. `setup` compiles the kernels and uploads the resident data once; `on_device` runs a
// request's repetitions; `checkpoint`, `reload` and `copy` are the requests of those names.

import std.io;
import mem;
import text;
import err;
import kinds;
import f32;
import ir;
import cli;
import devcodec;
import fileio;
import session;
import ckpt;
import metal;

pub fn words() -> [] int {
    return 100000000;
}

// 512 MiB: the largest tensor a session stages (a resident file, a table, a download) must fit it. Qwen2.5-0.5B's tied output matrix is 272 MB in f16
// (docs/resident.md section 20), which the 256 MiB of the CPU session and of section 19 could not hold.
pub fn bytes_cap() -> [] int {
    return 536870912;
}

// 128 MiB: the chunks a resident file goes up in.
pub fn chunk_cap() -> [] int {
    return 134217728;
}

pub fn floats_cap() -> [] int {
    return 32000000;
}

pub fn line_cap() -> [] int {
    return 1048576;
}

// The shim's last failure, as a `device` refusal.
pub fn device_fail[&m, &t, &f](m: &!m [int], t: &!t [byte], ffi: &f Ffi("libmetalgpu"), what: &static [byte]) -> [ffi("libmetalgpu")] int {
    let top = m[mem.text_slot()];
    let n = metal.cgpu_error(ffi, t[top..top + 4096]);
    var detail = text.handle(top, 0);
    if n > 0 {
        m[mem.text_slot()] = top + n;
        detail = text.handle(top, n);
    } else {
        detail = text.lit(m, t, "no detail");
    }
    return err.fail(m, t, "device", text.f2(m, t, "$: $", text.lit(m, t, what), detail));
}

// The device buffer of parameter `ai` of program `pi` once set up (`bufs` holds one list of buffers for each program).
fn buffer_of[&m](m: &!m [int], bufs: int, pi: int, ai: int) -> [] int {
    return mem.get(m, mem.get(m, bufs, pi), ai);
}

// A binary resident file, read and sent to its device buffer a chunk at a time (so that a file larger than the byte pool is not refused: the pool only has to hold one chunk).
// `rec` is a record of the session's `resident` list (program, parameter, file name). Answers 0, or -1 with a refusal. Setup uses it once for each file, and the request `reload` again.
fn upload_binary[&m, &t, &f, &s](m: &!m [int], t: &!t [byte], ffi: &f Ffi("libmetalgpu"), fs: &s Fs(""), progs: int, bufs: int, rec: int) -> [ffi("libmetalgpu"), fs_read(""), file_read] int {
    let g = mem.get(m, m[mem.get(m, progs, m[rec]) + 2], m[rec + 1]);
    let mark = m[mem.text_slot()];
    // a binary resident file: its bytes are the device's, and go up as they are, a chunk at a time, so that a file larger than the byte pool (Qwen2.5-0.5B's f32 table is 545 MB,
    // docs/resident.md section 24) is not refused: the pool only has to hold one chunk
    let want = m[g + 3] * kinds.size_bytes(m[g]);
    let path = text.bytes(t, m[rec + 2]);
    let (ftop, fgot, fsize) = fileio.prefix(m, t, fs, path, 1);
    if ftop < 0 {
        let e = err.fail(m, t, "io", text.f1(m, t, "cannot read $", m[rec + 2]));
        return 0 - 1;
    }
    if fsize != want {
        let e = err.fail(m, t, "usage", text.f2(m, t, "the binary file $ has $ bytes", m[rec + 2], text.num(m, t, fsize)));
        return 0 - 1;
    }
    var off = 0;
    while off < want {
        var piece = want - off;
        if piece > chunk_cap() {
            piece = chunk_cap();
        }
        let at = m[mem.text_slot()];
        if piece > len(t) - at {
            let e = err.fail(m, t, "usage", text.f1(m, t, "the byte pool cannot hold a chunk of $", m[rec + 2]));
            return 0 - 1;
        }
        if fileio.read_at(t, fs, text.bytes(t, m[rec + 2]), off, at, piece) != piece {
            let e = err.fail(m, t, "io", text.f1(m, t, "cannot read $", m[rec + 2]));
            return 0 - 1;
        }
        if metal.cgpu_upload_at(ffi, buffer_of(m, bufs, m[rec], m[rec + 1]), off, t[at..at + piece]) < 0 {
            let e = device_fail(m, t, ffi, "uploading resident data");
            return 0 - 1;
        }
        off = off + piece;
    }
    m[mem.text_slot()] = mark;
    return 0;
}

// Compile every kernel, give every parameter a buffer (a linked input shares the buffer of the output it is linked from) and upload
// the resident data. Answers (the list of each program's kernel function, the list of each program's buffers), or (-1, -1).
pub fn setup[&m, &t, &x, &f, &s](m: &!m [int], t: &!t [byte], fm: &!x [float], ffi: &f Ffi("libmetalgpu"), fs: &s Fs(""), sess: int) -> [ffi("libmetalgpu"), fs_read(""), file_read] (int, int) {
    let progs = m[sess + session.s_progs()];
    let links = m[sess + session.s_links()];
    let resident = m[sess + session.s_resident()];
    let carries = m[sess + session.s_carries()];
    let tables = m[sess + session.s_tables()];
    if metal.cgpu_open(ffi) < 0 {
        let r = device_fail(m, t, ffi, "opening the device");
        return (0 - 1, 0 - 1);
    }
    let funcs = mem.list(m);
    let bufs = mem.list(m);
    let groups = mem.list(m);
    let rfiles = mem.list(m);
    // (file name, bytes, buffer) of the binary tables uploaded so far
    let tfiles = mem.list(m);
    let rollbufs = mem.list(m);
    var q = 0;
    while q < mem.size(m, progs) {
        let pr = mem.get(m, progs, q);
        let l = m[pr + 3];
        let kernel_module = metal.cgpu_compile(ffi, text.bytes(t, m[l + 1]));
        if kernel_module < 0 {
            let r = device_fail(m, t, ffi, "compiling a kernel");
            return (0 - 1, 0 - 1);
        }
        let func = metal.cgpu_function(ffi, kernel_module, text.bytes(t, m[l]));
        if func < 0 {
            let r = device_fail(m, t, ffi, "finding an entry point");
            return (0 - 1, 0 - 1);
        }
        mem.push(m, funcs, func);
        let mine = mem.list(m);
        let globals = m[pr + 2];
        var i = 0;
        while i < mem.size(m, globals) {
            let g = mem.get(m, globals, i);
            var shared = 0 - 1;
            var k = 0;
            while k < mem.size(m, links) {
                let link = mem.get(m, links, k);
                if m[link + 2] == q && m[link + 3] == i {
                    let gs = mem.get(m, m[mem.get(m, progs, m[link]) + 2], m[link + 1]);
                    if m[gs] != m[g] {
                        let r = err.fail(m, t, "session", text.lit(m, t, "a link needs the same element type at both ends on a device, which shares the buffer"));
                        return (0 - 1, 0 - 1);
                    }
                    shared = buffer_of(m, bufs, m[link], m[link + 1]);
                }
                k = k + 1;
            }
            // a carry is one buffer for the output and every parameter it feeds (the kernel is safe in place): the first of the group to be set up
            // allocates it and the others take it. `groups` holds (source program, source parameter, buffer).
            var group_src = 0 - 1;
            var group_par = 0 - 1;
            k = 0;
            while k < mem.size(m, carries) {
                let c = mem.get(m, carries, k);
                if m[c] == q && m[c + 1] == i || m[c + 2] == q && m[c + 3] == i {
                    group_src = m[c];
                    group_par = m[c + 1];
                }
                k = k + 1;
            }
            if group_src >= 0 {
                k = 0;
                while k < mem.size(m, groups) {
                    let gr = mem.get(m, groups, k);
                    if m[gr] == group_src && m[gr + 1] == group_par {
                        shared = m[gr + 2];
                    }
                    k = k + 1;
                }
            }
            // an alias puts the output in the buffer of the root of its group (docs/resident.md section 21.4): the session file's checks leave nothing reading the root's value by then
            let aliases = m[sess + session.s_aliases()];
            k = 0;
            while k < mem.size(m, aliases) {
                let al = mem.get(m, aliases, k);
                if m[al + 2] == q && m[al + 3] == i {
                    shared = buffer_of(m, bufs, m[al], m[al + 1]);
                }
                k = k + 1;
            }
            var table_blocks = 1;
            var tpath = 0 - 1;
            var mytable = 0 - 1;
            k = 0;
            while k < mem.size(m, tables) {
                let tb = mem.get(m, tables, k);
                if m[tb] == q && m[tb + 1] == i {
                    table_blocks = m[tb + 3];
                    // a chosen mask is one parameter's worth: its record's third word is how many largest are taken, not blocks
                    if m[tb + session.t_way()] == 4 {
                        table_blocks = 1;
                    }
                    mytable = tb;
                    if m[tb + 2] < 0 {
                        tpath = m[tb + 4];
                    }
                }
                k = k + 1;
            }
            // a roll (docs/resident.md section 33) is one buffer, zero at the start: the output stored in it and every window of it are that buffer, bound at a block when the program runs
            if mytable >= 0 && (m[mytable + session.t_way()] == 2 || m[mytable + session.t_way()] == 3) {
                tpath = 0 - 1;
                k = 0;
                while k < mem.size(m, rollbufs) {
                    let rb = mem.get(m, rollbufs, k);
                    if m[rb] == m[mytable + session.t_roll()] {
                        shared = m[rb + 1];
                    }
                    k = k + 1;
                }
                if shared < 0 {
                    shared = metal.cgpu_alloc(ffi, m[mytable + 3] * m[mytable + session.t_stride()] * kinds.size_bytes(m[g]));
                    if shared < 0 || metal.cgpu_zero(ffi, shared) < 0 {
                        let r = device_fail(m, t, ffi, "allocating a roll");
                        return (0 - 1, 0 - 1);
                    }
                    mem.push(m, rollbufs, mem.rec2(m, m[mytable + session.t_roll()], shared));
                }
            }
            // a binary table that several programs read (an expert picked from the same file by each of a layer's six: docs/kolibri.md K2) is one buffer, uploaded once
            if shared < 0 && tpath >= 0 {
                k = 0;
                while k < mem.size(m, tfiles) {
                    let tf = mem.get(m, tfiles, k);
                    if m[tf + 1] == table_blocks * m[g + 3] * kinds.size_bytes(m[g]) && text.eq(t, m[tf], tpath) {
                        shared = m[tf + 2];
                        m[mytable + 8] = 1;
                    }
                    k = k + 1;
                }
            }
            // a binary resident file that two programs read (the weights of a layer, which its forward and its backward both take) is one buffer: read-only parameters of the same file and size share it.
            // A carry's destination is written, so it is never shared (docs/resident.md section 23.4).
            var rpath = 0 - 1;
            if shared < 0 && group_src < 0 {
                k = 0;
                while k < mem.size(m, resident) {
                    let rr = mem.get(m, resident, k);
                    if m[rr] == q && m[rr + 1] == i && m[rr + 2] >= 0 {
                        rpath = m[rr + 2];
                    }
                    k = k + 1;
                }
                if rpath >= 0 {
                    k = 0;
                    while k < mem.size(m, rfiles) {
                        let rf = mem.get(m, rfiles, k);
                        if m[rf + 1] == m[g + 3] * kinds.size_bytes(m[g]) && text.eq(t, m[rf], rpath) {
                            shared = m[rf + 2];
                        }
                        k = k + 1;
                    }
                }
            }
            if shared >= 0 {
                mem.push(m, mine, shared);
            } else {
                let buf = metal.cgpu_alloc(ffi, table_blocks * m[g + 3] * kinds.size_bytes(m[g]));
                if buf < 0 {
                    let r = device_fail(m, t, ffi, "allocating a buffer");
                    return (0 - 1, 0 - 1);
                }
                mem.push(m, mine, buf);
                if group_src >= 0 {
                    mem.push(m, groups, mem.rec3(m, group_src, group_par, buf));
                }
                if rpath >= 0 {
                    mem.push(m, rfiles, mem.rec3(m, rpath, m[g + 3] * kinds.size_bytes(m[g]), buf));
                }
                if tpath >= 0 {
                    mem.push(m, tfiles, mem.rec3(m, tpath, table_blocks * m[g + 3] * kinds.size_bytes(m[g]), buf));
                }
            }
            i = i + 1;
        }
        mem.push(m, bufs, mine);
        q = q + 1;
    }
    // The tables go up once, whole.
    var tq = 0;
    while tq < mem.size(m, tables) {
        let tb = mem.get(m, tables, tq);
        let g = mem.get(m, m[mem.get(m, progs, m[tb]) + 2], m[tb + 1]);
        let mark = m[mem.text_slot()];
        if m[tb + 8] == 1 || m[tb + session.t_way()] >= 2 {
            // the buffer is an earlier table's, which sent the file; or a roll's, which is zero; or a mask the session writes at each repetition
        } else if m[tb + 2] < 0 {
            // a binary table: the file's bytes are the device's, and go up as they are
            let want = m[g + 3] * m[tb + 3] * kinds.size_bytes(m[g]);
            let (ftop, fgot, fsize) = fileio.prefix(m, t, fs, text.bytes(t, m[tb + 4]), want + 1);
            if ftop == 0 - 2 {
                let e = err.fail(m, t, "usage", text.f2(m, t, "the binary table $ has $ bytes, more than the session's byte pool holds (512 MiB)", m[tb + 4], text.num(m, t, fsize)));
                return (0 - 1, 0 - 1);
            }
            if ftop < 0 {
                let e = err.fail(m, t, "io", text.f1(m, t, "cannot read $", m[tb + 4]));
                return (0 - 1, 0 - 1);
            }
            if fsize != want {
                let e = err.fail(m, t, "usage", text.f2(m, t, "the binary table $ has $ bytes", m[tb + 4], text.num(m, t, fsize)));
                return (0 - 1, 0 - 1);
            }
            if metal.cgpu_upload(ffi, buffer_of(m, bufs, m[tb], m[tb + 1]), t[ftop..ftop + want]) < 0 {
                let e = device_fail(m, t, ffi, "uploading a table");
                return (0 - 1, 0 - 1);
            }
        } else {
            let whole = mem.rec4(m, m[g], m[g + 1], m[tb + 2], m[g + 3] * m[tb + 3]);
            let at = devcodec.encode(m, t, fm, whole);
            let bytes = m[whole + 3] * kinds.size_bytes(m[g]);
            if metal.cgpu_upload(ffi, buffer_of(m, bufs, m[tb], m[tb + 1]), t[at..at + bytes]) < 0 {
                let e = device_fail(m, t, ffi, "uploading a table");
                return (0 - 1, 0 - 1);
            }
        }
        m[mem.text_slot()] = mark;
        tq = tq + 1;
    }
    // The resident data goes up once. The staging bytes are given back as soon as they are sent.
    var r = 0;
    while r < mem.size(m, resident) {
        let rec = mem.get(m, resident, r);
        let g = mem.get(m, m[mem.get(m, progs, m[rec]) + 2], m[rec + 1]);
        let mark = m[mem.text_slot()];
        var again = false;
        var e0 = 0;
        while e0 < r {
            let prev = mem.get(m, resident, e0);
            if m[prev + 2] >= 0 && buffer_of(m, bufs, m[prev], m[prev + 1]) == buffer_of(m, bufs, m[rec], m[rec + 1]) {
                again = true;
            }
            e0 = e0 + 1;
        }
        if again {
            // the buffer already holds this file: an earlier declaration uploaded it
            e0 = 0;
        } else if m[rec + 2] >= 0 {
            if upload_binary(m, t, ffi, fs, progs, bufs, rec) < 0 {
                return (0 - 1, 0 - 1);
            }
        } else {
            let at = devcodec.encode(m, t, fm, g);
            let bytes = m[g + 3] * kinds.size_bytes(m[g]);
            if metal.cgpu_upload(ffi, buffer_of(m, bufs, m[rec], m[rec + 1]), t[at..at + bytes]) < 0 {
                let e = device_fail(m, t, ffi, "uploading resident data");
                return (0 - 1, 0 - 1);
            }
        }
        m[mem.text_slot()] = mark;
        r = r + 1;
    }
    return (funcs, bufs);
}

// One request on the device, after `session.fill_inputs`: upload the inputs, launch the kernels in order, read the answers back.
pub fn on_device[&m, &t, &x, &f](m: &!m [int], t: &!t [byte], fm: &!x [float], ffi: &f Ffi("libmetalgpu"), sess: int, funcs: int, bufs: int, ptabs: int, reps: int) -> [ffi("libmetalgpu")] int {
    let progs = m[sess + session.s_progs()];
    let inputs = m[sess + session.s_inputs()];
    let answers = m[sess + session.s_answers()];
    var k = 0;
    while k < mem.size(m, inputs) {
        let rec = mem.get(m, inputs, k);
        let g = mem.get(m, m[mem.get(m, progs, m[rec]) + 2], m[rec + 1]);
        let at = devcodec.encode(m, t, fm, g);
        if metal.cgpu_upload(ffi, buffer_of(m, bufs, m[rec], m[rec + 1]), t[at..at + m[g + 3] * kinds.size_bytes(m[g])]) < 0 {
            return device_fail(m, t, ffi, "uploading an input");
        }
        k = k + 1;
    }
    var rep = 0;
    while rep < reps {
        // the outputs read back for picked tables in this repetition: (program, param, the place of its bytes in the byte pool)
        let fresh = mem.list(m);
        let rep_mark = m[mem.text_slot()];
        var q = 0;
        while q < mem.size(m, progs) {
            let pr = mem.get(m, progs, q);
            let l = m[pr + 3];
            let mine = mem.get(m, bufs, q);
            // this program's tables only (`tables_by_program`): a step of Kolibri's 2,559 programs looked through all 2,064 tables for each parameter (docs/kolibri.md section 17)
            let tables = mem.get(m, ptabs, q);
            var i = 0;
            while i < mem.size(m, mine) {
                // a table parameter is bound at the block the repetition number picks
                var offset = 0 - 1;
                var tk = 0;
                while tk < mem.size(m, tables) {
                    let tb = mem.get(m, tables, tk);
                    if m[tb + 1] == i {
                        let g = mem.get(m, m[pr + 2], i);
                        if m[tb + session.t_way()] == 4 {
                            // a chosen mask (docs/resident.md section 34): what is encoded so far must have run before the mask's buffer is written, since the repetition before may
                            // still read it; the scores are read back when the choice depends on them
                            if metal.cgpu_sync(ffi) < 0 {
                                return device_fail(m, t, ffi, "waiting for the kernels");
                            }
                            let sg = mem.get(m, m[mem.get(m, progs, m[tb + 10]) + 2], m[tb + 11]);
                            let mark4 = m[mem.text_slot()];
                            if session.choose_reads(m, sess, tb) {
                                let sbytes = m[sg + 3] * 4;
                                let sat = devcodec.reserve(m, sbytes);
                                if metal.cgpu_download(ffi, buffer_of(m, bufs, m[tb + 10], m[tb + 11]), t[sat..sat + sbytes]) < 0 {
                                    return device_fail(m, t, ffi, "reading the scores of a choice back");
                                }
                                devcodec.decode(m, t, fm, sg, sat);
                            }
                            if session.choose_mask(m, t, fm, sess, tb) < 0 {
                                return 0 - 1;
                            }
                            let mat = devcodec.encode(m, t, fm, g);
                            if metal.cgpu_upload(ffi, mem.get(m, mine, i), t[mat..mat + m[g + 3] * 4]) < 0 {
                                return device_fail(m, t, ffi, "sending a chosen mask");
                            }
                            m[mem.text_slot()] = mark4;
                        }
                        var block = 0;
                        if m[tb + session.t_way()] != 4 {
                            block = session.bound_block(m, t, sess, tb);
                        }
                        if block < 0 {
                            return 0 - 1;
                        }
                        if m[tb + 5] >= 0 {
                            // a picked table (docs/kolibri.md K2): the value is read back from the device, once for an output in a repetition, after what was encoded so far has run
                            let sg = mem.get(m, m[mem.get(m, progs, m[tb + 5]) + 2], m[tb + 6]);
                            // the output's bytes stay in the byte pool until the repetition ends: a device session's outputs have no place in the interpreter's memory
                            var spot = 0 - 1;
                            var fk = 0;
                            while fk < mem.size(m, fresh) {
                                let fr = mem.get(m, fresh, fk);
                                if m[fr] == m[tb + 5] && m[fr + 1] == m[tb + 6] {
                                    spot = m[fr + 2];
                                }
                                fk = fk + 1;
                            }
                            if spot < 0 {
                                if metal.cgpu_sync(ffi) < 0 {
                                    return device_fail(m, t, ffi, "waiting for the kernels");
                                }
                                let bytes = m[sg + 3] * 4;
                                spot = devcodec.reserve(m, bytes);
                                if metal.cgpu_download(ffi, buffer_of(m, bufs, m[tb + 5], m[tb + 6]), t[spot..spot + bytes]) < 0 {
                                    return device_fail(m, t, ffi, "reading a picked value back");
                                }
                                mem.push(m, fresh, mem.rec3(m, m[tb + 5], m[tb + 6], spot));
                            }
                            let w0 = spot + 4 * m[tb + 7];
                            let word = int_of(t[w0]) | int_of(t[w0 + 1]) << 8 | int_of(t[w0 + 2]) << 16 | int_of(t[w0 + 3]) << 24;
                            block = session.picked_block(m, t, f32.from_bits32(word), m[tb + 3]);
                            if block < 0 {
                                return 0 - 1;
                            }
                        }
                        offset = block * session.bound_stride(m, tb, m[g + 3]) * kinds.size_bytes(m[g]);
                        if m[tb + session.t_way()] == 4 {
                            offset = 0 - 1;
                        }
                    }
                    tk = tk + 1;
                }
                var bound = 0;
                if offset >= 0 {
                    bound = metal.cgpu_arg_at(ffi, mem.get(m, mine, i), offset);
                } else {
                    bound = metal.cgpu_arg(ffi, mem.get(m, mine, i));
                }
                if bound < 0 {
                    return device_fail(m, t, ffi, "binding an argument");
                }
                i = i + 1;
            }
            if metal.cgpu_launch_async(ffi, mem.get(m, funcs, q), m[l + 2], m[l + 3], m[l + 4]) < 0 {
                return device_fail(m, t, ffi, "launching a kernel");
            }
            q = q + 1;
        }
        m[mem.text_slot()] = rep_mark;
        m[sess + session.s_count()] = m[sess + session.s_count()] + 1;
        rep = rep + 1;
    }
    // One wait for all the kernels, which the device runs in the order they were encoded.
    if metal.cgpu_sync(ffi) < 0 {
        return device_fail(m, t, ffi, "waiting for the kernels");
    }
    k = 0;
    while k < mem.size(m, answers) {
        let a = mem.get(m, answers, k);
        let g = mem.get(m, m[mem.get(m, progs, m[a]) + 2], m[a + 1]);
        let bytes = m[g + 3] * kinds.size_bytes(m[g]);
        let at = devcodec.reserve(m, bytes);
        if metal.cgpu_download(ffi, buffer_of(m, bufs, m[a], m[a + 1]), t[at..at + bytes]) < 0 {
            return device_fail(m, t, ffi, "reading an answer back");
        }
        devcodec.decode(m, t, fm, g, at);
        k = k + 1;
    }
    return 0;
}

// A request line answered to its caller and not printed (the server of `docs/kolibri.md` section 18): a `seek`, whose answer is the repetition number, or steps, whose answer is the first
// value of the first `answer`. `(0, the answer)`, or `(-1, 0)` with a refusal.
pub fn ask[&m, &t, &x, &f](m: &!m [int], t: &!t [byte], fm: &!x [float], ffi: &f Ffi("libmetalgpu"), sess: int, funcs: int, bufs: int, ptabs: int, line: int) -> [ffi("libmetalgpu")] (int, float) {
    let sought = session.seek_request(m, t, sess, line);
    if sought < 0 {
        return (0 - 1, 0.0);
    }
    if sought > 0 {
        return (0, float_of(m[sess + session.s_count()]));
    }
    let (reps, rest) = session.take_steps(m, t, sess, line);
    if reps < 0 || session.fill_inputs(m, t, fm, sess, rest) < 0 || on_device(m, t, fm, ffi, sess, funcs, bufs, ptabs, reps) < 0 {
        return (0 - 1, 0.0);
    }
    return (0, session.first_answer(m, fm, sess));
}

// The session's tables by the program that reads them: a list for each program, in the tables' order. Made once, after `setup`.
pub fn tables_by_program[&m](m: &!m [int], sess: int) -> [] int {
    let progs = m[sess + session.s_progs()];
    let tables = m[sess + session.s_tables()];
    let out = mem.list(m);
    var q = 0;
    while q < mem.size(m, progs) {
        mem.push(m, out, mem.list(m));
        q = q + 1;
    }
    var tk = 0;
    while tk < mem.size(m, tables) {
        let tb = mem.get(m, tables, tk);
        mem.push(m, mem.get(m, out, m[tb]), tb);
        tk = tk + 1;
    }
    return out;
}

// One file of a checkpoint (`docs/resident.md` section 19): the saves `k` up to `end`, each downloaded from its device buffer and written as it is, to a temporary
// file that is made durable and renamed. Answers the bytes written, or -1 with a refusal.
fn save_group[&m, &t, &f, &s](m: &!m [int], t: &!t [byte], ffi: &f Ffi("libmetalgpu"), fs: &s Fs(""), sess: int, bufs: int, k: int, end: int) -> [ffi("libmetalgpu"), fs_write(""), file_write] int {
    let progs = m[sess + session.s_progs()];
    let saves = m[sess + session.s_saves()];
    let path = m[mem.get(m, saves, k) + 2];
    let tmp = ckpt.tmp_path(m, t, path);
    let mark = m[mem.text_slot()];
    var status = 0;
    var total = 0;
    var failed = false;
    match open_write(fs, text.bytes(t, tmp)) {
        Opened::Ok(opened) => {
            var out = opened;
            borrow mut out as &!w in {
                var j = k;
                while j < end && status == 0 && !failed {
                    let rec = mem.get(m, saves, j);
                    let g = mem.get(m, m[mem.get(m, progs, m[rec]) + 2], m[rec + 1]);
                    let bytes = m[g + 3] * kinds.size_bytes(m[g]);
                    // an output larger than a chunk (the 0.5B's f32 table gradient is 545 MB, the pool 512 MiB) goes out a chunk at a time
                    var off = 0;
                    while off < bytes && status == 0 && !failed {
                        var piece = bytes - off;
                        if piece > chunk_cap() {
                            piece = chunk_cap();
                        }
                        let at = devcodec.reserve(m, piece);
                        if metal.cgpu_download_at(ffi, buffer_of(m, bufs, m[rec], m[rec + 1]), off, t[at..at + piece]) < 0 {
                            failed = true;
                        } else {
                            status = ckpt.write_all(w, t[at..at + piece]);
                            total = total + piece;
                        }
                        m[mem.text_slot()] = at;
                        off = off + piece;
                    }
                    j = j + 1;
                }
                if status == 0 && !failed {
                    status = ckpt.sync_file(w);
                }
            }
            file_close(out);
        }
        Opened::Failed(e) => {
            status = e;
        }
    }
    if failed {
        // the temporary file is removed and the device's failure is the refusal
        let removed = ckpt.discard(t, fs, tmp);
        m[mem.text_slot()] = mark;
        return device_fail(m, t, ffi, "reading a save back");
    }
    let done = ckpt.finish(m, t, fs, path, tmp, status, total);
    m[mem.text_slot()] = mark;
    return done;
}

// The request `checkpoint` on the device: every file of the saves, then the bytes of each as the answer line. The kernels of the last request have finished (one wait ends a request).
pub fn checkpoint[&m, &t, &i, &f, &s](m: &!m [int], t: &!t [byte], io: &!i Io, ffi: &f Ffi("libmetalgpu"), fs: &s Fs(""), sess: int, bufs: int) -> [io_write, ffi("libmetalgpu"), fs_write(""), file_write] int {
    let saves = m[sess + session.s_saves()];
    let totals = mem.list(m);
    var k = 0;
    while k < mem.size(m, saves) {
        let end = ckpt.group_end(m, t, saves, k);
        let wrote = save_group(m, t, ffi, fs, sess, bufs, k, end);
        if wrote < 0 {
            return 0 - 1;
        }
        mem.push(m, totals, wrote);
        k = end;
    }
    return ckpt.print_totals(m, t, io, totals);
}

// The request `reload`: the named binary resident files are read again and sent to their buffers (`session.reload_request`). Answers the number of files sent, as one line.
pub fn reload[&m, &t, &i, &f, &s](m: &!m [int], t: &!t [byte], io: &!i Io, ffi: &f Ffi("libmetalgpu"), fs: &s Fs(""), sess: int, bufs: int, recs: int) -> [io_write, ffi("libmetalgpu"), fs_read(""), file_read] int {
    let progs = m[sess + session.s_progs()];
    var k = 0;
    while k < mem.size(m, recs) {
        if upload_binary(m, t, ffi, fs, progs, bufs, mem.get(m, recs, k)) < 0 {
            return 0 - 1;
        }
        k = k + 1;
    }
    io.write_all(io, text.bytes(t, text.num(m, t, mem.size(m, recs))));
    io.write_all(io, "\n");
    let _flushed = flush_out(io);
    return 0;
}

// The request `copy`: each source output is copied to its destination buffer on the device, a chunk at a time through the byte pool (`session.copy_request`). Answers the number of copies, as one line.
pub fn copy[&m, &t, &i, &f](m: &!m [int], t: &!t [byte], io: &!i Io, ffi: &f Ffi("libmetalgpu"), sess: int, bufs: int, pairs: int) -> [io_write, ffi("libmetalgpu")] int {
    let progs = m[sess + session.s_progs()];
    var k = 0;
    while k < mem.size(m, pairs) {
        let pr = mem.get(m, pairs, k);
        let g = mem.get(m, m[mem.get(m, progs, m[pr]) + 2], m[pr + 1]);
        let bytes = m[g + 3] * kinds.size_bytes(m[g]);
        let mark = m[mem.text_slot()];
        var off = 0;
        while off < bytes {
            var piece = bytes - off;
            if piece > chunk_cap() {
                piece = chunk_cap();
            }
            let at = m[mem.text_slot()];
            if piece > len(t) - at {
                return err.fail(m, t, "usage", text.lit(m, t, "the byte pool cannot hold a chunk of a copy"));
            }
            if metal.cgpu_download_at(ffi, buffer_of(m, bufs, m[pr], m[pr + 1]), off, t[at..at + piece]) < 0 {
                return device_fail(m, t, ffi, "reading a copy's source");
            }
            if metal.cgpu_upload_at(ffi, buffer_of(m, bufs, m[pr + 2], m[pr + 3]), off, t[at..at + piece]) < 0 {
                return device_fail(m, t, ffi, "writing a copy's destination");
            }
            off = off + piece;
        }
        m[mem.text_slot()] = mark;
        k = k + 1;
    }
    io.write_all(io, text.bytes(t, text.num(m, t, mem.size(m, pairs))));
    io.write_all(io, "\n");
    let _flushed = flush_out(io);
    return 0;
}

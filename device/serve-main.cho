edition 9;

// `cancho-gpu-serve` -- an OpenAI-compatible chat endpoint over Qwen3.8-27B on a Metal GPU
// (`docs/serving.md`).
//
//     cancho-gpu-serve <ollama store> <kernel dir> [--port N] [--model NAME] [--api-key KEY] [--think] [--no-spec] [--no-prefix-cache] [--cache-slots N] [--long-attention] [--loopback]
//
//     GET  /health                 {"status":"ok"}
//     GET  /v1/models              the one model
//     POST /v1/chat/completions    messages in, a completion out; "stream": true for server-sent events
//
// The engine of `device/qwen35.cho` is loaded once; each request resets it and runs on the same GPU, one at a
// time (one conversation's states and cache fit; a second request waits in the listen queue). The chat
// template and the request and response JSON are `src/chat.cho`. A connection carries one request
// (`Connection: close`).
//
// It listens on every address of the host (`tcp_listen` binds them all) unless `--loopback` (127.0.0.1 only: cancho-gpu-front's runner), so give it `--api-key` when the host
// is on a network: with a key, every request but `/health` needs `Authorization: Bearer <key>`.
//
// Linked with `shim/canchogpu-metal.mm` (`scripts/build-serve.sh`).

import std.io;
import mem;
import text;
import err;
import cli;
import bpe;
import sampler;
import metal;
import chat;
import qwen35;
import qwen35spec;
import qwen35slot;

fn words() -> [] int {
    return 100000000;
}

fn bytes_cap() -> [] int {
    return 536870912;
}

// The largest request taken, in bytes: a conversation of the whole context is a few thousand.
fn max_request() -> [] int {
    return 1048576;
}

fn usage[&i](io: &!i Io) -> [err_write] int {
    io.error_all(io, "usage: cancho-gpu-serve <ollama store> <kernel dir> [--port N] [--model NAME] [--api-key KEY] [--think] [--no-spec] [--no-prefix-cache] [--cache-slots N] [--long-attention] [--loopback]\n");
    return 2;
}

fn number_of[&t](t: &!t [byte], h: int) -> [] int {
    var n = 0;
    var i = 0;
    while i < text.size(h) {
        let c = text.at(t, h, i);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + c - 48;
        i = i + 1;
    }
    if text.size(h) == 0 {
        return 0 - 1;
    }
    return n;
}

fn lower(c: int) -> [] int {
    if c >= 65 && c <= 90 {
        return c + 32;
    }
    return c;
}

// The value of header `name` (lower case) in the head t[from..to) of a request: a text handle with leading
// and trailing blanks removed, or -1.
fn header[&t](t: &!t [byte], from: int, to: int, name: &static [byte]) -> [] int {
    var p = from;
    // skip the request line
    while p < to && t[p] != byte_of(10) {
        p = p + 1;
    }
    p = p + 1;
    while p < to {
        var q = p;
        while q < to && t[q] != byte_of(10) {
            q = q + 1;
        }
        // the line is t[p..q); the name runs to the colon
        var k = 0;
        var same = true;
        while k < len(name) {
            if p + k >= q || lower(int_of(t[p + k])) != int_of(name[k]) {
                same = false;
                k = len(name);
            } else {
                k = k + 1;
            }
        }
        if same && p + len(name) < q && t[p + len(name)] == byte_of(58) {
            var a = p + len(name) + 1;
            var b = q;
            while a < b && (t[a] == byte_of(32) || t[a] == byte_of(9)) {
                a = a + 1;
            }
            while b > a && (t[b - 1] == byte_of(32) || t[b - 1] == byte_of(9) || t[b - 1] == byte_of(13)) {
                b = b - 1;
            }
            return text.handle(a, b - a);
        }
        p = q + 1;
    }
    return 0 - 1;
}

// The offset of "\r\n\r\n" in t[from..to), or -1.
fn head_end[&t](t: &!t [byte], from: int, to: int) -> [] int {
    var p = from;
    while p + 3 < to {
        if t[p] == byte_of(13) && t[p + 1] == byte_of(10) && t[p + 2] == byte_of(13) && t[p + 3] == byte_of(10) {
            return p;
        }
        p = p + 1;
    }
    return 0 - 1;
}

// Send all of `h`; -1 when the peer is gone.
fn send_all[&m, &t, &c](m: &!m [int], t: &!t [byte], ch: &!c Conn, h: int) -> [conn_write] int {
    var off = 0;
    let n = text.size(h);
    while off < n {
        match conn_write(ch, text.bytes(t, text.handle(text.start(h) + off, n - off))) {
            Sent::Wrote(k) => {
                off = off + k;
            }
            Sent::Again => {
                return 0 - 1;
            }
            Sent::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    return 0;
}

fn reason(code: int) -> [] &static [byte] {
    if code == 200 {
        return "OK";
    }
    if code == 400 {
        return "Bad Request";
    }
    if code == 401 {
        return "Unauthorized";
    }
    if code == 404 {
        return "Not Found";
    }
    if code == 405 {
        return "Method Not Allowed";
    }
    if code == 413 {
        return "Payload Too Large";
    }
    return "Internal Server Error";
}

// A whole answer: the status line, the headers and the JSON body.
fn respond[&m, &t, &c](m: &!m [int], t: &!t [byte], ch: &!c Conn, code: int, body: int) -> [conn_write] int {
    let head = text.f3(m, t, "HTTP/1.1 $ $\r\nContent-Type: application/json\r\nContent-Length: $\r\nConnection: close\r\n\r\n", text.num(m, t, code), text.from_bytes(m, t, reason(code)), text.num(m, t, text.size(body)));
    if send_all(m, t, ch, head) < 0 {
        return 0 - 1;
    }
    return send_all(m, t, ch, body);
}

fn refuse[&m, &t, &c](m: &!m [int], t: &!t [byte], ch: &!c Conn, code: int, message: int, kind: &static [byte]) -> [conn_write] int {
    return respond(m, t, ch, code, chat.error_json(m, t, message, kind));
}

// A refusal in the form of the route: Ollama's `{"error": "..."}` on /api/generate, OpenAI's elsewhere.
fn refuse_on[&m, &t, &c](m: &!m [int], t: &!t [byte], ch: &!c Conn, code: int, message: int, kind: &static [byte], ollama: bool) -> [conn_write] int {
    if ollama {
        return respond(m, t, ch, code, text.f1(m, t, "{\"error\":\"$\"}", chat.escape(m, t, message)));
    }
    return refuse(m, t, ch, code, message, kind);
}

// The message of the last refusal recorded, then forget them.
fn last_error[&m, &t](m: &!m [int], t: &!t [byte]) -> [] int {
    var msg = text.lit(m, t, "the request could not be processed");
    let n = err.count(m);
    if n > 0 {
        let (rule, message) = err.nth(m, n - 1);
        msg = message;
    }
    err.clear(m);
    return msg;
}

// The tokens ids[from..) decoded as one text, in the pool.
fn decode_from[&m, &t](m: &!m [int], t: &!t [byte], tk: int, ids: int, from: int) -> [] int {
    let part = mem.list(m);
    var i = from;
    while i < mem.size(m, ids) {
        mem.push(m, part, mem.get(m, ids, i));
        i = i + 1;
    }
    let (s, n) = bpe.decode(m, t, tk, part);
    return text.handle(s, n);
}

fn trimmed[&t](t: &!t [byte], h: int) -> [] int {
    var a = text.start(h);
    var b = text.start(h) + text.size(h);
    while a < b && (t[a] == byte_of(32) || t[a] == byte_of(10) || t[a] == byte_of(13) || t[a] == byte_of(9)) {
        a = a + 1;
    }
    while b > a && (t[b - 1] == byte_of(32) || t[b - 1] == byte_of(10) || t[b - 1] == byte_of(13) || t[b - 1] == byte_of(9)) {
        b = b - 1;
    }
    return text.handle(a, b - a);
}

// What of a phase's text (decoded from `toks`) is ready to send: from the first byte not yet sent to the last
// whole character that is not trailing whitespace (which waits for what follows). Answers `(start, end)`
// handles into the pool, `emitted` being how many bytes of the phase were sent; the new `emitted` is `end`.
fn ready[&m, &t](m: &!m [int], t: &!t [byte], tk: int, toks: int, emitted: int, final: bool) -> [] (int, int) {
    let full = decode_from(m, t, tk, toks, 0);
    let s = text.start(full);
    var n = text.size(full);
    if !final {
        n = chat.utf8_prefix(t, s, n);
    }
    var end = n;
    while end > 0 && (t[s + end - 1] == byte_of(32) || t[s + end - 1] == byte_of(10) || t[s + end - 1] == byte_of(13) || t[s + end - 1] == byte_of(9)) {
        end = end - 1;
    }
    var lead = 0;
    while lead < n && (t[s + lead] == byte_of(32) || t[s + lead] == byte_of(10) || t[s + lead] == byte_of(13) || t[s + lead] == byte_of(9)) {
        lead = lead + 1;
    }
    var from = emitted;
    if lead > from {
        from = lead;
    }
    if end <= from {
        return (0 - 1, emitted);
    }
    return (text.handle(s + from, end - from), end);
}

// The state of one completion, a record: 0 tokens so far, 1 in the reasoning phase, 2 and 3 bytes of the
// reasoning and of the content already sent, 4 done, 5 the finish reason (a text handle), 6 the client is
// still there, 7 and 8 the reasoning and content token lists, 9 streaming, 10 the most tokens to give, 11 id,
// 12 created, 13 model, 14 tokenizer, 15 the "stop" text.
fn take[&m, &t, &c](m: &!m [int], t: &!t [byte], ch: &!c Conn, st: int, tok: int) -> [conn_write] int {
    m[st] = m[st] + 1;
    if qwen35spec.is_stop(tok) {
        m[st + 5] = m[st + 15];
        m[st + 4] = 1;
        return 0;
    }
    if m[st + 1] == 1 && tok == 248069 {
        m[st + 1] = 0;
    } else if m[st + 1] == 1 {
        mem.push(m, m[st + 7], tok);
    } else {
        mem.push(m, m[st + 8], tok);
    }
    if m[st + 9] == 1 && !(tok == 248069) {
        var which = m[st + 8];
        var sent = m[st + 3];
        var field = "content";
        if m[st + 1] == 1 {
            which = m[st + 7];
            sent = m[st + 2];
            field = "reasoning_content";
        }
        let (piece, upto) = ready(m, t, m[st + 14], which, sent, false);
        if m[st + 1] == 1 {
            m[st + 2] = upto;
        } else {
            m[st + 3] = upto;
        }
        if piece >= 0 {
            let ev = chat.chunk_json(m, t, m[st + 11], m[st + 12], m[st + 13], chat.delta_text(m, t, field, piece), 0 - 1);
            if send_all(m, t, ch, ev) < 0 {
                m[st + 6] = 0;
            }
        }
    }
    if m[st] >= m[st + 10] {
        m[st + 4] = 1;
    }
    return 0;
}

// The prefix cache (`docs/serving.md` sections 7 and 8). The cache is a record: 0 the number of slots, 1 the
// resident slot (the one whose keys and values are the engine's own; -1 for none), 2 a scratch in `t`, 3 a
// counter for "least recently used", 4 the first slot's address, 5 the tokens the latest request reused.
// A slot is eleven words: 0 valid, 1 c (the cut at the last assistant opener), 2 the address in `m` of its ids
// (`tmax()` words, allocated at start: the bump allocator is rewound after each request), 3 the snapshot at c,
// 4 c0 (a second, earlier cut; 0 for none), 5 the snapshot at c0, 6 its copy of the key and value caches,
// 7 whether that copy holds the rows of [0, c), 8 when it was last used, 9 its checkpoints (a list of `ck_count()` snapshots: section 12),
// 10 how many of them hold the states at ck_step(), 2 * ck_step(), ... of its ids.
fn slot_words() -> [] int {
    return 11;
}

fn slot_at[&m](m: &!m [int], ca: int, i: int) -> [] int {
    return m[ca + 4] + slot_words() * i;
}

fn cache_new[&m, &t, &g](m: &!m [int], t: &!t [byte], ffi: &g Ffi("libmetalgpu"), eng: int, n: int) -> [ffi("libmetalgpu")] int {
    let ca = mem.grab(m, 6);
    m[ca] = n;
    m[ca + 1] = 0 - 1;
    m[ca + 2] = qwen35.reserve(m, qwen35slot.piece());
    m[ca + 3] = 0;
    m[ca + 4] = mem.grab(m, slot_words() * n);
    m[ca + 5] = 0;
    var i = 0;
    while i < n {
        let sl = slot_at(m, ca, i);
        m[sl] = 0;
        m[sl + 1] = 0;
        m[sl + 2] = mem.grab(m, qwen35.tmax());
        m[sl + 3] = qwen35slot.snap_new(m, t, ffi);
        m[sl + 4] = 0;
        m[sl + 5] = qwen35slot.snap_new(m, t, ffi);
        m[sl + 6] = qwen35slot.kv_new(m, t, ffi, eng);
        m[sl + 7] = 0;
        m[sl + 8] = 0;
        let cks = mem.list(m);
        var j = 0;
        while j < ck_count() {
            mem.push(m, cks, qwen35slot.snap_new(m, t, ffi));
            j = j + 1;
        }
        m[sl + 9] = cks;
        m[sl + 10] = 0;
        if err.failed(m) {
            return 0 - 1;
        }
        i = i + 1;
    }
    return ca;
}

fn round_cut(b: int, n: int) -> [] int {
    // a multiple of the prefill chunk, so that what follows is fed in the chunks a fresh prefill takes
    let w = qwen35.mb();
    var c = w * (b / w);
    if c >= n {
        c = c - w;
    }
    if c < w {
        return 0;
    }
    return c;
}

fn cut_of[&m](m: &!m [int], ids: int, n: int) -> [] int {
    // The marker `<|im_start|>assistant\n` is the three tokens 248045 74455 198 (section 7.9).
    var i = n - 3;
    var b = 0;
    while i >= 0 && b == 0 {
        if mem.get(m, ids, i) == 248045 && mem.get(m, ids, i + 1) == 74455 && mem.get(m, ids, i + 2) == 198 {
            b = i + 3;
        }
        i = i - 1;
    }
    return round_cut(b, n);
}

// The earlier cut: after the opener of the second message (`<|im_start|>`, a role, a newline), which is the end
// of a system message when there is one. 0 when that is under 64 tokens in.
fn first_cut_of[&m](m: &!m [int], ids: int, n: int) -> [] int {
    var i = 1;
    while i + 3 <= n {
        if mem.get(m, ids, i) == 248045 {
            let c = round_cut(i + 3, n);
            if c < 64 {
                return 0;
            }
            return c;
        }
        i = i + 1;
    }
    return 0;
}

fn same_prefix[&m](m: &!m [int], sl: int, ids: int, c: int) -> [] bool {
    var i = 0;
    while i < c {
        if m[m[sl + 2] + i] != mem.get(m, ids, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The slot to write a conversation that continues none: not `keep`, an invalid one if there is one, else the
// least recently used.
fn victim[&m](m: &!m [int], ca: int, keep: int) -> [] int {
    var best = 0 - 1;
    var i = 0;
    while i < m[ca] {
        if i != keep {
            let sl = slot_at(m, ca, i);
            if best < 0 {
                best = i;
            } else {
                let bs = slot_at(m, ca, best);
                if m[bs] == 1 && (m[sl] == 0 || m[sl + 8] < m[bs + 8]) {
                    best = i;
                }
            }
        }
        i = i + 1;
    }
    if best < 0 {
        return keep;
    }
    return best;
}

// The engine is about to hold another conversation than the resident slot's: keep the resident's keys and values.
fn park[&m, &t, &g](m: &!m [int], t: &!t [byte], ffi: &g Ffi("libmetalgpu"), eng: int, ca: int, but: int) -> [ffi("libmetalgpu")] int {
    let r = m[ca + 1];
    if r >= 0 && r != but {
        let rs = slot_at(m, ca, r);
        if m[rs] == 1 && m[rs + 7] == 0 {
            if qwen35slot.kv_copy(m, t, ffi, eng, m[rs + 6], m[ca + 2], 1) < 0 {
                return 0 - 1;
            }
            m[rs + 7] = 1;
        }
    }
    return 0;
}

// The checkpoints of a slot (docs/serving.md section 12): the delta states at every multiple of `ck_step()` positions of its prompt,
// so that a prompt that parts from it inside a long message is read again from the last of them before it, not from its start.
fn ck_step() -> [] int {
    return 1024;
}

fn ck_count() -> [] int {
    return qwen35.tmax() / ck_step() - 1;
}

// Feed ids[from..to) of a prompt of `n` ids into the engine for slot `ts`, taking the checkpoints it passes that the slot has not
// got yet (one at each multiple of `ck_step()` under `n`, in order). The logits of the last go to `lg` (-1: none).
fn feed_marked[&m, &t, &f, &g](m: &!m [int], t: &!t [byte], ffi: &g Ffi("libmetalgpu"), fs: &f Fs(""), eng: int, ca: int, ts: int, ids: int, from: int, to: int, n: int, lg: int, warm: bool) -> [ffi("libmetalgpu"), fs_read(""), file_read] int {
    var at = from;
    var p = ck_step() * (m[ts + 10] + 1);
    // a slot whose checkpoints stop before `from` (one that took another's earlier cut) takes no more: they are kept in order
    while p >= at && p < to && p < n && m[ts + 10] < ck_count() {
        if p > at {
            if qwen35spec.feed(m, t, ffi, fs, eng, ids, at, p, 0 - 1, true, warm) < 0 {
                return 0 - 1;
            }
            at = p;
        }
        if p == at {
            if qwen35slot.snap_copy(m, t, ffi, eng, mem.get(m, m[ts + 9], m[ts + 10]), m[ca + 2], 1) < 0 {
                return 0 - 1;
            }
            m[ts + 10] = m[ts + 10] + 1;
        }
        p = ck_step() * (m[ts + 10] + 1);
    }
    if to > at {
        return qwen35spec.feed(m, t, ffi, fs, eng, ids, at, to, lg, true, warm);
    }
    return 0;
}

// The prompt in, with the cache: answers the tokens reused (0 on a miss), or -1.
fn prefill_cached[&m, &t, &f, &g](m: &!m [int], t: &!t [byte], ffi: &g Ffi("libmetalgpu"), fs: &f Fs(""), eng: int, ca: int, ids: int, n_prompt: int, lg: int, warm: bool) -> [ffi("libmetalgpu"), fs_read(""), file_read] int {
    // The longest prefix of this prompt that any slot can resume at: its cut c (kind 0), its earlier cut c0 (1) or a checkpoint (2).
    var hit = 0 - 1;
    var from = 0;
    var kind = 0;
    var ck = 0;
    var i = 0;
    while i < m[ca] {
        let sl = slot_at(m, ca, i);
        if m[sl] == 1 {
            if m[sl + 1] > from && m[sl + 1] < n_prompt && same_prefix(m, sl, ids, m[sl + 1]) {
                hit = i;
                from = m[sl + 1];
                kind = 0;
            }
            if m[sl + 4] > from && m[sl + 4] < n_prompt && same_prefix(m, sl, ids, m[sl + 4]) {
                hit = i;
                from = m[sl + 4];
                kind = 1;
            }
            var j = m[sl + 10];
            while j > 0 {
                let p = ck_step() * j;
                if p > from && p < n_prompt && same_prefix(m, sl, ids, p) {
                    hit = i;
                    from = p;
                    kind = 2;
                    ck = j - 1;
                    j = 0;
                } else {
                    j = j - 1;
                }
            }
        }
        i = i + 1;
    }
    // Where this conversation is written: the slot it continues (a cut c or a checkpoint), or another when it only shares the earlier cut.
    var target = hit;
    if hit < 0 || kind == 1 {
        target = victim(m, ca, hit);
    }
    let ts = slot_at(m, ca, target);
    if hit < 0 {
        if park(m, t, ffi, eng, ca, target) < 0 {
            return 0 - 1;
        }
        m[ts] = 0;
        m[ca + 1] = target;
        qwen35.reset(m, t, ffi, eng);
        m[ts + 1] = 0;
        m[ts + 4] = 0;
        m[ts + 10] = 0;
    } else {
        let hs = slot_at(m, ca, hit);
        if hit != m[ca + 1] {
            if park(m, t, ffi, eng, ca, target) < 0 {
                return 0 - 1;
            }
            m[ca + 1] = 0 - 1;
            if qwen35slot.kv_copy(m, t, ffi, eng, m[hs + 6], m[ca + 2], 0) < 0 {
                return 0 - 1;
            }
        } else if target != hit {
            if park(m, t, ffi, eng, ca, 0 - 1) < 0 {
                return 0 - 1;
            }
        }
        // Not valid while the engine is being changed: a request that fails cannot leave a slot a later one trusts.
        m[ts] = 0;
        m[ca + 1] = target;
        var snap = m[hs + 3];
        if kind == 1 {
            snap = m[hs + 5];
        } else if kind == 2 {
            snap = mem.get(m, m[hs + 9], ck);
        }
        if qwen35slot.snap_copy(m, t, ffi, eng, snap, m[ca + 2], 0) < 0 {
            return 0 - 1;
        }
        if target != hit {
            // the new conversation shares the earlier cut: its slot gets the same snapshot there, and no checkpoint yet
            if qwen35slot.snap_copy(m, t, ffi, eng, m[ts + 5], m[ca + 2], 1) < 0 {
                return 0 - 1;
            }
            m[ts + 4] = from;
            m[ts + 10] = 0;
        }
        // what of the slot lies past `from` is another conversation's now
        if m[ts + 1] > from {
            m[ts + 1] = 0;
        }
        if m[ts + 4] > from {
            m[ts + 4] = 0;
        }
        if m[ts + 10] > from / ck_step() {
            m[ts + 10] = from / ck_step();
        }
        qwen35slot.open_prefix(m, t, ffi, eng, from);
    }
    m[ts + 7] = 0;
    let cached = from;
    let c2 = cut_of(m, ids, n_prompt);
    if hit < 0 {
        let c0 = first_cut_of(m, ids, n_prompt);
        if c0 > 0 && c0 < c2 {
            if feed_marked(m, t, ffi, fs, eng, ca, ts, ids, 0, c0, n_prompt, 0 - 1, warm) < 0 {
                return 0 - 1;
            }
            if qwen35slot.snap_copy(m, t, ffi, eng, m[ts + 5], m[ca + 2], 1) < 0 {
                return 0 - 1;
            }
            m[ts + 4] = c0;
            from = c0;
        }
    }
    if c2 > from {
        if feed_marked(m, t, ffi, fs, eng, ca, ts, ids, from, c2, n_prompt, 0 - 1, warm) < 0 {
            return 0 - 1;
        }
        if qwen35slot.snap_copy(m, t, ffi, eng, m[ts + 3], m[ca + 2], 1) < 0 {
            return 0 - 1;
        }
        m[ts + 1] = c2;
        from = c2;
    }
    // the slot's ids are the whole prompt's: its cuts and its checkpoints are all prefixes of them
    i = 0;
    while i < n_prompt {
        m[m[ts + 2] + i] = mem.get(m, ids, i);
        i = i + 1;
    }
    if feed_marked(m, t, ffi, fs, eng, ca, ts, ids, from, n_prompt, n_prompt, lg, warm) < 0 {
        return 0 - 1;
    }
    if m[ts + 1] > 0 || m[ts + 4] > 0 || m[ts + 10] > 0 {
        m[ts] = 1;
        m[ca + 3] = m[ca + 3] + 1;
        m[ts + 8] = m[ca + 3];
    } else {
        m[ca + 1] = 0 - 1;
    }
    return cached;
}

// One chat completion on the engine: the request record `r` (src/chat.cho), the connection to answer on.
// Answers the number of tokens generated, or -1.
fn complete[&m, &t, &f, &g, &k, &c](m: &!m [int], t: &!t [byte], ffi: &g Ffi("libmetalgpu"), fs: &f Fs(""), clock: &k Clock, eng: int, ch: &!c Conn, r: int, model: int, serial: int, use_spec: bool, slot: int, ollama: bool) -> [ffi("libmetalgpu"), fs_read(""), file_read, clock, conn_write] int {
    let tk = qwen35spec.tokenizer(m, eng);
    let spec_on = use_spec && qwen35spec.has_head(m, eng);
    let prompt = m[r + chat.f_prompt()];
    let ids = bpe.encode(m, t, tk, text.start(prompt), text.start(prompt) + text.size(prompt));
    if ids < 0 {
        refuse_on(m, t, ch, 400, last_error(m, t), "invalid_request_error", ollama);
        return 0 - 1;
    }
    let n_prompt = mem.size(m, ids);
    let room = qwen35.tmax() - n_prompt;
    if room < 1 {
        refuse_on(m, t, ch, 400, text.f2(m, t, "this model's context is $ tokens and the prompt has $", text.num(m, t, qwen35.tmax()), text.num(m, t, n_prompt)), "invalid_request_error", ollama);
        return 0 - 1;
    }
    var max_new = m[r + chat.f_max_tokens()];
    if max_new < 0 || max_new > room {
        max_new = room;
    }
    let think = m[r + chat.f_think()] == 1;
    let stream = m[r + chat.f_stream()] == 1;
    let id = text.f2(m, t, "chatcmpl-$-$", text.num(m, t, serial), text.num(m, t, clock_unix_ms(clock) % 1000000));
    let created = clock_unix_ms(clock) / 1000;
    // A new conversation, the prompt in, the first logits out.
    var cached = 0;
    let lg = qwen35.reserve(m, 4 * qwen35.vocab());
    if slot < 0 {
        qwen35.reset(m, t, ffi, eng);
        if qwen35spec.feed(m, t, ffi, fs, eng, ids, 0, n_prompt, lg, true, spec_on) < 0 {
            refuse_on(m, t, ch, 500, last_error(m, t), "server_error", ollama);
            return 0 - 1;
        }
    } else {
        cached = prefill_cached(m, t, ffi, fs, eng, slot, ids, n_prompt, lg, spec_on);
        if cached < 0 {
            refuse_on(m, t, ch, 500, last_error(m, t), "server_error", ollama);
            return 0 - 1;
        }
        m[slot + 5] = cached;
    }
    var seed = m[r + chat.f_seed()];
    if seed < 0 {
        seed = clock_unix_ms(clock) % 2147483647 + serial;
    }
    let smp = sampler.new(m, float_of(m[r + chat.f_temperature()]) / 1000.0, float_of(m[r + chat.f_top_p()]) / 1000.0, m[r + chat.f_top_k()], seed);
    let f_stop = text.lit(m, t, "stop");
    let f_length = text.lit(m, t, "length");
    let f_error = text.lit(m, t, "error");
    let lgd = qwen35.reserve(m, 4 * qwen35.vocab());
    let rows = qwen35.reserve(m, 12 * qwen35.vocab());
    let gsmp = sampler.new(m, 0.0, 0.95, 20, 1);
    let after = m[mem.text_slot()];
    if stream {
        let head = text.lit(m, t, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: close\r\n\r\n");
        if send_all(m, t, ch, head) < 0 {
            return 0 - 1;
        }
        let first = chat.chunk_json(m, t, id, created, model, text.lit(m, t, "\"role\":\"assistant\",\"content\":\"\""), 0 - 1);
        if send_all(m, t, ch, first) < 0 {
            return 0 - 1;
        }
    }
    let st = mem.grab(m, 16);
    m[st + 1] = 0;
    if think {
        m[st + 1] = 1;
    }
    m[st + 5] = f_length;
    m[st + 6] = 1;
    m[st + 7] = mem.list(m);
    m[st + 8] = mem.list(m);
    m[st + 9] = 0;
    if stream {
        m[st + 9] = 1;
    }
    m[st + 10] = max_new;
    m[st + 11] = id;
    m[st + 12] = created;
    m[st + 13] = model;
    m[st + 14] = tk;
    m[st + 15] = f_stop;
    // The first token is drawn from the prompt's logits; each later one comes from a round of the draft
    // head and a three-row check (when the engine has the head), or from a single step.
    let (n0, p0) = sampler.nucleus(m, t, smp, lg, qwen35.vocab());
    let first_tok = sampler.draw(m, smp, n0, p0);
    take(m, t, ch, st, first_tok);
    var spec = spec_on;
    var sp = 0;
    var last = first_tok;
    var at = n_prompt;
    if spec {
        sp = qwen35spec.spec_init(m, eng, first_tok, n_prompt - 1);
    }
    while m[st + 4] == 0 && m[st + 6] == 1 {
        if spec && qwen35spec.spec_pos(m, sp) + 4 >= qwen35.tmax() {
            // the context is nearly full: finish with single steps
            last = qwen35spec.spec_last(m, sp);
            at = qwen35spec.spec_pos(m, sp) + 1;
            spec = false;
        }
        if spec {
            let got = qwen35spec.spec_round(m, t, ffi, fs, eng, sp, lgd, rows, smp, gsmp);
            if got < 0 {
                m[st + 5] = f_error;
                m[st + 4] = 1;
            } else {
                var j = 0;
                while j < got && m[st + 4] == 0 && m[st + 6] == 1 {
                    take(m, t, ch, st, qwen35spec.spec_token(m, sp, j));
                    j = j + 1;
                }
            }
        } else if qwen35.feed_one(m, t, ffi, fs, eng, last, at, lg) < 0 {
            m[st + 5] = f_error;
            m[st + 4] = 1;
        } else {
            let (nids, nprobs) = sampler.nucleus(m, t, smp, lg, qwen35.vocab());
            let pick = sampler.draw(m, smp, nids, nprobs);
            take(m, t, ch, st, pick);
            last = pick;
            at = at + 1;
        }
        // what a step allocated is not needed again: keep the logits and the lists
        m[mem.text_slot()] = after;
    }
    let n = m[st];
    let finish = m[st + 5];
    let reasoning = m[st + 7];
    let content = m[st + 8];
    let alive = m[st + 6] == 1;
    if !alive {
        return n;
    }
    if stream {
        let end = chat.chunk_json(m, t, id, created, model, text.empty(), finish);
        send_all(m, t, ch, end);
        if m[r + chat.f_usage()] == 1 {
            let usage = text.fmt(m, t, "data: {\"id\":\"$\",\"object\":\"chat.completion.chunk\",\"created\":$,\"model\":\"$\",\"choices\":[],\"usage\":{\"prompt_tokens\":$,\"completion_tokens\":$,\"total_tokens\":$,\"prompt_tokens_details\":{\"cached_tokens\":$}}}\n\n", mem.of7(m, id, text.num(m, t, created), chat.escape(m, t, model), text.num(m, t, n_prompt), text.num(m, t, n), text.num(m, t, n_prompt + n), text.num(m, t, cached)));
            send_all(m, t, ch, usage);
        }
        send_all(m, t, ch, text.lit(m, t, "data: [DONE]\n\n"));
        return n;
    }
    var rtext = 0 - 1;
    if think {
        rtext = trimmed(t, decode_from(m, t, tk, reasoning, 0));
    }
    let ctext = trimmed(t, decode_from(m, t, tk, content, 0));
    if ollama {
        var mname = model;
        if m[r + chat.f_model()] > 0 {
            mname = m[r + chat.f_model()];
        }
        respond(m, t, ch, 200, chat.generate_json(m, t, mname, rtext, ctext, finish, n_prompt, n));
        return n;
    }
    respond(m, t, ch, 200, chat.completion_json(m, t, id, created, model, rtext, ctext, finish, n_prompt, n, cached));
    return n;
}

fn handle[&m, &t, &i, &f, &g, &k, &c](m: &!m [int], t: &!t [byte], io: &!i Io, ffi: &g Ffi("libmetalgpu"), fs: &f Fs(""), clock: &k Clock, eng: int, ch: &!c Conn, cfg: int, serial: int) -> [err_write, ffi("libmetalgpu"), fs_read(""), file_read, clock, conn_read, conn_write] int {
    let t0 = clock_ms(clock);
    let cap = max_request();
    let buf = qwen35.reserve(m, cap);
    var got = 0;
    var he = 0 - 1;
    var need = 0 - 1;
    var open = true;
    while open {
        match conn_read(ch, t[buf + got..buf + cap]) {
            Received::Data(k2) => {
                got = got + k2;
            }
            Received::End => {
                open = false;
            }
            Received::Again => {
                open = false;
            }
            Received::Failed(e) => {
                open = false;
                got = 0 - 1;
            }
        }
        if got < 0 {
            return 0 - 1;
        }
        if open && he < 0 {
            he = head_end(t, buf, buf + got);
            if he >= 0 {
                let cl = header(t, buf, he, "content-length");
                need = he + 4 - buf;
                if cl >= 0 {
                    let v = number_of(t, cl);
                    if v < 0 {
                        refuse(m, t, ch, 400, text.lit(m, t, "bad Content-Length"), "invalid_request_error");
                        return 0 - 1;
                    }
                    need = need + v;
                }
                if need > cap {
                    refuse(m, t, ch, 413, text.lit(m, t, "the request is too large"), "invalid_request_error");
                    return 0 - 1;
                }
            }
        }
        if open && he >= 0 && got >= need {
            open = false;
        }
        if open && got >= cap {
            refuse(m, t, ch, 413, text.lit(m, t, "the request is too large"), "invalid_request_error");
            return 0 - 1;
        }
    }
    if he < 0 {
        refuse(m, t, ch, 400, text.lit(m, t, "no complete request head"), "invalid_request_error");
        return 0 - 1;
    }
    // The request line: METHOD SP path[?query] SP HTTP/1.x
    var p = buf;
    while p < he && t[p] != byte_of(32) {
        p = p + 1;
    }
    let method = text.handle(buf, p - buf);
    var q = p + 1;
    while q < he && t[q] != byte_of(32) && t[q] != byte_of(63) {
        q = q + 1;
    }
    let path = text.handle(p + 1, q - p - 1);
    var status = 200;
    var tokens = 0;
    let key = m[cfg + 3];
    let is_health = text.is(t, path, "/health");
    // Ollama's route (docs/serving.md section 12): the same engine, an answer in Ollama's form
    let is_gen = text.is(t, path, "/api/generate");
    var allowed = true;
    if key >= 0 && !is_health {
        let auth = header(t, buf, he, "authorization");
        allowed = false;
        if auth >= 0 && text.starts_with(t, auth, "Bearer ") && text.eq(t, text.sub(auth, 7, text.size(auth)), key) {
            allowed = true;
        }
    }
    let model = m[cfg + 1];
    if !allowed {
        status = 401;
        refuse(m, t, ch, 401, text.lit(m, t, "a valid API key is required (Authorization: Bearer <key>)"), "authentication_error");
    } else if is_health {
        respond(m, t, ch, 200, text.lit(m, t, "{\"status\":\"ok\"}"));
    } else if text.is(t, path, "/v1/models") {
        respond(m, t, ch, 200, text.f2(m, t, "{\"object\":\"list\",\"data\":[{\"id\":\"$\",\"object\":\"model\",\"created\":$,\"owned_by\":\"cancho-gpu\"}]}", chat.escape(m, t, model), text.num(m, t, clock_unix_ms(clock) / 1000)));
    } else if text.is(t, path, "/v1/chat/completions") || is_gen {
        if !text.is(t, method, "POST") {
            status = 405;
            refuse(m, t, ch, 405, text.lit(m, t, "use POST"), "invalid_request_error");
        } else {
            var r = 0 - 1;
            if is_gen {
                r = chat.generate(m, t, he + 4, got - (he + 4 - buf), m[cfg + 2] == 1);
            } else {
                r = chat.parse(m, t, he + 4, got - (he + 4 - buf), m[cfg + 2] == 1);
            }
            if r < 0 {
                status = 400;
                refuse_on(m, t, ch, 400, last_error(m, t), "invalid_request_error", is_gen);
            } else {
                if m[cfg + 6] >= 0 {
                    m[m[cfg + 6] + 5] = 0;
                }
                tokens = complete(m, t, ffi, fs, clock, eng, ch, r, model, serial, m[cfg + 4] == 1, m[cfg + 6], is_gen);
                if tokens < 0 {
                    status = 500;
                }
            }
        }
    } else {
        status = 404;
        refuse(m, t, ch, 404, text.lit(m, t, "no such route"), "invalid_request_error");
    }
    var reused = text.empty();
    if m[cfg + 6] >= 0 {
        reused = text.f1(m, t, " cached=$", text.num(m, t, m[m[cfg + 6] + 5]));
    }
    io.error_all(io, text.bytes(t, text.fmt(m, t, "$ $ $ tokens=$$ $ ms\n", mem.of6(m, method, path, text.num(m, t, status), text.num(m, t, tokens), reused, text.num(m, t, clock_ms(clock) - t0)))));
    return 0;
}

fn serve[&m, &t, &i, &f, &g, &k, &l](m: &!m [int], t: &!t [byte], io: &!i Io, ffi: &g Ffi("libmetalgpu"), fs: &f Fs(""), clock: &k Clock, eng: int, lh: &!l Listener, cfg: int) -> [err_write, ffi("libmetalgpu"), fs_read(""), file_read, clock, conn_accept, conn_read, conn_write] int {
    // What the load allocated stays; what a request allocated is given back after it.
    let mark_m = m[mem.top_slot()];
    let mark_t = m[mem.text_slot()];
    var serial = 0;
    var failures = 0;
    while failures < 100 {
        match tcp_accept(lh) {
            Accepted::Ok(conn) => {
                failures = 0;
                serial = serial + 1;
                var c = conn;
                borrow mut c as &!ch in {
                    handle(m, t, io, ffi, fs, clock, eng, ch, cfg, serial);
                }
                conn_close(c);
            }
            Accepted::Again => {
            }
            Accepted::Failed(e) => {
                failures = failures + 1;
            }
        }
        mem.release_to(m, mark_m);
        m[mem.text_slot()] = mark_t;
    }
    io.error_all(io, "error[accept]: the listening socket keeps failing\n");
    return 1;
}

fn run[&m, &t, &i, &f, &a, &g, &k, &l](m: &!m [int], t: &!t [byte], io: &!i Io, fs: &f Fs(""), args: &a Args, ffi: &g Ffi("libmetalgpu"), clock: &k Clock, lh: &!l Listener, port: int, cfg: int) -> [err_write, fs_read(""), file_read, args, ffi("libmetalgpu"), clock, conn_accept, conn_read, conn_write] int {
    let store = text.from_bytes(m, t, arg(args, 1));
    let kdir = text.from_bytes(m, t, arg(args, 2));
    if metal.cgpu_open(ffi) < 0 {
        qwen35.device_fail(m, t, ffi, "opening the device");
        return cli.report(m, t, io);
    }
    io.error_all(io, "loading the model...\n");
    let t0 = clock_ms(clock);
    let eng = qwen35.load(m, t, ffi, fs, store, kdir, m[cfg + 4] == 1);
    if eng < 0 {
        return cli.report(m, t, io);
    }
    m[eng + 222] = m[cfg + 8];
    // The batch kernels are compiled on first use otherwise, and a kernel is a record in `m`: one made while
    // handling a request would be given back with the request's memory.
    // (the kernels and buffers of a round of 7 drafts are records too: made here, not in the first request's memory)
    if qwen35spec.ensure_deep(m, t, ffi, fs, eng) < 0 {
        return cli.report(m, t, io);
    }
    if m[cfg + 5] == 1 {
        // Allocated here, before `serve` takes its mark, so it outlives every request.
        m[cfg + 6] = cache_new(m, t, ffi, eng, m[cfg + 7]);
        if m[cfg + 6] < 0 {
            return cli.report(m, t, io);
        }
    }
    io.error_all(io, text.bytes(t, text.f2(m, t, "ready on port $ (loaded in $ ms)\n", text.num(m, t, port), text.num(m, t, clock_ms(clock) - t0))));
    if m[cfg + 3] < 0 && m[cfg + 9] == 0 {
        io.error_all(io, "warning: no --api-key, and this listens on every address of the host\n");
    }
    let status = serve(m, t, io, ffi, fs, clock, eng, lh, cfg);
    metal.cgpu_close(ffi);
    return status;
}

// Listen on every address, or on 127.0.0.1 only (`--loopback`: a runner of cancho-gpu-front, docs/one-server.md).
fn listen_on[&n](net: &n Net(""), port: int, loopback: bool) -> [net_in("")] Listening {
    if loopback {
        return tcp_listen_on(net, "127.0.0.1", port, 16, 0);
    }
    return tcp_listen(net, port, 16, 0);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(signals);
    release(exec);
    release(tty);
    let gpu = narrow(ffi, "libmetalgpu");
    var status = 0;
    var port = 8080;
    borrow mut heap as &!h in {
        var mb = box_slice(h, words(), 0);
        var tb = box_slice(h, bytes_cap(), byte_of(0));
        borrow mut mb as &!mr in {
            borrow mut tb as &!tr in {
                let m = contents(mr);
                let t = contents(tr);
                mem.init(m);
                // cfg: 0 port, 1 model name, 2 think by default, 3 API key (a text handle, or -1), 4 draft head, 5 the
                // prefix cache is on, 6 the cache (-1 when off), 7 its number of slots, 8 the long route of attention at every length
                let cfg = mem.grab(m, 10);
                m[cfg + 8] = 0;
                m[cfg + 9] = 0;
                m[cfg + 7] = 2;
                m[cfg + 4] = 1;
                m[cfg + 5] = 1;
                m[cfg + 6] = 0 - 1;
                m[cfg + 1] = text.lit(m, t, "qwen3.8:27b-mlx");
                m[cfg + 3] = 0 - 1;
                var ok = true;
                borrow args as &a in {
                    if arg_count(a) < 3 {
                        ok = false;
                    }
                    var ai = 3;
                    while ok && ai < arg_count(a) {
                        let flag = text.from_bytes(m, t, arg(a, ai));
                        if text.is(t, flag, "--think") {
                            m[cfg + 2] = 1;
                        } else if text.is(t, flag, "--no-spec") {
                            m[cfg + 4] = 0;
                        } else if text.is(t, flag, "--loopback") {
                            m[cfg + 9] = 1;
                        } else if text.is(t, flag, "--long-attention") {
                            m[cfg + 8] = 1;
                        } else if text.is(t, flag, "--no-prefix-cache") {
                            m[cfg + 5] = 0;
                        } else if ai + 1 < arg_count(a) && text.is(t, flag, "--cache-slots") {
                            m[cfg + 7] = number_of(t, text.from_bytes(m, t, arg(a, ai + 1)));
                            if m[cfg + 7] < 1 || m[cfg + 7] > 16 {
                                ok = false;
                            }
                            ai = ai + 1;
                        } else if ai + 1 < arg_count(a) && text.is(t, flag, "--port") {
                            port = number_of(t, text.from_bytes(m, t, arg(a, ai + 1)));
                            ai = ai + 1;
                        } else if ai + 1 < arg_count(a) && text.is(t, flag, "--model") {
                            m[cfg + 1] = text.from_bytes(m, t, arg(a, ai + 1));
                            ai = ai + 1;
                        } else if ai + 1 < arg_count(a) && text.is(t, flag, "--api-key") {
                            m[cfg + 3] = text.from_bytes(m, t, arg(a, ai + 1));
                            ai = ai + 1;
                        } else {
                            ok = false;
                        }
                        ai = ai + 1;
                    }
                }
                m[cfg] = port;
                if !ok || port < 1 || port > 65535 {
                    borrow mut io as &!i in {
                        status = usage(i);
                    }
                } else {
                    borrow net as &nn in {
                        match listen_on(nn, port, m[cfg + 9] == 1) {
                            Listening::Ok(l) => {
                                var listener = l;
                                borrow mut listener as &!lh in {
                                    borrow mut io as &!i in {
                                        borrow fs as &f in {
                                            borrow args as &a in {
                                                borrow gpu as &g in {
                                                    borrow clock as &c in {
                                                        status = run(m, t, i, f, a, g, c, lh, port, cfg);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                listener_close(listener);
                            }
                            Listening::Failed(e) => {
                                borrow mut io as &!i in {
                                    io.error_all(i, "error[listen]: cannot listen on that port\n");
                                }
                                status = 1;
                            }
                        }
                    }
                }
            }
        }
        unbox_slice(h, mb);
        unbox_slice(h, tb);
    }
    release(heap);
    release(net);
    release(io);
    release(fs);
    release(args);
    release(gpu);
    release(clock);
    return status;
}

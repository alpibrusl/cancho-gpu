edition 9;

module gallery;

import std.buffer;
import std.bytes;
import std.http;
import files;
import results;
import picks;
import library;

// `gallery` -- every picture the studio holds (docs/studio-sessions.md, section 9): `GET /gallery`, newest job first, 48 tiles a page, each with a tag.
//
//   uploaded   `upload-N.*` (the first picture) and `upload-N-2.*` (the second), served as `/files/N/input1.*` and `input2.*`
//   generated  `out/N/image.png`, a picture made from a prompt
//   edited     `out/N/edited.png`, an edit (a refine too)
//
// The tag comes from the file, so nothing is stored and old jobs have one. A result is listed only when its job is `done`. `?tag=uploaded|generated|edited` filters, `?page=N` pages
// (a page past the end is empty). Nothing from the client reaches a path: the ids are the ones in `queue`, the names are fixed.

// One tile. `mode` 0: a job's result (Refine), 1: a picture a job was given (Edit this), 2: a library picture (Edit this). The picture links to its job, or to itself in the library.
fn tile[&h, &f, &d, &i, &n](heap: &!h Heap, page: buffer.Buffer, fs: &f Fs(""), dir: &d [byte], id: &i [byte], name: &n [byte], tag: &static [byte], mode: int) -> [heap, fs_read(""), file_read] buffer.Buffer {
    var p = buffer.append(heap, page, "<div class=job><a class=thumb href=");
    if mode == 2 {
        p = buffer.append(heap, p, "/files/");
        p = buffer.append(heap, p, id);
        p = buffer.append(heap, p, "/");
        p = buffer.append(heap, p, name);
    } else {
        p = buffer.append(heap, p, "/jobs/");
        p = buffer.append(heap, p, id);
    }
    p = buffer.append(heap, p, "><img loading=lazy alt=\"");
    p = buffer.append(heap, p, tag);
    p = buffer.append(heap, p, " picture ");
    p = buffer.append(heap, p, id);
    p = buffer.append(heap, p, "\" src=/files/");
    p = buffer.append(heap, p, id);
    p = buffer.append(heap, p, "/");
    p = buffer.append(heap, p, name);
    p = buffer.append(heap, p, "><span class=\"badge ");
    p = buffer.append(heap, p, tag);
    p = buffer.append(heap, p, "\">");
    p = buffer.append(heap, p, tag);
    if mode == 2 {
        p = buffer.append(heap, p, "</span><span class=idn>library</span></a><div class=body><p class=prompt>");
        let (desc, has_desc) = library.description(heap, fs, dir, id[1..len(id)]);
        if has_desc {
            borrow desc as &dsb in {
                p = results.escape(heap, p, buffer.bytes(dsb));
            }
            // written by the describer, not by a person (docs/studio-sessions.md, section 16)
            let auto = buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.empty(heap, 96), dir), "/lib-"), id[1..len(id)]), ".auto");
            borrow auto as &aub in {
                if files.exists(fs, buffer.bytes(aub)) {
                    p = buffer.append(heap, p, " <span class=meta>(auto)</span>");
                }
            }
            buffer.drop(heap, auto);
        } else {
            p = buffer.append(heap, p, "Added to the library");
        }
        buffer.drop(heap, desc);
        p = buffer.append(heap, p, "</p><span class=meta>library");
        let gk = library.kind(heap, fs, dir, id[1..len(id)]);
        if gk >= 0 {
            p = buffer.append(heap, p, " &middot; ");
            p = buffer.append(heap, p, results.kind_name(gk));
        }
        p = buffer.append(heap, p, " &middot; <a href=\"/edit?pick1=l/");
        p = buffer.append(heap, p, id);
        p = buffer.append(heap, p, "\">Edit this</a> &middot; <details style=\"display:inline\"><summary style=\"display:inline;cursor:pointer\">Group</summary><form method=post action=/gallery/group/");
        p = buffer.append(heap, p, id[1..len(id)]);
        p = buffer.append(heap, p, " style=\"max-width:none\"><select name=group><option value=auto>let the model decide");
        var gi = 0;
        while gi < results.kind_count() {
            p = buffer.append(heap, p, "<option value=");
            p = buffer.append(heap, p, results.kind_name(gi));
            if gi == gk {
                p = buffer.append(heap, p, " selected");
            }
            p = buffer.append(heap, p, ">");
            p = buffer.append(heap, p, results.kind_name(gi));
            gi = gi + 1;
        }
        p = buffer.append(heap, p, "</select><button>Set</button></form></details> &middot; <details style=\"display:inline\"><summary style=\"display:inline;cursor:pointer\">Delete</summary><form method=post action=/gallery/delete/");
        p = buffer.append(heap, p, id[1..len(id)]);
        p = buffer.append(heap, p, " style=\"max-width:none\"><button>Yes, delete it for good</button></form></details></span></div></div>");
        return p;
    }
    p = buffer.append(heap, p, "</span><span class=idn>job ");
    p = buffer.append(heap, p, id);
    p = buffer.append(heap, p, "</span></a><div class=body><p class=prompt>");
    let (av, has_av) = results.job_file(heap, fs, dir, id, ".argv");
    if has_av {
        borrow av as &avr in {
            let (ps, pe) = results.last_entry(buffer.bytes(avr));
            p = results.escape(heap, p, buffer.bytes(avr)[ps..pe]);
        }
    }
    buffer.drop(heap, av);
    p = buffer.append(heap, p, "</p><span class=meta><a href=/jobs/");
    p = buffer.append(heap, p, id);
    p = buffer.append(heap, p, ">job ");
    p = buffer.append(heap, p, id);
    p = buffer.append(heap, p, "</a>");
    if mode == 0 {
        p = buffer.append(heap, p, " &middot; <a href=\"/edit?from=");
        p = buffer.append(heap, p, id);
        p = buffer.append(heap, p, "\">Refine</a>");
    } else {
        p = buffer.append(heap, p, " &middot; <a href=\"/edit?pick1=j/");
        p = buffer.append(heap, p, id);
        p = buffer.append(heap, p, "/");
        p = buffer.append(heap, p, name);
        p = buffer.append(heap, p, "\">Edit this</a>");
    }
    return buffer.append(heap, p, "</span></div></div>");
}

// Offer one picture to the page: counted when its tag passes the filter, shown when it falls on this page, and `more` when there is another after the page.
// Returns (the page, seen so far, shown so far, whether more exist).
fn offer[&h, &f, &d, &i, &n, &z](heap: &!h Heap, page: buffer.Buffer, fs: &f Fs(""), dir: &d [byte], id: &i [byte], name: &n [byte], tag: &static [byte], mode: int, want: &static [byte], q: &z [byte], skip: int, seen: int, shown: int, more: bool) -> [heap, fs_read(""), file_read] (buffer.Buffer, int, int, bool) {
    if len(name) == 0 || (len(want) > 0 && bytes.equal(want, tag) == false) {
        return (page, seen, shown, more);
    }
    if len(q) > 0 {
        var found = false;
        if mode == 2 {
            found = picks.matches(heap, fs, dir, true, id[1..len(id)], q);
        } else {
            found = picks.matches(heap, fs, dir, false, id, q);
        }
        if found == false {
            return (page, seen, shown, more);
        }
    }
    let n = seen + 1;
    if n <= skip {
        return (page, n, shown, more);
    }
    if shown >= 48 {
        return (page, n, shown, true);
    }
    return (tile(heap, page, fs, dir, id, name, tag, mode), n, shown + 1, more);
}

fn filter_link[&h](heap: &!h Heap, page: buffer.Buffer, label: &static [byte], href: &static [byte], current: bool) -> [heap] buffer.Buffer {
    var p = buffer.append(heap, page, "<a class=btn href=\"");
    p = buffer.append(heap, p, href);
    p = buffer.append(heap, p, "\"");
    if current {
        p = buffer.append(heap, p, " aria-current=page style=\"border-color:var(--accent)\"");
    }
    p = buffer.append(heap, p, ">");
    p = buffer.append(heap, p, label);
    return buffer.append(heap, p, "</a>");
}

// `q` written for a query string: letters and digits as they are, everything else as `%XX`.
fn put_q[&h, &q](heap: &!h Heap, page: buffer.Buffer, q: &q [byte]) -> [heap] buffer.Buffer {
    var p = page;
    var i = 0;
    while i < len(q) {
        let c = int_of(q[i]);
        if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
            p = buffer.push(heap, p, byte_of(c));
        } else {
            p = buffer.push(heap, p, byte_of(37));
            let hi = c / 16;
            let lo = c - hi * 16;
            if hi < 10 {
                p = buffer.push(heap, p, byte_of(48 + hi));
            } else {
                p = buffer.push(heap, p, byte_of(55 + hi));
            }
            if lo < 10 {
                p = buffer.push(heap, p, byte_of(48 + lo));
            } else {
                p = buffer.push(heap, p, byte_of(55 + lo));
            }
        }
        i = i + 1;
    }
    return p;
}

// `GET /gallery[?tag=T][&q=WORDS][&page=N]`: (status, the page). 422 for a tag that is not one of the three or a page that is not 1 to 4 digits.
pub fn page[&h, &f, &d, &q](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], query: &q [byte]) -> [heap, fs_read(""), file_read] (int, buffer.Buffer) {
    let (tf, tt) = http.query_value(query, "tag");
    let (pf, pt) = http.query_value(query, "page");
    let (gf, gt) = http.query_value(query, "group");
    var grp = 0 - 1;
    if gf >= 0 && gt > gf {
        grp = results.kind_index(query[gf..gt]);
    }
    var want = "";
    var bad = false;
    if tf >= 0 && tt > tf {
        if bytes.equal(query[tf..tt], "uploaded") {
            want = "uploaded";
        } else if bytes.equal(query[tf..tt], "generated") {
            want = "generated";
        } else if bytes.equal(query[tf..tt], "edited") {
            want = "edited";
        } else {
            bad = true;
        }
    }
    var number = 1;
    if pf >= 0 && pt > pf {
        if pt - pf > 4 {
            bad = true;
        } else {
            var k = pf;
            var v = 0;
            while k < pt {
                let c = int_of(query[k]);
                if c < 48 || c > 57 {
                    bad = true;
                } else {
                    v = v * 10 + (c - 48);
                }
                k = k + 1;
            }
            if v >= 1 {
                number = v;
            }
        }
    }
    if gf >= 0 && gt > gf && grp < 0 {
        bad = true;
    }
    if bad {
        return (422, buffer.append(heap, buffer.empty(heap, 96), "tag is uploaded, generated or edited; group is person, garment, furniture, room, place, object, animal or other; page is a number of 1 to 4 digits"));
    }
    let skip = (number - 1) * 48;
    let qb = picks.query_text(heap, query, "q");
    var page = buffer.empty(heap, 8);
    borrow qb as &qbb in {
    buffer.drop(heap, page);
    page = results.open(heap, fs, dir, "gallery", "gallery", false);
    page = buffer.append(heap, page, "<div class=row><h1>Gallery</h1><span class=meta>Every picture the studio holds, newest job first</span></div><div class=acts>");
    page = filter_link(heap, page, "All", "/gallery", len(want) == 0);
    page = filter_link(heap, page, "Uploaded", "/gallery?tag=uploaded", bytes.equal(want, "uploaded"));
    page = filter_link(heap, page, "Generated", "/gallery?tag=generated", bytes.equal(want, "generated"));
    page = filter_link(heap, page, "Edited", "/gallery?tag=edited", bytes.equal(want, "edited"));
    page = buffer.append(heap, page, "</div><div class=acts><span class=meta>Groups of the library:</span>");
    var gi = 0;
    while gi < results.kind_count() {
        let gc = library.count_kind(heap, fs, dir, gi);
        if gc > 0 || gi == grp {
            page = buffer.append(heap, page, "<a class=btn href=\"/gallery?group=");
            page = buffer.append(heap, page, results.kind_name(gi));
            page = buffer.append(heap, page, "\"");
            if gi == grp {
                page = buffer.append(heap, page, " aria-current=page style=\"border-color:var(--accent)\"");
            }
            page = buffer.append(heap, page, ">");
            page = buffer.append(heap, page, results.kind_label(gi));
            page = buffer.append(heap, page, " (");
            page = buffer.push_nat(heap, page, gc);
            page = buffer.append(heap, page, ")</a>");
        }
        gi = gi + 1;
    }
    page = buffer.append(heap, page, "</div><form method=get action=/gallery style=\"max-width:none;flex-direction:row;align-items:flex-end;flex-wrap:wrap\">");
    if grp >= 0 {
        page = buffer.append(heap, page, "<input type=hidden name=group value=");
        page = buffer.append(heap, page, results.kind_name(grp));
        page = buffer.append(heap, page, ">");
    }
    if len(want) > 0 {
        page = buffer.append(heap, page, "<input type=hidden name=tag value=");
        page = buffer.append(heap, page, want);
        page = buffer.append(heap, page, ">");
    }
    page = buffer.append(heap, page, "<label style=\"flex:1 1 260px\">Search (words of a picture's description, or of the instruction a job's picture was made with)<input name=q maxlength=100 value=\"");
    page = results.escape(heap, page, buffer.bytes(qbb));
    page = buffer.append(heap, page, "\"></label><div><button>Search</button></div></form>");
    page = buffer.append(heap, page, "<form method=post action=/gallery enctype=multipart/form-data style=\"max-width:none;flex-direction:row;align-items:flex-end;flex-wrap:wrap\"><label style=\"flex:1 1 260px\">Add a picture to the library (JPEG, PNG or WebP, up to 15 MB)<input name=image type=file accept=image/jpeg,image/png,image/webp required></label><label style=\"flex:2 1 260px\">Description (optional, at most 200 characters: what is in it, to find it later)<input name=description maxlength=200></label><div><button>Add</button></div></form><div class=grid>");
    var seen = 0;
    var shown = 0;
    var more = false;
    // the library's own pictures come first (they have no job to date them), newest first
    if len(want) == 0 || bytes.equal(want, "uploaded") {
        let idx = library.index(heap, fs, dir);
        borrow idx as &ib in {
            let all = buffer.bytes(ib);
            var end = len(all);
            while end > 0 && more == false {
                var stop = end;
                while stop > 0 && int_of(all[stop - 1]) == 10 {
                    stop = stop - 1;
                }
                if stop == 0 {
                    end = 0;
                } else {
                    var start = stop;
                    while start > 0 && int_of(all[start - 1]) != 10 {
                        start = start - 1;
                    }
                    var sp = start;
                    while sp < stop && int_of(all[sp]) != 32 {
                        sp = sp + 1;
                    }
                    let number = all[start..sp];
                    if results.id_ok(number) && (grp < 0 || library.kind(heap, fs, dir, number) == grp) {
                        let lname = picks.lib_name(heap, fs, dir, number);
                        let ref = buffer.append(heap, buffer.push(heap, buffer.empty(heap, 12), byte_of(76)), number);
                        borrow ref as &rb in {
                            let (lp, ls, lh, lm) = offer(heap, page, fs, dir, buffer.bytes(rb), lname, "uploaded", 2, want, buffer.bytes(qbb), skip, seen, shown, more);
                            page = lp;
                            seen = ls;
                            shown = lh;
                            more = lm;
                        }
                        buffer.drop(heap, ref);
                    }
                    end = start;
                }
            }
        }
        buffer.drop(heap, idx);
    }
    var text = buffer.empty(heap, 8);
    let qp = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), dir), "/queue");
    borrow qp as &qb in {
        // a group is a group of the library: the pictures of jobs are not in one
        if grp < 0 {
            let (b, e) = files.read_all(heap, fs, buffer.bytes(qb));
            buffer.drop(heap, text);
            text = b;
        }
    }
    buffer.drop(heap, qp);
    borrow text as &tb in {
        let all = buffer.bytes(tb);
        var end = len(all);
        while end > 0 && more == false {
            var stop = end;
            while stop > 0 && int_of(all[stop - 1]) == 10 {
                stop = stop - 1;
            }
            if stop == 0 {
                end = 0;
            } else {
                var start = stop;
                while start > 0 && int_of(all[start - 1]) != 10 {
                    start = start - 1;
                }
                let id = all[start..stop];
                if results.id_ok(id) {
                    let first = picks.upload_name(heap, fs, dir, id, false);
                    let second = picks.upload_name(heap, fs, dir, id, true);
                    let made = results.result_name(heap, fs, dir, id);
                    var made_tag = "edited";
                    if bytes.equal(made, "image.png") {
                        made_tag = "generated";
                    }
                    let (p1, s1, h1, m1) = offer(heap, page, fs, dir, id, first, "uploaded", 1, want, buffer.bytes(qbb), skip, seen, shown, more);
                    let (p2, s2, h2, m2) = offer(heap, p1, fs, dir, id, second, "uploaded", 1, want, buffer.bytes(qbb), skip, s1, h1, m1);
                    let (p3, s3, h3, m3) = offer(heap, p2, fs, dir, id, made, made_tag, 0, want, buffer.bytes(qbb), skip, s2, h2, m2);
                    page = p3;
                    seen = s3;
                    shown = h3;
                    more = m3;
                }
                end = start;
            }
        }
    }
    buffer.drop(heap, text);
    page = buffer.append(heap, page, "</div>");
    if shown == 0 {
        page = buffer.append(heap, page, "<p>No pictures here yet.</p>");
    }
    if number > 1 || more {
        page = buffer.append(heap, page, "<div class=acts>");
        if number > 1 {
            page = buffer.append(heap, page, "<a class=btn href=\"/gallery?");
            if grp >= 0 {
                page = buffer.append(heap, page, "group=");
                page = buffer.append(heap, page, results.kind_name(grp));
                page = buffer.append(heap, page, "&amp;");
            }
            if len(want) > 0 {
                page = buffer.append(heap, page, "tag=");
                page = buffer.append(heap, page, want);
                page = buffer.append(heap, page, "&amp;");
            }
            if len(buffer.bytes(qbb)) > 0 {
                page = buffer.append(heap, page, "q=");
                page = put_q(heap, page, buffer.bytes(qbb));
                page = buffer.append(heap, page, "&amp;");
            }
            page = buffer.append(heap, page, "page=");
            page = buffer.push_nat(heap, page, number - 1);
            page = buffer.append(heap, page, "\">Newer</a>");
        }
        if more {
            page = buffer.append(heap, page, "<a class=btn href=\"/gallery?");
            if grp >= 0 {
                page = buffer.append(heap, page, "group=");
                page = buffer.append(heap, page, results.kind_name(grp));
                page = buffer.append(heap, page, "&amp;");
            }
            if len(want) > 0 {
                page = buffer.append(heap, page, "tag=");
                page = buffer.append(heap, page, want);
                page = buffer.append(heap, page, "&amp;");
            }
            if len(buffer.bytes(qbb)) > 0 {
                page = buffer.append(heap, page, "q=");
                page = put_q(heap, page, buffer.bytes(qbb));
                page = buffer.append(heap, page, "&amp;");
            }
            page = buffer.append(heap, page, "page=");
            page = buffer.push_nat(heap, page, number + 1);
            page = buffer.append(heap, page, "\">Older</a>");
        }
        page = buffer.append(heap, page, "</div>");
    }
    }
    buffer.drop(heap, qb);
    return (200, results.close(heap, page));
}

// Remove the file `lib-N<tail>` if there is one.
fn remove_one[&h, &f, &d, &n](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], n: &n [byte], tail: &static [byte]) -> [heap, fs_write("")] int {
    let p = buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.empty(heap, 96), dir), "/lib-"), n), tail);
    var rc = 0 - 1;
    borrow p as &pb in {
        rc = files.remove(fs, buffer.bytes(pb));
    }
    buffer.drop(heap, p);
    return rc;
}

// `POST /gallery/delete/N`: (status, text). 302 when the library picture N, its description and its marks are gone; 422 for a number that is not 1 to 9 digits; 404 for a picture that is not there; 409
// while a job is queued or running (it may be using the picture; nothing is removed). The index keeps its line, so a number is never given twice; `lib-N.tried` is written so the describer passes it by.
pub fn remove[&h, &f, &d, &n](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], n: &n [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write] (int, buffer.Buffer) {
    if results.id_ok(n) == false {
        return (422, buffer.append(heap, buffer.empty(heap, 64), "the picture number is 1 to 9 digits"));
    }
    let name = picks.lib_name(heap, fs, dir, n);
    if len(name) == 0 {
        return (404, buffer.append(heap, buffer.empty(heap, 64), "no such library picture"));
    }
    let (running, queued) = results.counts(heap, fs, dir);
    if running + queued > 0 {
        return (409, buffer.append(heap, buffer.empty(heap, 96), "a job is queued or running and may be using the picture; try again when the queue is empty"));
    }
    var rc = remove_one(heap, fs, dir, n, ".jpg");
    rc = remove_one(heap, fs, dir, n, ".png");
    rc = remove_one(heap, fs, dir, n, ".webp");
    rc = remove_one(heap, fs, dir, n, ".txt");
    rc = remove_one(heap, fs, dir, n, ".auto");
    rc = remove_one(heap, fs, dir, n, ".kind");
    rc = remove_one(heap, fs, dir, n, ".kindtried");
    let mark = buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.empty(heap, 96), dir), "/lib-"), n);
    let tp = buffer.append(heap, mark, ".tried");
    borrow tp as &tb in {
        rc = files.write_all(fs, buffer.bytes(tb), "deleted\n");
    }
    buffer.drop(heap, tp);
    if rc != 0 {
        return (500, buffer.append(heap, buffer.empty(heap, 64), "the picture could not be removed"));
    }
    return (302, buffer.empty(heap, 8));
}

// `POST /gallery/group/N` with the body `group=WORD`: (status, text). WORD is a group of the list (written as `lib-N.kind`, which the describer never replaces) or `auto` (the group is taken away, and the describer sorts the picture
// again). 302 when done; 422 for a number that is not 1 to 9 digits or a word that is neither; 404 for a picture that is not there.
pub fn set_group[&h, &f, &d, &n, &b](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], n: &n [byte], body: &b [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write] (int, buffer.Buffer) {
    if results.id_ok(n) == false {
        return (422, buffer.append(heap, buffer.empty(heap, 64), "the picture number is 1 to 9 digits"));
    }
    let name = picks.lib_name(heap, fs, dir, n);
    if len(name) == 0 {
        return (404, buffer.append(heap, buffer.empty(heap, 64), "no such library picture"));
    }
    let (gf, gt) = http.query_value(body, "group");
    let has = gf >= 0 && gt > gf;
    var rc = 0 - 1;
    if has && bytes.equal(body[gf..gt], "auto") {
        rc = remove_one(heap, fs, dir, n, ".kind");
        rc = remove_one(heap, fs, dir, n, ".kindtried");
        return (302, buffer.empty(heap, 8));
    }
    var gi = 0 - 1;
    if has {
        gi = results.kind_index(body[gf..gt]);
    }
    if gi < 0 {
        return (422, buffer.append(heap, buffer.empty(heap, 96), "group is auto, person, garment, furniture, room, place, object, animal or other"));
    }

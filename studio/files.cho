edition 9;

module files;

import std.buffer;

// `files` -- whole-file reads and writes for the studio, after cancho-ota-ui's `eventlog_io` (the same path rules: an absolute path,
// no NUL, one `fs_covers` says is inside the capability; the capability is `Fs("")` because a library cannot be generic in the prefix).

pub fn path_ok[&f, &p](fs: &f Fs(""), path: &p [byte]) -> [] bool {
    if len(path) < 2 || len(path) > 512 || int_of(path[0]) != 47 {
        return false;
    }
    var k = 0;
    while k < len(path) {
        if int_of(path[k]) == 0 {
            return false;
        }
        k = k + 1;
    }
    return fs_covers(fs, path);
}

// Whether `path` opens for reading; the file is not read.
pub fn exists[&f, &p](fs: &f Fs(""), path: &p [byte]) -> [fs_read("")] bool {
    if path_ok(fs, path) == false {
        return false;
    }
    match open_read(fs, path) {
        Opened::Failed(e) => {
            return false;
        }
        Opened::Ok(opened) => {
            var file = opened;
            file_close(file);
            return true;
        }
    }
}

// The size of the file at `path`, or -1.
pub fn size_of[&f, &p](fs: &f Fs(""), path: &p [byte]) -> [fs_read(""), file_read] int {
    if path_ok(fs, path) == false {
        return 0 - 1;
    }
    match open_read(fs, path) {
        Opened::Failed(e) => {
            return 0 - 1;
        }
        Opened::Ok(opened) => {
            var file = opened;
            var size = 0 - 1;
            borrow mut file as &!x in {
                match file_size(x) {
                    Done::Ok(n) => {
                        size = n;
                    }
                    Done::Failed(e) => {
                    }
                }
            }
            file_close(file);
            return size;
        }
    }
}

// Up to `len(into)` bytes of the file at `path`, from byte `at`, into `into`: how many were read, 0 at the end, -1 for an error. The file is opened and closed here, so a stream holds a path and a number and no handle.
pub fn read_at[&f, &p, &b](fs: &f Fs(""), path: &p [byte], at: int, into: &!b [byte]) -> [fs_read(""), file_read] int {
    if path_ok(fs, path) == false || at < 0 {
        return 0 - 1;
    }
    match open_read(fs, path) {
        Opened::Failed(e) => {
            return 0 - 1;
        }
        Opened::Ok(opened) => {
            var file = opened;
            var got = 0 - 1;
            borrow mut file as &!x in {
                match file_pread(x, at, into) {
                    Read::Got(n) => {
                        got = n;
                    }
                    Read::End => {
                        got = 0;
                    }
                    Read::Failed(e) => {
                    }
                }
            }
            file_close(file);
            return got;
        }
    }
}

fn drain[&h, &x](heap: &!h Heap, file: &!x File, all: buffer.Buffer) -> [heap, file_read] (buffer.Buffer, int) {
    var out = all;
    var errno = 0;
    var more = true;
    let scratch = box_slice(heap, 4096, byte_of(0));
    borrow mut scratch as &!sw in {
        while more {
            match file_read(file, contents(sw)) {
                Read::Got(n) => {
                    out = buffer.append(heap, out, contents(sw)[0..n]);
                }
                Read::End => {
                    more = false;
                }
                Read::Failed(e) => {
                    errno = e;
                    more = false;
                }
            }
        }
    }
    unbox_slice(heap, scratch);
    return (out, errno);
}

// The file's bytes and 0, or an errno (-2: path not ok; 2: no such file).
pub fn read_all[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte]) -> [heap, fs_read(""), file_read] (buffer.Buffer, int) {
    let all = buffer.empty(heap, 256);
    if path_ok(fs, path) == false {
        return (all, 0 - 2);
    }
    match open_read(fs, path) {
        Opened::Failed(e) => {
            return (all, e);
        }
        Opened::Ok(opened) => {
            var file = opened;
            var data = all;
            var errno = 0;
            borrow mut file as &!x in {
                let (got, e) = drain(heap, x, data);
                data = got;
                errno = e;
            }
            file_close(file);
            return (data, errno);
        }
    }
}

// Create or truncate `path` and write `text` with one write: 0, an errno, -1 for a short write, -2 for a path not ok.
pub fn write_all[&f, &p, &t](fs: &f Fs(""), path: &p [byte], text: &t [byte]) -> [fs_write(""), file_write] int {
    if path_ok(fs, path) == false {
        return 0 - 2;
    }
    var status = 0;
    match open_write(fs, path) {
        Opened::Failed(e) => {
            status = e;
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!x in {
                match file_write(x, text) {
                    Done::Ok(n) => {
                        if n != len(text) {
                            status = 0 - 1;
                        }
                    }
                    Done::Failed(e) => {
                        status = e;
                    }
                }
            }
            file_close(file);
        }
    }
    return status;
}

// Append `text` to `path` (created if absent) with one write: 0, an errno, -1 for a short write, -2 for a path not ok.
pub fn append_all[&f, &p, &t](fs: &f Fs(""), path: &p [byte], text: &t [byte]) -> [fs_write(""), file_write] int {
    if path_ok(fs, path) == false {
        return 0 - 2;
    }
    var status = 0;
    match open_append(fs, path) {
        Opened::Failed(e) => {
            status = e;
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!x in {
                match file_write(x, text) {
                    Done::Ok(n) => {
                        if n != len(text) {
                            status = 0 - 1;
                        }
                    }
                    Done::Failed(e) => {
                        status = e;
                    }
                }
            }
            file_close(file);
        }
    }
    return status;
}

// Write `text` to `path` (made or emptied), as many writes as it takes: 0, an errno, -1 for a write that made no progress, -2 for a path not ok. For a picture of megabytes, where `write_all`'s one write may be short.
pub fn write_big[&f, &p, &t](fs: &f Fs(""), path: &p [byte], text: &t [byte]) -> [fs_write(""), file_write] int {
    if path_ok(fs, path) == false {
        return 0 - 2;
    }
    var status = 0;
    match open_write(fs, path) {
        Opened::Failed(e) => {
            status = e;
        }
        Opened::Ok(opened) => {
            var file = opened;
            var at = 0;
            borrow mut file as &!x in {
                while at < len(text) && status == 0 {
                    match file_write(x, text[at..len(text)]) {
                        Done::Ok(n) => {
                            if n <= 0 {
                                status = 0 - 1;
                            } else {
                                at = at + n;
                            }
                        }
                        Done::Failed(e) => {
                            status = e;
                        }
                    }
                }
            }
            file_close(file);
        }
    }
    return status;
}

// Remove the file at `path` (`unlink`; a directory is not removed): 0 when it is gone, an errno, -2 for a path not ok.
pub fn remove[&f, &p](fs: &f Fs(""), path: &p [byte]) -> [fs_write("")] int {
    if path_ok(fs, path) == false {
        return 0 - 2;
    }
    match fs_remove(fs, path) {
        Done::Ok(n) => {
            return 0;
        }
        Done::Failed(e) => {
            return e;
        }
    }
}

{
  "schema": "cancho-ui-trace",
  "version": "0.1.0",
  "component": "Studio",
  "note": "A video job: refused while the prompt is empty, started, queued, running, done, and no more polling after it. Then an edit (with its steps): refused without a picture, started, and the server's refusal shown. Then a video with fps, three variations and a model, and the set's address shown. Then a text-to-image job (a size and steps of its own, no frames, the rewrite sent off whatever is chosen). Then an edit of two pictures (a second path and the size of each). The list of recent jobs is read when the page opens (counts shown, list kept) and, when the server cannot be reached, the old list is kept and the error shown. net.post and net.get answers are scripted.",
  "steps": [
    { "resolve": 1, "with": { "Ok": "{\"running\": 1, \"queued\": 2, \"jobs\": [{\"id\": 4, \"state\": \"running\", \"kind\": \"video\", \"prompt\": \"a fox\"}, {\"id\": 3, \"state\": \"done\", \"kind\": \"edit\", \"prompt\": \"say \\\"hi\\\"\"}]}" },
      "state": { "tally": "GPU busy: 1 running, 2 queued", "none": false } },
    { "event": "Start", "expect": { "outcome": "disabled" } },
    { "event": "Prompt", "params": ["a fox"], "state": { "prompt": "a fox", "blocked": false } },
    { "event": "Start",
      "expect": { "outcome": "suspended",
                  "issued": [ { "request": 2, "effect": "net.post",
                                "args": ["api/jobs", "{\"kind\":\"video\",\"prompt\":\"a fox\",\"frames\":17,\"size\":\"640x352\",\"seed\":0,\"fps\":16,\"rewrite\":\"off\"}"] } ] },
      "state": { "blocked": true, "note": "Sending ..." } },
    { "resolve": 2, "with": { "Ok": "{\"status\":202,\"body\":\"{\\\"id\\\":5}\"}" },
      "state": { "job": "5", "job_state": "queued", "note": "Job 5 is queued.", "busy": false } },
    { "event": "Poll",
      "expect": { "outcome": "suspended", "issued": [ { "request": 3, "effect": "net.get", "args": ["api/jobs/5"] } ] } },
    { "resolve": 3, "with": { "Ok": "{\"id\":5,\"state\":\"running\"}" }, "state": { "job_state": "running" } },
    { "event": "Poll", "expect": { "issued": [ { "request": 4, "effect": "net.get", "args": ["api/jobs/5"] } ] } },
    { "resolve": 4, "with": { "Ok": "{\"id\":5,\"state\":\"done\"}" }, "state": { "job_state": "done" } },
    { "event": "Poll", "expect": { "outcome": "completed" }, "state": { "job_state": "done" } },
    { "event": "Kind", "params": ["edit"], "state": { "kind": "edit", "is_edit": true, "is_video": false, "blocked": true } },
    { "event": "Start", "expect": { "outcome": "disabled" } },
    { "event": "Image", "params": ["/photos/a.jpg"], "state": { "blocked": false } },
    { "event": "Start",
      "expect": { "outcome": "suspended",
                  "issued": [ { "request": 5, "effect": "net.post",
                                "args": ["api/jobs", "{\"kind\":\"edit\",\"prompt\":\"a fox\",\"frames\":17,\"size\":\"640x352\",\"seed\":0,\"image\":\"/photos/a.jpg\",\"steps\":8,\"rewrite\":\"off\"}"] } ] } },
    { "resolve": 5, "with": { "Ok": "{\"status\":422,\"body\":\"{\\\"error\\\":\\\"no such image\\\"}\"}" },
      "state": { "job": "5", "note": "The server refused it: no such image.", "busy": false } },
    { "event": "Kind", "params": ["video"], "state": { "kind": "video", "is_video": true } },
    { "event": "Rewrite", "params": ["on"], "state": { "rewrite": "on" } },
    { "event": "Start",
      "expect": { "outcome": "suspended",
                  "issued": [ { "request": 6, "effect": "net.post",
                                "args": ["api/jobs", "{\"kind\":\"video\",\"prompt\":\"a fox\",\"frames\":17,\"size\":\"640x352\",\"seed\":0,\"fps\":16,\"rewrite\":\"on\"}"] } ] } },
    { "resolve": 6, "with": { "Ok": "{\"status\":202,\"body\":\"{\\\"id\\\":6}\"}" },
      "state": { "job": "6", "job_state": "queued", "note": "Job 6 is queued.", "busy": false } },
    { "event": "Rewrite", "params": ["off"], "state": { "rewrite": "off" } },
    { "event": "Fps", "params": ["24"], "state": { "fps": "24" } },
    { "event": "Variations", "params": ["3"], "state": { "variations": "3" } },
    { "event": "Model", "params": ["fastwan2.2-ti2v-5b"], "state": { "model": "fastwan2.2-ti2v-5b" } },
    { "event": "Start",
      "expect": { "outcome": "suspended",
                  "issued": [ { "request": 7, "effect": "net.post",
                                "args": ["api/jobs", "{\"kind\":\"video\",\"prompt\":\"a fox\",\"frames\":17,\"size\":\"640x352\",\"seed\":0,\"fps\":24,\"variations\":3,\"model\":\"fastwan2.2-ti2v-5b\",\"rewrite\":\"off\"}"] } ] } },
    { "resolve": 7, "with": { "Ok": "{\"status\":202,\"body\":\"{\\\"id\\\":7,\\\"ids\\\":[7,8,9],\\\"set\\\":\\\"/sets/7\\\"}\"}" },
      "state": { "job": "7", "job_state": "queued", "note": "Variations queued: open /sets/7 on this server.", "busy": false } },
    { "event": "Kind", "params": ["image"], "state": { "kind": "image", "is_image": true, "is_video": false, "is_edit": false } },
    { "event": "Variations", "params": ["1"], "state": { "variations": "1" } },
    { "event": "Model", "params": ["qwen-image-2.1-turbo"], "state": { "model": "qwen-image-2.1-turbo" } },
    { "event": "ISize", "params": ["512x512"], "state": { "isize": "512x512" } },
    { "event": "Steps", "params": ["4"], "state": { "steps": "4" } },
    { "event": "Rewrite", "params": ["on"], "state": { "rewrite": "on" } },
    { "event": "Start",
      "expect": { "outcome": "suspended",
                  "issued": [ { "request": 8, "effect": "net.post",
                                "args": ["api/jobs", "{\"kind\":\"image\",\"prompt\":\"a fox\",\"size\":\"512x512\",\"seed\":0,\"steps\":4,\"model\":\"qwen-image-2.1-turbo\",\"rewrite\":\"off\"}"] } ] } },
    { "resolve": 8, "with": { "Ok": "{\"status\":202,\"body\":\"{\\\"id\\\":10}\"}" },
      "state": { "job": "10", "job_state": "queued", "note": "Job 10 is queued.", "busy": false } },
    { "event": "Kind", "params": ["edit"], "state": { "kind": "edit", "is_edit": true, "is_image": false } },
    { "event": "Image2", "params": ["/photos/b.jpg"], "state": { "image2": "/photos/b.jpg" } },
    { "event": "CArea", "params": ["1048576"], "state": { "carea": "1048576" } },
    { "event": "Rewrite", "params": ["off"], "state": { "rewrite": "off" } },
    { "event": "Start",
      "expect": { "outcome": "suspended",
                  "issued": [ { "request": 9, "effect": "net.post",
                                "args": ["api/jobs", "{\"kind\":\"edit\",\"prompt\":\"a fox\",\"frames\":17,\"size\":\"640x352\",\"seed\":0,\"image\":\"/photos/a.jpg\",\"steps\":4,\"also\":\"/photos/b.jpg\",\"condition_area\":1048576,\"model\":\"qwen-image-2.1-turbo\",\"rewrite\":\"off\"}"] } ] } },
    { "resolve": 9, "with": { "Ok": "{\"status\":202,\"body\":\"{\\\"id\\\":11}\"}" },
      "state": { "job": "11", "job_state": "queued", "note": "Job 11 is queued.", "busy": false } },
    { "event": "Recent", "expect": { "outcome": "suspended", "issued": [ { "request": 10, "effect": "net.get", "args": ["api/jobs"] } ] } },
    { "resolve": 10, "with": { "Err": "offline" },
      "state": { "tally": "The list of jobs could not be read: offline", "none": false } }
  ]
}

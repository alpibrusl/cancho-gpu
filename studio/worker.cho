edition 10;

import std.buffer;
import std.bytes;
import std.dirs;
import std.io;
import files;
import rewrite_step;

// studio_worker -- runs one job: docs/studio.md, slice 2.
//
//   studio_worker <script> <home> <data-dir>                 drain the queue once and exit (exit 4: another worker holds the lock)
//   studio_worker <script> <home> <data-dir> --every <s>     drain it, wait up to <s> seconds (1-3600), drain again, until INT or TERM
//
// With `--every` the worker holds INT and TERM (`Signals("INT,TERM")`: the authority report names them): a signal that arrives while a job runs does not
// kill it, the worker stops once that job has ended, and one that arrives while it waits stops it at once (the signal wakes the `Poller` it waits on).
// `<data-dir>/queue` is read again at every drain.
//
// One worker at a time: before it reads the queue a worker takes an exclusive `flock` on `<data-dir>/worker.lock` (`file_lock`: not waiting, held while the process lives, dropped by the kernel when it ends, even
// by SIGKILL, so no stale lock file is left to remove) and keeps it until it exits. A second worker on the same directory gets exit 4 and touches nothing. With the lock held no other worker is running,
// so a job whose state is still `running` was left by one that died: it is marked `failed 255` before the queue is read, and is not run again. `<data-dir>/queue`
// is written by the server alone, one job id (decimal digits, at most 9) a line; a job is pending when `<data-dir>/<id>.state` does not exist.
// Jobs run one after another: the GPU takes one. For each pending job, `<data-dir>/<id>.argv` holds the argument list of `<script>` (the studio's `media`), each entry followed by a NUL, as the server wrote it after
// `std.process.add` had refused any entry with a NUL in it. The worker starts `<script>` on that list, its output and errors written to
// `<data-dir>/<id>.log`, waits for it, and writes `<data-dir>/<id>.state`: `running` first, then `done` or `failed <code>`. It reads no prompt and
// interprets nothing: the list is the server's, the process is the script's.

// `<dir>/<id>.<ext>` as bytes.
fn named[&h, &d, &i, &e](heap: &!h Heap, dir: &d [byte], id: &i [byte], ext: &e [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 128), dir);
    b = buffer.push(heap, b, byte_of(47));
    b = buffer.append(heap, b, id);
    b = buffer.push(heap, b, byte_of(46));
    return buffer.append(heap, b, ext);
}

fn put[&h, &f, &d, &i, &t](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte], ext: &static [byte], text: &t [byte]) -> [heap, fs_write(""), file_write] int {
    let p = named(heap, dir, id, ext);
    var code = 0;
    borrow p as &pb in {
        code = files.write_all(fs, buffer.bytes(pb), text);
    }
    buffer.drop(heap, p);
    return code;
}

fn id_ok[&t](id: &t [byte]) -> [] bool {
    if len(id) == 0 || len(id) > 9 {
        return false;
    }
    var k = 0;
    while k < len(id) {
        let c = int_of(id[k]);
        if c < 48 || c > 57 {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// Start `script` on `list` with the output in `log`, and wait: the exit status, 128 + the signal, 255 if it did not run.
fn run[&x, &y, &s, &l, &e](exec: &x Exec(""), sdir: &y Dir, script: &s [byte], list: &l [byte], env: &e [byte], log: File) -> [exec_under] int {
    match exec_spawn_under(exec, sdir, script, list, env, Stdio::Null, Stdio::File(log), Stdio::Null) {
        Spawned::Ok(child) => {
            match child_wait(child) {
                Exited::Code(n) => {
                    return n;
                }
                Exited::Signaled(sg) => {
                    return 128 + sg;
                }
                Exited::Failed(er) => {
                    return 255;
                }
            }
        }
        Spawned::Failed(er) => {
            return 255;
        }
    }
}

// Is `<dir>/<id>.state` there?
fn started[&h, &f, &d, &i](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte]) -> [heap, fs_read("")] bool {
    let p = named(heap, dir, id, "state");
    var yes = false;
    borrow p as &pb in {
        if files.path_ok(fs, buffer.bytes(pb)) {
            match open_read(fs, buffer.bytes(pb)) {
                Opened::Failed(e) => {
                    yes = e != 2;
                }
                Opened::Ok(o) => {
                    file_close(o);
                    yes = true;
                }
            }
        }
    }
    buffer.drop(heap, p);
    return yes;
}

// What stays of a job's `out/<id>/`: the results the page shows and the prompt. `frames/` is a directory and is not touched here.
fn keep[&n](name: &n [byte]) -> [] bool {
    return bytes.equal(name, "edited.png") || bytes.equal(name, "video.mp4") || bytes.equal(name, "video.gif") || bytes.equal(name, "prompt.txt");
}

// Remove the regular files of `dir` that are not kept (`all`: every one); the number removed. A link is not a regular file: it is left, and never followed.
fn clear[&h, &d](heap: &!h Heap, dir: &d Dir, all: bool) -> [heap, dir_read, dir_write] int {
    var removed = 0;
    let names = dirs.list(heap, dir, 10000);
    borrow names as &nr in {
        var k = 0;
        while k < dirs.count(nr) {
            let nm = dirs.name(nr, k);
            if dirs.kind(nr, k) == dirs.kind_file() && (all || keep(nm) == false) {
                match dir_remove(dir, nm) {
                    Done::Ok(n) => {
                        removed = removed + 1;
                    }
                    Done::Failed(e) => {
                    }
                }
            }
            k = k + 1;
        }
    }
    dirs.drop(heap, names);
    return removed;
}

// After a job that is `done`: what `media` left in `<data>/out/<id>` that is not a result is removed (its session's work files: 1.1 GB in `vae/` and 0.2 GB beside the results for a 17-frame video,
// measured on a real job). The results stay (`keep`), `frames/` stays, and every other subdirectory is emptied of its files (one level; a directory cannot be removed with `unlinkat` as it is
// called here, so the empty one stays). Answers how many files were removed, -1 if the directory could not be opened. Beneath a `Dir` handle: a name is one component and a link is removed, never followed.
fn tidy[&h, &f, &d, &i](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte]) -> [heap, fs_read(""), dir_read, dir_write] int {
    var removed = 0 - 1;
    var p = buffer.append(heap, buffer.empty(heap, 64), dir);
    p = buffer.append(heap, p, "/out/");
    p = buffer.append(heap, p, id);
    borrow p as &pb in {
        if files.path_ok(fs, buffer.bytes(pb)) {
            match open_dir(fs, buffer.bytes(pb)) {
                DirOpened::Ok(o) => {
                    var handle = o;
                    borrow handle as &dr in {
                        removed = clear(heap, dr, false);
                        let names = dirs.list(heap, dr, 10000);
                        borrow names as &nr in {
                            var k = 0;
                            while k < dirs.count(nr) {
                                let nm = dirs.name(nr, k);
                                if dirs.kind(nr, k) == dirs.kind_directory() && bytes.equal(nm, "frames") == false {
                                    match dir_enter(dr, nm) {
                                        DirOpened::Ok(so) => {
                                            var sub = so;
                                            borrow sub as &sr in {
                                                removed = removed + clear(heap, sr, true);
                                            }
                                            dir_close(sub);
                                        }
                                        DirOpened::Failed(e) => {
                                        }
                                    }
                                }
                                k = k + 1;
                            }
                        }
                        dirs.drop(heap, names);
                    }
                    dir_close(handle);
                }
                DirOpened::Failed(e) => {
                }
            }
        }
    }
    buffer.drop(heap, p);
    return removed;
}

// One pending job: 0 when it ran to the end and exited 0, else the code (3: no argument file, 4: the log could not be opened).
fn job[&h, &f, &x, &y, &nt, &ck, &md, &pd, &s, &m, &d, &i](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), sdir: &y Dir, net: &nt Net("127.0.0.1:11434"), clock: &ck Clock, model: &md [byte], pdir: &pd [byte], script: &s [byte], home: &m [byte], dir: &d [byte], id: &i [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write, exec_under, net_out("127.0.0.1:11434"), conn_read, conn_write, poll, clock, dir_read, dir_write] int {
    var status = 3;
    let argv_path = named(heap, dir, id, "argv");
    var list = buffer.empty(heap, 8);
    var errno = 0 - 1;
    borrow argv_path as &ap in {
        let (b, e) = files.read_all(heap, fs, buffer.bytes(ap));
        buffer.drop(heap, list);
        list = b;
        errno = e;
    }
    buffer.drop(heap, argv_path);
    var rcode = 0 - 1;
    var fresh = buffer.empty(heap, 8);
    if errno == 0 {
        borrow list as &l0 in {
            let (c, nl) = rewrite_step.apply(heap, fs, net, clock, buffer.bytes(l0), dir, id, model, pdir, 600);
            rcode = c;
            buffer.drop(heap, fresh);
            fresh = nl;
        }
    }
    if errno == 0 {
        status = 4;
        put(heap, fs, dir, id, "state", "running\n");
        let log_path = named(heap, dir, id, "log");
        borrow log_path as &lp in {
            if files.path_ok(fs, buffer.bytes(lp)) {
                match open_write(fs, buffer.bytes(lp)) {
                    Opened::Ok(log) => {
                        var env = buffer.append(heap, buffer.empty(heap, 128), "HOME=");
                        env = buffer.append(heap, env, home);
                        env = buffer.append(heap, env, "\0PATH=/usr/bin:/bin:/opt/homebrew/bin\0");
                        var code = 255;
                        borrow list as &lb in {
                            borrow fresh as &fb in {
                                borrow env as &eb in {
                                    if rcode == 0 {
                                        code = run(exec, sdir, script, buffer.bytes(fb), buffer.bytes(eb), log);
                                    } else {
                                        code = run(exec, sdir, script, buffer.bytes(lb), buffer.bytes(eb), log);
                                    }
                                }
                            }
                        }
                        if rcode >= 0 {
                            var rnote = buffer.empty(heap, 128);
                            if rcode == 0 {
                                rnote = buffer.append(heap, rnote, "studio: prompt rewritten by ");
                                rnote = buffer.append(heap, rnote, model);
                            } else {
                                rnote = buffer.append(heap, rnote, "studio: prompt not rewritten: ");
                                rnote = buffer.append(heap, rnote, rewrite_step.reason(rcode));
                            }
                            rnote = buffer.push(heap, rnote, byte_of(10));
                            borrow rnote as &rnb in {
                                files.append_all(fs, buffer.bytes(lp), buffer.bytes(rnb));
                            }
                            buffer.drop(heap, rnote);
                        }
                        buffer.drop(heap, env);
                        var line = buffer.empty(heap, 32);
                        if code == 0 {
                            line = buffer.append(heap, line, "done\n");
                        } else {
                            line = buffer.append(heap, line, "failed ");
                            line = buffer.push_nat(heap, line, code);
                            line = buffer.push(heap, line, byte_of(10));
                        }
                        borrow line as &ln in {
                            put(heap, fs, dir, id, "state", buffer.bytes(ln));
                        }
                        buffer.drop(heap, line);
                        status = code;
                        if code == 0 {
                            let gone = tidy(heap, fs, dir, id);
                            var note = buffer.append(heap, buffer.empty(heap, 48), "studio: removed ");
                            var shown = gone;
                            if shown < 0 {
                                shown = 0;
                            }
                            note = buffer.push_nat(heap, note, shown);
                            note = buffer.append(heap, note, " work files from out/");
                            note = buffer.append(heap, note, id);
                            note = buffer.push(heap, note, byte_of(10));
                            if gone >= 0 {
                                borrow note as &nb in {
                                    files.append_all(fs, buffer.bytes(lp), buffer.bytes(nb));
                                }
                            }
                            buffer.drop(heap, note);
                        }
                    }
                    Opened::Failed(er) => {
                        put(heap, fs, dir, id, "state", "failed 254\n");
                    }
                }
            }
        }
        buffer.drop(heap, log_path);
    }
    buffer.drop(heap, list);
    buffer.drop(heap, fresh);
    return status;
}

// The queue, once: every id in it that has no state yet is run. The number of jobs run.
fn drain[&h, &f, &x, &y, &nt, &ck, &md, &pd, &s, &m, &d](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), sdir: &y Dir, net: &nt Net("127.0.0.1:11434"), clock: &ck Clock, model: &md [byte], pdir: &pd [byte], script: &s [byte], home: &m [byte], dir: &d [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write, exec_under, net_out("127.0.0.1:11434"), conn_read, conn_write, poll, clock, dir_read, dir_write] int {
    let qp = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), dir), "/queue");
    var text = buffer.empty(heap, 8);
    borrow qp as &q in {
        let (b, e) = files.read_all(heap, fs, buffer.bytes(q));
        buffer.drop(heap, text);
        text = b;
    }
    buffer.drop(heap, qp);
    var ran = 0;
    borrow text as &tb in {
        let all = buffer.bytes(tb);
        var at = 0;
        while at < len(all) {
            var stop = at;
            while stop < len(all) && int_of(all[stop]) != 10 {
                stop = stop + 1;
            }
            let id = all[at..stop];
            if id_ok(id) && started(heap, fs, dir, id) == false {
                job(heap, fs, exec, sdir, net, clock, model, pdir, script, home, dir, id);
                ran = ran + 1;
            }
            at = stop + 1;
        }
    }
    buffer.drop(heap, text);
    return ran;
}

// `<dir>/worker.lock`
fn lock_path[&h, &d](heap: &!h Heap, dir: &d [byte]) -> [heap] buffer.Buffer {
    return buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), dir), "/worker.lock");
}

// Try the lock on the open file `x`: true if this process now holds it.
fn lock_it[&x](file: &!x File) -> [file_write] bool {
    match file_lock(file) {
        Done::Ok(n) => {
            return true;
        }
        Done::Failed(e) => {
            return false;
        }
    }
}

// With the lock held: every job in the queue whose state says `running` was left by a worker that died; it becomes `failed 255`. The number marked.
fn recover[&h, &f, &d](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write] int {
    let qp = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), dir), "/queue");
    var text = buffer.empty(heap, 8);
    borrow qp as &q in {
        let (b, e) = files.read_all(heap, fs, buffer.bytes(q));
        buffer.drop(heap, text);
        text = b;
    }
    buffer.drop(heap, qp);
    var marked = 0;
    borrow text as &tb in {
        let all = buffer.bytes(tb);
        var at = 0;
        while at < len(all) {
            var stop = at;
            while stop < len(all) && int_of(all[stop]) != 10 {
                stop = stop + 1;
            }
            let id = all[at..stop];
            if id_ok(id) {
                let sp = named(heap, dir, id, "state");
                var left_running = false;
                borrow sp as &sb in {
                    let (b, e) = files.read_all(heap, fs, buffer.bytes(sb));
                    borrow b as &br in {
                        left_running = e == 0 && bytes.starts_with(buffer.bytes(br), "running");
                    }
                    buffer.drop(heap, b);
                }
                buffer.drop(heap, sp);
                if left_running {
                    put(heap, fs, dir, id, "state", "failed 255\n");
                    marked = marked + 1;
                }
            }
            at = stop + 1;
        }
    }
    buffer.drop(heap, text);
    return marked;
}

// Once, under the lock: 0, or 4 if another worker holds it (or the lock file cannot be opened).
fn once[&h, &f, &x, &y, &nt, &ck, &md, &pd, &s, &m, &d](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), sdir: &y Dir, net: &nt Net("127.0.0.1:11434"), clock: &ck Clock, model: &md [byte], pdir: &pd [byte], script: &s [byte], home: &m [byte], dir: &d [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write, exec_under, net_out("127.0.0.1:11434"), conn_read, conn_write, poll, clock, dir_read, dir_write] int {
    var status = 4;
    let lp = lock_path(heap, dir);
    borrow lp as &lb in {
        if files.path_ok(fs, buffer.bytes(lb)) {
            match open_append(fs, buffer.bytes(lb)) {
                Opened::Failed(e) => {
                }
                Opened::Ok(o) => {
                    var lock = o;
                    var held = false;
                    borrow mut lock as &!lx in {
                        held = lock_it(lx);
                    }
                    if held {
                        recover(heap, fs, dir);
                        drain(heap, fs, exec, sdir, net, clock, model, pdir, script, home, dir);
                        status = 0;
                    }
                    file_close(lock);
                }
            }
        }
    }
    buffer.drop(heap, lp);
    return status;
}

// Where the last `/` of `path` is, or -1. The script is `<its directory>/<its name>`: the directory is opened once (a `Dir`), and the program is started beneath it by name (`exec_spawn_under`).
fn last_slash[&p](path: &p [byte]) -> [] int {
    var at = 0 - 1;
    var i = 0;
    while i < len(path) {
        if int_of(path[i]) == 47 {
            at = i;
        }
        i = i + 1;
    }
    return at;
}

// A name `exec_spawn_under` will not trap on: not empty and no `..` (it has no `/`, being what follows the last one).
fn name_ok[&n](name: &n [byte]) -> [] bool {
    if len(name) == 0 {
        return false;
    }
    var i = 0;
    while i + 1 < len(name) {
        if int_of(name[i]) == 46 && int_of(name[i + 1]) == 46 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn seconds_of[&t](text: &t [byte]) -> [] int {
    if len(text) == 0 || len(text) > 4 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if n < 1 || n > 3600 {
        return 0 - 1;
    }
    return n;
}

// Under the lock: drain, wait, drain, until a signal. 0 when stopped by one, 4 if another worker holds the lock, 5 if the wait failed.
fn keep_going[&h, &f, &x, &y, &nt, &ck, &md, &pd, &s, &m, &d, &p, &w](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), sdir: &y Dir, net: &nt Net("127.0.0.1:11434"), clock: &ck Clock, model: &md [byte], pdir: &pd [byte], script: &s [byte], home: &m [byte], dir: &d [byte], poller: &!p Poller, watch: &!w SignalWatch, seconds: int) -> [heap, fs_read(""), fs_write(""), file_read, file_write, exec_under, net_out("127.0.0.1:11434"), conn_read, conn_write, poll, clock, dir_read, dir_write, signals_read, poll] int {
    var status = 4;
    let events = box_slice(heap, 8, 0);
    var spare = events;
    let lp = lock_path(heap, dir);
    borrow lp as &lb in {
        if files.path_ok(fs, buffer.bytes(lb)) {
            match open_append(fs, buffer.bytes(lb)) {
                Opened::Failed(e) => {
                }
                Opened::Ok(o) => {
                    var lock = o;
                    var held = false;
                    borrow mut lock as &!lx in {
                        held = lock_it(lx);
                    }
                    if held {
                        status = 0;
                        recover(heap, fs, dir);
                        var stop = false;
                        while stop == false {
                            drain(heap, fs, exec, sdir, net, clock, model, pdir, script, home, dir);
                            if signals_pending(watch) != 0 {
                                stop = true;
                            } else {
                                var n = 0;
                                borrow mut spare as &!eb in {
                                    n = poller_wait(poller, contents(eb), seconds * 1000);
                                }
                                if n < 0 {
                                    status = 5;
                                    stop = true;
                                }
                                if signals_pending(watch) != 0 {
                                    stop = true;
                                }
                            }
                        }
                    }
                    file_close(lock);
                }
            }
        }
    }
    buffer.drop(heap, lp);
    unbox_slice(heap, spare);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(tty);
    let ollama = narrow(net, "127.0.0.1:11434");
    var status = 2;
    var every = 0 - 1;
    var looping = false;
    var rewriting = false;
    var n_args = 0;
    borrow args as &g0 in {
        n_args = arg_count(g0);
        if (n_args == 6 || n_args == 9) && bytes.equal(arg(g0, 4), "--every") {
            looping = true;
            every = seconds_of(arg(g0, 5));
        }
        if (n_args == 7 || n_args == 9) && bytes.equal(arg(g0, n_args - 3), "--rewriter") {
            rewriting = true;
        }
    }
    if looping && every > 0 {
        let hold = narrow(signals, "INT,TERM");
        borrow hold as &hs in {
            match signals_watch(hs) {
                Watching::Ok(w) => {
                    var watch = w;
                    match poller_new() {
                        Polling::Ok(pl) => {
                            var poller = pl;
                            borrow mut poller as &!pw in {
                                borrow watch as &wr in {
                                    poller_add_signals(pw, wr, 1);
                                }
                            }
                            borrow args as &g in {
                                borrow fs as &f in {
                                    borrow mut heap as &!h in {
                                        borrow exec as &xe in {
                                            borrow ollama as &on in {
                                                borrow clock as &ck in {
                                                    status = 3;
                                                    let cut = last_slash(arg(g, 1));
                                                    if files.path_ok(f, arg(g, 3)) && cut > 0 && name_ok(arg(g, 1)[cut + 1..len(arg(g, 1))]) && files.path_ok(f, arg(g, 1)[0..cut]) {
                                                        match open_dir(f, arg(g, 1)[0..cut]) {
                                                            DirOpened::Ok(so) => {
                                                                var sd = so;
                                                                borrow sd as &sdr in {
                                                                    borrow mut poller as &!pw2 in {
                                                                        borrow mut watch as &!wh in {
                                                                            if rewriting && files.path_ok(f, arg(g, n_args - 1)) {
                                                                                status = keep_going(h, f, xe, sdr, on, ck, arg(g, n_args - 2), arg(g, n_args - 1), arg(g, 1)[cut + 1..len(arg(g, 1))], arg(g, 2), arg(g, 3), pw2, wh, every);
                                                                            } else if rewriting == false {
                                                                                status = keep_going(h, f, xe, sdr, on, ck, "", "", arg(g, 1)[cut + 1..len(arg(g, 1))], arg(g, 2), arg(g, 3), pw2, wh, every);
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                                dir_close(sd);
                                                            }
                                                            DirOpened::Failed(e) => {
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            poller_close(poller);
                        }
                        Polling::Failed(e) => {
                            status = 5;
                        }
                    }
                    signals_close(watch);
                }
                Watching::Failed(e) => {
                    status = 5;
                }
            }
        }
        release(hold);
    } else {
        release(signals);
        borrow args as &g in {
            if looping == false && (n_args == 4 || (n_args == 7 && rewriting)) {
                borrow fs as &f in {
                    borrow mut heap as &!h in {
                        borrow exec as &xe in {
                            borrow ollama as &on in {
                                borrow clock as &ck in {
                                    status = 3;
                                    let cut = last_slash(arg(g, 1));
                                    if files.path_ok(f, arg(g, 3)) && cut > 0 && name_ok(arg(g, 1)[cut + 1..len(arg(g, 1))]) && files.path_ok(f, arg(g, 1)[0..cut]) {
                                        match open_dir(f, arg(g, 1)[0..cut]) {
                                            DirOpened::Ok(so) => {
                                                var sd = so;
                                                borrow sd as &sdr in {
                                                    if rewriting && files.path_ok(f, arg(g, n_args - 1)) {
                                                        status = once(h, f, xe, sdr, on, ck, arg(g, n_args - 2), arg(g, n_args - 1), arg(g, 1)[cut + 1..len(arg(g, 1))], arg(g, 2), arg(g, 3));
                                                    } else if rewriting == false {
                                                        status = once(h, f, xe, sdr, on, ck, "", "", arg(g, 1)[cut + 1..len(arg(g, 1))], arg(g, 2), arg(g, 3));
                                                    }
                                                }
                                                dir_close(sd);
                                            }
                                            DirOpened::Failed(e) => {
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                borrow mut io as &!i in {
                    io.error_all(i, "usage: studio_worker <script> <home> <absolute data-dir> [--every <seconds 1-3600>] [--rewriter <model> <absolute prompts dir>]\n");
                }
            }
        }
    }
    if status == 4 {
        borrow mut io as &!i4 in {
            io.error_all(i4, "studio_worker: another worker holds worker.lock in the data directory (or it cannot be opened); nothing was run\n");
        }
    }
    release(ollama);
    release(clock);
    release(exec);
    release(args);
    release(io);
    release(heap);
    release(fs);
    return status;
}

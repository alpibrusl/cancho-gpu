edition 9;

import std.buffer;
import std.bytes;
import std.http;
import std.io;
import http.server;
import files;
import jobs;
import results;
import auth;
import range;
import upload;
import cases;
import gallery;
import sessions;
import library;
import batch;
import compare;
import sets;

// studio -- the web app of docs/studio.md, slice 1: the page and the model list. Nothing starts a program here.
//
//   studio <port> <absolute data-dir> [<absolute site-dir>]
//
//     <site-dir> holds `index.html` and `app.js`, the page `cancho-ui build studio/ui/studio.cui --page -o <site-dir>` wrote; without it `GET /` is a stub.
//
//     POST /api/jobs      {kind, prompt, ...} -> 202 {"id":N}: `<data>/N.argv` and a line in `<data>/queue` (docs/studio.md); `studio_worker` runs it
//     GET  /api/jobs      {"running":R,"queued":Q,"jobs":[{id,state,kind,prompt}, ...]} the 50 newest
//     GET  /api/jobs/N    {"id":N,"state":"queued|running|done|failed C"}
//
//     GET /jobs/N        the job's page: state, the result when done, the log (HTML the server writes)
//     GET /files/N/NAME  edited.png, video.mp4, video.gif, log or input1/input2 (the pictures an edit through the form was given: .jpg, .png or .webp) of job N (a closed list of names), streamed in pieces; `Range: bytes=a-b` is answered 206, up to 8 files at once
//
//     GET /jobs          the jobs, newest first, each a link to its page
//     GET /app.js        <site-dir>/app.js
//     GET /openapi.json  <site-dir>/openapi.json (studio/openapi.json, copied there; check.sh holds it to what the server answers)
//     GET /              <site-dir>/index.html, or the stub (HTML the server writes)
//     GET /api/models    the registry of tools/media.py, as JSON
//
// Listens on 127.0.0.1 only (`tcp_listen_on`). `cancho authority` reports `net_in("")`, UNBOUNDED: the host is a run-time argument and `narrow` takes a literal, so the bind is the code's, held by the Host/Origin/token checks and checked with lsof, not by the report (docs/studio-fetch.md section 2).

fn page() -> [] &static [byte] {
    return "<!doctype html><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><link rel=stylesheet href=/style.css><title>cancho-studio</title><h1>cancho-studio</h1><p>Slice 1: no job runs yet.</p><p><a href=/api/models>/api/models</a></p>";
}

fn models() -> [] &static [byte] {
    return "{\"video\":[\"fastwan2.2-ti2v-5b\"],\"edit\":[\"qwen-image-2.1-turbo\"],\"image\":[]}";
}

fn number_of[&t](text: &t [byte]) -> [] int {
    if len(text) == 0 || len(text) > 6 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

fn serve[&h, &k, &l, &i, &f, &d, &y, &z](heap: &!h Heap, clock: &k Clock, listener: &!l Listener, con: &!i Io, fs: &f Fs(""), dir: &d [byte], site: &y [byte], token: &z [byte], port: int, rewrite_on: bool) -> [heap, conn_accept, conn_read, conn_write, poll, clock, err_write, fs_read(""), fs_write(""), file_read, file_write] int {
    match poller_new() {
        Polling::Ok(p) => {
            var srv = server.open(heap, p, listener, 16777216, 0, 30);
            var line = buffer.append(heap, buffer.empty(heap, 128), "listening on ");
            line = buffer.push_nat(heap, line, port);
            line = buffer.append(heap, line, "\nopen http://127.0.0.1:");
            line = buffer.push_nat(heap, line, port);
            line = buffer.append(heap, line, "/?token=");
            line = buffer.append(heap, line, token);
            line = buffer.push(heap, line, byte_of(10));
            borrow line as &lb in {
                io.error_all(con, buffer.bytes(lb));
            }
            buffer.drop(heap, line);
            var out = buffer.empty(heap, 4096);
            // Files are streamed (`hold`, `stream`, `answer`: docs/http-server.md section 14), up to 8 at once. A stream is four integers in `streams` (its ticket + 1, 0 for a free slot; how many
            // bytes of path it has in `arena`; the next byte to send; the byte to stop before) and a path in `arena` (512 bytes a slot): no file is held in memory and no handle is held open, each turn
            // of the loop reads the next piece (at most what the connection has room for, 64 KiB) with `files.read_at`.
            let streams = box_slice(heap, 32, 0);
            let arena = box_slice(heap, 4096, byte_of(0));
            let scratch = box_slice(heap, 65536, byte_of(0));
            var streaming = 0;
            while true {
                var wait_ms = 1000;
                if streaming > 0 {
                    wait_ms = 20;
                }
                srv = server.wait(heap, srv, clock, listener, wait_ms);
                streaming = 0;
                var si = 0;
                while si < 8 {
                    var tk = 0;
                    var plen = 0;
                    var pos = 0;
                    var fin = 0;
                    borrow streams as &sa in {
                        tk = contents(sa)[si * 4];
                        plen = contents(sa)[si * 4 + 1];
                        pos = contents(sa)[si * 4 + 2];
                        fin = contents(sa)[si * 4 + 3];
                    }
                    if tk > 0 {
                        let ticket = tk - 1;
                        var want = 0;
                        borrow srv as &sr0 in {
                            want = server.space(sr0, server.ticket_slot(ticket));
                        }
                        var give = fin - pos;
                        if want < give {
                            give = want;
                        }
                        if give > 65536 {
                            give = 65536;
                        }
                        var finished = pos >= fin;
                        if give > 0 && finished == false {
                            var n = 0;
                            borrow arena as &ar in {
                                borrow mut scratch as &!sc in {
                                    n = files.read_at(fs, contents(ar)[si * 512..si * 512 + plen], pos, contents(sc)[0..give]);
                                }
                            }
                            if n <= 0 {
                                finished = true;
                            } else {
                                var m = 0;
                                borrow mut srv as &!sw0 in {
                                    borrow scratch as &sc2 in {
                                        m = server.stream(sw0, ticket, contents(sc2)[0..n]);
                                    }
                                }
                                if m < 0 {
                                    finished = true;
                                } else {
                                    pos = pos + m;
                                    finished = pos >= fin;
                                    borrow mut streams as &!sm in {
                                        contents(sm)[si * 4 + 2] = pos;
                                    }
                                }
                            }
                        }
                        if finished {
                            borrow mut srv as &!sw1 in {
                                server.answer(sw1, ticket, "");
                            }
                            borrow mut streams as &!sm2 in {
                                contents(sm2)[si * 4] = 0;
                            }
                        } else {
                            streaming = streaming + 1;
                        }
                    }
                    si = si + 1;
                }
                var more = true;
                while more {
                    var slot = 0 - 1;
                    borrow mut srv as &!sw in {
                        slot = server.next(heap, sw);
                    }
                    if slot < 0 {
                        more = false;
                    } else {
                        borrow mut out as &!ob in {
                            buffer.clear(ob);
                        }
                        var take = false;
                        var tslot = 0 - 1;
                        var tplen = 0;
                        var tfrom = 0;
                        var tto = 0;
                        let now_s = clock_unix_ms(clock) / 1000;
                        borrow srv as &sr in {
                            let head = server.head(sr);
                            let table = server.parsed(sr);
                            let keep = http.keeps_alive(table);
                            let path = http.path(head, table);
                            let method = http.method(head, table);
                            var gate = 0;
                            if auth.host_ok(head, table, port) == false || auth.origin_ok(head, table, port) == false {
                                gate = 403;
                            } else if bytes.equal(path, "/") && bytes.equal(method, "GET") && auth.login_ok(head, table, token) {
                                gate = 302;
                            } else if auth.token_ok(head, table, token) == false {
                                gate = 401;
                            } else if bytes.equal(method, "POST") && auth.json_ok(head, table) == false && ((bytes.equal(path, "/edit") == false && bytes.equal(path, "/gallery") == false && bytes.equal(path, "/batch") == false) || auth.multipart_ok(head, table) == false) && (bytes.starts_with(path, "/compare/") == false || auth.form_ok(head, table) == false) {
                                gate = 415;
                            }
                            if gate == 403 {
                                out = server.failure(heap, out, 403, "forbidden: not this server's own host or origin", keep);
                            } else if gate == 302 {
                                var extra = buffer.append(heap, buffer.empty(heap, 128), "Set-Cookie: studio=");
                                extra = buffer.append(heap, extra, token);
                                extra = buffer.append(heap, extra, "; HttpOnly; SameSite=Strict; Path=/\r\nLocation: /\r\n");
                                borrow extra as &eb in {
                                    out = server.reply_as(heap, out, 302, "text/plain; charset=utf-8", "", keep, buffer.bytes(eb));
                                }
                                buffer.drop(heap, extra);
                            } else if gate == 401 {
                                out = server.failure(heap, out, 401, "a token is needed: open the URL the server printed", keep);
                            } else if gate == 415 {
                                out = server.failure(heap, out, 415, "a POST is application/json", keep);
                            } else if bytes.equal(path, "/") && bytes.equal(method, "GET") {
                                var served = false;
                                if len(site) > 0 {
                                    let (sst, sdata) = results.site_file(heap, fs, site, "index.html");
                                    if sst == 200 {
                                        borrow sdata as &sb in {
                                            let dec = results.decorate(heap, fs, dir, buffer.bytes(sb));
                                            borrow dec as &db in {
                                                out = server.reply_as(heap, out, 200, "text/html; charset=utf-8", buffer.bytes(db), keep, "");
                                            }
                                            buffer.drop(heap, dec);
                                        }
                                        served = true;
                                    }
                                    buffer.drop(heap, sdata);
                                }
                                if served == false {
                                    out = server.reply_as(heap, out, 200, "text/html; charset=utf-8", page(), keep, "");
                                }
                            } else if bytes.equal(path, "/app.js") && bytes.equal(method, "GET") && len(site) > 0 {
                                let (sst, sdata) = results.site_file(heap, fs, site, "app.js");
                                if sst == 200 {
                                    borrow sdata as &sb in {
                                        out = server.reply_as(heap, out, 200, "text/javascript; charset=utf-8", buffer.bytes(sb), keep, "");
                                    }
                                } else {
                                    out = server.failure(heap, out, 404, "not found", keep);
                                }
                                buffer.drop(heap, sdata);
                            } else if bytes.equal(path, "/openapi.json") && bytes.equal(method, "GET") && len(site) > 0 {
                                let (sst, sdata) = results.site_file(heap, fs, site, "openapi.json");
                                if sst == 200 {
                                    borrow sdata as &sb in {
                                        out = server.reply_as(heap, out, 200, "application/json", buffer.bytes(sb), keep, "");
                                    }
                                } else {
                                    out = server.failure(heap, out, 404, "not found", keep);
                                }
                                buffer.drop(heap, sdata);
                            } else if bytes.equal(path, "/style.css") && bytes.equal(method, "GET") {
                                out = server.reply_as(heap, out, 200, "text/css; charset=utf-8", results.css(), keep, "");
                            } else if bytes.equal(path, "/edit") && bytes.equal(method, "GET") {
                                // `?from=N` refines the result of job N, `?again=N` fills in its prompt and settings: the value is used only if it is 1 to 9 digits (results.id_ok), else ignored
                                let eq = http.query(head, table);
                                let (ff, ft) = http.query_value(eq, "from");
                                let (af, at) = http.query_value(eq, "again");
                                let (kf, kt) = http.query_value(eq, "pick1");
                                var f0 = 0;
                                var f1 = 0;
                                var a0 = 0;
                                var a1 = 0;
                                var k0 = 0;
                                var k1 = 0;
                                if kf >= 0 {
                                    k0 = kf;
                                    k1 = kt;
                                }
                                if ff >= 0 {
                                    f0 = ff;
                                    f1 = ft;
                                }
                                if af >= 0 {
                                    a0 = af;
                                    a1 = at;
                                }
                                let form = upload.form_page(heap, fs, dir, eq[f0..f1], eq[a0..a1], eq[k0..k1]);
                                borrow form as &fpb in {
                                    out = server.reply_as(heap, out, 200, "text/html; charset=utf-8", buffer.bytes(fpb), keep, "");
                                }
                                buffer.drop(heap, form);
                            } else if bytes.equal(path, "/sessions") && bytes.equal(method, "GET") {
                                let sl = sessions.list(heap, fs, dir);
                                borrow sl as &slb in {
                                    out = server.reply_as(heap, out, 200, "text/html; charset=utf-8", buffer.bytes(slb), keep, "");
                                }
                                buffer.drop(heap, sl);
                            } else if bytes.starts_with(path, "/sessions/") && bytes.equal(method, "GET") {
                                let (sst2, spg) = sessions.page(heap, fs, dir, path[10..len(path)]);
                                borrow spg as &spb in {
                                    out = server.reply_as(heap, out, sst2, "text/html; charset=utf-8", buffer.bytes(spb), keep, "");
                                }
                                buffer.drop(heap, spg);
                            } else if bytes.equal(path, "/batch") && bytes.equal(method, "POST") {
                                let (bst, btext, bfirst) = batch.handle(heap, fs, dir, http.header(head, table, "content-type"), server.body(sr));
                                if bst == 302 {
                                    var bextra = buffer.append(heap, buffer.empty(heap, 64), "Location: /sessions/");
                                    bextra = buffer.push_nat(heap, bextra, bfirst);
                                    bextra = buffer.append(heap, bextra, "\r\n");
                                    borrow bextra as &bxb in {
                                        out = server.reply_as(heap, out, 302, "text/plain; charset=utf-8", "", keep, buffer.bytes(bxb));
                                    }
                                    buffer.drop(heap, bextra);
                                } else {
                                    borrow btext as &btb in {
                                        out = server.reply_as(heap, out, bst, "application/json", buffer.bytes(btb), keep, "");
                                    }
                                }
                                buffer.drop(heap, btext);
                            } else if bytes.equal(path, "/gallery") && bytes.equal(method, "POST") {
                                let (lst, ltext) = library.add(heap, fs, dir, http.header(head, table, "content-type"), server.body(sr));
                                if lst == 302 {
                                    out = server.reply_as(heap, out, 302, "text/plain; charset=utf-8", "", keep, "Location: /gallery\r\n");
                                } else {
                                    borrow ltext as &ltb in {
                                        out = server.reply_as(heap, out, lst, "application/json", buffer.bytes(ltb), keep, "");
                                    }
                                }
                                buffer.drop(heap, ltext);
                            } else if bytes.equal(path, "/gallery") && bytes.equal(method, "GET") {
                                let (gst, gpg) = gallery.page(heap, fs, dir, http.query(head, table));
                                borrow gpg as &gpb in {
                                    if gst == 200 {
                                        out = server.reply_as(heap, out, 200, "text/html; charset=utf-8", buffer.bytes(gpb), keep, "");
                                    } else {
                                        out = server.failure(heap, out, gst, buffer.bytes(gpb), keep);
                                    }
                                }
                                buffer.drop(heap, gpg);
                            } else if bytes.equal(path, "/cases") && bytes.equal(method, "GET") {
                                let cpg = cases.page(heap, fs, dir, http.query(head, table));
                                borrow cpg as &cpb in {
                                    out = server.reply_as(heap, out, 200, "text/html; charset=utf-8", buffer.bytes(cpb), keep, "");
                                }
                                buffer.drop(heap, cpg);
                            } else if bytes.equal(path, "/edit") && bytes.equal(method, "POST") {
                                let (ust, utext, uid) = upload.handle(heap, fs, dir, http.header(head, table, "content-type"), server.body(sr), rewrite_on);
                                if ust == 302 {
                                    var to_pair = false;
                                    var to_set = false;
                                    borrow utext as &utp in {
                                        to_pair = bytes.equal(buffer.bytes(utp), "pair");
                                        to_set = bytes.equal(buffer.bytes(utp), "set");
                                    }
                                    var extra = buffer.append(heap, buffer.empty(heap, 64), "Location: /jobs/");
                                    if to_pair {
                                        buffer.drop(heap, extra);
                                        extra = buffer.append(heap, buffer.empty(heap, 64), "Location: /compare/");
                                    }
                                    if to_set {
                                        buffer.drop(heap, extra);
                                        extra = buffer.append(heap, buffer.empty(heap, 64), "Location: /sets/");
                                    }
                                    extra = buffer.push_nat(heap, extra, uid);
                                    extra = buffer.append(heap, extra, "\r\n");
                                    borrow extra as &eb in {
                                        out = server.reply_as(heap, out, 302, "text/plain; charset=utf-8", "", keep, buffer.bytes(eb));
                                    }
                                    buffer.drop(heap, extra);
                                } else {
                                    borrow utext as &ub in {
                                        out = server.reply_as(heap, out, ust, "application/json", buffer.bytes(ub), keep, "");
                                    }
                                }
                                buffer.drop(heap, utext);
                            } else if bytes.starts_with(path, "/sets/") && bytes.equal(method, "GET") {
                                let (sst, spage) = sets.page(heap, fs, dir, path[6..len(path)]);
                                borrow spage as &sp in {
                                    out = server.reply_as(heap, out, sst, "text/html; charset=utf-8", buffer.bytes(sp), keep, "");
                                }
                                buffer.drop(heap, spage);
                            } else if bytes.equal(path, "/compare") && bytes.equal(method, "GET") {
                                let cmp_list = compare.index(heap, fs, dir);
                                borrow cmp_list as &cl in {
                                    out = server.reply_as(heap, out, 200, "text/html; charset=utf-8", buffer.bytes(cl), keep, "");
                                }
                                buffer.drop(heap, cmp_list);
                            } else if bytes.starts_with(path, "/compare/") && bytes.equal(method, "GET") {
                                let (cst, cpage) = compare.page(heap, fs, dir, path[9..len(path)]);
                                borrow cpage as &cp in {
                                    out = server.reply_as(heap, out, cst, "text/html; charset=utf-8", buffer.bytes(cp), keep, "");
                                }
                                buffer.drop(heap, cpage);
                            } else if bytes.starts_with(path, "/compare/") && bytes.equal(method, "POST") {
                                let (vst, vtext) = compare.choose(heap, fs, dir, path[9..len(path)], server.body(sr));
                                if vst == 302 {
                                    var vextra = buffer.append(heap, buffer.empty(heap, 48), "Location: /compare/");
                                    vextra = buffer.append(heap, vextra, path[9..len(path)]);
                                    vextra = buffer.append(heap, vextra, "\r\n");
                                    borrow vextra as &veb in {
                                        out = server.reply_as(heap, out, 302, "text/plain; charset=utf-8", "", keep, buffer.bytes(veb));
                                    }
                                    buffer.drop(heap, vextra);
                                } else {
                                    borrow vtext as &vtb in {
                                        out = server.reply_as(heap, out, vst, "text/plain; charset=utf-8", buffer.bytes(vtb), keep, "");
                                    }
                                }
                                buffer.drop(heap, vtext);
                            } else if bytes.equal(path, "/jobs") && bytes.equal(method, "GET") {
                                let list = results.job_list(heap, fs, dir, false);
                                borrow list as &lb in {
                                    out = server.reply_as(heap, out, 200, "text/html; charset=utf-8", buffer.bytes(lb), keep, "");
                                }
                                buffer.drop(heap, list);
                            } else if bytes.equal(path, "/recent") && bytes.equal(method, "GET") {
                                let list = results.job_list(heap, fs, dir, true);
                                borrow list as &lb in {
                                    out = server.reply_as(heap, out, 200, "text/html; charset=utf-8", buffer.bytes(lb), keep, "");
                                }
                                buffer.drop(heap, list);
                            } else if bytes.equal(path, "/api/models") {
                                out = server.reply_as(heap, out, 200, "application/json", models(), keep, "");
                            } else if bytes.equal(path, "/api/jobs") && bytes.equal(method, "POST") {
                                let (st, answer) = jobs.create(heap, fs, dir, server.body(sr), rewrite_on);
                                borrow answer as &ab in {
                                    out = server.reply_as(heap, out, st, "application/json", buffer.bytes(ab), keep, "");
                                }
                                buffer.drop(heap, answer);
                            } else if bytes.equal(path, "/api/jobs") && bytes.equal(method, "GET") {
                                let list = results.api_list(heap, fs, dir);
                                borrow list as &lb in {
                                    out = server.reply_as(heap, out, 200, "application/json", buffer.bytes(lb), keep, "");
                                }
                                buffer.drop(heap, list);
                            } else if bytes.starts_with(path, "/api/jobs/") && bytes.equal(method, "GET") {
                                let (st, answer) = jobs.state_of(heap, fs, dir, path[10..len(path)]);
                                borrow answer as &ab in {
                                    out = server.reply_as(heap, out, st, "application/json", buffer.bytes(ab), keep, "");
                                }
                                buffer.drop(heap, answer);
                            } else if bytes.starts_with(path, "/jobs/") && bytes.equal(method, "GET") {
                                let (st, answer) = results.job_page(heap, fs, dir, path[6..len(path)]);
                                borrow answer as &ab in {
                                    out = server.reply_as(heap, out, st, "text/html; charset=utf-8", buffer.bytes(ab), keep, "");
                                }
                                buffer.drop(heap, answer);
                            } else if bytes.starts_with(path, "/files/") && bytes.equal(method, "GET") {
                                let rest = path[7..len(path)];
                                let (st, fpath, size) = results.file_info(heap, fs, dir, rest);
                                if st == 200 {
                                    var free = 0 - 1;
                                    borrow streams as &sf in {
                                        var k = 0;
                                        while k < 8 && free < 0 {
                                            if contents(sf)[k * 4] == 0 {
                                                free = k;
                                            }
                                            k = k + 1;
                                        }
                                    }
                                    var cut = 0;
                                    while cut < len(rest) && int_of(rest[cut]) != 47 {
                                        cut = cut + 1;
                                    }
                                    let (rk, ra, rb) = range.parse(http.header(head, table, "range"), size);
                                    if free < 0 {
                                        out = server.reply_as(heap, out, 503, "text/plain; charset=utf-8", "too many files are being sent; retry", keep, "Retry-After: 1\r\n");
                                    } else if rk == 2 {
                                        var extra = buffer.append(heap, buffer.empty(heap, 64), "Content-Range: bytes */");
                                        extra = buffer.push_nat(heap, extra, size);
                                        extra = buffer.append(heap, extra, "\r\n");
                                        borrow extra as &xb in {
                                            out = server.reply_as(heap, out, 416, "text/plain; charset=utf-8", "range not satisfiable", keep, buffer.bytes(xb));
                                        }
                                        buffer.drop(heap, extra);
                                    } else {
                                        var status = 200;
                                        var from = 0;
                                        var to = size;
                                        var extra = buffer.append(heap, buffer.empty(heap, 96), "Accept-Ranges: bytes\r\n");
                                        if rk == 1 {
                                            status = 206;
                                            from = ra;
                                            to = rb + 1;
                                            extra = buffer.append(heap, extra, "Content-Range: bytes ");
                                            extra = buffer.push_nat(heap, extra, ra);
                                            extra = buffer.push(heap, extra, byte_of(45));
                                            extra = buffer.push_nat(heap, extra, rb);
                                            extra = buffer.push(heap, extra, byte_of(47));
                                            extra = buffer.push_nat(heap, extra, size);
                                            extra = buffer.append(heap, extra, "\r\n");
                                        }
                                        borrow extra as &xb2 in {
                                            out = http.respond_head_with(heap, out, status, results.content_type(rest[cut + 1..len(rest)]), to - from, keep, buffer.bytes(xb2));
                                        }
                                        buffer.drop(heap, extra);
                                        borrow fpath as &fb in {
                                            let pb = buffer.bytes(fb);
                                            borrow mut arena as &!am in {
                                                var c = 0;
                                                while c < len(pb) && c < 512 {
                                                    contents(am)[free * 512 + c] = pb[c];
                                                    c = c + 1;
                                                }
                                            }
                                            tplen = len(pb);
                                        }
                                        tslot = free;
                                        tfrom = from;
                                        tto = to;
                                        take = true;
                                    }
                                    buffer.drop(heap, fpath);
                                } else {
                                    buffer.drop(heap, fpath);
                                    if st == 422 {
                                        out = server.reply_as(heap, out, 422, "text/plain; charset=utf-8", "the id is 1 to 9 digits", keep, "");
                                    } else {
                                        out = server.reply_as(heap, out, 404, "text/plain; charset=utf-8", "not found", keep, "");
                                    }
                                }
                            } else {
                                out = server.failure(heap, out, 404, "not found", keep);
                            }
                        }
                        borrow mut srv as &!sw in {
                            if take {
                                let ticket = server.hold(sw);
                                borrow mut streams as &!sm3 in {
                                    contents(sm3)[tslot * 4] = ticket + 1;
                                    contents(sm3)[tslot * 4 + 1] = tplen;
                                    contents(sm3)[tslot * 4 + 2] = tfrom;
                                    contents(sm3)[tslot * 4 + 3] = tto;
                                }
                                streaming = streaming + 1;
                                borrow out as &ob in {
                                    server.stream(sw, ticket, buffer.bytes(ob));
                                }
                            } else {
                                borrow out as &ob in {
                                    server.respond(sw, buffer.bytes(ob));
                                }
                            }
                        }
                    }
                }
            }
            server.close(heap, srv);
            unbox_slice(heap, streams);
            unbox_slice(heap, arena);
            unbox_slice(heap, scratch);
            buffer.drop(heap, out);
            return 0;
        }
        Polling::Failed(e) => {
            return 4;
        }
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(signals);
    release(exec);
    release(tty);
    var status = 2;
    borrow args as &g in {
        let n = arg_count(g);
        var flag_ok = true;
        var rewrite_on = false;
        if n == 5 || n == 6 {
            flag_ok = bytes.equal(arg(g, n - 2), "--rewrite") && (bytes.equal(arg(g, n - 1), "on") || bytes.equal(arg(g, n - 1), "off"));
            rewrite_on = bytes.equal(arg(g, n - 1), "on");
        }
        let has_site = n == 4 || n == 6;
        if (n == 3 || n == 4 || n == 5 || n == 6) && flag_ok {
            let port = number_of(arg(g, 1));
            borrow fs as &fr in {
            borrow mut heap as &!h in {
                if port > 0 && port < 65536 && files.path_ok(fr, arg(g, 2)) && (has_site == false || files.path_ok(fr, arg(g, 3))) {
                    status = 3;
                    borrow net as &nn in {
                        let token = auth.make(h, fr);
                        borrow token as &tk in {
                        if len(buffer.bytes(tk)) == 32 {
                        match tcp_listen_on(nn, "127.0.0.1", port, 1024, 0) {
                            Listening::Ok(l) => {
                                var listener = l;
                                borrow mut listener as &!lh in {
                                    listener_nonblocking(lh);
                                    borrow mut io as &!i in {
                                        borrow clock as &c in {
                                            if has_site {
                                                status = serve(h, c, lh, i, fr, arg(g, 2), arg(g, 3), buffer.bytes(tk), port, rewrite_on);
                                            } else {
                                                status = serve(h, c, lh, i, fr, arg(g, 2), "", buffer.bytes(tk), port, rewrite_on);
                                            }
                                        }
                                    }
                                }
                                listener_close(listener);
                            }
                            Listening::Failed(e) => {
                            }
                        }
                        } else {
                            status = 6;
                        }
                        }
                        buffer.drop(h, token);
                    }
                } else {
                    borrow mut io as &!i in {
                        io.error_all(i, "usage: studio <port> <absolute data-dir> [<absolute site-dir>] [--rewrite on|off]\n");
                    }
                }
            }
            }
        }
    }
    release(fs);
    release(net);
    release(clock);
    release(args);
    release(io);
    release(heap);
    return status;
}

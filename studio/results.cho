edition 9;

module results;

import std.buffer;
import std.bytes;
import files;

// `results` -- what the browser sees of a job (docs/studio.md, route 3): a page the server writes, and the job's files by a closed list of names.
//
//   GET /jobs/N          HTML: the state, the result (an <img> or a <video>) when it is done, the log; refreshes itself while queued or running
//   GET /files/N/NAME    NAME is one of edited.png, image.png, video.mp4, video.gif, log, or a picture the person gave (input1.jpg|png|webp, input2.jpg|png|webp: the files `upload-N...` that POST /edit kept); never a path from the client
//
// `media` writes `<data>/out/N/{edited.png,image.png,video.mp4,video.gif}`; the worker writes `<data>/N.log`.

pub fn id_ok[&i](id: &i [byte]) -> [] bool {
    if len(id) == 0 || len(id) > 9 {
        return false;
    }
    var k = 0;
    while k < len(id) {
        let c = int_of(id[k]);
        if c < 48 || c > 57 {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn word_char(c: int) -> [] bool {
    return (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 32;
}

// `<data>/N<tail>`
pub fn job_path[&h, &d, &i, &t](heap: &!h Heap, dir: &d [byte], id: &i [byte], tail: &t [byte]) -> [heap] buffer.Buffer {
    var p = buffer.append(heap, buffer.empty(heap, 64), dir);
    p = buffer.append(heap, p, "/");
    p = buffer.append(heap, p, id);
    p = buffer.append(heap, p, tail);
    return p;
}

// `<data>/out/N/NAME`
fn out_path[&h, &d, &i, &n](heap: &!h Heap, dir: &d [byte], id: &i [byte], name: &n [byte]) -> [heap] buffer.Buffer {
    var p = buffer.append(heap, buffer.empty(heap, 64), dir);
    p = buffer.append(heap, p, "/out/");
    p = buffer.append(heap, p, id);
    p = buffer.append(heap, p, "/");
    p = buffer.append(heap, p, name);
    return p;
}

pub fn has_out[&h, &f, &d, &i](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte], name: &static [byte]) -> [heap, fs_read("")] bool {
    let p = out_path(heap, dir, id, name);
    var yes = false;
    borrow p as &pb in {
        yes = files.exists(fs, buffer.bytes(pb));
    }
    buffer.drop(heap, p);
    return yes;
}

// The file name's tail of the upload behind a name of the closed list: `input1.png` is `<data>/upload-N.png`, `input2.png` is `<data>/upload-N-2.png` (studio/upload.cho keeps them so). "" for any other name.
fn upload_tail[&n](name: &n [byte]) -> [] &static [byte] {
    if bytes.equal(name, "input1.jpg") {
        return ".jpg";
    }
    if bytes.equal(name, "input1.png") {
        return ".png";
    }
    if bytes.equal(name, "input1.webp") {
        return ".webp";
    }
    if bytes.equal(name, "input2.jpg") {
        return "-2.jpg";
    }
    if bytes.equal(name, "input2.png") {
        return "-2.png";
    }
    if bytes.equal(name, "input2.webp") {
        return "-2.webp";
    }
    return "";
}

// `<data>/upload-N` + `tail`
fn upload_path[&h, &d, &i, &t](heap: &!h Heap, dir: &d [byte], id: &i [byte], tail: &t [byte]) -> [heap] buffer.Buffer {
    var p = buffer.append(heap, buffer.empty(heap, 64), dir);
    p = buffer.append(heap, p, "/upload-");
    p = buffer.append(heap, p, id);
    p = buffer.append(heap, p, tail);
    return p;
}

pub fn has_upload[&h, &f, &d, &i](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte], name: &static [byte]) -> [heap, fs_read("")] bool {
    let p = upload_path(heap, dir, id, upload_tail(name));
    var yes = false;
    borrow p as &pb in {
        yes = files.exists(fs, buffer.bytes(pb));
    }
    buffer.drop(heap, p);
    return yes;
}

// Whether the job has the file `<id><tail>` (`.argv`, `.from`).
fn has_file[&h, &f, &d, &i](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte], tail: &static [byte]) -> [heap, fs_read("")] bool {
    let p = job_path(heap, dir, id, tail);
    var yes = false;
    borrow p as &pb in {
        yes = files.exists(fs, buffer.bytes(pb));
    }
    buffer.drop(heap, p);
    return yes;
}

// (known, the state word): `queued` when there is an argument file but no state yet; letters, digits and spaces only, so it can go into HTML as it is.
pub fn state_word[&h, &f, &d, &i](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte]) -> [heap, fs_read(""), file_read] (bool, buffer.Buffer) {
    var word = buffer.empty(heap, 16);
    var known = false;
    let sp = job_path(heap, dir, id, ".state");
    borrow sp as &sb in {
        let (b, e) = files.read_all(heap, fs, buffer.bytes(sb));
        borrow b as &br in {
            let all = buffer.bytes(br);
            if e == 0 && len(all) > 0 {
                var stop = 0;
                while stop < len(all) && word_char(int_of(all[stop])) {
                    stop = stop + 1;
                }
                word = buffer.append(heap, word, all[0..stop]);
                known = stop > 0;
            }
        }
        buffer.drop(heap, b);
    }
    buffer.drop(heap, sp);
    if known == false {
        let ap = job_path(heap, dir, id, ".argv");
        borrow ap as &ab in {
            known = files.exists(fs, buffer.bytes(ab));
        }
        buffer.drop(heap, ap);
        if known {
            word = buffer.append(heap, word, "queued");
        }
    }
    return (known, word);
}

// `text` as HTML text: `& < > " '` become entities. A model's words are untrusted and are shown only through this.
pub fn escape[&h, &t](heap: &!h Heap, b: buffer.Buffer, text: &t [byte]) -> [heap] buffer.Buffer {
    var out = b;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c == 38 {
            out = buffer.append(heap, out, "&amp;");
        } else if c == 60 {
            out = buffer.append(heap, out, "&lt;");
        } else if c == 62 {
            out = buffer.append(heap, out, "&gt;");
        } else if c == 34 {
            out = buffer.append(heap, out, "&quot;");
        } else if c == 39 {
            out = buffer.append(heap, out, "&#39;");
        } else {
            out = buffer.push(heap, out, byte_of(c));
        }
        i = i + 1;
    }
    return out;
}

// The contents of `<data>/<id><tail>` (empty if it is not there), and whether it was.
pub fn job_file[&h, &f, &d, &i, &t](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte], tail: &t [byte]) -> [heap, fs_read(""), file_read] (buffer.Buffer, bool) {
    let p = job_path(heap, dir, id, tail);
    var found = false;
    var out = buffer.empty(heap, 8);
    borrow p as &pb in {
        let (b, e) = files.read_all(heap, fs, buffer.bytes(pb));
        buffer.drop(heap, out);
        out = b;
        found = e == 0;
    }
    buffer.drop(heap, p);
    return (out, found);
}

// The page of job `id` (the text after `/jobs/`): 200, 404 for an id with no argument file, 422 for one that is not 1 to 9 digits.
// The last entry of a job's argument list (`<id>.argv`, entries ended by a NUL): the prompt as written. (start, end) of it in the list.
pub fn last_entry[&l](list: &l [byte]) -> [] (int, int) {
    var end = len(list);
    if end > 0 && int_of(list[end - 1]) == 0 {
        end = end - 1;
    }
    var start = end;
    while start > 0 && int_of(list[start - 1]) != 0 {
        start = start - 1;
    }
    return (start, end);
}

// (running, queued) among the 200 newest jobs of `queue`, for the header's status.
pub fn counts[&h, &f, &d](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte]) -> [heap, fs_read(""), file_read] (int, int) {
    var running = 0;
    var queued = 0;
    var text = buffer.empty(heap, 8);
    let qp = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), dir), "/queue");
    borrow qp as &q in {
        let (b, e) = files.read_all(heap, fs, buffer.bytes(q));
        buffer.drop(heap, text);
        text = b;
    }
    buffer.drop(heap, qp);
    var seen = 0;
    borrow text as &tb in {
        let all = buffer.bytes(tb);
        var end = len(all);
        while end > 0 && seen < 200 {
            var stop = end;
            while stop > 0 && int_of(all[stop - 1]) == 10 {
                stop = stop - 1;
            }
            if stop == 0 {
                end = 0;
            } else {
                var start = stop;
                while start > 0 && int_of(all[start - 1]) != 10 {
                    start = start - 1;
                }
                let id = all[start..stop];
                if id_ok(id) {
                    let (known, word) = state_word(heap, fs, dir, id);
                    if known {
                        borrow word as &wb in {
                            if bytes.equal(buffer.bytes(wb), "running") {
                                running = running + 1;
                            }
                            if bytes.equal(buffer.bytes(wb), "queued") {
                                queued = queued + 1;
                            }
                        }
                    }
                    buffer.drop(heap, word);
                    seen = seen + 1;
                }
                end = start;
            }
        }
    }
    buffer.drop(heap, text);
    return (running, queued);
}

fn nav_link[&h](heap: &!h Heap, page: buffer.Buffer, href: &static [byte], label: &static [byte], key: &static [byte], current: &static [byte]) -> [heap] buffer.Buffer {
    var p = buffer.append(heap, page, "<a href=");
    p = buffer.append(heap, p, href);
    if bytes.equal(current, key) {
        p = buffer.append(heap, p, " aria-current=page");
    }
    p = buffer.append(heap, p, ">");
    p = buffer.append(heap, p, label);
    return buffer.append(heap, p, "</a>");
}

// A place of the header: a link that is marked open when `inside` (the page shown belongs to it).
fn place_link[&h](heap: &!h Heap, page: buffer.Buffer, href: &static [byte], label: &static [byte], inside: bool) -> [heap] buffer.Buffer {
    var p = buffer.append(heap, page, "<a href=");
    p = buffer.append(heap, p, href);
    if inside {
        p = buffer.append(heap, p, " aria-current=page");
    }
    p = buffer.append(heap, p, ">");
    p = buffer.append(heap, p, label);
    return buffer.append(heap, p, "</a>");
}

// The header of every page (docs/studio-sessions.md, section 10.1): the brand, two places and the queue's status, then the tabs of the open place.
// Create: Generate (`studio`), Edit a picture (`edit`), Cases (`cases`). Library: Gallery (`gallery`), Sessions (`sessions`), Jobs (`jobs`), Comparisons (`compare`). `current` is the tab that is open.
pub fn header[&h, &f, &d](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], current: &static [byte]) -> [heap, fs_read(""), file_read] buffer.Buffer {
    let create = bytes.equal(current, "studio") || bytes.equal(current, "edit") || bytes.equal(current, "cases");
    var page = buffer.append(heap, buffer.empty(heap, 512), "<header class=top><a class=brand href=/>cancho-studio</a><nav>");
    page = place_link(heap, page, "/", "Create", create);
    page = place_link(heap, page, "/gallery", "Library", create == false);
    let (running, queued) = counts(heap, fs, dir);
    if running > 0 {
        page = buffer.append(heap, page, "</nav><div class=\"status busy\"><span class=dot></span><span>GPU busy &middot; ");
        page = buffer.push_nat(heap, page, running);
        page = buffer.append(heap, page, " running &middot; ");
        page = buffer.push_nat(heap, page, queued);
        page = buffer.append(heap, page, " queued</span></div></header>");
    } else {
        page = buffer.append(heap, page, "</nav><div class=status><span class=dot></span><span>GPU idle");
        if queued > 0 {
            page = buffer.append(heap, page, " &middot; ");
            page = buffer.push_nat(heap, page, queued);
            page = buffer.append(heap, page, " queued");
        }
        page = buffer.append(heap, page, "</span></div></header>");
    }
    page = buffer.append(heap, page, "<div class=tabs>");
    if create {
        page = nav_link(heap, page, "/", "Generate", "studio", current);
        page = nav_link(heap, page, "/edit", "Edit a picture", "edit", current);
        page = nav_link(heap, page, "/cases", "Cases", "cases", current);
    } else {
        page = nav_link(heap, page, "/gallery", "Gallery", "gallery", current);
        page = nav_link(heap, page, "/sessions", "Sessions", "sessions", current);
        page = nav_link(heap, page, "/jobs", "Jobs", "jobs", current);
        page = nav_link(heap, page, "/compare", "Comparisons", "compare", current);
    }
    return buffer.append(heap, page, "</div>");
}

// The start of every page the server writes (docs/studio-design.md): the document head with the stylesheet, a refresh when `refresh`, the title, and the header (the brand, the four places, and the queue's status), then `<main>`.
// `current` is the place that is open: `studio`, `edit`, `compare` or `jobs`. `close` ends it.
pub fn open[&h, &f, &d, &t](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], title: &t [byte], current: &static [byte], refresh: bool) -> [heap, fs_read(""), file_read] buffer.Buffer {
    var page = buffer.append(heap, buffer.empty(heap, 2048), "<!doctype html><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><link rel=stylesheet href=/style.css>");
    if refresh {
        page = buffer.append(heap, page, "<meta http-equiv=refresh content=5>");
    }
    page = buffer.append(heap, page, "<title>cancho-studio: ");
    page = buffer.append(heap, page, title);
    page = buffer.append(heap, page, "</title>");
    let hd = header(heap, fs, dir, current);
    borrow hd as &hb in {
        page = buffer.append(heap, page, buffer.bytes(hb));
    }
    buffer.drop(heap, hd);
    return buffer.append(heap, page, "<main>");
}

// The cancho-ui page of `/` (built by `cancho-ui`, its own markup and script) as the studio serves it: the stylesheet linked before `</head>` and the header right after `<body>`, so that it looks like the pages the server writes. A page
// that does not have both tags is served as it is.
pub fn decorate[&h, &f, &d, &p](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], page: &p [byte]) -> [heap, fs_read(""), file_read] buffer.Buffer {
    let at_head = bytes.find(page, "</head>");
    let at_body = bytes.find(page, "<body>");
    var out = buffer.empty(heap, len(page) + 2048);
    if at_head < 0 || at_body < at_head {
        return buffer.append(heap, out, page);
    }
    out = buffer.append(heap, out, page[0..at_head]);
    out = buffer.append(heap, out, "<link rel=stylesheet href=/style.css>");
    out = buffer.append(heap, out, page[at_head..at_body + 6]);
    let hd = header(heap, fs, dir, "studio");
    borrow hd as &hb in {
        out = buffer.append(heap, out, buffer.bytes(hb));
    }
    buffer.drop(heap, hd);
    let at_end = bytes.find(page, "</body>");
    if at_end < at_body + 6 {
        return buffer.append(heap, out, page[at_body + 6..len(page)]);
    }
    out = buffer.append(heap, out, page[at_body + 6..at_end]);
    out = buffer.append(heap, out, "<iframe class=recent src=/recent title=\"Recent jobs\"></iframe>");
    return buffer.append(heap, out, page[at_end..len(page)]);
}

pub fn close[&h](heap: &!h Heap, page: buffer.Buffer) -> [heap] buffer.Buffer {
    return buffer.append(heap, page, "</main>");
}

// A job's parameters from its argument list (`<id>.argv`, entries ended by a NUL), as `<dt>`/`<dd>` pairs: the kind, then every `--name value` before the `--` that ends the options (`-o` and its value are the server's, not shown).
fn param_rows[&h, &a](heap: &!h Heap, page: buffer.Buffer, argv: &a [byte]) -> [heap] buffer.Buffer {
    var p = page;
    var i = 0;
    var first = true;
    while i < len(argv) {
        var j = i;
        while j < len(argv) && int_of(argv[j]) != 0 {
            j = j + 1;
        }
        let entry = argv[i..j];
        if first {
            p = buffer.append(heap, p, "<dt>kind</dt><dd>");
            p = escape(heap, p, entry);
            p = buffer.append(heap, p, "</dd>");
            first = false;
            i = j + 1;
        } else if bytes.equal(entry, "--") {
            i = len(argv) + 1;
        } else if bytes.equal(entry, "-o") || (len(entry) > 2 && bytes.starts_with(entry, "--")) {
            var k = j + 1;
            while k < len(argv) && int_of(argv[k]) != 0 {
                k = k + 1;
            }
            if bytes.equal(entry, "-o") == false && j + 1 < len(argv) {
                p = buffer.append(heap, p, "<dt>");
                p = escape(heap, p, entry[2..len(entry)]);
                p = buffer.append(heap, p, "</dt><dd>");
                p = escape(heap, p, argv[j + 1..k]);
                p = buffer.append(heap, p, "</dd>");
            }
            i = k + 1;
        } else {
            i = j + 1;
        }
    }
    return p;
}

fn file_item[&h, &f, &d, &i](heap: &!h Heap, page: buffer.Buffer, fs: &f Fs(""), dir: &d [byte], id: &i [byte], name: &static [byte]) -> [heap, fs_read("")] buffer.Buffer {
    if has_out(heap, fs, dir, id, name) == false {
        return page;
    }
    var p = buffer.append(heap, page, "<li><a href=/files/");
    p = buffer.append(heap, p, id);
    p = buffer.append(heap, p, "/");
    p = buffer.append(heap, p, name);
    p = buffer.append(heap, p, ">");
    p = buffer.append(heap, p, name);
    return buffer.append(heap, p, "</a></li>");
}

// `GET /jobs/N`: (200, HTML), 404 for an id with no argument file, 422 for one that is not digits. The result beside the details (docs/studio-design.md, section 1): the prompt as written and, when there is one, the rewritten prompt; the parameters; the files.
pub fn job_page[&h, &f, &d, &i](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte]) -> [heap, fs_read(""), file_read] (int, buffer.Buffer) {
    if id_ok(id) == false {
        return (422, buffer.append(heap, buffer.empty(heap, 48), "the id is 1 to 9 digits"));
    }
    let (known, state) = state_word(heap, fs, dir, id);
    if known == false {
        buffer.drop(heap, state);
        return (404, buffer.append(heap, buffer.empty(heap, 32), "no such job"));
    }
    var active = false;
    var done = false;
    var failed = false;
    borrow state as &sb in {
        active = bytes.equal(buffer.bytes(sb), "queued") || bytes.equal(buffer.bytes(sb), "running");
        done = bytes.equal(buffer.bytes(sb), "done");
        failed = bytes.starts_with(buffer.bytes(sb), "failed");
    }
    let title = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 16), "job "), id);
    var page = buffer.empty(heap, 8);
    borrow title as &tr in {
        buffer.drop(heap, page);
        page = open(heap, fs, dir, buffer.bytes(tr), "jobs", active);
    }
    buffer.drop(heap, title);
    page = buffer.append(heap, page, "<div class=row><a href=/jobs>&larr; All jobs</a><h1>Job ");
    page = buffer.append(heap, page, id);
    page = buffer.append(heap, page, "</h1><span class=pill>state: ");
    borrow state as &sb2 in {
        page = buffer.append(heap, page, buffer.bytes(sb2));
    }
    page = buffer.append(heap, page, "</span></div><div class=split><section class=main>");
    // the pictures the person gave and, when the job is done, the result beside them (an edit made through the form: studio/upload.cho keeps its pictures)
    var row = buffer.empty(heap, 8);
    let (row2, shown) = input_figures(heap, row, fs, dir, id);
    row = row2;
    var in_row = false;
    if shown > 0 {
        if done && has_out(heap, fs, dir, id, "edited.png") {
            row = figure(heap, row, id, "edited.png", "the edited picture", "Result");
            in_row = true;
        }
        page = buffer.append(heap, page, "<div class=trio>");
        borrow row as &rowr in {
            page = buffer.append(heap, page, buffer.bytes(rowr));
        }
        page = buffer.append(heap, page, "</div>");
    }
    buffer.drop(heap, row);
    if done {
        if in_row == false && has_out(heap, fs, dir, id, "edited.png") {
            page = buffer.append(heap, page, "<img alt=\"the edited picture\" src=/files/");
            page = buffer.append(heap, page, id);
            page = buffer.append(heap, page, "/edited.png>");
        }
        if has_out(heap, fs, dir, id, "image.png") {
            page = buffer.append(heap, page, "<img alt=\"the generated picture\" src=/files/");
            page = buffer.append(heap, page, id);
            page = buffer.append(heap, page, "/image.png>");
        }
        if has_out(heap, fs, dir, id, "video.mp4") {
            page = buffer.append(heap, page, "<video controls loop src=/files/");
            page = buffer.append(heap, page, id);
            page = buffer.append(heap, page, "/video.mp4></video>");
        }
    } else if failed {
        page = buffer.append(heap, page, "<div class=alert role=alert>The job did not finish. The log says why.</div>");
    } else {
        page = buffer.append(heap, page, "<p>Waiting for the result. This page refreshes by itself.</p>");
    }
    page = buffer.append(heap, page, "<div class=acts><a class=btn href=/files/");
    page = buffer.append(heap, page, id);
    page = buffer.append(heap, page, "/log>Open the log</a>");
    // the next round (docs/studio-sessions.md): refine this result, or start again from this job's prompt and settings
    if done && (has_out(heap, fs, dir, id, "edited.png") || has_out(heap, fs, dir, id, "image.png")) {
        page = buffer.append(heap, page, "<a class=btn href=\"/edit?from=");
        page = buffer.append(heap, page, id);
        page = buffer.append(heap, page, "\">Refine this result</a>");
    }
    if has_file(heap, fs, dir, id, ".argv") && has_out(heap, fs, dir, id, "video.mp4") == false {
        page = buffer.append(heap, page, "<a class=btn href=\"/edit?again=");
        page = buffer.append(heap, page, id);
        page = buffer.append(heap, page, "\">Use this prompt again</a>");
    }
    page = buffer.append(heap, page, "</div></section><aside class=side>");
    let (orig, has_orig) = job_file(heap, fs, dir, id, ".prompt.orig");
    let (fresh, has_fresh) = job_file(heap, fs, dir, id, ".prompt.new");
    let (flag, has_flag) = job_file(heap, fs, dir, id, ".rewrite");
    let (av, has_av) = job_file(heap, fs, dir, id, ".argv");
    page = buffer.append(heap, page, "<section class=card><h2>Prompt as written</h2><p>");
    if has_orig {
        borrow orig as &obr in {
            page = escape(heap, page, buffer.bytes(obr));
        }
    } else if has_av {
        // a job that was not rewritten has no `.prompt.orig`: its prompt is the last entry of its argument list
        borrow av as &avr in {
            let (ps, pe) = last_entry(buffer.bytes(avr));
            page = escape(heap, page, buffer.bytes(avr)[ps..pe]);
        }
    }
    page = buffer.append(heap, page, "</p>");
    if has_fresh {
        page = buffer.append(heap, page, "<h2 style=\"margin-top:14px\">Rewritten by the local model</h2><p>");
        borrow fresh as &fbr in {
            page = escape(heap, page, buffer.bytes(fbr));
        }
        page = buffer.append(heap, page, "</p>");
    } else if has_flag && active == false {
        borrow flag as &flr in {
            if bytes.starts_with(buffer.bytes(flr), "on") {
                page = buffer.append(heap, page, "<p style=\"margin-top:14px\">the prompt was not rewritten (see the log)</p>");
            }
        }
    }
    page = buffer.append(heap, page, "</section><section class=card><h2>Parameters</h2><dl>");
    if has_av {
        borrow av as &avr2 in {
            page = param_rows(heap, page, buffer.bytes(avr2));
        }
    }
    if has_flag {
        borrow flag as &flr2 in {
            page = buffer.append(heap, page, "<dt>rewrite</dt><dd>");
            page = escape(heap, page, buffer.bytes(flr2)[0..bytes.find(buffer.bytes(flr2), "\n")]);
            page = buffer.append(heap, page, "</dd>");
        }
    }
    page = buffer.append(heap, page, "</dl></section><section class=card><h2>Files</h2><ul>");
    page = file_item(heap, page, fs, dir, id, "video.mp4");
    page = file_item(heap, page, fs, dir, id, "video.gif");
    page = file_item(heap, page, fs, dir, id, "edited.png");
    page = file_item(heap, page, fs, dir, id, "image.png");
    page = buffer.append(heap, page, "<li><a href=/files/");
    page = buffer.append(heap, page, id);
    page = buffer.append(heap, page, "/log>log</a></li></ul></section></aside></div>");
    buffer.drop(heap, orig);
    buffer.drop(heap, fresh);
    buffer.drop(heap, flag);
    buffer.drop(heap, av);
    buffer.drop(heap, state);
    return (200, close(heap, page));
}

// One figure of the job page's row of pictures: the file `name` of the job, with its caption.
pub fn figure[&h, &i](heap: &!h Heap, page: buffer.Buffer, id: &i [byte], name: &static [byte], alt: &static [byte], caption: &static [byte]) -> [heap] buffer.Buffer {
    var p = buffer.append(heap, page, "<figure><a href=/files/");
    p = buffer.append(heap, p, id);
    p = buffer.append(heap, p, "/");
    p = buffer.append(heap, p, name);
    p = buffer.append(heap, p, "><img alt=\"");
    p = buffer.append(heap, p, alt);
    p = buffer.append(heap, p, "\" loading=lazy src=/files/");
    p = buffer.append(heap, p, id);
    p = buffer.append(heap, p, "/");
    p = buffer.append(heap, p, name);
    p = buffer.append(heap, p, "></a><figcaption>");
    p = buffer.append(heap, p, caption);
    return buffer.append(heap, p, "</figcaption></figure>");
}

// The pictures the person gave this job, as figures: (the page, how many). A job made by POST /api/jobs has none (its picture is a path, never served).
pub fn input_figures[&h, &f, &d, &i](heap: &!h Heap, page: buffer.Buffer, fs: &f Fs(""), dir: &d [byte], id: &i [byte]) -> [heap, fs_read(""), file_read] (buffer.Buffer, int) {
    var p = page;
    var n = 0;
    // a refine (studio/upload.cho, docs/studio-sessions.md): its first picture is the result of an earlier job, named in `<id>.from` as `JOB NAME`
    let (fromfile, has_from) = job_file(heap, fs, dir, id, ".from");
    var shown_from = false;
    if has_from {
        borrow fromfile as &ffb in {
            let line = buffer.bytes(ffb);
            let (digits, dend) = nat_at(line, 0);
            if digits > 0 && dend < len(line) && id_ok(line[0..dend]) {
                if bytes.starts_with(line[dend + 1..len(line)], "edited.png") {
                    p = figure(heap, p, line[0..dend], "edited.png", "the first picture, the result of an earlier job", "Picture 1 (result of an earlier job)");
                    n = n + 1;
                    shown_from = true;
                } else if bytes.starts_with(line[dend + 1..len(line)], "image.png") {
                    p = figure(heap, p, line[0..dend], "image.png", "the first picture, the result of an earlier job", "Picture 1 (result of an earlier job)");
                    n = n + 1;
                    shown_from = true;
                }
            }
        }
    }
    buffer.drop(heap, fromfile);
    if shown_from {
        // the first picture is shown; nothing else is the first picture
    } else if has_upload(heap, fs, dir, id, "input1.jpg") {
        p = figure(heap, p, id, "input1.jpg", "the first picture", "Picture 1");
        n = n + 1;
    } else if has_upload(heap, fs, dir, id, "input1.png") {
        p = figure(heap, p, id, "input1.png", "the first picture", "Picture 1");
        n = n + 1;
    } else if has_upload(heap, fs, dir, id, "input1.webp") {
        p = figure(heap, p, id, "input1.webp", "the first picture", "Picture 1");
        n = n + 1;
    }
    if has_upload(heap, fs, dir, id, "input2.jpg") {
        p = figure(heap, p, id, "input2.jpg", "the second picture", "Picture 2");
        n = n + 1;
    } else if has_upload(heap, fs, dir, id, "input2.png") {
        p = figure(heap, p, id, "input2.png", "the second picture", "Picture 2");
        n = n + 1;
    } else if has_upload(heap, fs, dir, id, "input2.webp") {
        p = figure(heap, p, id, "input2.webp", "the second picture", "Picture 2");
        n = n + 1;
    }
    return (p, n);
}

// The number of digits at `from` in `line` and where they end: (n, end). No digit: (0, from).
fn nat_at[&l](line: &l [byte], from: int) -> [] (int, int) {
    var n = 0;
    var i = from;
    while i < len(line) && int_of(line[i]) >= 48 && int_of(line[i]) <= 57 && i < from + 9 {
        n = n * 10 + (int_of(line[i]) - 48);
        i = i + 1;
    }
    return (n, i);
}

// What a running job's log says about where it is: (the last stage, steps done, steps in all). The stage is the last line `== name` or `== name: N s` (the name); the steps are the last `step i: ...` of a run that
// said `steps N, ...` first (the drivers of an edit and of a picture; i counts from 0) or the last `step i of N: ...` (the video sampler). A log with no such line is ("", 0, 0).
fn log_progress[&h, &l](heap: &!h Heap, log: &l [byte]) -> [heap] (buffer.Buffer, int, int) {
    var label = buffer.empty(heap, 32);
    var done = 0;
    var total = 0;
    var i = 0;
    while i < len(log) {
        var e = i;
        while e < len(log) && int_of(log[e]) != 10 {
            e = e + 1;
        }
        let line = log[i..e];
        if bytes.starts_with(line, "== ") {
            var stop = 3;
            while stop < len(line) && int_of(line[stop]) != 58 {
                stop = stop + 1;
            }
            buffer.drop(heap, label);
            label = buffer.append(heap, buffer.empty(heap, 32), line[3..stop]);
        } else if bytes.starts_with(line, "steps ") {
            let (n, after) = nat_at(line, 6);
            total = n;
            done = 0;
        } else if bytes.starts_with(line, "step ") {
            let (a, p) = nat_at(line, 5);
            if p < len(line) && int_of(line[p]) == 58 {
                done = a + 1;
            } else if bytes.starts_with(line[p..len(line)], " of ") {
                let (b, after2) = nat_at(line, p + 4);
                done = a;
                total = b;
            }
        }
        i = e + 1;
    }
    return (label, done, total);
}

// `GET /jobs`: the jobs in `queue`, newest first (the 200 last), each a link to its page and its state.
// `embed` is the version the main page shows in a frame (`GET /recent`): no header, the 12 newest, it refreshes itself, and a card opens in the whole window.
pub fn job_list[&h, &f, &d](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], embed: bool) -> [heap, fs_read(""), file_read] buffer.Buffer {
    var running_any = false;
    let (nrun, nq) = counts(heap, fs, dir);
    running_any = nrun + nq > 0;
    var page = buffer.empty(heap, 2048);
    var cap = 200;
    if embed {
        cap = 12;
        page = buffer.append(heap, page, "<!doctype html><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><link rel=stylesheet href=/style.css><meta http-equiv=refresh content=5><base target=_top><title>cancho-studio: recent jobs</title><body class=embed><div class=grid>");
    } else {
        buffer.drop(heap, page);
        page = open(heap, fs, dir, "jobs", "jobs", running_any);
        page = buffer.append(heap, page, "<div class=row><h1>Jobs</h1><span class=meta>Newest first &middot; refreshes while a job is queued or running</span></div><div class=grid>");
    }
    var text = buffer.empty(heap, 8);
    let qp = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), dir), "/queue");
    borrow qp as &q in {
        let (b, e) = files.read_all(heap, fs, buffer.bytes(q));
        buffer.drop(heap, text);
        text = b;
    }
    buffer.drop(heap, qp);
    var shown = 0;
    borrow text as &tb in {
        let all = buffer.bytes(tb);
        var end = len(all);
        while end > 0 && shown < cap {
            var stop = end;
            while stop > 0 && int_of(all[stop - 1]) == 10 {
                stop = stop - 1;
            }
            if stop == 0 {
                end = 0;
            } else {
                var start = stop;
                while start > 0 && int_of(all[start - 1]) != 10 {
                    start = start - 1;
                }
                let id = all[start..stop];
                if id_ok(id) {
                    let (known, word) = state_word(heap, fs, dir, id);
                    if known {
                        // the state's first word is the badge's class
                        var cls = "";
                        var is_done = false;
                        var is_failed = false;
                        var is_running = false;
                        borrow word as &wb in {
                            if bytes.starts_with(buffer.bytes(wb), "running") {
                                cls = "running";
                                is_running = true;
                            } else if bytes.starts_with(buffer.bytes(wb), "queued") {
                                cls = "queued";
                            } else if bytes.starts_with(buffer.bytes(wb), "done") {
                                cls = "done";
                                is_done = true;
                            } else {
                                cls = "failed";
                                is_failed = true;
                            }
                        }
                        page = buffer.append(heap, page, "<a class=\"job ");
                        page = buffer.append(heap, page, cls);
                        page = buffer.append(heap, page, "\" href=/jobs/");
                        page = buffer.append(heap, page, id);
                        page = buffer.append(heap, page, "><div class=thumb>");
                        // a picture of a finished edit is its own thumbnail (the server cannot shrink one), for the newest 24 only; a video has none
                        if is_done && shown < 24 && has_out(heap, fs, dir, id, "edited.png") {
                            page = buffer.append(heap, page, "<img alt=\"\" loading=lazy src=/files/");
                            page = buffer.append(heap, page, id);
                            page = buffer.append(heap, page, "/edited.png>");
                        } else if is_done && shown < 24 && has_out(heap, fs, dir, id, "image.png") {
                            page = buffer.append(heap, page, "<img alt=\"\" loading=lazy src=/files/");
                            page = buffer.append(heap, page, id);
                            page = buffer.append(heap, page, "/image.png>");
                        } else if is_done && shown < 24 && has_out(heap, fs, dir, id, "video.mp4") {
                            // the first frame of the clip: the browser draws it from the metadata and the first bytes (the file is served in ranges)
                            page = buffer.append(heap, page, "<video muted playsinline preload=metadata src=/files/");
                            page = buffer.append(heap, page, id);
                            page = buffer.append(heap, page, "/video.mp4#t=0.1></video>");
                        } else if is_done {
                            page = buffer.append(heap, page, "result");
                        } else if is_failed {
                            page = buffer.append(heap, page, "no result");
                        } else if is_running {
                            page = buffer.append(heap, page, "working");
                        } else {
                            page = buffer.append(heap, page, "in the queue");
                        }
                        page = buffer.append(heap, page, "<span class=\"badge ");
                        page = buffer.append(heap, page, cls);
                        page = buffer.append(heap, page, "\">");
                        borrow word as &wb2 in {
                            page = escape(heap, page, buffer.bytes(wb2));
                        }
                        page = buffer.append(heap, page, "</span><span class=idn>#");
                        page = buffer.append(heap, page, id);
                        page = buffer.append(heap, page, "</span></div>");
                        var stage = buffer.empty(heap, 8);
                        var sdone = 0;
                        var stotal = 0;
                        if is_running {
                            let (lg, has_lg) = job_file(heap, fs, dir, id, ".log");
                            if has_lg {
                                borrow lg as &lgr in {
                                    let (lab, d1, t1) = log_progress(heap, buffer.bytes(lgr));
                                    buffer.drop(heap, stage);
                                    stage = lab;
                                    sdone = d1;
                                    stotal = t1;
                                }
                            }
                            buffer.drop(heap, lg);
                            if stotal > 0 && sdone <= stotal {
                                page = buffer.append(heap, page, "<div class=bar><i class=det style=\"width:");
                                page = buffer.push_nat(heap, page, sdone * 100 / stotal);
                                page = buffer.append(heap, page, "%\"></i></div>");
                            } else {
                                page = buffer.append(heap, page, "<div class=bar><i></i></div>");
                            }
                        }
                        page = buffer.append(heap, page, "<div class=body><span class=prompt>");
                        let (av, has_av) = job_file(heap, fs, dir, id, ".argv");
                        if has_av {
                            borrow av as &avr in {
                                let (ps, pe) = last_entry(buffer.bytes(avr));
                                page = escape(heap, page, buffer.bytes(avr)[ps..pe]);
                            }
                        }
                        page = buffer.append(heap, page, "</span><span class=meta>");
                        if has_av {
                            borrow av as &avr2 in {
                                var e0 = 0;
                                while e0 < len(buffer.bytes(avr2)) && int_of(buffer.bytes(avr2)[e0]) != 0 {
                                    e0 = e0 + 1;
                                }
                                page = escape(heap, page, buffer.bytes(avr2)[0..e0]);
                            }
                        }
                        buffer.drop(heap, av);
                        borrow stage as &stg in {
                            if len(buffer.bytes(stg)) > 0 {
                                page = buffer.append(heap, page, " &middot; ");
                                page = escape(heap, page, buffer.bytes(stg));
                            }
                        }
                        if stotal > 0 && sdone <= stotal {
                            page = buffer.append(heap, page, " &middot; step ");
                            page = buffer.push_nat(heap, page, sdone);
                            page = buffer.append(heap, page, " of ");
                            page = buffer.push_nat(heap, page, stotal);
                        }
                        buffer.drop(heap, stage);
                        page = buffer.append(heap, page, "</span></div></a>");
                        shown = shown + 1;
                    }
                    buffer.drop(heap, word);
                }
                end = start;
            }
        }
    }
    buffer.drop(heap, text);
    if embed {
        return buffer.append(heap, page, "</div>");
    }
    return close(heap, buffer.append(heap, page, "</div>"));
}

// `text` as the inside of a JSON string: a quote and a backslash are escaped, a control character becomes a space.
fn jstr[&h, &t](heap: &!h Heap, b: buffer.Buffer, text: &t [byte]) -> [heap] buffer.Buffer {
    var out = b;
    var from = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 32 || c == 34 || c == 92 {
            out = buffer.append(heap, out, text[from..i]);
            if c == 34 {
                out = buffer.append(heap, out, "\\\"");
            } else if c == 92 {
                out = buffer.append(heap, out, "\\\\");
            } else {
                out = buffer.append(heap, out, " ");
            }
            from = i + 1;
        }
        i = i + 1;
    }
    return buffer.append(heap, out, text[from..len(text)]);
}

// `GET /api/jobs`: {"running":R,"queued":Q,"jobs":[{"id":N,"state":"...","kind":"...","prompt":"..."}, ...]}, the 50 newest jobs of `queue`, newest first.
// `kind` is the first entry of the job's argument list (the `media` subcommand), `prompt` the last (as written).
pub fn api_list[&h, &f, &d](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte]) -> [heap, fs_read(""), file_read] buffer.Buffer {
    let (nrun, nq) = counts(heap, fs, dir);
    var out = buffer.append(heap, buffer.empty(heap, 256), "{\"running\":");
    out = buffer.push_nat(heap, out, nrun);
    out = buffer.append(heap, out, ",\"queued\":");
    out = buffer.push_nat(heap, out, nq);
    out = buffer.append(heap, out, ",\"jobs\":[");
    var text = buffer.empty(heap, 8);
    let qp = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), dir), "/queue");
    borrow qp as &q in {
        let (b, e) = files.read_all(heap, fs, buffer.bytes(q));
        buffer.drop(heap, text);
        text = b;
    }
    buffer.drop(heap, qp);
    var shown = 0;
    borrow text as &tb in {
        let all = buffer.bytes(tb);
        var end = len(all);
        while end > 0 && shown < 50 {
            var stop = end;
            while stop > 0 && int_of(all[stop - 1]) == 10 {
                stop = stop - 1;
            }
            if stop == 0 {
                end = 0;
            } else {
                var start = stop;
                while start > 0 && int_of(all[start - 1]) != 10 {
                    start = start - 1;
                }
                let id = all[start..stop];
                if id_ok(id) {
                    let (known, word) = state_word(heap, fs, dir, id);
                    if known {
                        if shown > 0 {
                            out = buffer.append(heap, out, ",");
                        }
                        out = buffer.append(heap, out, "{\"id\":");
                        out = buffer.append(heap, out, id);
                        out = buffer.append(heap, out, ",\"state\":\"");
                        borrow word as &wb in {
                            out = jstr(heap, out, buffer.bytes(wb));
                        }
                        out = buffer.append(heap, out, "\",\"kind\":\"");
                        let (av, has_av) = job_file(heap, fs, dir, id, ".argv");
                        if has_av {
                            borrow av as &avr in {
                                var e0 = 0;
                                while e0 < len(buffer.bytes(avr)) && int_of(buffer.bytes(avr)[e0]) != 0 {
                                    e0 = e0 + 1;
                                }
                                out = jstr(heap, out, buffer.bytes(avr)[0..e0]);
                            }
                        }
                        out = buffer.append(heap, out, "\",\"prompt\":\"");
                        if has_av {
                            borrow av as &avr2 in {
                                let (ps, pe) = last_entry(buffer.bytes(avr2));
                                out = jstr(heap, out, buffer.bytes(avr2)[ps..pe]);
                            }
                        }
                        buffer.drop(heap, av);
                        out = buffer.append(heap, out, "\"}");
                        shown = shown + 1;
                    }
                    buffer.drop(heap, word);
                }
                end = start;
            }
        }
    }
    buffer.drop(heap, text);
    return buffer.append(heap, out, "]}");
}

// A file of the site directory (the page `cancho-ui build --page` wrote): 200 and its bytes, or 404. `name` is one of the server's own literals, never the client's.
pub fn site_file[&h, &f, &s, &n](heap: &!h Heap, fs: &f Fs(""), site: &s [byte], name: &n [byte]) -> [heap, fs_read(""), file_read] (int, buffer.Buffer) {
    var p = buffer.append(heap, buffer.empty(heap, 64), site);
    p = buffer.append(heap, p, "/");
    p = buffer.append(heap, p, name);
    var status = 200;
    var data = buffer.empty(heap, 8);
    borrow p as &pb in {
        let (b, e) = files.read_all(heap, fs, buffer.bytes(pb));
        buffer.drop(heap, data);
        data = b;
        if e != 0 {
            status = 404;
        }
    }
    buffer.drop(heap, p);
    return (status, data);
}

// The media type for a name of the closed list, or "" for a name that is not on it.
// The one stylesheet of the pages the server writes (`GET /style.css`): a system font, a card for each result, light and dark by the browser's setting, no script, no outside file.
pub fn css() -> [] &static [byte] {
    return ":root{color-scheme:dark;--bg:#121314;--surface:#1B1D1F;--raised:#24272A;--line:#2A2D30;--line2:#3A3E42;--line3:#4A4F54;--fg:#ECEAE4;--muted:#B5B2A9;--accent:#F2B544;--accent2:#FFD27A;--err:#FFB4A0;--ink:#141413;--mono:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,monospace}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.45 'IBM Plex Sans',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}a{color:var(--accent);text-decoration:none}a:hover{color:var(--accent2)}header.top{display:flex;flex-wrap:wrap;align-items:center;gap:8px 32px;padding:14px 32px;border-bottom:1px solid var(--line)}.brand{font:500 16px var(--mono);color:var(--fg)}.brand:hover{color:var(--fg)}nav{display:flex;flex-wrap:wrap;gap:4px;flex-grow:1}nav a{padding:12px 14px;border-radius:8px;color:var(--muted)}nav a[aria-current=page]{background:var(--raised);color:var(--fg);font-weight:500}.status{display:flex;align-items:center;gap:8px;font:13px var(--mono);color:var(--muted)}.dot{width:8px;height:8px;border-radius:50%;background:var(--line3)}.busy .dot{background:var(--accent)}main{max-width:1216px;margin:0 auto;padding:28px 32px 48px;display:flex;flex-direction:column;gap:20px}h1{margin:0;font-size:22px;font-weight:600}h2{margin:0 0 6px;font-size:13px;font-weight:500;color:var(--muted)}p{margin:0;color:var(--muted)}b{color:var(--fg)}.row{display:flex;flex-wrap:wrap;align-items:center;gap:12px}.row h1{flex-grow:1}.pill{padding:4px 12px;border-radius:999px;border:1px solid var(--line2);font:13px var(--mono);color:var(--fg)}img,video{display:block;max-width:100%;height:auto;border-radius:12px;border:1px solid var(--line)}.card,form,.cell{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 20px}.cell{padding:16px}.cell h2 a{color:var(--fg)}.cell h2{font-size:15px;color:var(--fg)}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}.job{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden;color:var(--fg)}.job:hover{color:var(--fg);border-color:var(--line3)}.job.running{border-color:var(--accent)}.thumb{position:relative;aspect-ratio:16/9;background:#202326;display:flex;align-items:center;justify-content:center;font:12px var(--mono);color:var(--muted)}.thumb img,.thumb video{width:100%;height:100%;object-fit:cover;border:0;border-radius:0}.badge{position:absolute;top:10px;left:10px;padding:3px 9px;border-radius:999px;font:500 12px var(--mono);background:var(--line2);color:var(--fg)}.badge.running{background:var(--accent);color:var(--ink)}.badge.failed{background:var(--err);color:var(--ink)}.badge.done{background:var(--bg)}.idn{position:absolute;top:10px;right:10px;font:12px var(--mono);color:var(--muted)}.bar{height:4px;background:var(--line);overflow:hidden}.bar i{display:block;height:4px;width:40%;background:var(--accent);animation:slide 1.6s ease-in-out infinite}@keyframes slide{0%{margin-left:-40%}100%{margin-left:100%}}@media(prefers-reduced-motion:reduce){.bar i{animation:none;width:100%}}.body{padding:12px 14px 14px;display:flex;flex-direction:column;gap:6px}.prompt{font-weight:500;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.meta{font:12px var(--mono);color:var(--muted)}.split{display:flex;flex-wrap:wrap;gap:24px;align-items:flex-start}.split>.main{flex:999 1 560px;min-width:0;padding:0;display:flex;flex-direction:column;gap:12px}.side{flex:1 1 320px;min-width:0;display:flex;flex-direction:column;gap:16px}.card p{color:var(--fg);font-size:16px}.acts{display:flex;flex-wrap:wrap;gap:8px}.btn{min-height:44px;padding:0 16px;border:1px solid var(--line2);border-radius:8px;color:var(--fg);display:inline-flex;align-items:center}.btn:hover{color:var(--fg);border-color:var(--line3)}dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:8px 16px;font:13px var(--mono)}dt{color:var(--muted)}dd{margin:0}ul{margin:0;padding:0;list-style:none;font:13px var(--mono)}li{padding:12px 0;border-bottom:1px solid var(--line)}li:last-child{border:0}.alert{border:1px solid var(--err);color:var(--err);border-radius:10px;padding:12px 14px}form{display:flex;flex-direction:column;gap:16px;max-width:44rem}label{display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--muted)}input,select,textarea,button{font:inherit;color:inherit}input:not([type=file]),select,textarea{min-height:44px;padding:0 12px;border:1px solid var(--line2);border-radius:8px;background:var(--bg);width:100%}input[type=file]{padding:24px;border:2px dashed var(--line3);border-radius:14px;background:var(--surface);width:100%;color:var(--muted)}button{min-height:48px;padding:0 28px;border:0;border-radius:10px;background:var(--accent);color:var(--ink);font-weight:600;cursor:pointer}button:hover{background:var(--accent2)}.choices{display:flex;flex-wrap:wrap;justify-content:center;gap:12px}.choices button{min-width:180px;background:var(--surface);color:var(--fg);border:1px solid var(--line2)}.choices button:hover{border-color:var(--accent);background:var(--surface)}form.choices{background:none;border:0;padding:0;max-width:none;flex-direction:row;align-items:center;justify-content:center}code{font-family:var(--mono)}#root{max-width:48rem;margin:0 auto;padding:28px 0 48px}#root>.cui-col{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px 24px;gap:16px}#root h1{font-size:22px;margin:0 0 4px}#root .cui-field{font-size:13px;color:var(--muted);display:flex;flex-direction:column;gap:6px;flex:0 0 auto}#root .cui-field input:not([type=checkbox]):not([type=file]):not([type=range]),#root .cui-field select,#root .cui-field textarea{min-height:44px;padding:0 12px;border:1px solid var(--line2);border-radius:8px;background:var(--bg);color:var(--fg);font-size:15px;width:100%;box-shadow:none}#root .cui-field input:disabled,#root .cui-field select:disabled{opacity:.4}#root .cui-field input:focus-visible,#root .cui-field select:focus-visible{outline:2px solid var(--accent);outline-offset:1px}#root button:disabled{opacity:.4;cursor:not-allowed;background:var(--line2);color:var(--muted)}#root span{color:var(--muted)}.bar i.det{animation:none;margin:0;transition:width .6s}body.embed{padding:0;background:var(--bg)}iframe.recent{display:block;width:100%;max-width:1216px;height:760px;margin:0 auto 32px;border:0}#root [role=status]{color:var(--fg)}@media(max-width:600px){header.top{padding:12px 16px}nav a{padding:10px 12px}main{padding:20px 16px 40px}#root{padding:20px 16px 32px}#root>.cui-col{padding:16px}.grid{grid-template-columns:1fr}iframe.recent{height:900px;padding:0 16px}.split>.main{flex-basis:100%}}.trio{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:16px}.trio figure{margin:0}.trio img{display:block;width:100%;height:auto;border-radius:8px;border:1px solid var(--line)}.trio figcaption{color:var(--muted);font-size:13px;margin-top:6px}.badge.uploaded{background:var(--line2)}.badge.generated{background:var(--accent2);color:var(--ink)}.badge.edited{background:var(--accent);color:var(--ink)}.thumb{overflow:hidden}label input[type=radio],label input[type=checkbox]{width:auto;min-height:0;accent-color:var(--accent)}.tabs{display:flex;gap:4px;padding:0 32px;border-bottom:1px solid var(--line);overflow-x:auto}.tabs a{padding:12px 14px;color:var(--muted);border-bottom:2px solid transparent;white-space:nowrap}.tabs a:hover{color:var(--fg)}.tabs a[aria-current=page]{color:var(--fg);font-weight:500;border-bottom-color:var(--accent)}@media(max-width:600px){.tabs{padding:0 16px}}";
}

pub fn content_type[&n](name: &n [byte]) -> [] &static [byte] {
    if bytes.equal(name, "edited.png") || bytes.equal(name, "image.png") {
        return "image/png";
    }
    if bytes.equal(name, "input1.jpg") || bytes.equal(name, "input2.jpg") {
        return "image/jpeg";
    }
    if bytes.equal(name, "input1.png") || bytes.equal(name, "input2.png") {
        return "image/png";
    }
    if bytes.equal(name, "input1.webp") || bytes.equal(name, "input2.webp") {
        return "image/webp";
    }
    if bytes.equal(name, "video.mp4") {
        return "video/mp4";
    }
    if bytes.equal(name, "video.gif") {
        return "image/gif";
    }
    if bytes.equal(name, "log") {
        return "text/plain; charset=utf-8";
    }
    return "";
}

// `rest` is the text after `/files/`: `N/NAME`. Answers (status, path, size): 200 with the file's path (to be read in pieces, never whole) and its size; 404 if the name is not on the list or the file is not
// there; 422 for an id that is not digits. The path is empty unless the status is 200.
pub fn file_info[&h, &f, &d, &r](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], rest: &r [byte]) -> [heap, fs_read(""), file_read] (int, buffer.Buffer, int) {
    var cut = 0;
    while cut < len(rest) && int_of(rest[cut]) != 47 {
        cut = cut + 1;
    }
    if cut >= len(rest) {
        return (404, buffer.empty(heap, 8), 0 - 1);
    }
    let id = rest[0..cut];
    let name = rest[cut + 1..len(rest)];
    if id_ok(id) == false {
        return (422, buffer.empty(heap, 8), 0 - 1);
    }
    if len(content_type(name)) == 0 {
        return (404, buffer.empty(heap, 8), 0 - 1);
    }
    var path = out_path(heap, dir, id, name);
    if len(upload_tail(name)) > 0 {
        buffer.drop(heap, path);
        path = upload_path(heap, dir, id, upload_tail(name));
    }
    if bytes.equal(name, "log") {
        buffer.drop(heap, path);
        path = job_path(heap, dir, id, ".log");
    }
    var size = 0 - 1;
    borrow path as &pb in {
        size = files.size_of(fs, buffer.bytes(pb));
    }
    if size < 0 {
        buffer.drop(heap, path);
        return (404, buffer.empty(heap, 8), 0 - 1);
    }
    return (200, path, size);
}

edition 9;

module upload;

import std.buffer;
import std.bytes;
import files;
import jobs;
import results;

// `upload` -- a picture chosen in the browser, for an edit (docs/studio.md, "Editing a picture chosen in the page").
//
//   GET  /edit    a form the server writes: the instruction, a seed, a file; no JavaScript
//   POST /edit    `multipart/form-data` with the parts `prompt`, `seed` (optional) and `image`; the picture is kept as `<data>/upload-N.<jpg|png|webp>`, a job is made as `POST /api/jobs` would
//                 make it (`jobs.create`, so the same refusals) and the answer is `302 /jobs/N`
//
// The whole body is in memory: the server's input buffer is 16 MiB (`server.open`), a bigger request is a 413 from the package. A part is found by its header (`name="..."`), never by position, and its
// content ends at the next delimiter. Nothing from the client is a path: the file name the browser sends is not read, and the name kept is built from a number the server made and an extension chosen
// by the picture's first bytes (JPEG, PNG or WebP; anything else is refused, whatever its name or `Content-Type` says).

// The value of the option `flag` in a job's argument list (NUL-separated, up to its `--`): (from, to), or (-1, -1).
fn flag_value[&a, &g](argv: &a [byte], flag: &g [byte]) -> [] (int, int) {
    var i = 0;
    while i < len(argv) {
        var j = i;
        while j < len(argv) && int_of(argv[j]) != 0 {
            j = j + 1;
        }
        if bytes.equal(argv[i..j], "--") {
            return (0 - 1, 0 - 1);
        }
        if bytes.equal(argv[i..j], flag) && j + 1 < len(argv) {
            var k = j + 1;
            while k < len(argv) && int_of(argv[k]) != 0 {
                k = k + 1;
            }
            return (j + 1, k);
        }
        i = j + 1;
    }
    return (0 - 1, 0 - 1);
}

// The name of the picture a finished job made, "edited.png" or "image.png", or "" for none (not done, failed, a video, or the file is gone).
pub fn result_name[&h, &f, &d, &i](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte]) -> [heap, fs_read(""), file_read] &static [byte] {
    if results.id_ok(id) == false {
        return "";
    }
    let (known, state) = results.state_word(heap, fs, dir, id);
    var done = false;
    borrow state as &sb in {
        done = bytes.equal(buffer.bytes(sb), "done");
    }
    buffer.drop(heap, state);
    if known == false || done == false {
        return "";
    }
    if results.has_out(heap, fs, dir, id, "edited.png") {
        return "edited.png";
    }
    if results.has_out(heap, fs, dir, id, "image.png") {
        return "image.png";
    }
    return "";
}

// `GET /edit`, `GET /edit?from=N` (refine the result of job N: its picture is the first picture) and `GET /edit?again=N` (the prompt, seed, steps and model of job N filled in; a picture is still asked for).
pub fn form_page[&h, &f, &d, &s, &a](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], from: &s [byte], again: &a [byte]) -> [heap, fs_read(""), file_read] buffer.Buffer {
    let rname = result_name(heap, fs, dir, from);
    var page = results.open(heap, fs, dir, "edit a picture", "edit", false);
    page = buffer.append(heap, page, "<div class=row><h1>Edit a picture</h1></div><p>The picture stays on this machine. It is copied to the studio's data directory and nowhere else.</p><form method=post action=/edit enctype=multipart/form-data>");
    if len(rname) > 0 {
        page = buffer.append(heap, page, "<figure><img alt=\"the picture to refine\" src=/files/");
        page = buffer.append(heap, page, from);
        page = buffer.append(heap, page, "/");
        page = buffer.append(heap, page, rname);
        page = buffer.append(heap, page, "><figcaption>The result of job ");
        page = buffer.append(heap, page, from);
        page = buffer.append(heap, page, " is the first picture. Say what to change in it.</figcaption></figure><input type=hidden name=from value=");
        page = buffer.append(heap, page, from);
        page = buffer.append(heap, page, ">");
    } else {
        page = buffer.append(heap, page, "<label>Picture (JPEG, PNG or WebP, up to 15 MB)<input name=image type=file accept=image/jpeg,image/png,image/webp required></label>");
    }
    page = buffer.append(heap, page, "<label>Second picture (optional: combine it with the first; the instruction can refer to both)<input name=image2 type=file accept=image/jpeg,image/png,image/webp></label><label>Size of each picture when combining (pixels; 589824 = 768 x 768, the default; 1048576 = 1024 x 1024 is the largest measured)<select name=condition_area><option value=589824>589824<option value=262144>262144<option value=1048576>1048576</select></label>");
    // what to fill in, from the argument list of job `again` (a job the server made: the file is its own)
    var pid = again;
    if len(rname) > 0 || results.id_ok(again) == false {
        pid = "";
    }
    let (av, has_av) = results.job_file(heap, fs, dir, pid, ".argv");
    let (orig, has_orig) = results.job_file(heap, fs, dir, pid, ".prompt.orig");
    page = buffer.append(heap, page, "<label>What to change<textarea name=prompt required maxlength=1000 rows=3>");
    if has_orig {
        borrow orig as &obr in {
            page = results.escape(heap, page, buffer.bytes(obr));
        }
    } else if has_av {
        borrow av as &avr in {
            let (ps, pe) = results.last_entry(buffer.bytes(avr));
            page = results.escape(heap, page, buffer.bytes(avr)[ps..pe]);
        }
    }
    page = buffer.append(heap, page, "</textarea></label><label>Seed (optional)<input name=seed type=number min=0 max=2147483647");
    if has_av {
        borrow av as &avs in {
            let (sf, st) = flag_value(buffer.bytes(avs), "--seed");
            if sf >= 0 && all_digits(buffer.bytes(avs)[sf..st]) {
                page = buffer.append(heap, page, " value=");
                page = buffer.append(heap, page, buffer.bytes(avs)[sf..st]);
            }
        }
    }
    page = buffer.append(heap, page, "></label><label>Variations (the same edit with this many seeds, shown together; each takes as long as one edit)<select name=variations><option value=1>1<option>2<option>3<option>4<option>5<option>6<option>7<option>8</select></label>");
    page = buffer.append(heap, page, "<label>Steps (optional; the model's default is 8)<input name=steps type=number min=1 max=50");
    if has_av {
        borrow av as &avt in {
            let (tf, tt) = flag_value(buffer.bytes(avt), "--steps");
            if tf >= 0 && all_digits(buffer.bytes(avt)[tf..tt]) {
                page = buffer.append(heap, page, " value=");
                page = buffer.append(heap, page, buffer.bytes(avt)[tf..tt]);
            }
        }
    }
    page = buffer.append(heap, page, "></label><label>Model (optional; see /api/models)<input name=model maxlength=40");
    if has_av {
        borrow av as &avm in {
            let (mf, mt) = flag_value(buffer.bytes(avm), "--model");
            if mf >= 0 && no_controls(buffer.bytes(avm)[mf..mt]) {
                page = buffer.append(heap, page, " value=\"");
                page = results.escape(heap, page, buffer.bytes(avm)[mf..mt]);
                page = buffer.append(heap, page, "\"");
            }
        }
    }
    page = buffer.append(heap, page, "></label><label>Rewrite the prompt first (a local model; see docs/studio-rewrite.md)<select name=rewrite><option value=off>off<option value=on>on<option value=ab>ab (run both and compare blind)</select></label><div><button>Edit</button></div></form>");
    buffer.drop(heap, av);
    buffer.drop(heap, orig);
    return results.close(heap, page);
}

// (from, to) of the boundary in a `Content-Type` value, or (-1, -1) for none, an empty one or one over 70 bytes.
fn boundary_of[&t](ctype: &t [byte]) -> [] (int, int) {
    let at = bytes.find(ctype, "boundary=");
    if at < 0 {
        return (0 - 1, 0 - 1);
    }
    var from = at + 9;
    var stop = 59;
    if from < len(ctype) && int_of(ctype[from]) == 34 {
        from = from + 1;
        stop = 34;
    }
    var to = from;
    while to < len(ctype) && int_of(ctype[to]) != stop {
        to = to + 1;
    }
    if to - from < 1 || to - from > 70 {
        return (0 - 1, 0 - 1);
    }
    return (from, to);
}

// Is `name="<want>"` the field name in this part header? (`filename="..."` also contains `name="`: it counts only after a space or a semicolon.)
fn named[&t, &w](header: &t [byte], want: &w [byte]) -> [] bool {
    var at = 0;
    while at < len(header) {
        let k = bytes.find(header[at..len(header)], "name=\"");
        if k < 0 {
            return false;
        }
        let pos = at + k;
        if pos > 0 && (int_of(header[pos - 1]) == 32 || int_of(header[pos - 1]) == 59) {
            var end = pos + 6;
            while end < len(header) && int_of(header[end]) != 34 {
                end = end + 1;
            }
            if end < len(header) && bytes.equal(header[pos + 6..end], want) {
                return true;
            }
        }
        at = pos + 6;
    }
    return false;
}

// The content of the part named `want`: (from, to), or (-1, -1) if there is none or the body is not well formed. `delim` is `--<boundary>`.
fn part[&b, &d, &w](body: &b [byte], delim: &d [byte], want: &w [byte]) -> [] (int, int) {
    var at = 0;
    while at < len(body) {
        let p = bytes.find(body[at..len(body)], delim);
        if p < 0 {
            return (0 - 1, 0 - 1);
        }
        let start = at + p + len(delim);
        if start + 2 > len(body) {
            return (0 - 1, 0 - 1);
        }
        if int_of(body[start]) == 45 && int_of(body[start + 1]) == 45 {
            return (0 - 1, 0 - 1);
        }
        let hs = start + 2;
        let he = bytes.find(body[hs..len(body)], "\r\n\r\n");
        if he < 0 {
            return (0 - 1, 0 - 1);
        }
        let cs = hs + he + 4;
        let nx = bytes.find(body[cs..len(body)], delim);
        if nx < 2 {
            return (0 - 1, 0 - 1);
        }
        let ce = cs + nx - 2;
        if named(body[hs..hs + he], want) {
            return (cs, ce);
        }
        at = cs + nx;
    }
    return (0 - 1, 0 - 1);
}

// 1 JPEG, 2 PNG, 3 WebP, 0 neither: by the first bytes.
fn kind_of[&t](head: &t [byte]) -> [] int {
    if len(head) >= 3 && int_of(head[0]) == 255 && int_of(head[1]) == 216 && int_of(head[2]) == 255 {
        return 1;
    }
    if len(head) >= 4 && int_of(head[0]) == 137 && int_of(head[1]) == 80 && int_of(head[2]) == 78 && int_of(head[3]) == 71 {
        return 2;
    }
    if len(head) >= 12 && bytes.equal(head[0..4], "RIFF") && bytes.equal(head[8..12], "WEBP") {
        return 3;
    }
    return 0;
}

// `text` as the inside of a JSON string: a quote or a backslash is escaped, nothing else changes (control characters were refused before).
fn quoted[&h, &t](heap: &!h Heap, b: buffer.Buffer, text: &t [byte]) -> [heap] buffer.Buffer {
    var out = b;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c == 34 || c == 92 {
            out = buffer.push(heap, out, byte_of(92));
        }
        out = buffer.push(heap, out, byte_of(c));
        i = i + 1;
    }
    return out;
}

fn no_controls[&t](text: &t [byte]) -> [] bool {
    var i = 0;
    while i < len(text) {
        if int_of(text[i]) < 32 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn all_digits[&t](text: &t [byte]) -> [] bool {
    if len(text) == 0 || len(text) > 10 {
        return false;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return false;
        }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n <= 2147483647;
}

// The id in `{"id":N}`, or 0.
fn id_in[&t](answer: &t [byte]) -> [] int {
    var n = 0;
    var i = 6;
    while i < len(answer) && int_of(answer[i]) >= 48 && int_of(answer[i]) <= 57 {
        n = n * 10 + (int_of(answer[i]) - 48);
        i = i + 1;
    }
    return n;
}

// Handle a POST /edit. (status, text, id): 302 with the job's id and an empty text (or the text `pair` when the job was made as a pair: the person is sent to /compare/N), or the status `jobs.create` or this function refuses with and a one-line JSON `{"error": ..}`.
// The ids a request made, other than the first: the rest of `<first>.set`'s first line, or the second id of `<first>.pair`.
fn other_ids[&h, &f, &d](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], first: int, set: bool, pair: bool) -> [heap, fs_read(""), file_read] buffer.Buffer {
    var path = buffer.append(heap, buffer.empty(heap, 96), dir);
    path = buffer.append(heap, path, "/");
    path = buffer.push_nat(heap, path, first);
    if set {
        path = buffer.append(heap, path, ".set");
    } else {
        path = buffer.append(heap, path, ".pair");
    }
    var ids = buffer.empty(heap, 16);
    if set || pair {
        var text = buffer.empty(heap, 8);
        var ok = 0 - 1;
        borrow path as &pb in {
            let (t, r) = files.read_all(heap, fs, buffer.bytes(pb));
            buffer.drop(heap, text);
            text = t;
            ok = r;
        }
        if ok == 0 {
            borrow text as &tb in {
                let all = buffer.bytes(tb);
                var end = 0;
                while end < len(all) && int_of(all[end]) != 10 {
                    end = end + 1;
                }
                var k = 0;
                var first_tok = true;
                while k < end {
                    var e = k;
                    while e < end && int_of(all[e]) != 32 {
                        e = e + 1;
                    }
                    // a set lists every id (the first among them); a pair's file starts with the second id and ends with the flip bit
                    if e > k && all_digits(all[k..e]) && (set || first_tok) {
                        ids = buffer.append(heap, ids, all[k..e]);
                        ids = buffer.push(heap, ids, byte_of(32));
                    }
                    first_tok = false;
                    k = e + 1;
                }
            }
        }
        buffer.drop(heap, text);
    }
    buffer.drop(heap, path);
    return ids;
}

// Write `<id>.root` and `<id>.from` (docs/studio-sessions.md): the session the job belongs to and where its pictures came from. Best effort in order (root last): a job with no `.root` is its own session.
fn id_file[&h, &d, &n, &x](heap: &!h Heap, dir: &d [byte], id: &n [byte], ext: &x [byte]) -> [heap] buffer.Buffer {
    var p = buffer.append(heap, buffer.empty(heap, 96), dir);
    p = buffer.append(heap, p, "/");
    p = buffer.append(heap, p, id);
    return buffer.append(heap, p, ext);
}

fn record_one[&h, &f, &d, &n, &r, &x](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &n [byte], root: &r [byte], inputs: &x [byte]) -> [heap, fs_write(""), file_write] int {
    let pf = id_file(heap, dir, id, ".from");
    let pr = id_file(heap, dir, id, ".root");
    var rc = 0;
    borrow pf as &pfb in {
        rc = files.write_all(fs, buffer.bytes(pfb), inputs);
    }
    if rc == 0 {
        borrow pr as &prb in {
            rc = files.write_all(fs, buffer.bytes(prb), root);
        }
    }
    buffer.drop(heap, pf);
    buffer.drop(heap, pr);
    return rc;
}

pub fn handle[&h, &f, &d, &c, &b](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], ctype: &c [byte], body: &b [byte], rewrite_default: bool) -> [heap, fs_read(""), fs_write(""), file_read, file_write] (int, buffer.Buffer, int) {
    var status = 422;
    var why = "a multipart/form-data body with a boundary is needed";
    var answer = buffer.empty(heap, 8);
    var made = 0;
    let (bf, bt) = boundary_of(ctype);
    if bf >= 0 {
        why = "the form is not well formed";
        var delim = buffer.append(heap, buffer.empty(heap, 80), "--");
        delim = buffer.append(heap, delim, ctype[bf..bt]);
        borrow delim as &db in {
            let dl = buffer.bytes(db);
            let (pf, pt) = part(body, dl, "prompt");
            let (sf, st) = part(body, dl, "seed");
            let (rwf, rwt) = part(body, dl, "rewrite");
            let (vf, vt) = part(body, dl, "variations");
            let (stpf, stpt) = part(body, dl, "steps");
            let (mf, mt) = part(body, dl, "model");
            let (imf, imt) = part(body, dl, "image");
            let (i2f, i2t) = part(body, dl, "image2");  // a second picture to combine with the first (docs/two-images.md): an empty file field is a part of 0 bytes, which is "none"
            let (caf, cat) = part(body, dl, "condition_area");
            let (frf, frt) = part(body, dl, "from");  // refine: the result of this earlier job is the first picture (docs/studio-sessions.md)
            var has_from = false;
            var rname = "";
            if frf >= 0 && frt > frf {
                has_from = true;
                rname = result_name(heap, fs, dir, body[frf..frt]);
            }
            let (ntf, ntt) = part(body, dl, "note");  // optional real sizes (docs/studio-cases.md): added to the instruction as a sentence
            var has_note = false;
            if ntf >= 0 && ntt > ntf {
                has_note = true;
            }
            var kind = 0;
            if imf >= 0 && imt - imf >= 16 {
                kind = kind_of(body[imf..imt]);
            }
            var kind2 = 0;
            var has2 = false;
            if i2f >= 0 && i2t > i2f {
                has2 = true;
                if i2t - i2f >= 16 {
                    kind2 = kind_of(body[i2f..i2t]);
                }
            }
            if pf < 0 || pt - pf < 1 || pt - pf > 1000 {
                why = "prompt is a text of 1 to 1000 bytes";
            } else if no_controls(body[pf..pt]) == false {
                why = "the prompt has no control characters";
            } else if has_note && (ntt - ntf > 200 || no_controls(body[ntf..ntt]) == false || (pt - pf) + (ntt - ntf) + 12 > 1000) {
                why = "the sizes are a text of at most 200 bytes without control characters, and with the instruction at most 1000 bytes";
            } else if has_from && imf >= 0 && imt > imf {
                why = "give a picture or from (the result of an earlier job), not both";
            } else if has_from && len(rname) == 0 {
                why = "from is the id of a finished job that made a picture";
            } else if has_from == false && (imf < 0 || imt - imf < 16) {
                why = "a picture is needed";
            } else if has_from == false && kind == 0 {
                why = "the picture is not a JPEG, PNG or WebP file";
            } else if has2 && kind2 == 0 {
                why = "the second picture is not a JPEG, PNG or WebP file";
            } else if caf >= 0 && cat > caf && (all_digits(body[caf..cat]) == false || cat - caf > 7) {
                why = "condition_area is the pixels each picture is resized to, a whole number";
            } else if sf >= 0 && st > sf && all_digits(body[sf..st]) == false {
                why = "seed is an integer from 0 to 2147483647";
            } else if vf >= 0 && vt > vf && (all_digits(body[vf..vt]) == false || vt - vf > 2) {
                why = "variations is a whole number from 1 to 8";
            } else if stpf >= 0 && stpt > stpf && (all_digits(body[stpf..stpt]) == false || stpt - stpf > 3) {
                why = "steps is a whole number from 1 to 50";
            } else if mf >= 0 && mt > mf && no_controls(body[mf..mt]) == false {
                why = "the model name has no control characters";
            } else if rwf >= 0 && rwt > rwf && bytes.equal(body[rwf..rwt], "on") == false && bytes.equal(body[rwf..rwt], "off") == false && bytes.equal(body[rwf..rwt], "ab") == false {
                why = "rewrite is on, off or ab";
            } else {
                let id = jobs.next_id(heap, fs, dir);
                status = 500;
                if id == 0 {
                    why = "the queue could not be read";
                } else {
                    var path = buffer.append(heap, buffer.empty(heap, 96), dir);
                    var saved = 0 - 1;
                    if has_from {
                        // no copy: the first picture is the earlier job's own result, named by the server from the job's id (never a path from the client)
                        path = buffer.append(heap, path, "/out/");
                        path = buffer.append(heap, path, body[frf..frt]);
                        path = buffer.append(heap, path, "/");
                        path = buffer.append(heap, path, rname);
                        saved = 0;
                    } else {
                        path = buffer.append(heap, path, "/upload-");
                        path = buffer.push_nat(heap, path, id);
                        if kind == 1 {
                            path = buffer.append(heap, path, ".jpg");
                        } else if kind == 2 {
                            path = buffer.append(heap, path, ".png");
                        } else {
                            path = buffer.append(heap, path, ".webp");
                        }
                        borrow path as &pb in {
                            if len(buffer.bytes(pb)) <= 390 {
                                saved = files.write_big(fs, buffer.bytes(pb), body[imf..imt]);
                            }
                        }
                    }
                    var path2 = buffer.empty(heap, 8);
                    var saved2 = 0;
                    if has2 {
                        buffer.drop(heap, path2);
                        path2 = buffer.append(heap, buffer.empty(heap, 96), dir);
                        path2 = buffer.append(heap, path2, "/upload-");
                        path2 = buffer.push_nat(heap, path2, id);
                        if kind2 == 1 {
                            path2 = buffer.append(heap, path2, "-2.jpg");
                        } else if kind2 == 2 {
                            path2 = buffer.append(heap, path2, "-2.png");
                        } else {
                            path2 = buffer.append(heap, path2, "-2.webp");
                        }
                        saved2 = 0 - 1;
                        if saved == 0 {
                            borrow path2 as &pb3 in {
                                if len(buffer.bytes(pb3)) <= 390 {
                                    saved2 = files.write_big(fs, buffer.bytes(pb3), body[i2f..i2t]);
                                }
                            }
                        }
                    }
                    if saved != 0 || saved2 != 0 {
                        why = "the picture could not be saved";
                    } else {
                        var json = buffer.append(heap, buffer.empty(heap, 256), "{\"kind\":\"edit\",\"prompt\":\"");
                        json = quoted(heap, json, body[pf..pt]);
                        if has_note {
                            json = buffer.append(heap, json, " Real sizes: ");
                            json = quoted(heap, json, body[ntf..ntt]);
                            json = buffer.append(heap, json, ".");
                        }
                        json = buffer.append(heap, json, "\",\"image\":\"");
                        borrow path as &pb2 in {
                            json = quoted(heap, json, buffer.bytes(pb2));
                        }
                        json = buffer.append(heap, json, "\"");
                        if has2 {
                            json = buffer.append(heap, json, ",\"also\":\"");
                            borrow path2 as &pb4 in {
                                json = quoted(heap, json, buffer.bytes(pb4));
                            }
                            json = buffer.append(heap, json, "\"");
                            if caf >= 0 && cat > caf {
                                json = buffer.append(heap, json, ",\"condition_area\":");
                                json = buffer.append(heap, json, body[caf..cat]);
                            }
                        }
                        if sf >= 0 && st > sf {
                            json = buffer.append(heap, json, ",\"seed\":");
                            json = buffer.append(heap, json, body[sf..st]);
                        }
                        if rwf >= 0 && rwt > rwf {
                            json = buffer.append(heap, json, ",\"rewrite\":\"");
                            json = buffer.append(heap, json, body[rwf..rwt]);
                            json = buffer.push(heap, json, byte_of(34));
                        }
                        if vf >= 0 && vt > vf && bytes.equal(body[vf..vt], "1") == false {
                            json = buffer.append(heap, json, ",\"variations\":");
                            json = buffer.append(heap, json, body[vf..vt]);
                        }
                        if stpf >= 0 && stpt > stpf {
                            json = buffer.append(heap, json, ",\"steps\":");
                            json = buffer.append(heap, json, body[stpf..stpt]);
                        }
                        if mf >= 0 && mt > mf {
                            json = buffer.append(heap, json, ",\"model\":\"");
                            json = quoted(heap, json, body[mf..mt]);
                            json = buffer.push(heap, json, byte_of(34));
                        }
                        json = buffer.append(heap, json, "}");
                        borrow json as &jb in {
                            let (cst, reply) = jobs.create(heap, fs, dir, buffer.bytes(jb), rewrite_default);
                            buffer.drop(heap, answer);
                            answer = reply;
                            status = cst;
                            why = "";
                        }
                        buffer.drop(heap, json);
                        if status == 202 {
                            var paired = false;
                            var made_set = false;
                            borrow answer as &ab in {
                                made = id_in(buffer.bytes(ab));
                                paired = bytes.find(buffer.bytes(ab), "pair") >= 0;
                                made_set = bytes.find(buffer.bytes(ab), "\"set\"") >= 0;
                            }
                            var root = buffer.push_nat(heap, buffer.empty(heap, 16), made);
                            var inputs = buffer.empty(heap, 48);
                            if has_from {
                                // a refine stays in the session of the job it came from (that job's `.root`, or the job itself when it has none)
                                let (rv, has_rv) = results.job_file(heap, fs, dir, body[frf..frt], ".root");
                                buffer.drop(heap, root);
                                root = buffer.empty(heap, 16);
                                if has_rv {
                                    borrow rv as &rvb in {
                                        var e = 0;
                                        while e < len(buffer.bytes(rvb)) && int_of(buffer.bytes(rvb)[e]) >= 48 && int_of(buffer.bytes(rvb)[e]) <= 57 {
                                            e = e + 1;
                                        }
                                        root = buffer.append(heap, root, buffer.bytes(rvb)[0..e]);
                                    }
                                } else {
                                    root = buffer.append(heap, root, body[frf..frt]);
                                }
                                buffer.drop(heap, rv);
                                inputs = buffer.append(heap, inputs, body[frf..frt]);
                                inputs = buffer.append(heap, inputs, " ");
                                inputs = buffer.append(heap, inputs, rname);
                                inputs = buffer.append(heap, inputs, "\n");
                            } else {
                                inputs = buffer.append(heap, inputs, "upload\n");
                            }
                            if has2 {
                                inputs = buffer.append(heap, inputs, "upload\n");
                            }
                            let more = other_ids(heap, fs, dir, made, made_set, paired);
                            let first_name = buffer.push_nat(heap, buffer.empty(heap, 16), made);
                            borrow first_name as &fnb in {
                                borrow root as &rtb in {
                                    borrow inputs as &inb in {
                                        record_one(heap, fs, dir, buffer.bytes(fnb), buffer.bytes(rtb), buffer.bytes(inb));
                                        borrow more as &mob in {
                                            let list = buffer.bytes(mob);
                                            var k = 0;
                                            while k < len(list) {
                                                var e = k;
                                                while e < len(list) && int_of(list[e]) != 32 {
                                                    e = e + 1;
                                                }
                                                if e > k {
                                                    record_one(heap, fs, dir, list[k..e], buffer.bytes(rtb), buffer.bytes(inb));
                                                }
                                                k = e + 1;
                                            }
                                        }
                                    }
                                }
                            }
                            buffer.drop(heap, more);
                            buffer.drop(heap, first_name);
                            buffer.drop(heap, root);
                            buffer.drop(heap, inputs);
                            buffer.drop(heap, answer);
                            answer = buffer.empty(heap, 8);
                            if paired {
                                answer = buffer.append(heap, answer, "pair");
                            }
                            if made_set {
                                answer = buffer.append(heap, answer, "set");
                            }
                            status = 302;
                        }
                    }
                    buffer.drop(heap, path);
                    buffer.drop(heap, path2);
                }
            }
        }
        buffer.drop(heap, delim);
    }
    if len(why) > 0 {
        buffer.drop(heap, answer);
        answer = buffer.append(heap, buffer.empty(heap, 64), "{\"error\":\"");
        answer = buffer.append(heap, answer, why);
        answer = buffer.append(heap, answer, "\"}");
    }
    return (status, answer, made);
}

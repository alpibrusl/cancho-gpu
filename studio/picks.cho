edition 9;

module picks;

import std.buffer;
import std.bytes;
import std.http;
import files;
import results;
import library;

// `picks` -- choosing a picture from the gallery instead of uploading one (docs/studio-sessions.md, section 10.4). A choice is a text the form posts in `pick1` or `pick2`:
//
//   j/N/NAME   a job's picture: `edited.png` or `image.png` (its result, the job done), `input1.jpg|png|webp` or `input2.*` (a picture it was given)
//   l/LN       a library picture
//
// `resolve` turns it into a path the SERVER builds from an id and a closed name; nothing from the client is a path and nothing is copied.

// The name under which `/files/ID/` serves the first or second upload of a job (`input1.png`...), or "" for none.
pub fn upload_name[&h, &f, &d, &i](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte], second: bool) -> [heap, fs_read("")] &static [byte] {
    if second {
        if results.has_upload(heap, fs, dir, id, "input2.jpg") {
            return "input2.jpg";
        }
        if results.has_upload(heap, fs, dir, id, "input2.png") {
            return "input2.png";
        }
        if results.has_upload(heap, fs, dir, id, "input2.webp") {
            return "input2.webp";
        }
        return "";
    }
    if results.has_upload(heap, fs, dir, id, "input1.jpg") {
        return "input1.jpg";
    }
    if results.has_upload(heap, fs, dir, id, "input1.png") {
        return "input1.png";
    }
    if results.has_upload(heap, fs, dir, id, "input1.webp") {
        return "input1.webp";
    }
    return "";
}

// The name of library picture `n` (digits): `picture.jpg|png|webp` for the file that exists, or "".
pub fn lib_name[&h, &f, &d, &n](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], n: &n [byte]) -> [heap, fs_read("")] &static [byte] {
    var p = buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.empty(heap, 96), dir), "/lib-"), n);
    var name = "";
    borrow p as &pb in {
        let base = buffer.bytes(pb);
        let b = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 96), base), ".jpg");
        borrow b as &b1 in {
            if files.exists(fs, buffer.bytes(b1)) {
                name = "picture.jpg";
            }
        }
        buffer.drop(heap, b);
        if len(name) == 0 {
            let c = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 96), base), ".png");
            borrow c as &c1 in {
                if files.exists(fs, buffer.bytes(c1)) {
                    name = "picture.png";
                }
            }
            buffer.drop(heap, c);
        }
        if len(name) == 0 {
            let w = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 96), base), ".webp");
            borrow w as &w1 in {
                if files.exists(fs, buffer.bytes(w1)) {
                    name = "picture.webp";
                }
            }
            buffer.drop(heap, w);
        }
    }
    buffer.drop(heap, p);
    return name;
}

// The fixed name for a client's text naming an uploaded picture of a job, or "" (a closed list: nothing else is a name).
fn closed_upload[&n](name: &n [byte]) -> [] &static [byte] {
    if bytes.equal(name, "input1.jpg") {
        return "input1.jpg";
    }
    if bytes.equal(name, "input1.png") {
        return "input1.png";
    }
    if bytes.equal(name, "input1.webp") {
        return "input1.webp";
    }
    if bytes.equal(name, "input2.jpg") {
        return "input2.jpg";
    }
    if bytes.equal(name, "input2.png") {
        return "input2.png";
    }
    if bytes.equal(name, "input2.webp") {
        return "input2.webp";
    }
    return "";
}

// Resolve a choice: (the path of the picture, the `.from` line for it, whether it is a job's result, whether it is valid). An invalid choice has empty buffers.
pub fn resolve[&h, &f, &d, &v](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], value: &v [byte]) -> [heap, fs_read(""), file_read] (buffer.Buffer, buffer.Buffer, bool, bool) {
    if bytes.starts_with(value, "l/") {
        let ref = value[2..len(value)];
        if results.lib_id_ok(ref) {
            let name = lib_name(heap, fs, dir, ref[1..len(ref)]);
            if len(name) > 0 {
                var path = buffer.append(heap, buffer.empty(heap, 96), dir);
                path = buffer.append(heap, path, "/lib-");
                path = buffer.append(heap, path, ref[1..len(ref)]);
                path = buffer.append(heap, path, results.lib_ext(name));
                var line = buffer.append(heap, buffer.empty(heap, 32), ref);
                line = buffer.append(heap, line, " ");
                line = buffer.append(heap, line, name);
                return (path, line, false, true);
            }
        }
    } else if bytes.starts_with(value, "j/") {
        let rest = value[2..len(value)];
        var cut = 0;
        while cut < len(rest) && int_of(rest[cut]) != 47 {
            cut = cut + 1;
        }
        if cut > 0 && cut < len(rest) {
            let id = rest[0..cut];
            let name = rest[cut + 1..len(rest)];
            if results.id_ok(id) {
                if bytes.equal(name, "edited.png") || bytes.equal(name, "image.png") {
                    if bytes.equal(results.result_name(heap, fs, dir, id), name) {
                        var path = buffer.append(heap, buffer.empty(heap, 96), dir);
                        path = buffer.append(heap, path, "/out/");
                        path = buffer.append(heap, path, id);
                        path = buffer.append(heap, path, "/");
                        path = buffer.append(heap, path, name);
                        var line = buffer.append(heap, buffer.empty(heap, 32), id);
                        line = buffer.append(heap, line, " ");
                        line = buffer.append(heap, line, name);
                        return (path, line, true, true);
                    }
                } else {
                    let sname = closed_upload(name);
                    if len(sname) > 0 && results.has_upload(heap, fs, dir, id, sname) {
                        var line = buffer.append(heap, buffer.empty(heap, 32), id);
                        line = buffer.append(heap, line, " ");
                        line = buffer.append(heap, line, sname);
                        return (results.upload_path(heap, dir, id, results.upload_tail(sname)), line, false, true);
                    }
                }
            }
        }
    }
    return (buffer.empty(heap, 8), buffer.empty(heap, 8), false, false);
}

// ASCII case-insensitive: whether `hay` contains `needle` (an empty needle is in everything).
pub fn contains_ci[&h, &n](hay: &h [byte], needle: &n [byte]) -> [] bool {
    if len(needle) == 0 {
        return true;
    }
    var i = 0;
    while i + len(needle) <= len(hay) {
        var j = 0;
        var same = true;
        while j < len(needle) && same {
            var a = int_of(hay[i + j]);
            var b = int_of(needle[j]);
            if a >= 65 && a <= 90 {
                a = a + 32;
            }
            if b >= 65 && b <= 90 {
                b = b + 32;
            }
            if a != b {
                same = false;
            }
            j = j + 1;
        }
        if same {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// The words a picture is found by (docs/studio-sessions.md, section 15): a library picture's description, a job's picture's prompt. `lib` says which `id` is (the digits of a library number, or a job id).
pub fn search_text[&h, &f, &d, &i](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], lib: bool, id: &i [byte]) -> [heap, fs_read(""), file_read] buffer.Buffer {
    var text = buffer.empty(heap, 8);
    if lib {
        let (t, ok) = library.description(heap, fs, dir, id);
        buffer.drop(heap, text);
        text = t;
        return text;
    }
    let (av, has_av) = results.job_file(heap, fs, dir, id, ".argv");
    if has_av {
        borrow av as &avr in {
            let (ps, pe) = results.last_entry(buffer.bytes(avr));
            buffer.drop(heap, text);
            text = buffer.append(heap, buffer.empty(heap, 64), buffer.bytes(avr)[ps..pe]);
        }
    }
    buffer.drop(heap, av);
    return text;
}

// Words that mean the same for finding a picture (docs/studio-sessions.md, section 17): a group is its words separated by spaces, groups are separated by `|`. A search word is looked for as itself (inside
// any word, as always) and as any other word of its group **as a whole word** (so `bike` finds `bicycle`, `shoes` finds `sneakers`, `lamp` finds `chandelier`, and `hat` does not find `that`). A starting
// list of true synonyms, easy to extend; a word in no group is only itself.
fn groups() -> [] &static [byte] {
    return "bike bicycle cycle|shoe sneaker trainer footwear|jeans denim|couch sofa settee|lamp chandelier lantern|fridge refrigerator|tv television|pants trousers|sweater jumper pullover sweatshirt|tshirt t-shirt tee|dress gown frock|hat cap beanie|dog puppy canine|cat kitten feline|car automobile|sea ocean|phone smartphone|rug carpet|painting artwork";
}

fn alnum(c: int) -> [] bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}

// Whether `hay` has `w` at `i`, ignoring ASCII case.
fn at_ci[&h, &w](hay: &h [byte], i: int, w: &w [byte]) -> [] bool {
    if i + len(w) > len(hay) {
        return false;
    }
    var j = 0;
    while j < len(w) {
        var a = int_of(hay[i + j]);
        var b = int_of(w[j]);
        if a >= 65 && a <= 90 {
            a = a + 32;
        }
        if b >= 65 && b <= 90 {
            b = b + 32;
        }
        if a != b {
            return false;
        }
        j = j + 1;
    }
    return true;
}

// Whether `hay` holds `w` as a whole word, ignoring case, with one trailing `s` allowed (`sneakers` for `sneaker`): the bytes around it are not letters or digits.
fn contains_word_ci[&h, &w](hay: &h [byte], w: &w [byte]) -> [] bool {
    if len(w) == 0 {
        return false;
    }
    var i = 0;
    while i + len(w) <= len(hay) {
        if at_ci(hay, i, w) && (i == 0 || alnum(int_of(hay[i - 1])) == false) {
            let e = i + len(w);
            if e == len(hay) || alnum(int_of(hay[e])) == false {
                return true;
            }
            if (int_of(hay[e]) == 115 || int_of(hay[e]) == 83) && (e + 1 == len(hay) || alnum(int_of(hay[e + 1])) == false) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

// Equal, ignoring ASCII case and one trailing `s` (`sneakers` and `Sneaker` are the same word).
fn same_word[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    var lx = len(x);
    var ly = len(y);
    if lx > 3 && (int_of(x[lx - 1]) == 115 || int_of(x[lx - 1]) == 83) {
        lx = lx - 1;
    }
    if ly > 3 && (int_of(y[ly - 1]) == 115 || int_of(y[ly - 1]) == 83) {
        ly = ly - 1;
    }
    if lx != ly {
        return false;
    }
    var i = 0;
    while i < lx {
        var c = int_of(x[i]);
        var d = int_of(y[i]);
        if c >= 65 && c <= 90 {
            c = c + 32;
        }
        if d >= 65 && d <= 90 {
            d = d + 32;
        }
        if c != d {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Whether `text` holds the search word `token`, or a word of a group that has it.
fn word_hit[&t, &w](text: &t [byte], token: &w [byte]) -> [] bool {
    if contains_ci(text, token) {
        return true;
    }
    let all = groups();
    var gs = 0;
    while gs < len(all) {
        var ge = gs;
        while ge < len(all) && int_of(all[ge]) != 124 {
            ge = ge + 1;
        }
        let group = all[gs..ge];
        // is the token in this group?
        var has = false;
        var ws = 0;
        while ws < len(group) {
            var we = ws;
            while we < len(group) && int_of(group[we]) != 32 {
                we = we + 1;
            }
            if we > ws && same_word(group[ws..we], token) {
                has = true;
            }
            ws = we + 1;
        }
        if has {
            var xs = 0;
            while xs < len(group) {
                var xe = xs;
                while xe < len(group) && int_of(group[xe]) != 32 {
                    xe = xe + 1;
                }
                if xe > xs && contains_word_ci(text, group[xs..xe]) {
                    return true;
                }
                xs = xe + 1;
            }
        }
        gs = ge + 1;
    }
    return false;
}

// Whether `text` is found by `q`: `q` as it is, or every word of `q` (in any order, each as itself or a synonym).
pub fn query_hit[&t, &q](text: &t [byte], q: &q [byte]) -> [] bool {
    if contains_ci(text, q) {
        return true;
    }
    var words = 0;
    var i = 0;
    while i < len(q) {
        while i < len(q) && int_of(q[i]) == 32 {
            i = i + 1;
        }
        var j = i;
        while j < len(q) && int_of(q[j]) != 32 {
            j = j + 1;
        }
        if j > i {
            words = words + 1;
            if word_hit(text, q[i..j]) == false {
                return false;
            }
        }
        i = j;
    }
    return words > 0;
}

// Whether the picture is found by `q` (an empty `q` finds everything).
pub fn matches[&h, &f, &d, &i, &q](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], lib: bool, id: &i [byte], q: &q [byte]) -> [heap, fs_read(""), file_read] bool {
    if len(q) == 0 {
        return true;
    }
    let text = search_text(heap, fs, dir, lib, id);
    var yes = false;
    borrow text as &tb in {
        yes = query_hit(buffer.bytes(tb), q);
    }
    buffer.drop(heap, text);
    return yes;
}

fn tile[&h, &v, &i, &n, &t](heap: &!h Heap, page: buffer.Buffer, field: &static [byte], kind: &static [byte], value: &v [byte], ref: &i [byte], name: &n [byte], tag: &static [byte], label: &t [byte]) -> [heap] buffer.Buffer {
    var p = buffer.append(heap, page, "<label style=\"position:relative;display:block;width:96px;height:96px;flex-direction:row\"><input type=");
    p = buffer.append(heap, p, kind);
    p = buffer.append(heap, p, " name=");
    p = buffer.append(heap, p, field);
    p = buffer.append(heap, p, " value=\"");
    p = buffer.append(heap, p, value);
    p = buffer.append(heap, p, "\" style=\"position:absolute;top:6px;left:6px;z-index:1;width:auto;min-height:0\"><img loading=lazy alt=\"");
    p = buffer.append(heap, p, tag);
    p = buffer.append(heap, p, "\" title=\"");
    p = buffer.append(heap, p, tag);
    if len(label) > 0 {
        p = buffer.append(heap, p, ": ");
        p = results.escape(heap, p, label);
    }
    p = buffer.append(heap, p, "\" style=\"width:96px;height:96px;object-fit:cover;border-radius:8px\" src=/files/");
    p = buffer.append(heap, p, ref);
    p = buffer.append(heap, p, "/");
    p = buffer.append(heap, p, name);
    return buffer.append(heap, p, "></label>");
}

// The picker for one picture slot (`field` is `pick1` or `pick2`): "or choose from the gallery", a closed `<details>` with the `limit` newest pictures (the library's, then the jobs') as radio tiles
// and a first radio for none. No script. A choice is posted as the text `resolve` reads.
pub fn picker[&h, &f, &d](heap: &!h Heap, page: buffer.Buffer, fs: &f Fs(""), dir: &d [byte], field: &static [byte], limit: int) -> [heap, fs_read(""), file_read] buffer.Buffer {
    return picker_q(heap, page, fs, dir, field, limit, "", false);
}

// The same, found by `q` (a picture's description or its job's prompt, ignoring case; empty for all), and with checkboxes when `multi` (several can be ticked: one text each, the same field name).
pub fn picker_q[&h, &f, &d, &q](heap: &!h Heap, page: buffer.Buffer, fs: &f Fs(""), dir: &d [byte], field: &static [byte], limit: int, q: &q [byte], multi: bool) -> [heap, fs_read(""), file_read] buffer.Buffer {
    var kind = "radio";
    if multi {
        kind = "checkbox";
    }
    var p = buffer.append(heap, page, "<details");
    if multi {
        p = buffer.append(heap, p, " open");
    }
    p = buffer.append(heap, p, "><summary>");
    if multi {
        p = buffer.append(heap, p, "tick the pictures to use, from the gallery");
    } else {
        p = buffer.append(heap, p, "or choose from the gallery");
    }
    p = buffer.append(heap, p, "</summary><div style=\"display:flex;flex-wrap:wrap;gap:6px;margin-top:8px\">");
    if multi == false {
        p = buffer.append(heap, p, "<label style=\"flex-direction:row;align-items:center;gap:6px;width:96px\"><input type=radio name=");
        p = buffer.append(heap, p, field);
        p = buffer.append(heap, p, " value=\"\" checked style=\"width:auto;min-height:0\"> none</label>");
    }
    var shown = 0;
    let idx = library.index(heap, fs, dir);
    borrow idx as &ib in {
        let all = buffer.bytes(ib);
        var end = len(all);
        while end > 0 && shown < limit {
            var stop = end;
            while stop > 0 && int_of(all[stop - 1]) == 10 {
                stop = stop - 1;
            }
            if stop == 0 {
                end = 0;
            } else {
                var start = stop;
                while start > 0 && int_of(all[start - 1]) != 10 {
                    start = start - 1;
                }
                var sp = start;
                while sp < stop && int_of(all[sp]) != 32 {
                    sp = sp + 1;
                }
                let number = all[start..sp];
                if results.id_ok(number) {
                    let name = lib_name(heap, fs, dir, number);
                    if len(name) > 0 && matches(heap, fs, dir, true, number, q) {
                        let ref = buffer.append(heap, buffer.push(heap, buffer.empty(heap, 12), byte_of(76)), number);
                        var value = buffer.append(heap, buffer.empty(heap, 16), "l/");
                        let (desc, has_desc) = library.description(heap, fs, dir, number);
                        borrow ref as &rb in {
                            value = buffer.append(heap, value, buffer.bytes(rb));
                            borrow value as &vb in {
                                borrow desc as &db in {
                                    p = tile(heap, p, field, kind, buffer.bytes(vb), buffer.bytes(rb), name, "library", buffer.bytes(db));
                                }
                            }
                        }
                        buffer.drop(heap, desc);
                        buffer.drop(heap, ref);
                        buffer.drop(heap, value);
                        shown = shown + 1;
                    }
                }
                end = start;
            }
        }
    }
    buffer.drop(heap, idx);
    var text = buffer.empty(heap, 8);
    let qp = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), dir), "/queue");
    borrow qp as &qb in {
        let (b, e) = files.read_all(heap, fs, buffer.bytes(qb));
        buffer.drop(heap, text);
        text = b;
    }
    buffer.drop(heap, qp);
    borrow text as &tb in {
        let all = buffer.bytes(tb);
        var end = len(all);
        while end > 0 && shown < limit {
            var stop = end;
            while stop > 0 && int_of(all[stop - 1]) == 10 {
                stop = stop - 1;
            }
            if stop == 0 {
                end = 0;
            } else {
                var start = stop;
                while start > 0 && int_of(all[start - 1]) != 10 {
                    start = start - 1;
                }
                let id = all[start..stop];
                if results.id_ok(id) && matches(heap, fs, dir, false, id, q) {
                    let first = upload_name(heap, fs, dir, id, false);
                    let second = upload_name(heap, fs, dir, id, true);
                    let made = results.result_name(heap, fs, dir, id);
                    var k = 0;
                    while k < 3 {
                        var name = first;
                        var tag = "uploaded";
                        if k == 1 {
                            name = second;
                        } else if k == 2 {
                            name = made;
                            if bytes.equal(made, "image.png") {
                                tag = "generated";
                            } else {
                                tag = "edited";
                            }
                        }
                        if len(name) > 0 && shown < limit {
                            let value = buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.empty(heap, 40), "j/"), id), "/"), name);
                            let label = search_text(heap, fs, dir, false, id);
                            borrow value as &vb2 in {
                                borrow label as &lb in {
                                    p = tile(heap, p, field, kind, buffer.bytes(vb2), id, name, tag, buffer.bytes(lb));
                                }
                            }
                            buffer.drop(heap, label);
                            buffer.drop(heap, value);
                            shown = shown + 1;
                        }
                        k = k + 1;
                    }
                }
                end = start;
            }
        }
    }
    buffer.drop(heap, text);
    if shown == 0 {
        p = buffer.append(heap, p, "<span class=meta>No pictures found.</span>");
    }
    return buffer.append(heap, p, "</div></details>");
}

// The value of query parameter `key`, decoded (`+` is a space, `%XX` a byte), at most 100 bytes, no control characters; empty if absent. Used for `?q=`.
pub fn query_text[&h, &q, &k](heap: &!h Heap, query: &q [byte], key: &k [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 16);
    let (a, b) = http.query_value(query, key);
    if a < 0 {
        return out;
    }
    var i = a;
    var n = 0;
    while i < b && n < 100 {
        let c = int_of(query[i]);
        var v = c;
        var step = 1;
        if c == 43 {
            v = 32;
        } else if c == 37 && i + 2 < b {
            let hi = http.hex_value(int_of(query[i + 1]));
            let lo = http.hex_value(int_of(query[i + 2]));
            if hi >= 0 && lo >= 0 {
                v = hi * 16 + lo;
                step = 3;
            }
        }
        if v >= 32 && v != 127 {
            out = buffer.push(heap, out, byte_of(v));
            n = n + 1;
        }
        i = i + step;
    }
    return out;
}

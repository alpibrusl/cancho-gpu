edition 10;

module negative;

// negative -- Wan2.2's own default negative prompt, the text tools/media.py keeps as NEG_OFFICIAL (its shared_config `sample_neg_prompt`; docs/video-image.md section 7). tests/media_video.sh holds the two equal: the stage
// is called with this text in both, and the check compares the argument lists word for word.
pub fn official() -> [] &static [byte] {
    return "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走";
}

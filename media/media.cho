edition 10;

import std.buffer;
import std.dirs;
import std.io;
import files;
import pathx;
import rewriter;
import stage;

// media -- the command line of tools/media.py, in cancho (docs/media-cho.md). Slice A: the parts that decide and do not run anything.
//
//   media models                               the supported models per task (the text `media.py models` prints)
//   media check image WxH PROMPT               the refusals of `media image`, or `ok`
//   media check video WxH FRAMES FORCE         the refusals of `media video` (FORCE 0 or 1), or `ok frames N latent L tokens T`
//
// A refusal is one line on stderr, `media: ...`, exit 2: the words of tools/media.py, so that tests/media_diff.sh can hold the two equal.
// Built with  cancho build media/media.cho --std -o build/media   Its authority is the point: it reads no file, starts nothing, reaches no network.

import shared;
import transcribe;
import speak;
import video;

fn cmd_image[&i, &h, &f, &x, &y, &c, &e, &a, &zc](io: &!i Io, heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), sdir: &y Dir, clock: &c Clock, ctx: &zc shared.Ctx, env: &e [byte], args: &a Args, from: int) -> [args, io_write, err_write, heap, fs_read(""), fs_write(""), file_write, dir_read, dir_write, exec_under, clock, poll] int {
    var prompt = "";
    var have_prompt = false;
    var output = "";
    var size = "1024x1024";
    var seed = "0";
    var steps = "8";
    var model = "";
    var weights = "";
    var tweights = "";
    var k = from;
    let n = arg_count(args);
    let stop = shared.dashdash(args, from);
    while k < stop {
        let t = arg(args, k);
        if shared.is_text(t, "-o") || shared.is_text(t, "--output") {
            k = k + 1;
            if k >= stop {
                return shared.bad_value(io, "-o/--output");
            }
            output = arg(args, k);
        } else if shared.is_text(t, "--size") {
            k = k + 1;
            if k >= stop {
                return shared.bad_value(io, "--size");
            }
            size = arg(args, k);
        } else if shared.is_text(t, "--seed") {
            k = k + 1;
            if k >= stop || shared.num(arg(args, k)) < 0 {
                return shared.bad_value(io, "--seed");
            }
            seed = arg(args, k);
        } else if shared.is_text(t, "--steps") {
            k = k + 1;
            if k >= stop || shared.num(arg(args, k)) < 0 {
                return shared.bad_value(io, "--steps");
            }
            steps = arg(args, k);
        } else if shared.is_text(t, "--model") {
            k = k + 1;
            if k >= stop {
                return shared.bad_value(io, "--model");
            }
            model = arg(args, k);
        } else if shared.is_text(t, "--weights") {
            k = k + 1;
            if k >= stop {
                return shared.bad_value(io, "--weights");
            }
            weights = arg(args, k);
        } else if shared.is_text(t, "--text-weights") {
            k = k + 1;
            if k >= stop {
                return shared.bad_value(io, "--text-weights");
            }
            tweights = arg(args, k);
        } else if have_prompt == false {
            prompt = t;
            have_prompt = true;
        } else {
            io.error_all(io, "media: unrecognized arguments\n");
            return 2;
        }
        k = k + 1;
    }
    k = stop + 1;
    while k < n {
        if have_prompt == false {
            prompt = arg(args, k);
            have_prompt = true;
        } else {
            io.error_all(io, "media: unrecognized arguments\n");
            return 2;
        }
        k = k + 1;
    }
    if have_prompt == false || len(output) == 0 {
        io.error_all(io, "media: the following arguments are required: prompt, -o/--output\n");
        return 2;
    }
    let first = shared.session_and_model(io, heap, fs, ctx, "image", model);
    if first != 0 {
        return first;
    }
    let sized = shared.check_image(io, heap, size, prompt);
    if sized != 0 {
        return sized;
    }
    let (w, h2) = shared.size_of(size);
    let wd = shared.weights_of(heap, ctx, weights, ctx.edit_weights, "qwen-edit-dit");
    let tw = shared.weights_of(heap, ctx, tweights, ctx.edit_text_weights, "qwen-edit-text");
    var status = 0;
    borrow wd as &wb in {
        status = shared.weights_checks(io, heap, fs, ctx, buffer.bytes(wb));
    }
    if status == 0 {
        let out = pathx.absolute(heap, ctx.cwd, output);
        borrow out as &ob in {
            let made = pathx.make_all(fs, buffer.bytes(ob));
            if made != 0 {
                status = shared.refuse_text(io, "cannot create the output directory");
            } else {
                let work = pathx.under(heap, buffer.bytes(ob), "work");
                let png = pathx.under(heap, buffer.bytes(ob), "image.png");
                var list = shared.put_arg(heap, buffer.empty(heap, 256), "tests/t2i_pipeline_gpu.py");
                borrow work as &wk in {
                    list = shared.put_arg(heap, list, buffer.bytes(wk));
                }
                list = shared.put_arg(heap, list, "--prompt");
                list = shared.put_arg(heap, list, prompt);
                list = shared.put_arg(heap, list, "--seed");
                list = shared.put_num(heap, list, shared.num(seed));
                list = shared.put_arg(heap, list, "--steps");
                list = shared.put_num(heap, list, shared.num(steps));
                list = shared.put_arg(heap, list, "--size");
                list = shared.push_int(heap, list, w);
                list = buffer.push(heap, list, byte_of(120));
                list = shared.put_num(heap, list, h2);
                list = shared.put_arg(heap, list, "--weights");
                borrow wd as &wb2 in {
                    list = shared.put_arg(heap, list, buffer.bytes(wb2));
                }
                list = shared.put_arg(heap, list, "--text-weights");
                borrow tw as &tb in {
                    list = shared.put_arg(heap, list, buffer.bytes(tb));
                }
                list = shared.put_arg(heap, list, "--out");
                borrow png as &pg in {
                    list = shared.put_arg(heap, list, buffer.bytes(pg));
                }
                list = shared.put_arg(heap, list, "--resident");
                borrow list as &lb in {
                    borrow png as &pg2 in {
                        status = shared.start_stage(io, heap, fs, exec, sdir, clock, "text to image (GPU, three stages)", buffer.bytes(lb), env, buffer.bytes(ob), prompt, prompt, buffer.bytes(pg2));
                    }
                }
                buffer.drop(heap, list);
                buffer.drop(heap, work);
                buffer.drop(heap, png);
            }
        }
        buffer.drop(heap, out);
    }
    buffer.drop(heap, wd);
    buffer.drop(heap, tw);
    return status;
}

fn cmd_edit[&i, &h, &f, &x, &y, &c, &e, &a, &zc](io: &!i Io, heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), sdir: &y Dir, clock: &c Clock, ctx: &zc shared.Ctx, env: &e [byte], args: &a Args, from: int) -> [args, io_write, err_write, heap, fs_read(""), fs_write(""), file_write, dir_read, dir_write, exec_under, clock, poll] int {
    var image = "";
    var instruction = "";
    var positional = 0;
    var output = "";
    var seed = "0";
    var steps = "8";
    var area_text = "0";
    var model = "";
    var weights = "";
    var tweights = "";
    var also = buffer.empty(heap, 64);
    var n_also = 0;
    var rewrite = false;
    var rewrite_model = "qwen3.8:27b-mlx";
    var k = from;
    let n = arg_count(args);
    let stop = shared.dashdash(args, from);
    while k < stop {
        let t = arg(args, k);
        if shared.is_text(t, "-o") || shared.is_text(t, "--output") {
            k = k + 1;
            if k >= stop {
                buffer.drop(heap, also);
                return shared.bad_value(io, "-o/--output");
            }
            output = arg(args, k);
        } else if shared.is_text(t, "--rewrite") {
            rewrite = true;
        } else if shared.is_text(t, "--rewrite-model") {
            k = k + 1;
            if k >= stop {
                buffer.drop(heap, also);
                return shared.bad_value(io, "--rewrite-model");
            }
            rewrite_model = arg(args, k);
        } else if shared.is_text(t, "--also") {
            k = k + 1;
            if k >= stop {
                buffer.drop(heap, also);
                return shared.bad_value(io, "--also");
            }
            also = buffer.push(heap, buffer.append(heap, also, arg(args, k)), byte_of(0));
            n_also = n_also + 1;
        } else if shared.is_text(t, "--condition-area") {
            k = k + 1;
            if k >= stop || shared.num(arg(args, k)) < 0 {
                buffer.drop(heap, also);
                return shared.bad_value(io, "--condition-area");
            }
            area_text = arg(args, k);
        } else if shared.is_text(t, "--seed") {
            k = k + 1;
            if k >= stop || shared.num(arg(args, k)) < 0 {
                buffer.drop(heap, also);
                return shared.bad_value(io, "--seed");
            }
            seed = arg(args, k);
        } else if shared.is_text(t, "--steps") {
            k = k + 1;
            if k >= stop || shared.num(arg(args, k)) < 0 {
                buffer.drop(heap, also);
                return shared.bad_value(io, "--steps");
            }
            steps = arg(args, k);
        } else if shared.is_text(t, "--model") {
            k = k + 1;
            if k >= stop {
                buffer.drop(heap, also);
                return shared.bad_value(io, "--model");
            }
            model = arg(args, k);
        } else if shared.is_text(t, "--weights") {
            k = k + 1;
            if k >= stop {
                buffer.drop(heap, also);
                return shared.bad_value(io, "--weights");
            }
            weights = arg(args, k);
        } else if shared.is_text(t, "--text-weights") {
            k = k + 1;
            if k >= stop {
                buffer.drop(heap, also);
                return shared.bad_value(io, "--text-weights");
            }
            tweights = arg(args, k);
        } else if positional == 0 {
            image = t;
            positional = 1;
        } else if positional == 1 {
            instruction = t;
            positional = 2;
        } else {
            buffer.drop(heap, also);
            io.error_all(io, "media: unrecognized arguments\n");
            return 2;
        }
        k = k + 1;
    }
    k = stop + 1;
    while k < n {
        if positional == 0 {
            image = arg(args, k);
            positional = 1;
        } else if positional == 1 {
            instruction = arg(args, k);
            positional = 2;
        } else {
            buffer.drop(heap, also);
            io.error_all(io, "media: unrecognized arguments\n");
            return 2;
        }
        k = k + 1;
    }
    if positional < 2 || len(output) == 0 {
        buffer.drop(heap, also);
        io.error_all(io, "media: the following arguments are required: image, instruction, -o/--output\n");
        return 2;
    }
    if rewrite && n_also > 1 {
        buffer.drop(heap, also);
        return shared.refuse_text(io, "--rewrite reads at most two pictures (the image and one --also): the two-picture template is the one measured");
    }
    var status = shared.session_and_model(io, heap, fs, ctx, "edit", model);
    if status == 0 {
        let img = pathx.absolute(heap, ctx.cwd, image);
        borrow img as &ib in {
            if shared.is_file(fs, buffer.bytes(ib)) == false {
                var m = buffer.append(heap, buffer.empty(heap, 96), "no such image: ");
                m = buffer.append(heap, m, image);
                status = shared.refuse_buf(io, heap, m);
            }
        }
        buffer.drop(heap, img);
    }
    // each --also picture must be there, in the order given
    if status == 0 {
        borrow also as &ab in {
            let all = buffer.bytes(ab);
            var at = 0;
            while at < len(all) && status == 0 {
                var stop = at;
                while stop < len(all) && int_of(all[stop]) != 0 {
                    stop = stop + 1;
                }
                let one = pathx.absolute(heap, ctx.cwd, all[at..stop]);
                borrow one as &ob1 in {
                    if shared.is_file(fs, buffer.bytes(ob1)) == false {
                        var m = buffer.append(heap, buffer.empty(heap, 96), "no such image: ");
                        m = buffer.append(heap, m, all[at..stop]);
                        status = shared.refuse_buf(io, heap, m);
                    }
                }
                buffer.drop(heap, one);
                at = stop + 1;
            }
        }
    }
    var area = shared.num(area_text);
    if area == 0 {
        if n_also == 0 {
            area = 1024 * 1024;
        } else {
            area = 768 * 768;
        }
    }
    let prefix_rows = (n_also + 1) * (area / 256) + 128;
    if status == 0 && n_also > 0 && 32 * prefix_rows * prefix_rows >= 4294967296 {
        var m = buffer.append(heap, buffer.empty(heap, 320), "--condition-area ");
        m = shared.push_int(heap, m, area);
        m = buffer.append(heap, m, " with ");
        m = shared.push_int(heap, m, n_also + 1);
        m = buffer.append(heap, m, " pictures is about ");
        m = shared.push_int(heap, m, prefix_rows);
        m = buffer.append(heap, m, " prefix rows: the attention scores pass what the kernels can index (at most about 11,500 rows; two pictures of 1024 x 1024 are 8,300). Lower it (docs/two-images.md)");
        status = shared.refuse_buf(io, heap, m);
    }
    let wd = shared.weights_of(heap, ctx, weights, ctx.edit_weights, "qwen-edit-dit");
    let tw = shared.weights_of(heap, ctx, tweights, ctx.edit_text_weights, "qwen-edit-text");
    if status == 0 {
        borrow wd as &wb in {
            status = shared.weights_checks(io, heap, fs, ctx, buffer.bytes(wb));
        }
    }
    if status == 0 {
        let out = pathx.absolute(heap, ctx.cwd, output);
        borrow out as &ob in {
            let made = pathx.make_all(fs, buffer.bytes(ob));
            if made != 0 {
                status = shared.refuse_text(io, "cannot create the output directory");
            } else {
                let work = pathx.under(heap, buffer.bytes(ob), "work");
                let png = pathx.under(heap, buffer.bytes(ob), "edited.png");
                let img2 = pathx.absolute(heap, ctx.cwd, image);
                var final = buffer.append(heap, buffer.empty(heap, 64), instruction);
                var rewrite_status = 0;
                if rewrite {
                    var first_also = buffer.empty(heap, 8);
                    borrow also as &fa in {
                        let all3 = buffer.bytes(fa);
                        var e3 = 0;
                        while e3 < len(all3) && int_of(all3[e3]) != 0 {
                            e3 = e3 + 1;
                        }
                        if e3 > 0 {
                            buffer.drop(heap, first_also);
                            first_also = pathx.absolute(heap, ctx.cwd, all3[0..e3]);
                        }
                    }
                    borrow img2 as &im3 in {
                        borrow first_also as &fb in {
                            let (rs, nt) = shared.rewrite_text(io, heap, fs, exec, clock, ctx, "edit", instruction, buffer.bytes(im3), buffer.bytes(fb), rewrite_model);
                            rewrite_status = rs;
                            buffer.drop(heap, final);
                            final = nt;
                        }
                    }
                    buffer.drop(heap, first_also);
                }
                var list = shared.put_arg(heap, buffer.empty(heap, 256), "tests/edit_pipeline_gpu.py");
                borrow img2 as &i2 in {
                    list = shared.put_arg(heap, list, buffer.bytes(i2));
                }
                borrow work as &wk in {
                    list = shared.put_arg(heap, list, buffer.bytes(wk));
                }
                list = shared.put_arg(heap, list, "--prompt");
                borrow final as &fn1 in {
                    list = shared.put_arg(heap, list, buffer.bytes(fn1));
                }
                list = shared.put_arg(heap, list, "--seed");
                list = shared.put_num(heap, list, shared.num(seed));
                list = shared.put_arg(heap, list, "--steps");
                list = shared.put_num(heap, list, shared.num(steps));
                list = shared.put_arg(heap, list, "--weights");
                borrow wd as &wb2 in {
                    list = shared.put_arg(heap, list, buffer.bytes(wb2));
                }
                list = shared.put_arg(heap, list, "--text-weights");
                borrow tw as &tb in {
                    list = shared.put_arg(heap, list, buffer.bytes(tb));
                }
                list = shared.put_arg(heap, list, "--out");
                borrow png as &pg in {
                    list = shared.put_arg(heap, list, buffer.bytes(pg));
                }
                list = shared.put_arg(heap, list, "--resident");
                borrow also as &ab2 in {
                    let all2 = buffer.bytes(ab2);
                    var at2 = 0;
                    while at2 < len(all2) {
                        var stop2 = at2;
                        while stop2 < len(all2) && int_of(all2[stop2]) != 0 {
                            stop2 = stop2 + 1;
                        }
                        let one2 = pathx.absolute(heap, ctx.cwd, all2[at2..stop2]);
                        list = shared.put_arg(heap, list, "--also");
                        borrow one2 as &o2 in {
                            list = shared.put_arg(heap, list, buffer.bytes(o2));
                        }
                        buffer.drop(heap, one2);
                        at2 = stop2 + 1;
                    }
                }
                if n_also > 0 {
                    list = shared.put_arg(heap, list, "--condition-area");
                    list = shared.put_num(heap, list, area);
                }
                if rewrite_status != 0 {
                    status = rewrite_status;
                } else {
                    borrow list as &lb in {
                        borrow png as &pg2 in {
                            borrow final as &fn2 in {
                                status = shared.start_stage(io, heap, fs, exec, sdir, clock, "image edit (GPU, five stages)", buffer.bytes(lb), env, buffer.bytes(ob), buffer.bytes(fn2), instruction, buffer.bytes(pg2));
                            }
                        }
                    }
                }
                buffer.drop(heap, final);
                buffer.drop(heap, list);
                buffer.drop(heap, work);
                buffer.drop(heap, png);
                buffer.drop(heap, img2);
            }
        }
        buffer.drop(heap, out);
    }
    buffer.drop(heap, wd);
    buffer.drop(heap, tw);
    buffer.drop(heap, also);
    return status;
}

// `media rewrite {video|edit} PROMPT [--image P] [--also P] [--rewrite-model M]`: only the rewriter, no GPU (tools/media.py cmd_rewrite). Prints the new prompt; exit 0 when it changed, 1 when not.
fn cmd_rewrite[&i, &h, &f, &x, &c, &a, &zc](io: &!i Io, heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, ctx: &zc shared.Ctx, args: &a Args, from: int) -> [args, io_write, err_write, heap, fs_read(""), exec_under, clock, poll] int {
    var kind = "";
    var prompt = "";
    var positional = 0;
    var image = "";
    var also = "";
    var n_also = 0;
    var model = "qwen3.8:27b-mlx";
    var k = from;
    let n = arg_count(args);
    let stop = shared.dashdash(args, from);
    while k < stop {
        let t = arg(args, k);
        if shared.is_text(t, "--image") {
            k = k + 1;
            if k >= stop {
                return shared.bad_value(io, "--image");
            }
            image = arg(args, k);
        } else if shared.is_text(t, "--also") {
            k = k + 1;
            if k >= stop {
                return shared.bad_value(io, "--also");
            }
            if n_also == 0 {
                also = arg(args, k);
            }
            n_also = n_also + 1;
        } else if shared.is_text(t, "--rewrite-model") {
            k = k + 1;
            if k >= stop {
                return shared.bad_value(io, "--rewrite-model");
            }
            model = arg(args, k);
        } else if positional == 0 {
            kind = t;
            positional = 1;
        } else if positional == 1 {
            prompt = t;
            positional = 2;
        } else {
            io.error_all(io, "media: unrecognized arguments\n");
            return 2;
        }
        k = k + 1;
    }
    k = stop + 1;
    while k < n {
        if positional == 0 {
            kind = arg(args, k);
            positional = 1;
        } else if positional == 1 {
            prompt = arg(args, k);
            positional = 2;
        } else {
            io.error_all(io, "media: unrecognized arguments\n");
            return 2;
        }
        k = k + 1;
    }
    if positional < 2 || shared.is_text(kind, "video") == false && shared.is_text(kind, "edit") == false {
        io.error_all(io, "usage: media rewrite {video|edit} PROMPT [--image PICTURE [--also PICTURE2]] [--rewrite-model M]\n");
        return 2;
    }
    let is_edit = shared.is_text(kind, "edit");
    if is_edit && len(image) == 0 {
        return shared.refuse_text(io, "rewrite edit needs --image PICTURE (the model reads it)");
    }
    if is_edit == false && len(image) > 0 {
        return shared.refuse_text(io, "there is no rewriter template for a video from a picture (not measured); --image is for `rewrite edit`");
    }
    var img_abs = pathx.absolute(heap, ctx.cwd, image);
    if len(image) > 0 {
        var there = false;
        borrow img_abs as &ib in {
            there = shared.is_file(fs, buffer.bytes(ib));
        }
        if there == false {
            buffer.drop(heap, img_abs);
            var m = buffer.append(heap, buffer.empty(heap, 96), "no such image: ");
            m = buffer.append(heap, m, image);
            return shared.refuse_buf(io, heap, m);
        }
    }
    if n_also > 0 && is_edit == false {
        buffer.drop(heap, img_abs);
        return shared.refuse_text(io, "--also is for `rewrite edit`");
    }
    if n_also > 1 {
        buffer.drop(heap, img_abs);
        return shared.refuse_text(io, "the rewriter reads at most two pictures (image1 and --also once): the two-picture template is the one measured");
    }
    var also_abs = buffer.empty(heap, 8);
    if n_also == 1 {
        buffer.drop(heap, also_abs);
        also_abs = pathx.absolute(heap, ctx.cwd, also);
        var there2 = false;
        borrow also_abs as &ab in {
            there2 = shared.is_file(fs, buffer.bytes(ab));
        }
        if there2 == false {
            buffer.drop(heap, img_abs);
            buffer.drop(heap, also_abs);
            var m = buffer.append(heap, buffer.empty(heap, 96), "no such image: ");
            m = buffer.append(heap, m, also);
            return shared.refuse_buf(io, heap, m);
        }
    }
    if shared.rewriter_blank(prompt) {
        buffer.drop(heap, img_abs);
        buffer.drop(heap, also_abs);
        return shared.refuse_text(io, "the prompt is empty");
    }
    var status = 0;
    var no_picture = buffer.append(heap, buffer.empty(heap, 4), "-");
    borrow img_abs as &ia in {
        borrow no_picture as &np in {
            borrow also_abs as &aa in {
                var pic = buffer.bytes(np);
                if len(image) > 0 {
                    pic = buffer.bytes(ia);
                }
                let (rs, nt) = shared.rewrite_text(io, heap, fs, exec, clock, ctx, kind, prompt, pic, buffer.bytes(aa), model);
                status = rs;
                if rs == 0 {
                    borrow nt as &ntb in {
                        io.write_all(io, buffer.bytes(ntb));
                        io.write_all(io, "\n");
                        if shared.is_text(buffer.bytes(ntb), prompt) {
                            status = 1;
                        }
                    }
                }
                buffer.drop(heap, nt);
            }
        }
    }
    buffer.drop(heap, no_picture);
    buffer.drop(heap, img_abs);
    buffer.drop(heap, also_abs);
    return status;
}

fn run[&i, &h, &f, &x, &c, &a](io: &!i Io, heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, args: &a Args) -> [args, io_write, err_write, heap, fs_read(""), fs_write(""), file_read, file_write, dir_read, dir_write, exec_under, clock, poll] int {
    let n = arg_count(args);
    // the plain commands of slice A take no context
    if n == 2 && shared.is_text(arg(args, 1), "models") {
        return shared.models(io);
    }
    if n == 5 && shared.is_text(arg(args, 1), "check") && shared.is_text(arg(args, 2), "image") {
        let code = shared.check_image(io, heap, arg(args, 3), arg(args, 4));
        if code == 0 {
            io.write_all(io, "ok\n");
        }
        return code;
    }
    if n == 6 && shared.is_text(arg(args, 1), "check") && shared.is_text(arg(args, 2), "video") {
        return shared.check_video(io, heap, arg(args, 3), arg(args, 4), shared.is_text(arg(args, 5), "1"));
    }
    // the context flags, then the command
    var root = "";
    var cwd = "";
    var home = "";
    var py = "";
    var cache = "";
    var ew = "";
    var etw = "";
    var online = false;
    var free_kb = "";
    var ffmpeg = "";
    var env = buffer.empty(heap, 256);
    var k = 1;
    var going = true;
    while going && k < n {
        let t = arg(args, k);
        if shared.is_text(t, "--root") && k + 1 < n {
            root = arg(args, k + 1);
            k = k + 2;
        } else if shared.is_text(t, "--cwd") && k + 1 < n {
            cwd = arg(args, k + 1);
            k = k + 2;
        } else if shared.is_text(t, "--home") && k + 1 < n {
            home = arg(args, k + 1);
            k = k + 2;
        } else if shared.is_text(t, "--py") && k + 1 < n {
            py = arg(args, k + 1);
            k = k + 2;
        } else if shared.is_text(t, "--cache") && k + 1 < n {
            cache = arg(args, k + 1);
            k = k + 2;
        } else if shared.is_text(t, "--edit-weights") && k + 1 < n {
            ew = arg(args, k + 1);
            k = k + 2;
        } else if shared.is_text(t, "--edit-text-weights") && k + 1 < n {
            etw = arg(args, k + 1);
            k = k + 2;
        } else if shared.is_text(t, "--free-kb") && k + 1 < n {
            free_kb = arg(args, k + 1);
            k = k + 2;
        } else if shared.is_text(t, "--ffmpeg") {
            ffmpeg = "1";
            k = k + 1;
        } else if shared.is_text(t, "--env") && k + 1 < n {
            env = stage.add_arg(heap, env, arg(args, k + 1));
            k = k + 2;
        } else if shared.is_text(t, "--online") {
            online = true;
            k = k + 1;
        } else {
            going = false;
        }
    }
    var status = 100;
    if k >= n || len(root) == 0 || len(cwd) == 0 || len(home) == 0 || len(py) == 0 || len(cache) == 0 {
        io.error_all(io, "usage: media models | check image WxH PROMPT | check video WxH FRAMES FORCE | --root R --cwd C --home H --py P --cache K [--online] [--env N=V]... (image|edit) ...\n");
    } else {
        var py_entry = buffer.append(heap, buffer.empty(heap, 128), "CANCHO_MEDIA_PY=");
        py_entry = buffer.append(heap, py_entry, py);
        borrow py_entry as &pe in {
            env = stage.add_arg(heap, env, buffer.bytes(pe));
        }
        buffer.drop(heap, py_entry);
        if online == false {
            env = stage.add_arg(heap, env, "HF_HUB_OFFLINE=1");
        }
        var ctx = shared.Ctx { root: root, cwd: cwd, home: home, cache: cache, edit_weights: ew, edit_text_weights: etw, free_kb: free_kb, ffmpeg: ffmpeg };
        if shared.is_text(arg(args, k), "rewrite") {
            var rctx = shared.Ctx { root: root, cwd: cwd, home: home, cache: cache, edit_weights: ew, edit_text_weights: etw, free_kb: free_kb, ffmpeg: ffmpeg };
            borrow rctx as &rc in {
                status = cmd_rewrite(io, heap, fs, exec, clock, rc, args, k + 1);
            }
            buffer.drop(heap, env);
            return status;
        }
        let scripts = pathx.under(heap, root, "scripts");
        borrow scripts as &sc in {
            match open_dir(fs, buffer.bytes(sc)) {
                DirOpened::Failed(e) => {
                    status = shared.refuse_text(io, "scripts/ is not at the --root given");
                }
                DirOpened::Ok(d) => {
                    var sdir = d;
                    borrow sdir as &sd in {
                        borrow env as &eb in {
                            if shared.is_text(arg(args, k), "image") {
                                borrow ctx as &cx in {
                                    status = cmd_image(io, heap, fs, exec, sd, clock, cx, buffer.bytes(eb), args, k + 1);
                                }
                            } else if shared.is_text(arg(args, k), "edit") {
                                borrow ctx as &cx2 in {
                                    status = cmd_edit(io, heap, fs, exec, sd, clock, cx2, buffer.bytes(eb), args, k + 1);
                                }
                            } else if shared.is_text(arg(args, k), "video") {
                                borrow ctx as &cx3 in {
                                    status = video.cmd_video(io, heap, fs, exec, sd, clock, cx3, buffer.bytes(eb), args, k + 1);
                                }
                            } else if shared.is_text(arg(args, k), "transcribe") {
                                borrow ctx as &cx4 in {
                                    status = transcribe.cmd_transcribe(io, heap, fs, exec, sd, clock, cx4, buffer.bytes(eb), args, k + 1);
                                }
                            } else if shared.is_text(arg(args, k), "speak") {
                                borrow ctx as &cx5 in {
                                    status = speak.cmd_speak(io, heap, fs, exec, sd, clock, cx5, buffer.bytes(eb), args, k + 1);
                                }
                            } else {
                                io.error_all(io, "media: build/media runs image, edit, video, transcribe, speak and rewrite; the other commands are tools/media.py's\n");
                                status = 2;
                            }
                        }
                    }
                    dir_close(sdir);
                }
            }
        }
        buffer.drop(heap, scripts);
    }
    buffer.drop(heap, env);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(signals);
    release(tty);
    var status = 100;
    borrow mut io as &!i in {
        borrow mut heap as &!h in {
            borrow fs as &f in {
                borrow exec as &x in {
                    borrow clock as &c in {
                        borrow args as &g in {
                            status = run(i, h, f, x, c, g);
                        }
                    }
                }
            }
        }
    }
    release(args);
    release(io);
    release(heap);
    release(fs);
    release(exec);
    release(clock);
    return status;
}

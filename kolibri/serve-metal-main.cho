edition 9;

// `cancho-gpu-kolibri` -- the server of Kolibri 1.1 on a Metal GPU (docs/kolibri.md section 18):
//
//     cancho-gpu-kolibri <gguf> <model file> [--port N] [--name MODEL] [--api-key KEY] [--ctx STEPS] [--ring SLOTS] [--window KEYS] [--greedy] [--end ID] [--max-new N] [--trace] [NAME=value ...]
//
//     POST /api/generate           Ollama's: a prompt in, the answer out
//     POST /v1/chat/completions    OpenAI's: messages in, a completion out
//     GET  /health, /v1/models, /api/tags
//
// The GGUF gives the tokenizer and the end tokens. The model file is a session file whose request is `N ID MASK` (`N ID MASK U` unless `--greedy`) and whose first answer is the id the step
// chose: models/kolibri_step.model with GEN=1, its definitions after the flags. `--ctx` is the steps its tables hold (2,184), `--ring` and `--window` a sliding layer's slots and keys when
// the ring is shorter than that (none: the ring never wraps, and any position can be gone back to). The server's logic is kolibri/kserve.cho; this program is its engine, the Metal session's (device/msession.cho). Linked with shim/canchogpu-metal.mm.
// One request at a time; a connection carries one request. **It listens on every address of the host**: give it `--api-key` on a network, or `--loopback` (127.0.0.1 only, as cancho-gpu-front's runner).
// `--trace` writes each line given to the session to standard error.
//
// Built by scripts/build-kolibri-serve.sh.

import std.io;
import mem;
import text;
import err;
import cli;
import fileio;
import chat;
import session;
import kserve;
import kcache;
import kcache_dev;
import metal;
import msession;

fn words() -> [] int {
    return 100000000;
}

fn bytes_cap() -> [] int {
    return 536870912;
}

fn floats_cap() -> [] int {
    return 32000000;
}

fn usage[&i](io: &!i Io) -> [err_write] int {
    io.error_all(io, "usage: cancho-gpu-kolibri");
    io.error_all(io, kserve.usage_text());
    return 2;
}

// One connection: its request read, answered at once or by the model, and a line said of it.
fn handle[&m, &t, &x, &i, &k, &c, &g, &f](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, fs: &f Fs(""), clock: &k Clock, ch: &!c Conn, cfg: int, sess: int, ffi: &g Ffi("libmetalgpu"), funcs: int, bufs: int, ptabs: int) -> [err_write, clock, conn_read, conn_write, ffi("libmetalgpu"), fs_write(""), file_write] int {
    let t0 = clock_ms(clock);
    let (code, from, he, blen) = kserve.read_request(m, t, ch);
    if code < 0 {
        return 0;
    }
    if code > 0 {
        kserve.respond(m, t, ch, code, chat.error_json(m, t, kserve.last_error(m, t), "invalid_request_error"));
        return 0;
    }
    let (rc, what) = kserve.open(m, t, cfg, from, he, blen, clock_unix_ms(clock) / 1000);
    if m[cfg + kserve.c_trace()] == 1 {
        // what the request took of the pools to become a prompt's ids, or to be refused
        io.error_all(io, text.bytes(t, text.n3(m, t, "pools $ words of $, $ bytes\n", m[mem.top_slot()], len(m), m[mem.text_slot()])));
    }
    if rc > 0 {
        kserve.respond(m, t, ch, rc, what);
        io.error_all(io, text.bytes(t, kserve.log_line(m, t, cfg, from, he, rc, 0 - 1, clock_ms(clock) - t0)));
        return 0;
    }
    // the head now: the model may take longer than a client waits for one
    let gone = kserve.respond_head(m, t, ch) < 0;
    let mark = m[mem.top_slot()];
    let tmark = m[mem.text_slot()];
    var failed = false;
    var line = kserve.next(m, t, cfg, what);
    while line >= 0 && !failed {
        if m[cfg + kserve.c_trace()] == 1 {
            io.error_all(io, "ask ");
            io.error_all(io, text.bytes(t, line));
            io.error_all(io, "\n");
        }
        let (st, v) = msession.ask(m, t, fm, ffi, sess, funcs, bufs, ptabs, line);
        if st < 0 || kserve.took(m, t, cfg, what, v) < 0 {
            failed = true;
        } else {
            mem.release_to(m, mark);
            m[mem.text_slot()] = tmark;
            line = kserve.next(m, t, cfg, what);
        }
    }
    if failed {
        // the session refused, or answered what it cannot have: said in the body, since the head is gone, and the server stops, since the session's state is not known any more
        let msg = kserve.last_error(m, t);
        io.error_all(io, "error[kolibri-session]: ");
        io.error_all(io, text.bytes(t, msg));
        io.error_all(io, "\n");
        kserve.respond_body(m, t, ch, chat.error_json(m, t, msg, "server_error"));
        return 0 - 1;
    }
    if !gone {
        kserve.respond_body(m, t, ch, kserve.body(m, t, cfg, what));
    }
    io.error_all(io, text.bytes(t, kserve.log_line(m, t, cfg, from, he, 200, what, clock_ms(clock) - t0)));
    // the answer is gone: what the prompt left in the session is kept now, if it is worth a file
    return keep(m, t, io, fs, clock, ffi, cfg, sess, bufs, what);
}

// The caches of the file, if there is one and it is this server's, into the device's rolls (docs/kolibri.md section 28). A file that is not is said and left alone: never an
// error of the start.
fn restore[&m, &t, &x, &i, &f, &k, &g](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, fs: &f Fs(""), clock: &k Clock, ffi: &g Ffi("libmetalgpu"), cfg: int, sess: int, funcs: int, bufs: int, ptabs: int) -> [err_write, fs_read(""), file_read, clock, ffi("libmetalgpu")] int {
    let path = m[cfg + kserve.c_cache()];
    if path < 0 {
        return 0;
    }
    let t0 = clock_ms(clock);
    let mark = m[mem.top_slot()];
    let tmark = m[mem.text_slot()];
    let rolls = kcache.rolls(m, sess);
    let (n, ids, off) = kcache.open(m, t, fs, path, m[cfg + kserve.c_gguf_bytes()], m[cfg + kserve.c_ctx()], kserve.vocab(m, cfg), rolls);
    var took = n > 0;
    if took {
        took = kcache_dev.read(m, t, ffi, fs, path, off, rolls, bufs, n) == 0;
    }
    if took {
        let (st, v) = msession.ask(m, t, fm, ffi, sess, funcs, bufs, ptabs, text.n1(m, t, "seek $", n));
        took = st >= 0;
    }
    if took {
        kserve.restored(m, cfg, n, ids);
        io.error_all(io, text.bytes(t, text.f3(m, t, "took $ positions from $ in $ ms\n", text.num(m, t, n), path, text.num(m, t, clock_ms(clock) - t0))));
    } else if n != 0 {
        io.error_all(io, text.bytes(t, text.f2(m, t, "the cache $ is not taken: $\n", path, kserve.last_error(m, t))));
    }
    mem.release_to(m, mark);
    m[mem.text_slot()] = tmark;
    return 0;
}

// After a request: the caches to its prompt's end into the file, when the server says they are worth it. A write that fails is said, and nothing more.
fn keep[&m, &t, &i, &f, &k, &g](m: &!m [int], t: &!t [byte], io: &!i Io, fs: &f Fs(""), clock: &k Clock, ffi: &g Ffi("libmetalgpu"), cfg: int, sess: int, bufs: int, j: int) -> [err_write, fs_write(""), file_write, clock, ffi("libmetalgpu")] int {
    let n = kserve.keeps(m, cfg, j);
    if n == 0 {
        return 0;
    }
    let t0 = clock_ms(clock);
    let path = m[cfg + kserve.c_cache()];
    let rolls = kcache.rolls(m, sess);
    let hd = kcache.head(m, t, m[cfg + kserve.c_gguf_bytes()], m[cfg + kserve.c_ctx()], kserve.vocab(m, cfg), rolls, n, kserve.kept_ids(m, cfg));
    let wrote = kcache_dev.write(m, t, ffi, fs, path, hd, rolls, bufs, n);
    if wrote < 0 {
        io.error_all(io, text.bytes(t, text.f2(m, t, "the cache $ is not written: $\n", path, kserve.last_error(m, t))));
        return 0;
    }
    kserve.kept(m, cfg, n);
    let l = mem.of4(m, text.num(m, t, n), path, text.num(m, t, wrote), text.num(m, t, clock_ms(clock) - t0));
    io.error_all(io, text.bytes(t, text.fmt(m, t, "kept $ positions in $ ($ bytes) in $ ms\n", l)));
    return 0;
}

fn serve[&m, &t, &x, &i, &k, &g, &l, &f](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, fs: &f Fs(""), clock: &k Clock, lh: &!l Listener, ffi: &g Ffi("libmetalgpu"), cfg: int, sess: int, funcs: int, bufs: int, ptabs: int) -> [err_write, clock, conn_accept, conn_read, conn_write, ffi("libmetalgpu"), fs_write(""), file_write] int {
    // what the load allocated stays; what a request allocated is given back after it
    let mark_m = m[mem.top_slot()];
    let mark_t = m[mem.text_slot()];
    var failures = 0;
    while failures < 100 {
        var stop = false;
        match tcp_accept(lh) {
            Accepted::Ok(conn) => {
                failures = 0;
                var c = conn;
                borrow mut c as &!ch in {
                    stop = handle(m, t, fm, io, fs, clock, ch, cfg, sess, ffi, funcs, bufs, ptabs) < 0;
                }
                conn_close(c);
            }
            Accepted::Again => {
            }
            Accepted::Failed(e) => {
                failures = failures + 1;
            }
        }
        if stop {
            return 1;
        }
        mem.release_to(m, mark_m);
        m[mem.text_slot()] = mark_t;
    }
    io.error_all(io, "error[accept]: the listening socket keeps failing\n");
    return 1;
}

fn run[&m, &t, &x, &i, &f, &k, &l, &g](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, fs: &f Fs(""), clock: &k Clock, lh: &!l Listener, ffi: &g Ffi("libmetalgpu"), cfg: int) -> [err_write, fs_read(""), file_read, clock, conn_accept, conn_read, conn_write, ffi("libmetalgpu"), fs_write(""), file_write] int {
    if kserve.load(m, t, fs, cfg) < 0 {
        return cli.report(m, t, io);
    }
    let file = text.bytes(t, m[cfg + kserve.c_model()]);
    let top = m[mem.text_slot()];
    var got = 0 - 1;
    if fileio.covers(fs, file) {
        got = fs_read(fs, file, t[top..len(t)]);
    }
    if got < 0 {
        io.error_all(io, "error[io]: cannot read ");
        io.error_all(io, file);
        io.error_all(io, "\n");
        return 1;
    }
    m[mem.text_slot()] = top + got;
    let sess = session.open(m, t, fm, fs, text.handle(top, got), m[cfg + kserve.c_defs()], text.lit(m, t, "apple-m-series"), true, true);
    if sess < 0 {
        return cli.report(m, t, io);
    }
    let (funcs, bufs) = msession.setup(m, t, fm, ffi, fs, sess);
    if funcs < 0 {
        return cli.report(m, t, io);
    }
    let ptabs = msession.tables_by_program(m, sess);
    restore(m, t, fm, io, fs, clock, ffi, cfg, sess, funcs, bufs, ptabs);
    if m[cfg + kserve.c_loopback()] == 1 {
        io.error_all(io, text.bytes(t, text.n1(m, t, "listening on port $ (127.0.0.1 only)\n", m[cfg + kserve.c_port()])));
    } else {
        io.error_all(io, text.bytes(t, text.n1(m, t, "listening on port $ (every address of this host)\n", m[cfg + kserve.c_port()])));
    }
    let status = serve(m, t, fm, io, fs, clock, lh, ffi, cfg, sess, funcs, bufs, ptabs);
    metal.cgpu_close(ffi);
    return status;
}

// Listen on every address, or on 127.0.0.1 only (`--loopback`: a runner of cancho-gpu-front, docs/one-server.md).
fn listen_on[&n](net: &n Net(""), port: int, loopback: bool) -> [net_in("")] Listening {
    if loopback {
        return tcp_listen_on(net, "127.0.0.1", port, 16, 0);
    }
    return tcp_listen(net, port, 16, 0);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(signals);
    release(exec);
    release(tty);
    let gpu = narrow(ffi, "libmetalgpu");
    var status = 0;
    borrow mut heap as &!h in {
        var mb = box_slice(h, words(), 0);
        var tb = box_slice(h, bytes_cap(), byte_of(0));
        var fb = box_slice(h, floats_cap(), 0.0);
        borrow mut mb as &!mr in {
            borrow mut tb as &!tr in {
                borrow mut fb as &!fr in {
                    let m = contents(mr);
                    let t = contents(tr);
                    let fm = contents(fr);
                    mem.init(m);
                    var cfg = 0 - 1;
                    borrow args as &a in {
                        cfg = kserve.config(m, t, a);
                    }
                    if cfg < 0 {
                        borrow mut io as &!i in {
                            status = usage(i);
                        }
                    } else {
                        borrow net as &nn in {
                            match listen_on(nn, m[cfg + kserve.c_port()], m[cfg + kserve.c_loopback()] == 1) {
                                Listening::Ok(l) => {
                                    var listener = l;
                                    borrow mut listener as &!lh in {
                                        borrow mut io as &!i in {
                                            borrow fs as &f in {
                                                borrow clock as &c in {
                                                    borrow gpu as &g in {
                                                        status = run(m, t, fm, i, f, c, lh, g, cfg);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    listener_close(listener);
                                }
                                Listening::Failed(e) => {
                                    borrow mut io as &!i in {
                                        io.error_all(i, "error[listen]: cannot listen on that port\n");
                                    }
                                    status = 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        unbox_slice(h, mb);
        unbox_slice(h, tb);
        unbox_slice(h, fb);
    }
    release(heap);
    release(net);
    release(io);
    release(fs);
    release(args);
    release(clock);
    release(gpu);
    return status;
}

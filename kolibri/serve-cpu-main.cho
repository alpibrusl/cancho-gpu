edition 5;

// `cancho-gpu-kolibri-cpu` -- the server of Kolibri 1.1 on the CPU interpreter's session: what the gate runs, on a session that is no model (docs/kolibri.md section 18):
//
//     cancho-gpu-kolibri-cpu <gguf> <model file> [--port N] [--name MODEL] [--api-key KEY] [--ctx STEPS] [--ring SLOTS] [--window KEYS] [--greedy] [--end ID] [--max-new N] [--trace] [NAME=value ...]
//
//     POST /api/generate           Ollama's: a prompt in, the answer out
//     POST /v1/chat/completions    OpenAI's: messages in, a completion out
//     GET  /health, /v1/models, /api/tags
//
// The GGUF gives the tokenizer and the end tokens. The model file is a session file whose request is `N ID MASK` (`N ID MASK U` unless `--greedy`) and whose first answer is the id the step
// chose: models/kolibri_step.model with GEN=1, its definitions after the flags. `--ctx` is the steps its tables hold (2,184), `--ring` and `--window` a sliding layer's slots and keys when
// the ring is shorter than that (none: the ring never wraps, and any position can be gone back to). The server's logic is kolibri/kserve.cho; this program is its engine, the CPU session's.
// One request at a time; a connection carries one request. **It listens on every address of the host**: give it `--api-key` on a network.
// `--trace` writes each line given to the session to standard error.
//
// Built by scripts/build-kolibri-serve.sh.

import std.io;
import mem;
import text;
import err;
import cli;
import fileio;
import chat;
import session;
import kserve;

fn words() -> [] int {
    return 100000000;
}

fn bytes_cap() -> [] int {
    return 536870912;
}

fn floats_cap() -> [] int {
    return 32000000;
}

fn usage[&i](io: &!i Io) -> [err_write] int {
    io.error_all(io, "usage: cancho-gpu-kolibri-cpu");
    io.error_all(io, kserve.usage_text());
    return 2;
}

// One connection: its request read, answered at once or by the model, and a line said of it.
fn handle[&m, &t, &x, &i, &k, &c](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, clock: &k Clock, ch: &!c Conn, cfg: int, sess: int) -> [err_write, clock, conn_read, conn_write] int {
    let t0 = clock_ms(clock);
    let (code, from, he, blen) = kserve.read_request(m, t, ch);
    if code < 0 {
        return 0;
    }
    if code > 0 {
        kserve.respond(m, t, ch, code, chat.error_json(m, t, kserve.last_error(m, t), "invalid_request_error"));
        return 0;
    }
    let (rc, what) = kserve.open(m, t, cfg, from, he, blen, clock_unix_ms(clock) / 1000);
    if rc > 0 {
        kserve.respond(m, t, ch, rc, what);
        io.error_all(io, text.bytes(t, kserve.log_line(m, t, cfg, from, he, rc, 0 - 1, clock_ms(clock) - t0)));
        return 0;
    }
    // the head now: the model may take longer than a client waits for one
    let gone = kserve.respond_head(m, t, ch) < 0;
    let mark = m[mem.top_slot()];
    let tmark = m[mem.text_slot()];
    var failed = false;
    var line = kserve.next(m, t, cfg, what);
    while line >= 0 && !failed {
        if m[cfg + kserve.c_trace()] == 1 {
            io.error_all(io, "ask ");
            io.error_all(io, text.bytes(t, line));
            io.error_all(io, "\n");
        }
        let (st, v) = session.ask(m, t, fm, sess, line);
        if st < 0 || kserve.took(m, t, cfg, what, v) < 0 {
            failed = true;
        } else {
            mem.release_to(m, mark);
            m[mem.text_slot()] = tmark;
            line = kserve.next(m, t, cfg, what);
        }
    }
    if failed {
        // the session refused, or answered what it cannot have: said in the body, since the head is gone, and the server stops, since the session's state is not known any more
        let msg = kserve.last_error(m, t);
        io.error_all(io, "error[kolibri-session]: ");
        io.error_all(io, text.bytes(t, msg));
        io.error_all(io, "\n");
        kserve.respond_body(m, t, ch, chat.error_json(m, t, msg, "server_error"));
        return 0 - 1;
    }
    if !gone {
        kserve.respond_body(m, t, ch, kserve.body(m, t, cfg, what));
    }
    io.error_all(io, text.bytes(t, kserve.log_line(m, t, cfg, from, he, 200, what, clock_ms(clock) - t0)));
    return 0;
}

fn serve[&m, &t, &x, &i, &k, &l](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, clock: &k Clock, lh: &!l Listener, cfg: int, sess: int) -> [err_write, clock, conn_accept, conn_read, conn_write] int {
    // what the load allocated stays; what a request allocated is given back after it
    let mark_m = m[mem.top_slot()];
    let mark_t = m[mem.text_slot()];
    var failures = 0;
    while failures < 100 {
        var stop = false;
        match tcp_accept(lh) {
            Accepted::Ok(conn) => {
                failures = 0;
                var c = conn;
                borrow mut c as &!ch in {
                    stop = handle(m, t, fm, io, clock, ch, cfg, sess) < 0;
                }
                conn_close(c);
            }
            Accepted::Again => {
            }
            Accepted::Failed(e) => {
                failures = failures + 1;
            }
        }
        if stop {
            return 1;
        }
        mem.release_to(m, mark_m);
        m[mem.text_slot()] = mark_t;
    }
    io.error_all(io, "error[accept]: the listening socket keeps failing\n");
    return 1;
}

fn run[&m, &t, &x, &i, &f, &k, &l](m: &!m [int], t: &!t [byte], fm: &!x [float], io: &!i Io, fs: &f Fs(""), clock: &k Clock, lh: &!l Listener, cfg: int) -> [err_write, fs_read(""), file_read, clock, conn_accept, conn_read, conn_write] int {
    if kserve.load(m, t, fs, cfg) < 0 {
        return cli.report(m, t, io);
    }
    let file = text.bytes(t, m[cfg + kserve.c_model()]);
    let top = m[mem.text_slot()];
    var got = 0 - 1;
    if fileio.covers(fs, file) {
        got = fs_read(fs, file, t[top..len(t)]);
    }
    if got < 0 {
        io.error_all(io, "error[io]: cannot read ");
        io.error_all(io, file);
        io.error_all(io, "\n");
        return 1;
    }
    m[mem.text_slot()] = top + got;
    let sess = session.open(m, t, fm, fs, text.handle(top, got), m[cfg + kserve.c_defs()], text.empty(), false, false);
    if sess < 0 {
        return cli.report(m, t, io);
    }
    io.error_all(io, text.bytes(t, text.n1(m, t, "listening on port $ (every address of this host)\n", m[cfg + kserve.c_port()])));
    return serve(m, t, fm, io, clock, lh, cfg, sess);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    var status = 0;
    borrow mut heap as &!h in {
        var mb = box_slice(h, words(), 0);
        var tb = box_slice(h, bytes_cap(), byte_of(0));
        var fb = box_slice(h, floats_cap(), 0.0);
        borrow mut mb as &!mr in {
            borrow mut tb as &!tr in {
                borrow mut fb as &!fr in {
                    let m = contents(mr);
                    let t = contents(tr);
                    let fm = contents(fr);
                    mem.init(m);
                    var cfg = 0 - 1;
                    borrow args as &a in {
                        cfg = kserve.config(m, t, a);
                    }
                    if cfg < 0 {
                        borrow mut io as &!i in {
                            status = usage(i);
                        }
                    } else {
                        borrow net as &nn in {
                            match tcp_listen(nn, m[cfg + kserve.c_port()], 16, 0) {
                                Listening::Ok(l) => {
                                    var listener = l;
                                    borrow mut listener as &!lh in {
                                        borrow mut io as &!i in {
                                            borrow fs as &f in {
                                                borrow clock as &c in {
                                                    status = run(m, t, fm, i, f, c, lh, cfg);
                                                }
                                            }
                                        }
                                    }
                                    listener_close(listener);
                                }
                                Listening::Failed(e) => {
                                    borrow mut io as &!i in {
                                        io.error_all(i, "error[listen]: cannot listen on that port\n");
                                    }
                                    status = 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        unbox_slice(h, mb);
        unbox_slice(h, tb);
        unbox_slice(h, fb);
    }
    release(heap);
    release(net);
    release(io);
    release(fs);
    release(args);
    release(clock);
    return status;
}

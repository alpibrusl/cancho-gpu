// PROBE type
// ARGS m=64 n=64 k=32
// BatchNorm's statistics in the convolution's epilogue: the accumulator is a fragment, and a fragment can be accumulated into, stored or carried, and nothing else.
algo frag_epilogue(m, n, k)
  in  a: f16[m, k]
  in  b: f16[n, k]
  out y: f32[m, n]
  out s: f32[m]
  tile bm, bn, bk
{
  grid i over m / bm, j over n / bn
  let c = zeros f32[bm, bn] @frag
  let c = for p in 0 .. k / bk with c {
    let at = load a[i * bm, p * bk ; bm, bk] @shared
    let bt = load b[j * bn, p * bk ; bn, bk] @shared
    yield mma c at bt
  }
  let r = rowsum c
  store r -> s[i * bm]
  store c -> y[i * bm, j * bn]
}

schedule frag_epilogue for apple-m-series { threads 128 warps 2 2 bm 32 bn 32 bk 16 }
schedule frag_epilogue for nvidia-ada     { threads 128 warps 2 2 bm 32 bn 32 bk 16 }

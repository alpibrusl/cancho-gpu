// One Adam step on n parameters, element-wise (so safe in place: the output may be the buffer of the input, `docs/resident.md` section 12):
//
//     g = grad gs            m = m + (g - m) (1 - beta1)         v = v beta2 + ((1 - beta2) g) g
//     w = w - rate (m / (sqrt(v) isq + eps))
//
// `s` is the step's two numbers [rate, isq] = [lr / (1 - beta1^t), 1 / sqrt(1 - beta2^t)], one block of a session `table`, computed on the host in binary64;
// `gs` scales the gradient (1/r for a mean over r samples). The surface has no sqrt: sqrt(v) = v rsqrt(v), with 1e-30 added to v inside it so that v = 0 gives
// 1e-15, far below eps, and not 0 * infinity. `torch.optim.Adam` is the reference (examples/train/mlp_check.py).
algo adam(n, bn, gs, b1, b2, eps)
  in  w:    f32[1, n]
  in  m:    f32[1, n]
  in  v:    f32[1, n]
  in  grad: f32[1, n]
  in  s:    f32[1, 2]
  out wo:   f32[1, n]
  out mo:   f32[1, n]
  out vo:   f32[1, n]
{
  grid i over n / bn
  let g0 = load grad[0, i * bn ; 1, bn]
  let g  = g0 * gs
  let m0 = load m[0, i * bn ; 1, bn]
  let d  = &g - &m0
  let m1 = m0 + d * (1 - b1)
  store &m1 * 1.0 -> mo[0, i * bn]
  let v0 = load v[0, i * bn ; 1, bn]
  let q  = &g * (1 - b2)
  let v1 = v0 * b2 + q * g
  store &v1 * 1.0 -> vo[0, i * bn]
  let vg = v1 + 1.0e-30
  let rr = rsqrt &vg
  let sq = vg * rr
  let o  = zeros f32[1, bn]
  let on = o + 1.0
  let sc = load s[0, 1 ; 1, 1]
  let sb = matmul sc &on
  let dn = sq * sb + eps
  let q2 = m1 / dn
  let rt = load s[0, 0 ; 1, 1]
  let rb = matmul rt on
  let w0 = load w[0, i * bn ; 1, bn]
  store w0 - q2 * rb -> wo[0, i * bn]
}

schedule adam for apple-m-series { threads 128 }
schedule adam for nvidia-ada     { threads 128 }

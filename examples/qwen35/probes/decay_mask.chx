// PROBE numeric
// ARGS nc=4
// The decay matrix D[i, j] = exp(gc_i - gc_j) on i >= j, applied to a product block: the difference of a loaded column and a loaded row (both broadcasts are in the grammar), clamped with relu so that the upper triangle never reaches exp (gc falls, so the unclamped upper triangle is exp(+hundreds): inf times the mask's 0 is NaN), then multiplied by a mask table. The surface has no min and no tril: min(x, 0) = x - relu(x), the mask is a [64, 64] table of 0 and 1 the host writes.
algo decay_mask(nc)
  in  a:    f32[nc * 64, 64]
  in  gcc:  f32[nc * 64, 1]
  in  gcr:  f32[nc, 64]
  in  mask: f32[64, 64]
  out y:    f32[nc * 64, 64]
{
  grid c over nc
  let col = load gcc[c * 64, 0 ; 64, 1]
  let row = load gcr[c, 0 ; 1, 64]
  let z1  = zeros f32[64, 64]
  let z2  = zeros f32[64, 64]
  let dc  = z1 + col
  let dr  = z2 + row
  let df  = dc - dr
  let pos = relu &df
  let cl  = df - pos
  let d   = exp cl
  let av  = load a[c * 64, 0 ; 64, 64]
  let mk  = load mask
  let am  = av * mk
  store am * d -> y[c * 64, 0]
}

schedule decay_mask for apple-m-series { threads 128 }
schedule decay_mask for nvidia-ada     { threads 128 }

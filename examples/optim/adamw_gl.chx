// AdamW with a clip scale, a decay factor per group and an apply flag (docs/optimizer.md section 2) and the f16 copy the matrix unit reads. `s` is one row of the group's table,
// [rate, isq, dec, apply, 1 - apply] = [lr_t / (1 - b1^t), 1 / sqrt(1 - b2^t), 1 - lr_t wd, 1 if this repetition ends a window, 0 then], computed on the host in binary64; `cs` is clip_scale's coefficient (1 for no clip).
//     g = grad gs cs     m = m + (g - m)(1 - b1)     v = v b2 + ((1 - b2) g) g     w = w dec - rate m / (sqrt(v) isq + eps)
// `ob1` and `ob2` are 1 - beta1 and 1 - beta2 computed on the host in binary64 (1 - 0.999 in f32 is off by 5e-5 relative, torch's is not).
// `osc` multiplies the f16 copy (alpha / r for a LoRA B, 1 for A: examples/qwen/adamw_l.chx); the gradient is masked before it is accumulated (gacc_m).
// The f16 copy is of the blended value (the weight the next micro-step reads), not of the update that was not applied.
// With apply = 0 the outputs are the inputs (old (1 - apply) + new apply, exact for 0 and 1): the micro-steps of a window leave the optimiser alone.
algo adamw_gl(n, bn, gs, b1, ob1, b2, ob2, eps, osc)
  in  w:    f32[1, n]
  in  m:    f32[1, n]
  in  v:    f32[1, n]
  in  grad: f32[1, n]
  in  s:    f32[1, 5]
  in  cs:   f32[1, 1]
  out wo:   f32[1, n]
  out mo:   f32[1, n]
  out vo:   f32[1, n]
  out wh:   f16[1, n]
{
  grid i over n / bn
  let z  = zeros f32[1, bn]
  let on = z + 1.0
  let ap = load s[0, 3 ; 1, 1]
  let ab = matmul ap &on
  let an = load s[0, 4 ; 1, 1]
  let na = matmul an &on
  let cc = load cs[0, 0 ; 1, 1]
  let cb = matmul cc &on
  let g0 = load grad[0, i * bn ; 1, bn]
  let g1 = g0 * gs
  let g  = g1 * cb
  let m0 = load m[0, i * bn ; 1, bn]
  let d  = &g - &m0
  let m1 = &m0 + d * ob1
  store m0 * &na + &m1 * &ab -> mo[0, i * bn]
  let v0 = load v[0, i * bn ; 1, bn]
  let q  = &g * ob2
  let v1 = &v0 * b2 + q * g
  store v0 * &na + &v1 * &ab -> vo[0, i * bn]
  let vg = v1 + 1.0e-30
  let rr = rsqrt &vg
  let sq = vg * rr
  let sc = load s[0, 1 ; 1, 1]
  let sb = matmul sc &on
  let dn = sq * sb + eps
  let q2 = m1 / dn
  let rt = load s[0, 0 ; 1, 1]
  let rb = matmul rt &on
  let dc = load s[0, 2 ; 1, 1]
  let db = matmul dc on
  let w0 = load w[0, i * bn ; 1, bn]
  let wn = &w0 * db - q2 * rb
  let wb = w0 * na + wn * ab
  store &wb * 1.0 -> wo[0, i * bn]
  let ws = wb * osc
  let wq = stage f16 ws
  store wq -> wh[0, i * bn]
}

schedule adamw_gl for apple-m-series { threads 128 }
schedule adamw_gl for nvidia-ada     { threads 128 }
